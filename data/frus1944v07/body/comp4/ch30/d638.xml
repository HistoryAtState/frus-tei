    <text>
        <body>
            <div xml:id="d638">

                <pb facs="0682" n="668" sameAs="frus:frus1944v07/pg668"/>

                <note rend="inline" type="source">632.116/12–1944</note>
                <head>
                    <hi rendition="#italic">The American Embassy in Brazil to the Brazilian Ministry
                        for Foreign Affairs </hi><anchor n="73" xml:id="d638-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 2341</seg>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Aide-Mémoire</hi>
                </p>
                <p>The Embassy of the United States of America presents its compliments to the
                    Ministry of Foreign Affairs and, at the request of the Department of State, has
                    the honor to draw its attention in the attached memorandum to the views of the
                    Department regarding the introduction of trade controls in Brazil affecting the
                    importation of products from the United States and the Reciprocal Trade
                    Agreement between the United States and Brazil.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <placeName><hi rendition="#small-caps">Rio de Janeiro</hi></placeName>,
                            <date calendar="gregorian" when="1944-12-15">December 15,
                        1944</date>.</dateline>
                </closer>


                <xi:include href="d638-a1.xml" xpointer="d638-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d638-f1" n="73" type="source" xml:id="d638-f1-content">
                <p>Copy transmitted to the Department in despatch 19230, December 19, 1944, from Rio
                    de Janeiro: received December 28.</p>
            </note>
        </listAnnotation>
    </standOff>
