            <div xml:id="d713">

                <pb facs="0760" n="746" sameAs="frus:frus1944v07/pg746"/>

                <note rend="inline" type="source">825.24/1865a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Chile</hi>
                        (<hi rendition="#italic">Bowers</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-06-14">June 14, 1944</date>.</dateline>
                </opener>
                <p>692. Please reply immediately if Chile can be included in rollback
                    decentralization announcement along with other countries on June 15.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
