            </note>
            <note corresp="#d1303-f2" n="24" xml:id="d1303-f2-content">
                <p>Alamo Canal.</p>
            </note>
            <note corresp="#d1303-f3" n="25" xml:id="d1303-f3-content">
                <p>A Mexican commission.</p>
            </note>
            <note corresp="#d1303-f4" n="26" xml:id="d1303-f4-content">
                <p>Elijio Esquivel, manager of the Mexicali office of the National Irrigation
                    Commission.</p>
            </note>
        </listAnnotation>
    </standOff>
