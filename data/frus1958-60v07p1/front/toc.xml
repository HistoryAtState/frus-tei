    <text>
        <body>
            <div xml:id="toc">

                <pb facs="0015" n="XI" xml:id="pgXI"/>

                <head>Contents</head>
                <list type="toc">
                    <item><ref target="#pgIII"><hi rendition="#bold">Preface</hi></ref></item>
                    <item><ref target="#pgXIII"><hi rendition="#bold">List of
                        Sources</hi></ref></item>
                    <item><ref target="#pgXIX"><hi rendition="#bold">List of
                            Abbreviations</hi></ref></item>
                    <item><ref target="#pgXXV"><hi rendition="#bold">List of
                        Persons</hi></ref></item>
                    <item>Western European Integration <list>
                            <item><ref target="#pg1">U.S. interest in the growth and development of
                                    the European Economic Communities; U.S. role in the
                                    establishment of the Organization for Economic Cooperation and
                                    Development; European Chiefs of Mission Meetings in Paris May
                                    9–13, 1958, and in London October 6–8, 1958</ref></item>
                        </list></item>
                    <item>North Atlantic Treaty Organization <list>
                            <item><ref target="#pg314">U.S. participation in the North Atlantic
                                    Treaty Organization; efforts to strengthen the Alliance through
                                    consultation and cooperation on political, economic, and
                                    military matters; U.S. participation in the North Atlantic
                                    Council Ministerial Meetings and Defense Ministers
                                    Conferences</ref></item>
                        </list></item>
                    <item>Canada <list>
                            <item><ref target="#pg684">President Eisenhower’s visit to Ottawa July 8–11, 1958;
                                    meetings of economic and military bilateral groups; use of the
                                    St. Lawrence Seaway; Prime Minister Diefenbaker’s visit to Washington June 3,
                                    1960</ref></item>
                        </list></item>
                    <item><ref target="#pg815"><hi rendition="#bold">Index</hi></ref></item>
                </list>
