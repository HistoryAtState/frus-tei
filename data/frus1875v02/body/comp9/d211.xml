    <text>
        <body>
            <div xml:id="d211">

                <pb facs="0415" n="1069" sameAs="frus:frus1875v02/pg1069"/>

                <head>No. 510.<lb/><hi rendition="#italic">Mr. Fish to Mr. Schuyler.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1875-06-18"><hi rendition="#italic">May</hi> 18,
                        1875</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Schuyler</hi>,<lb/><hi
                        rendition="#italic">Chargé d’Affaires, St. Petersburg:</hi></p>
                <p>Attend the telegraphic convention and report results without committing this
                    Government.</p>
                <closer><signed>FISH, <hi rendition="#italic">Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
