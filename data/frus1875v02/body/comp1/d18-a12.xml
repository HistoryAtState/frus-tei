    <text>
        <body>
            <div xml:id="d18-a12">

                <pb facs="0068" n="722" sameAs="frus:frus1875v02/pg722"/>

                <opener><seg rendition="#center">[L.—Inclosure 12 in No. 384.]</seg></opener>
                <head><hi rendition="#italic">Mr. Bassett to Mr.
                            Excellent</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Port au Prince</hi></placeName>, <date calendar="gregorian"
                            when="1875-07-22"><hi rendition="#italic">July</hi> 22,
                        1875</date>.</dateline></opener>
                <p>Mr. <hi rendition="#small-caps">Minister</hi>: I have the honor to acknowledge
                    the receipt of your two dispatches j of Saturday the 17th instant, and to
                    express to you my regret that I have not before been able to make this
                    acknowledgment of them, and thank you for the information which they
                    contain.</p>
                <p>I am, Mr. Minister, your obedient servant,</p>
                <closer><signed>EBENEZER D. BASSETT.</signed></closer>
                <postscript>
                    <p>Monsieur <hi rendition="#small-caps">Excellent</hi>,<lb/><hi
                            rendition="#italic">Secretary of State for Foreign Affairs</hi>,</p>
                </postscript>
            </div>
        </body>
