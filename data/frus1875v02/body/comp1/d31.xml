    <text>
        <body>
            <div xml:id="d31">

                <pb facs="0077" n="731" sameAs="frus:frus1875v02/pg731"/>

                <head>No. 335.<lb/><hi rendition="#italic">Mr. Bassett to Mr. Fish</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Hayti</hi></placeName>, <date calendar="gregorian"
                            when="1875-10-05"><hi rendition="#italic">October</hi> 5, 1875</date>.
                        (Received October 15.)</dateline></opener>
                <p>Refugees amicably embarked and soldiers withdrawn from around my premises
                    yesterday.</p>
                <closer><signed>BASSETT.</signed></closer>
            </div>
        </body>
