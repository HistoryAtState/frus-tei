                <head>No. 592.<lb/><hi rendition="#italic">Mr. Cashing to Mr. Fish.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1875-03-12"><hi rendition="#italic">March</hi> 12,
                        1875</date>.</dateline></opener>
                <p>Credentials presented the 10th; ratification signed the 11th, and sent the same
                    day by express.</p>
                <p rendition="#center">* * * * * * *</p>
                <closer><signed>CUSHING.</signed></closer>
