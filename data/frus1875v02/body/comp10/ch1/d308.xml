    <text>
        <body>
            <div xml:id="d308">

                <pb facs="0601" n="1255" sameAs="frus:frus1875v02/pg1255"/>

                <head>No. 600.<lb/><hi rendition="#italic">Mr. Cushing to Mr. Fish.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1875-05-05"><hi rendition="#italic">May</hi> 5,
                        1875</date>.</dateline></opener>
                <p>I have obtained payment to-day of balance of indemnity money, 175,000 pesetas,
                    which will be remitted conformably to existing instructions.</p>
                <closer><signed>CUSHING.</signed></closer>
            </div>
        </body>
