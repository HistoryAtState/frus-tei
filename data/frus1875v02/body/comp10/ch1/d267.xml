        <body>
            <div xml:id="d267">

                <pb facs="0567" n="1221" sameAs="frus:frus1875v02/pg1221"/>

                <head>No. 566.<lb/><hi rendition="#italic">Mr. Cushing to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Legation</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1874-07-22"><hi rendition="#italic">July</hi> 22, 1874.</date>
                        Received August 18.)</dateline>
                    <seg rendition="#float-left">No. 64.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith copy of note to the
                    minister of state on the subject of the officers crew, and passengers of the
                    Virginius.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>C. CUSHING.</signed></closer>



                <xi:include href="d267-a1.xml" xpointer="d267-a1"/>
            </div>
