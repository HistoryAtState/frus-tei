                <pb facs="0582" n="1236" sameAs="frus:frus1875v02/pg1236"/>

                <head>No. 575.<lb/><hi rendition="#italic">Mr. Cushing to Mr. Fish</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1874-11-30"><hi rendition="#italic">November</hi> 30, 1874</date>.
                        (Received 12.30 p.m., Nov. 30.)</dateline></opener>
                <p><hi rendition="#small-caps">Fish</hi>, <hi rendition="#italic">Secretary of
                        State, Washington:</hi></p>
                <p>Instruction of twenty-eighth received, and will be punctually obeyed.</p>
                <closer><signed>CUSHING.</signed></closer>
            </div>
        </body>
