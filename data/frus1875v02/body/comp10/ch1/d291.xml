    <text>
        <body>
            <div xml:id="d291">

                <pb facs="0593" n="1247" xml:id="pg1247"/>

                <head>No. 583.<lb/><hi rendition="#italic">Mr. Cushing to Mr. Fish</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1875-02-10"><hi rendition="#italic">February</hi> 10,
                        1875</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Fish</hi>, <hi rendition="#italic"
                        >Secretary of State, Washington:</hi></p>
                <p>Interview to-day with Castro.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>Satisfactory sum of indemnity free from condition of accountability required of
                    England to be stipulated by immediate further interchange of officious
                    notes.</p>
                <closer><signed>CUSHING.</signed></closer>
            </div>
        </body>
