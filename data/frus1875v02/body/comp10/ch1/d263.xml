                <pb facs="0564" n="1218" sameAs="frus:frus1875v02/pg1218"/>

                <head>No. 562.<lb/><hi rendition="#italic">Mr. Cushing to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1874-06-01"><hi rendition="#italic">June</hi> 1, 1874</date>.
                        (Received June 22.)</dateline>
                    <seg rendition="#float-left">No. 21.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to report that my official
                    presentation to the President of the executive power of the Spanish republic
                    took place on Saturday, the 30th ultimo, according to the usual forms practiced
                    in Spain.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>C. CUSHING.</signed></closer>
            </div>
        </body>
