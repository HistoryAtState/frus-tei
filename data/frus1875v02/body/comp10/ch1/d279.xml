    <text>
        <body>
            <div xml:id="d279">

                <pb facs="0580" n="1234" sameAs="frus:frus1875v02/pg1234"/>

                <head>No. 8.<lb/><hi rendition="#italic">The Earl of Derby to Mr.
                    Layard.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Foreign Office</hi></placeName>, <date calendar="gregorian"
                            when="1874-12-19"><hi rendition="#italic">December</hi> 19,
                        1874</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit to you herewith a copy of a note
                    from the Spanish minister at this Court,<anchor n="*" xml:id="d279-f1"/>
                    inclosing a check for £6,700, on account of the claims of the families of the
                    British subjects executed at Santiago de Cuba, in November, 1873, for
                    participation in the Virginius affair.</p>
                <p>I also inclose a copy of the answer which I have returned to Señor Comyn.<anchor
                        n="†" xml:id="d279-f2"/></p>
                <p>I am, &amp;c.,</p>
                <closer><signed>DERBY.</signed></closer>
            </div>
        </body>
    </text>
