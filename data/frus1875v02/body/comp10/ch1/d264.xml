    <text>
        <body>
            <div xml:id="d264">

                <pb facs="0564" n="1218" sameAs="frus:frus1875v02/pg1218"/>

                <head>No. 563.<lb/><hi rendition="#italic">Mr. Cushing to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Legation</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1874-06-26"><hi rendition="#italic">June</hi> 26, 1874</date>.
                        (Received July 17.)</dateline>
                    <seg rendition="#float-left">No. 41.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith copy
                    of communication addressed to the minister of state of Spain, presenting
                    reclamation in behalf of the crew and passengers of the Virginius.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>C. CUSHING.</signed></closer>


                <xi:include href="d264-a1.xml" xpointer="d264-a1"/>
            </div>
