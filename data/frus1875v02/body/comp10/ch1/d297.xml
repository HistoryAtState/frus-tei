                <pb facs="0596" n="1250" xml:id="pg1250"/>

                <head>No. 589.<lb/><hi rendition="#italic">Mr. Fish
                        to Mr. Cushing</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1875-03-03"><hi rendition="#italic">March</hi> 3,
                        1875</date>.</dateline></opener>
                <p>You are authorized to present credentials, if immediately thereupon final
                    agreement will be signed.</p>
                <p rendition="#center">* * * * * * *</p>
                <closer><signed>FISH.</signed></closer>
            </div>
