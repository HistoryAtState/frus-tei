    <text>
        <body>
            <div xml:id="d233">

                <pb facs="0461" n="1115" xml:id="pg1115"/>

                <head>No. 532.<lb/><hi rendition="#italic">Mr. Fish
                        to Mr. Cushing.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1875-04-12"><hi rendition="#italic">April</hi> 12,
                        1875</date>.</dateline>
                    <seg rendition="#float-left">No. 157.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your No. 316, wherein you treat of the
                    diplomatic situation in Spain, has been received.</p>
                <p>The practice of the United States in recognizing that government of a people
                    which is the <hi rendition="#italic">de facto</hi> one, is founded upon the only
                    true and wise principle and policy.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>HAMILTON FISH.</signed></closer>
            </div>
        </body>
    </text>
