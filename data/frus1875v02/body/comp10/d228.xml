    <text>
        <body>
            <div xml:id="d228">

                <pb facs="0449" n="1103" sameAs="frus:frus1875v02/pg1103"/>

                <head>No. 527.<lb/><hi rendition="#italic">Mr. Cushing to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1875-02-16"><hi rendition="#italic">February</hi> 16, 1875</date>.
                        (Received March 12.)</dateline>
                    <seg rendition="#float-left">No. 270.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I annex hereto copy and translation of a
                    decree of January 25, 1875, re-organizing the ministry of state, which, if not
                    containing anything useful to you by way of practical suggestion, may yet be not
                    unacceptable as general information.</p>
                <p>I have, &amp;c.,</p>
                <closer><signed>C. CUSHING.</signed></closer>



                <xi:include href="d228-a1.xml" xpointer="d228-a1"/>
            </div>
