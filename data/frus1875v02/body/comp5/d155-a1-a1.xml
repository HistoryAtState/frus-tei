    <text>
        <body>
            <div xml:id="d155-a1-a1">

                <pb facs="0323" n="977" sameAs="frus:frus1875v02/pg977"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Piedras Negras</hi></placeName>, <date calendar="gregorian"
                            when="1874-10-05"><hi rendition="#italic">October</hi> 5,
                        1874</date>.</dateline></opener>
                <p>I, the judge, having returned from the parish of La Resurreccion, which I visited
                    for the purpose of taking the foregoing testimony, in obedience to superior
                    orders, hereby order that the said testimony be sent to the citizen president of
                    the municipal board of this town, to the end that it may be transmitted by him
                    to the governor of the State. In witness whereof I, the aforesaid judge, have
                    signed the present document, with assisting witnesses, as required by law.</p>
                <p>We certify.</p>
                <closer><signed>JOSÉ A. MALDONADO.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">F. Ramon</hi>,</p>
                    <p><hi rendition="#small-caps">Ventura Ramos</hi>,<lb/><hi rendition="#italic"
                            >Assisting Witnesses.</hi></p>
                </postscript>
                <postscript>
                    <p>Testimony sent as ordered. In witness—</p>
                    <p>[Seal of the court.]</p>
                    <p rendition="#right">[A flourish.]</p>
                </postscript>
            </div>
        </body>
    </text>
