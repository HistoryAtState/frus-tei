    <text>
        <body>
            <div xml:id="d153-a4-a6">

                <pb facs="0306" n="960" sameAs="frus:frus1875v02/pg960"/>

                <head><hi rendition="#small-caps">tax receipt.</hi></head>
                <p><table cols="2" rend="width:75%;" rendition="#center" rows="3">
                        <row role="label">
                            <cell role="num">$69</cell>
                            <cell role="num">22</cell>
                        </row>
                        <row>
                            <cell rendition="#border-bottom" role="num">19</cell>
                            <cell rendition="#border-bottom" role="num">35</cell>
                        </row>
                        <row>
                            <cell role="num">88</cell>
                            <cell role="num">57</cell>
                        </row>
                    </table></p>
                <p>Received of Toribio Losano the sum of sixty-nine <hi rendition="#superscript"
                        >22</hi>/100 dollars, the State and county taxes for 1873 on his property,
                    including the following-described real estate: <table cols="4" rend="bordered"
                        rows="3">
                        <row role="label">
                            <cell>A. b. No.</cell>
                            <cell>Acres.</cell>
                            <cell>Original grantee.</cell>
                            <cell>County.</cell>
                        </row>
                        <row>
                            <cell>Also</cell>
                            <cell/>
                            <cell>Nineteen <hi rendition="#superscript">35</hi>/100 dollars
                                school-tax.</cell>
                            <cell>County.</cell>
                        </row>
                        <row>
                            <cell cols="2">This 1st day of December, 1873.</cell>
                            <cell cols="2">JOHN M<hi rendition="#small-caps">c</hi>CLANE,<lb/><hi
                                    rendition="#italic">Sheiff of Nueces County.</hi></cell>
                        </row>
                    </table></p>
            </div>
        </body>
