    <text>
        <body>
            <div xml:id="d144">

                <pb facs="0284" n="938" sameAs="frus:frus1875v02/pg938"/>

                <head>No. 443.<lb/><hi rendition="#italic">Mr. Foster to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1875-06-17"><hi rendition="#italic">June</hi> 17, 1875</date>.
                        (Received July 12.)</dateline>
                    <seg rendition="#float-left">No. 305.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit herewith an official copy and
                    translation of the law passed at the last session of the Mexican Congress to
                    encourage immigration to this republic.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>JOHN W. FOSTER.</signed></closer>


                <xi:include href="d144-a1.xml" xpointer="d144-a1"/>
            </div>
