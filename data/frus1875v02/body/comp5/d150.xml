    <text>
        <body>
            <div xml:id="d150">

                <pb facs="0294" n="948" sameAs="frus:frus1875v02/pg948"/>

                <head>No. 449.<lb/><hi rendition="#italic">Mr. Foster to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1875-09-22"><hi rendition="#italic">September</hi> 22,
                        1875</date>. (Received Oct. 12.)</dateline>
                    <seg rendition="#float-left">No. 333.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The eighth national Congress convened in
                    this capital on the 16th instant, and was opened with the customary address by
                    the President of the Republic. I inclose herewith a copy and translation of the
                    address.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>JOHN W. FOSTER.</signed></closer>


                <xi:include href="d150-a1.xml" xpointer="d150-a1"/>
