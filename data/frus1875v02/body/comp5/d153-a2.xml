                <pb facs="0304" n="958" sameAs="frus:frus1875v02/pg958"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >District Court of the State of Nuevo Leon</hi>,<lb/><hi
                                rendition="#italic">Monterey</hi></placeName>, <date
                            calendar="gregorian" when="1874-01-01">1874</date>.</dateline></opener>
                <p>Deposition of witnesses solicited by the citizen Toribio Lozano for the purpose
                    of presenting a claim to the United States of America for losses suffered in
                    Texas.</p>
                <p>August 6. The citizen licentiate Valdez Gomez, judge.</p>
                <closer><signed>P. BORREGO, <hi rendition="#italic"
                    >Secretary.</hi></signed></closer>
            </div>
