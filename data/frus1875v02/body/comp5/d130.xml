    <text>
        <body>
            <div xml:id="d130">

                <pb facs="0245" n="899" sameAs="frus:frus1875v02/pg899"/>

                <head>No. 429.<lb/><hi rendition="#italic">Mr. Fish
                        to Mr. Foster.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1875-04-14"><hi rendition="#italic">April</hi> 14,
                        1875</date>.</dateline>
                    <seg rendition="#float-left">No. 214.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to a previous instruction
                    upon the subject, I transmit for your information a copy of a letter of the 10th
                    instant, and of its accompaniment, addressed to this Department by the Secretary
                    of War, relative to the recent burning of the post-office at Nueces, Texas, by
                    marauders, supposed to have come from Mexico.</p>
                <p>I am, &amp;c.,</p>
                <closer><signed>HAMILTON FISH.</signed></closer>




                <xi:include href="d130-a1.xml" xpointer="d130-a1"/>
