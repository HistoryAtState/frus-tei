    <text>
        <body>
            <div xml:id="d153-a4-a5">

                <pb facs="0306" n="960" sameAs="frus:frus1875v02/pg960"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Carrizo, Tex.</hi></placeName>, <date calendar="gregorian"
                            when="1874-02-09"><hi rendition="#italic">February</hi> 9,
                        1874</date>.</dateline></opener>
                <p>Received from Don Toribio Lozano the sum of sixty-five dollars ($65) specie, in
                    part payment of one hundred and twenty-five ($125) dollars, being the amount of
                    inspection-fees due on 800 head of sheep and goats.</p>
                <p>Balance due, $60.</p>
                <closer><signed>JOSHUA ARMSTRONG,<lb/>Inspector Sides and Animals, Zapata
                        County.</signed></closer>
            </div>
        </body>
    </text>
