    <text>
        <body>
            <div xml:id="d125-a2">

                <pb facs="0237" n="891" sameAs="frus:frus1875v02/pg891"/>

                <opener><seg rendition="#center">[Subinclosure to No. 206.]</seg></opener>
                <head><hi rendition="#italic">Mr. Taylor to the Postmaster-General</hi>.</head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Corpus Christi, Tex.</hi></placeName>,<lb/><date
                            calendar="gregorian" when="1875-03-27"><hi rendition="#italic"
                                >March</hi> 27, 1875</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">Postmaster-General</hi>,<lb/><hi
                        rendition="#italic">Washington, D. C.:</hi></p>
                <p>Post-office at Nueces robbed and burned yesterday. San Antonio mail-carrier
                    robbed and taken prisoner. Mail saved: no mail sent out to-day.</p>
                <closer><signed>H. TAYLOR,<lb/><hi rendition="#italic">Postmaster,
                            Corpus-Christi</hi></signed></closer>
            </div>
        </body>
