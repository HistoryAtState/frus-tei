    <text>
        <body>
            <div xml:id="d153-a4-a8">

                <pb facs="0307" n="961" xml:id="pg961"/>

                <head><hi rendition="#small-caps">tax receipt.</hi></head>
                <p><table cols="2" rend="width:75%;" rendition="#center" rows="3">
                        <row role="label">
                            <cell role="num">$33</cell>
                            <cell role="num">45</cell>
                        </row>
                        <row>
                            <cell rendition="#border-bottom" role="num">9</cell>
                            <cell rendition="#border-bottom" role="num">13</cell>
                        </row>
                        <row>
                            <cell role="num">42</cell>
                            <cell role="num">58</cell>
                        </row>
                    </table></p>
                <p>Received of Antonio Lozano the sum of thirty-three <hi rendition="#superscript"
                        >45</hi>/100 dollars, the State and county taxes, for the year 1873, on his
                    property, including the following-described real estate: <table cols="4"
                        rend="bordered" rows="3">
                        <row role="label">
                            <cell>A. b. No.</cell>
                            <cell>Acres.</cell>
                            <cell>Original grantees.</cell>
                            <cell>County.</cell>
                        </row>
                        <row>
                            <cell>Also</cell>
                            <cell/>
                            <cell>Nine <hi rendition="#superscript">13</hi>/100 dollars
                                school-tax.</cell>
                            <cell>County.</cell>
                        </row>
                        <row>
                            <cell cols="2">This 1st day of December, 1873.</cell>
                            <cell cols="2">JOHN M<hi rendition="#small-caps">c</hi>CLANE.<lb/><hi
                                    rendition="#italic">Sheriff of Nueces County.</hi></cell>
                        </row>
                    </table></p>
            </div>
        </body>
