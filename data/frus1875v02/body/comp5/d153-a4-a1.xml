    <text>
        <body>
            <div xml:id="d153-a4-a1">

                <pb facs="0305" n="959" xml:id="pg959"/>

                <p>We, the undersigned jurors, find that the bodies of Filomeno Rios, Epifaneo Rios,
                    Vicente Garcia, Jorge Rodriguez, Leonardo Garza, José Maria, and Bias Mata were
                    found hung to trees by parties unknown, some with their hands tied behind and
                    some before, their bodies not appearing shot or stabbed.</p>
                <closer><signed>
                        <list>
                            <item>CALIXTO TOVAR, <hi rendition="#italic">Foreman</hi>.</item>
                            <item>ALONZO ALLEN.</item>
                            <item>T. A. SHAW.</item>
                            <item>OWEN SINNOTT.</item>
                            <item>D. G. RAMIREZ.</item>
                            <item>FRANCISCO G. FLORES.</item>
                        </list></signed>
                    <lb/>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps">La
                                Chuza</hi></placeName>, <date calendar="gregorian" when="1873-12-08"
                                ><hi rendition="#italic">December</hi> 8,
                    1873</date>.</dateline></closer>
                <postscript>
                    <p>Attest:</p>
                    <closer><signed>JAMES O. LUBY,<lb/><hi rendition="#italic">Justice of the Peace,
                                Precinct No</hi>. 3, <hi rendition="#italic">Nueces County, Acting
                                Coroner.</hi></signed></closer>
                </postscript>
            </div>
        </body>
    </text>
