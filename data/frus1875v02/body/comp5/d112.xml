                <pb facs="0205" n="859" sameAs="frus:frus1875v02/pg859"/>

                <head><hi rendition="#italic">Mr. Foster to Mr.
                            Sutter.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1875-01-28"><hi rendition="#italic">January</hi>
                        28</date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#small-caps">John A. Sutter</hi>,<lb/><hi
                        rendition="#italic">American Consul, Acapulco:</hi></p>
                <p>The government will furnish Mr. Hutchinson a guard, if he desires to return by
                    land.</p>
                <closer><signed>JOHN W. FOSTER.</signed></closer>
            </div>
        </body>
