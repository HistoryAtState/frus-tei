                <pb facs="0206" n="860" sameAs="frus:frus1875v02/pg860"/>

                <head><hi rendition="#italic">Mr. Sutter to Mr.
                            Foster.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Acapulco</hi></placeName>, <date calendar="gregorian"
                            when="1875-01-29"><hi rendition="#italic">January</hi>
                        29</date>.</dateline></opener>
                <p rendition="#center">[Received in Mexico 29th, 4.45 p.m.]</p>
                <p rendition="#flush"><hi rendition="#small-caps">Minister of the United
                    States</hi>:</p>
                <p>It is more prudent for Mr. Hutchinson to go by water via Panama or San
                    Francisco.</p>
                <closer><signed>J. A. SUTTER.</signed></closer>









