                <pb facs="0140" n="794" sameAs="frus:frus1875v02/pg794"/>

                <opener><seg rendition="#center">[Inclosure in No. 219.—Translation.]</seg></opener>
                <head>Notification, No. 58.</head>
                <p rendition="#center">[From the “Japan Weekly Mail,” April 17, 1875.]</p>
                <p>An edict having been made in the terms of the annexed decree, I hereby make this
                    known.</p>
                <closer><signed>SANJO SANEYOSHI,<lb/><hi rendition="#italic">Prime
                        Minister.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><date calendar="gregorian" when="1875-04-14"
                                ><hi rendition="#small-caps">April</hi> 14,
                    1875</date>.</dateline></closer>


                <xi:include href="d76-a1-a1.xml" xpointer="d76-a1-a1"/>
            </div>
