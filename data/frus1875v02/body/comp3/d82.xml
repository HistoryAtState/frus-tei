    <text>
        <body>
            <div xml:id="d82">

                <pb facs="0160" n="814" xml:id="pg814"/>

                <head>No. 386.<lb/><hi rendition="#italic">Mr. Bingham to Mr. Fish.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Legation, Japan</hi>,<lb/><hi rendition="#italic"
                                >Tokei</hi></placeName>, <date calendar="gregorian"
                            when="1875-06-22"><hi rendition="#italic">June</hi> 22, 1875</date>.
                        (Received July 24.)</dateline>
                    <seg rendition="#float-left">No. 239.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith
                    (inclosure 1) a copy of a communication from his excellency the minister of
                    foreign affairs, Mr. Terashima, in which he informs me of the organization of
                    the new judicial department, the daishinin, and transmits a copy of the
                    regulations adopted for the government thereof and of the several courts.</p>
                <p>Mr. Thompson has carefully translated the regulations, a copy of which is
                    herewith (inclosure 2) inclosed.</p>
                <p>I am, &amp;c., &amp;c.,</p>
                <closer><signed>JOHN A. BINGHAM.</signed></closer>



                <xi:include href="d82-a1.xml" xpointer="d82-a1"/>
                <xi:include href="d82-a2.xml" xpointer="d82-a2"/>
