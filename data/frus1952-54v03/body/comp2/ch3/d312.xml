    <text>
        <body>
            <div xml:id="d312">

                <pb facs="0567" n="539" sameAs="frus:frus1952-54v03/pg539"/>

                <note rend="inline" type="source"> UNP files, lot 59 D 237, “Slates”</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Acting Director of the Office of
                        United Nations Political and Security Affairs</hi> (<hi rendition="#italic"
                        >Popper</hi>)<anchor n="1" xml:id="d312-f1"/></head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">confidential</hi></seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1954-05-10">May 10, 1954</date>.</dateline>
                </opener>
                <list subtype="subject" type="description">
                    <item>Subject:</item>
                    <item>Attached Draft Cable on Security Council Election and Presidency of Ninth
                        GA</item>
                </list>
                <p> UNA wishes to send to USUN the attached draft cable in reply to New York’s 678
                    on the question of the Security Council election and <pb facs="0568" n="540"
                        xml:id="pg540"/> the Presidency of the Ninth Assembly. Could we please have
                    your comments and clearance as soon as possible?<anchor n="2" xml:id="d312-f2"
                    /></p>


                <xi:include href="d312-a1.xml" xpointer="d312-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d312-f1" n="1" type="source" xml:id="d312-f1-content">
                <p>Addressed to the four representatives of the geographic bureaus on the Membership
                    Team.</p>
            </note>
            <note corresp="#d312-f2" n="2" xml:id="d312-f2-content">
                <p>The attached draft cable was never sent.</p>
            </note>
        </listAnnotation>
    </standOff>
