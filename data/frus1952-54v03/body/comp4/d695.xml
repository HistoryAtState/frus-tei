    <text>
        <body>
            <div xml:id="d695">

                <pb facs="1029" n="1001" xml:id="pg1001"/>

                <note rend="inline" type="source">310.2/4–3054: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Dillon</hi>) <hi rendition="#italic">to the Department of State</hi></head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi></seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1954-04-30T16:00:00+01:00">April 30, 1954—4
                            p.m.</date></dateline>
                </opener>
                <p>4157. Deptel 3872 (Vienna 3180). We have discussed Department’s position with
                    Sauvagnargues. Foreign Office views are identical and they will instruct French
                    HICOMER accordingly.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Dillon</hi></signed></closer>
            </div>
        </body>
    </text>
