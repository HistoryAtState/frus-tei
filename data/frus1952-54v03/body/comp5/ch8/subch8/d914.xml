    <text>
        <body>
            <div xml:id="d914">

                <pb facs="1482" n="1454" sameAs="frus:frus1952-54v03/pg1454"/>

                <note rend="inline" type="source">711C.02/11–453: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Mission at the United
                        Nations </hi><anchor n="1" xml:id="d914-f1"/></head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">restricted</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1953-11-04T18:45:00-05:00">November 4,
                            1953—6:45 p.m.</date>
                    </dateline>
                </opener>
                <p>214. Re Puerto Rico. Draft Res L.300 on Puerto Rico satisfactory. USDel could
                    vote for all paras.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Dulles</hi>
                    </signed></closer>


                <xi:include href="d914-a1.xml" xpointer="d914-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d914-f1" n="1" type="source" xml:id="d914-f1-content">
                <p>Drafted and signed by the Director of the Office of Dependent Area Affairs
                    (Gerig). Cleared with each of the geographic bureaus and the Legal Adviser.</p>
            </note>
        </listAnnotation>
    </standOff>
