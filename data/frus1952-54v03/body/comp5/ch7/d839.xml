    <text>
        <body>
            <div xml:id="d839">

                <pb facs="1315" n="1287" sameAs="frus:frus1952-54v03/pg1287"/>

                <note rend="inline" type="source">320.14/11–2552</note>
                <head>
                    <hi rendition="#italic">The Embassy in the United Kingdom to the Department of
                        State</hi></head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">confidential</hi>
                        <lb/> No. 2466</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1952-11-25">November 25,
                        1952</date>.</dateline>
                </opener>
                <list subtype="subject" type="description">
                    <item>Subject:</item>
                    <item>Mr. Henry Hopkinson’s<anchor n="1" xml:id="d839-f1"/> Reported Views on
                        the UN’s Work on Colonial Questions</item>
                </list>
                <p>There is enclosed a copy of a memorandum of an informal conversation between Mr.
                    Peter Smithers, M.P. and officers of the Embassy on the subject of Mr. Henry
                    Hopkinson’s reported views on the work of the UN on Colonial Questions. Mr.
                    Smithers is Mr. Hopkinson’s Parliamentary Private Secretary (unpaid, unofficial
                    personal assistant) and takes a keen interest in colonial affairs.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Margaret Joy Tibbetts</hi>
                    </signed>
                    <lb/>
                    <hi rendition="#italic">Second Secretary of Embassy</hi></closer>



                <xi:include href="d839-a1.xml" xpointer="d839-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d839-f1" n="1" xml:id="d839-f1-content">
                <p> Henry Hopkinson was Minister of State for Colonial Affairs and Member of the UK
                    Delegation to the General Assembly.</p>
            </note>
        </listAnnotation>
    </standOff>
