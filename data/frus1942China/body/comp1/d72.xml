    <text>
        <body>
            <div xml:id="d72">

                <pb facs="0070" n="60" sameAs="frus:frus1942China/pg60"/>

                <head>
                    <hi rendition="#italic">Madame Chiang Kai-shek
                        to Mr. Lauchlin Currie
                    </hi><anchor n="23" xml:id="d72-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Chungking</hi></placeName>, <date
                            calendar="gregorian" when="1942-05-31">May 31, 1942</date>.</dateline>
                </opener>
                <p>Owing critical situation in China theater Generalissimo wiring President request
                    Hopkins come China for consultation. Would it be feasible for you to come
                    together. Reply immediately.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
