    <text>
        <body>
            <div xml:id="d114">

                <pb facs="0136" n="126" sameAs="frus:frus1942China/pg126"/>

                <note rend="inline" type="source">740.0011 Pacific War/2720: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in India</hi> (<hi rendition="#italic"
                        >Merrell</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">New Delhi</hi></placeName>, <date
                            calendar="gregorian" when="1942-08-12T11:00:00+05:30">August 12, 1942—11
                            a.m.</date>
                        <lb/> [Received August 12—7:32 a.m.]</dateline>
                </opener>
                <p>596. At the request of Mr. Currie, General Stilwell has ordered Davies to
                    accompany Currie to Washington following which journey Davies is to return
                    promptly to this theater.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Merrell</hi>
                    </signed>
                </closer>
            </div>
        </body>
