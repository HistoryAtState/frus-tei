    <text>
        <body>
            <div xml:id="d461">

                <pb facs="0581" n="571" sameAs="frus:frus1942China/pg571"/>

                <note rend="inline" type="source">893.24/1354</note>
                <head>
                    <hi rendition="#italic">Memorandum of Conversation, by the Secretary of
                        State</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1942-05-27">May 27, 1942</date>.</dateline>
                </opener>
                <p>Dr. T. V. Soong, Foreign Minister of China, accompanied by the Counselor, called
                    at my request.</p>
                <p>I handed the Minister the substance of the proposed lend-lease agreement between
                    this country and China, which he seemed pleased to receive.</p>
                <p>There were just a few general remarks exchanged since the Minister was obliged to
                    leave for a White House engagement.</p>
                <closer>
                    <signed>C[<hi rendition="#small-caps">ordell</hi>] H[<hi rendition="#small-caps"
                            >ull</hi>]</signed>
                </closer>
            </div>
        </body>
