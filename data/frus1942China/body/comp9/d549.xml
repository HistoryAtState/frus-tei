    <text>
        <body>
            <div xml:id="d549">

                <pb facs="0661" n="651" xml:id="pg651"/>

                <note rend="inline" type="source">811.20 Defense (M)/6516: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi
                            rendition="#italic">Gauss</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Chungking</hi></placeName>, <date
                            calendar="gregorian" when="1942-05-07T13:00:00+07:00">May 7, 1942—1
                            p.m.</date>
                        <lb/> [Received May 7—9:40 a.m.]</dateline>
                </opener>
                <p>523. Department’s 354, May 4, 8 p.m. The stocks in reference were not shipped to
                    place of safety and there is no likelihood of saving any portion thereof. Will
                    report further information when available.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gauss</hi>
                    </signed>
                </closer>
            </div>
        </body>
