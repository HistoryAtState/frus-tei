            <div xml:id="d189">

                <pb facs="0252" n="242" sameAs="frus:frus1942China/pg242"/>

                <note rend="inline" type="source">793.94/17094: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in China</hi> (<hi rendition="#italic"
                        >Gauss</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Chungking</hi></placeName>, <date
                            calendar="gregorian" when="1942-09-21T14:00:00+07:00">September 21,
                            1942—2 p.m.</date>
                        <lb/> [Received September 22—8:23 p.m.]</dateline>
                </opener>
                <p>1072. For information of the Department only and not for other Government
                    agencies. The information contained in Embassy’s Nos. 1070 and 1071 was obtained
                    from Chou En-lai, Communist Party representative in Chungking.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gauss</hi>
                    </signed>
                </closer>
            </div>
        </body>
