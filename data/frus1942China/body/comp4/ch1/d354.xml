    <text>
        <body>
            <div xml:id="d354">

                <pb facs="0478" n="468" xml:id="pg468"/>

                <note rend="inline" type="source">893.51/7455</note>
                <head>
                    <hi rendition="#italic">The Chinese Minister for Foreign Affairs</hi> (<hi
                        rendition="#italic">Soong</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1942-02-16">February 16, 1942</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I take pleasure in
                    enclosing a translation of a telegram to the President from Generalissimo Chiang
                    Kai-shek under date of February 15, 1942, and shall be grateful if you will be
                    so good as to transmit it to its high destination.</p>
                <p>I remain [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Tse Vun Soong</hi>
                    </signed>
                </closer>


                <xi:include href="d354-a1.xml" xpointer="d354-a1"/>
            </div>
