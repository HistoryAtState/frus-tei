    <text>
        <body>
            <div xml:id="d342">

                <pb facs="0465" n="455" sameAs="frus:frus1942China/pg455"/>

                <note rend="inline" type="source">893.51/7454</note>
                <head>
                    <hi rendition="#italic">The Secretary of the Treasury</hi> (<hi
                        rendition="#italic">Morgenthau</hi>) <hi rendition="#italic">to the
                        Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-02-02">February 2,
                        1942</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Cordell</hi>: Yesterday, at five o’clock, Sir
                    Frederick Phillips of the British Treasury, called on me and gave me a
                    memorandum, a copy of which you will find enclosed herewith.</p>
                <p>Yours sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">H. Morgenthau, Jr.</hi>
                    </signed>
                </closer>


                <xi:include href="d342-a1.xml" xpointer="d342-a1"/>
