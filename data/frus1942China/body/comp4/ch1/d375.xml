    <text>
        <body>
            <div xml:id="d375">

                <pb facs="0501" n="491" sameAs="frus:frus1942China/pg491"/>

                <note rend="inline" type="source">893.51/7443</note>
                <head>
                    <hi rendition="#italic">The Chinese Ambassador</hi> (<hi
                            rendition="#italic">Hu Shih</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-03-26">March 26, 1942</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I take pleasure in
                    transmitting to you a telegram from Dr. H. H. Kung, Minister of Finance and
                    Vice-President of the Executive Yuan, under date of March 25 as follows: <quote
                        rend="blockquote">
                        <p>I wish to express the deep appreciation of the Chinese Government and
                            people for all you have done in helping the consummation of the recent
                            American loan to China. The speed and unanimity with which the loan was
                            adopted are a tribute to your statesman-like grasp <pb facs="0502"
                                n="492" xml:id="pg492"/> of our position and needs and a magnificent
                            illustration of fighting democracy in action which will hasten our
                            common victory over aggression.</p>
                        <p rendition="#right">(Signed) H. H. Kung</p>
                    </quote>
                </p>
                <p>I remain [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hu Shih</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
