            <div xml:id="d398">

                <pb facs="0527" n="517" sameAs="frus:frus1942China/pg517"/>

                <note rend="inline" type="source">893.51/7484c: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in China</hi>
                        (<hi rendition="#italic">Gauss</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-05-07T17:00:00-04:00">May 7, 1942—5
                            p.m.</date>
                    </dateline>
                </opener>
                <p>365. For Adler from the Secretary of the Treasury.</p>
                <p>“Fox has left Washington to return to Chungking by plane. He is expected to
                    arrive at Chungking about June 5.”</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
