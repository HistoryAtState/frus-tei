    <text>
        <body>
            <div xml:id="d471">

                <pb facs="0588" n="578" sameAs="frus:frus1942China/pg578"/>

                <note rend="inline" type="source">893.24/1318½</note>
                <head>
                    <hi rendition="#italic">The Chinese Minister for Foreign Affairs</hi> (<hi rendition="#italic">Soong</hi>) <hi
                        rendition="#italic">to the Under Secretary of State</hi> (<hi rendition="#italic">Welles</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1942-04-20">April 20, 1942</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Welles</hi>: In connection with our talk
                    this afternoon, I am enclosing copy of a message to Mr. Lauchlin Currie,<anchor
                        n="15" xml:id="d471-f1"/> dated Chungking, April 19th, which I think will
                    interest you.</p>
                <p>With kind regards [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Tse Vun Soong</hi>
                    </signed>
                </closer>


                <xi:include href="d471-a1.xml" xpointer="d471-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d471-f1" n="15" xml:id="d471-f1-content">
                <p>Administrative Assistant to President Roosevelt.</p>
            </note>
