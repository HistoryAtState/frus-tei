                <head>186. Summary of Conclusions of Policy Review Committee Meeting<anchor n="1"
                        xml:id="d186-f1"/>
                </head>
                <opener><dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            from="1979-02-06T16:10:00-05:00" to="1979-02-06T17:30:00-05:00">February
                            6, 1979, 4:10–5:30 p.m.</date>
                    </dateline></opener>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>U.S. Policy to Mexico</item>
                </list>
