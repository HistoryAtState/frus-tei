    <text>
        <body>
            <div xml:id="d275">

                <pb facs="0411" n="397" sameAs="frus:frus1949v07p1/pg397"/>

                <note rend="inline" type="source">501.BC Indonesia/5–349: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Consulate General at Batavia
                    </hi><anchor n="1" xml:id="d275-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">restricted   us urgent</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-05-03T17:00:00-04:00">May 3, 1949—5 p.
                            m.</date>
                    </dateline>
                </opener>
                <p>253. Usgoc 359. Despite US opposition Indo item transferred to UNGA Ad Hoc Comite May 2. This means full debate Indo question may begin any time.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d275-f1" n="1" type="source" xml:id="d275-f1-content">
                <p>Repeated as 382 to The Hague.</p>
            </note>
        </listAnnotation>
