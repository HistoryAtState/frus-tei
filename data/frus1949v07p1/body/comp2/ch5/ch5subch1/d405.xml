    <text>
        <body>
            <div xml:id="d405">

                <pb facs="0596" n="582" sameAs="frus:frus1949v07p1/pg582"/>

                <note rend="inline" type="source">856d.00/12–849: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Consulate General at
                        Batavia </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-12-15T19:00:00-05:00">December 15,
                            1949—7 p. m.</date>
                    </dateline>
                </opener>
                <p>627. Your 979<anchor n="1" xml:id="d405-f1"/> much appreciated. ECA shipments
                    will be marked with US flag and preparations now in process to insure full
                    propaganda capitalizing arrival ECA sums Indo. Similar treatment will be
                    accorded ExImBank announcement extension credit to USI. Technical missions and
                    suggested visit fleet will be discussed by Cochran upon arrival.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
