    <text>
        <body>
            <div xml:id="d313">

                <pb facs="0468" n="454" sameAs="frus:frus1949v07p1/pg454"/>

                <note rend="inline" type="source">501.BC Indonesia/6–2449: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Consulate General at
                        Batavia </hi><anchor n="1" xml:id="d313-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">confidential   priority</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1949-06-24T17:00:00-04:00">June 24, 1949—5 p.
                            m.</date>
                    </dateline>
                </opener>
                <p>346. Usgoc 390. Gocus 739.<anchor n="2" xml:id="d313-f2"/> ECA prepared discuss
                    all aspects aid program for all Indo once satisfactory political settlement
                    reached. However, on strength views Gocus 725,<anchor n="3" xml:id="d313-f3"/>
                    no resumption under present conditions now being contemplated.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
