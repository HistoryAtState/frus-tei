    <text>
        <body>
            <div xml:id="d601">

                <pb facs="0633" n="525" sameAs="frus:frus1927v02/pg525"/>

                <note rend="inline" type="source">837.00/2674</note>
                <head><hi rendition="#italic">The Chargé in Cuba</hi> (<hi rendition="#italic"
                        >Winslow</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Habana</hi></placeName>, <date calendar="gregorian"
                            when="1927-06-30"><hi rendition="#italic">June 30,
                        1927</hi></date>.<lb/>[Received July 6.]</dateline>
                    <seg rendition="#float-left">No. 2148</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the last sentence in the
                    penultimate paragraph of my despatch No. 2139 of June 27, 1927,<anchor n="17"
                        xml:id="d601-f1"/> I have the honor to transmit herewith a complete
                    translation of the Constitutional Amendment Bill<anchor n="17" xml:id="d601-f2"
                    /> as it was published in the <hi rendition="#italic">Gaceta Oficial</hi> of
                    June 21.</p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">L. Lanier Winslow</hi></signed></closer>
            </div>
        </body>
    </text>
