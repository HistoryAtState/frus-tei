            <div xml:id="d597">

                <pb facs="0626" n="518" sameAs="frus:frus1927v02/pg518"/>

                <note rend="inline" type="source">611.3731/250</note>
                <head><hi rendition="#italic">The Secretary of State to the Cuban Chargé</hi> (<hi
                        rendition="#italic">Altunaga</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1928-01-12"><hi rendition="#italic">January 12,
                        1928</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I beg to refer to the note which the
                    Ambassador handed to me on December 15, 1927, containing certain proposals for
                    the modification of the commercial agreement of 1902 between Cuba and the United
                    States. This matter is receiving careful consideration, and I shall communicate
                    to you the views of this Government as soon as the necessary study of your
                    Government’s proposals shall have been completed.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Frank B. Kellogg</hi></signed></closer>
            </div>
        </body>
    </text>
