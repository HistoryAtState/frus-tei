                <pb facs="0648" n="540" sameAs="frus:frus1927v02/pg540"/>

                <note rend="inline" type="source">711.60 f 2/21: Telegram</note>
                <head><hi rendition="#italic">The Minister in Czechoslovakia</hi> (<hi
                        rendition="#italic">Einstein</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Prague</hi></placeName>, <date calendar="gregorian"
                            when="1927-04-18T13:00:00+01:00"><hi rendition="#italic">April 18,
                                1927—1 p.m.</hi></date><lb/>[Received April 18—8:40
                    a.m.]</dateline></opener>
                <p>15. Your number 9, April 2 [<hi rendition="#italic">1</hi>], 6 p.m. Note from the
                    Foreign Office states that Ministry of Foreign Affairs will be glad to negotiate
                    a treaty of amity, commerce and consular rights, and to learn our point of view
                    regarding this.</p>
                <closer><signed><hi rendition="#small-caps">Einstein</hi></signed></closer>
            </div>
        </body>
