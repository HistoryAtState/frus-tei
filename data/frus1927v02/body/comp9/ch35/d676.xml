                <pb facs="0729" n="621" sameAs="frus:frus1927v02/pg621"/>

                <note rend="inline" type="source">711.5112 France/35</note>
                <head><hi rendition="#italic">President Coolidge to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Rapid City, S. Dak.</hi></placeName>, <date calendar="gregorian"
                            when="1927-06-29"><hi rendition="#italic">June 29,
                        1927</hi></date>.<lb/>[Received July 5.]</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: Thank you for your letter
                    of the 27th, which I have read with care. I approve of the conclusions you have
                    reached.</p>
                <p>Very truly yours,</p>
                <closer><signed><hi rendition="#small-caps">Calvin Coolidge</hi></signed></closer>
            </div>
        </body>
