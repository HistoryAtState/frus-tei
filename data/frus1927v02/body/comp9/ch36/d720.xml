            <div xml:id="d720">

                <pb facs="0810" n="702" sameAs="frus:frus1927v02/pg702"/>

                <note rend="inline" type="source">611.5131/692</note>
                <head><hi rendition="#italic">The Chargé in France</hi> (<hi rendition="#italic"
                        >Whitehouse</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1927-11-18"><hi rendition="#italic">November 18,
                        1927</hi></date>.<lb/>[Received November 28.]</dateline>
                    <seg rendition="#float-left">No. 8038</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my telegram No. 434 of
                    November 16th,<anchor n="6" xml:id="d720-f1"/> transmitting a translation of the
                    text of the note received that day from the Foreign Office, concerning the new
                    French tariff decree affecting American products, I have the honor to forward a
                    copy of the original note.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Sheldon
                    Whitehouse</hi></signed></closer>


                <xi:include href="d720-a1.xml" xpointer="d720-a1"/>
            </div>
        </body>
    </text>
