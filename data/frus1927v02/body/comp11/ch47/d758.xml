    <text>
        <body>
            <div xml:id="d758">

                <pb facs="0912" n="804" sameAs="frus:frus1927v02/pg804"/>

                <note rend="inline" type="source">890g.01/194</note>
                <head><hi rendition="#italic">The Chargé in Great Britain</hi> (<hi
                        rendition="#italic">Atherton</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1927-11-08"><hi rendition="#italic">November 8,
                        1927</hi></date>.<lb/>[Received November 17.]</dateline>
                    <seg rendition="#float-left">No. 2256</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to refer to the Embassy’s
                    telegram No. 191 of August 28 [<hi rendition="#italic">26</hi>], 3 p.m.,
                        1927,<anchor n="68" xml:id="d758-f1"/> relating to the proposed Iraq
                    Convention between the United States and Great Britain, and in this connection
                    to forward a copy, in triplicate, of a Foreign Office note, dated November 7,
                    1927, with regard to certain modifications in the draft convention as enclosed
                    therewith.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Ray Atherton</hi></signed></closer>



                <xi:include href="d758-a1.xml" xpointer="d758-a1"/>
            </div>
        </body>
    </text>
