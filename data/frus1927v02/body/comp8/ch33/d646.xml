    <text>
        <body>
            <div xml:id="d646">

                <pb facs="0699" n="591" sameAs="frus:frus1927v02/pg591"/>

                <note rend="inline" type="source">125.0084/40</note>
                <head><hi rendition="#italic">The Vice Consul at Aden</hi> (<hi rendition="#italic">Park</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Aden</hi></placeName>, <date calendar="gregorian" when="1927-05-11"
                                ><hi rendition="#italic">May 11, 1927</hi></date>.<lb/>[Received
                        June 4.]</dateline>
                    <seg rendition="#float-left">No. 220</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith two
                    sealed envelopes addressed by His Imperial Highness, Ras Tafari Makonnen, Regent
                    of the Empire and Heir to the Throne of Ethiopia, to President Coolidge, with
                    regard to the question of the proposed establishment of an American Legation at
                    Addis Ababa. Copies of the French version of these letters were received from
                    the Prince Regent, and it seemed advisable, for the possible convenience of the
                    Department, to append hereto copies of the French and translations of the same
                    into English.<anchor n="8" xml:id="d646-f1"/></p>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">J. Loder Park</hi></signed></closer>



                <xi:include href="d646-a1.xml" xpointer="d646-a1"/>
            </div>
        </body>
    </text>
    <standOff>
