                <pb facs="0435" n="327" sameAs="frus:frus1927v02/pg327"/>

                <note rend="inline" type="source">893.113/1041</note>
                <head><hi rendition="#italic">The Secretary of State to the Minister in China</hi>
                        (<hi rendition="#italic">MacMurray</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1927-06-21"><hi rendition="#italic">June 21,
                        1927</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 559</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The Department has received your despatch
                    No. 983 of April 6, 1927, with regard to a monopoly for the sale of sulphur,
                    saltpetre and other chemicals which has been established by the Chinese
                    authorities at Canton.</p>
                <p>The Department is of the opinion that no further action need be taken in this
                    matter for the present.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State:<lb/><signed><hi rendition="#small-caps">Joseph
                            C. Grew</hi></signed></closer>
            </div>
        </body>
