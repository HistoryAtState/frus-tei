            <div xml:id="d301">

                <pb facs="0389" n="281" xml:id="pg281"/>

                <note rend="inline" type="source">893.00/8585: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">MacMurray</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1927-04-06T03:00:00+08:00"><hi rendition="#italic">April 6, 1927—3
                                a.m.</hi></date><lb/>[Received April 5—3:45
                    p.m.]</dateline></opener>
                <p>354. Following from Patrol commander: <quote rend="blockquote">
                        <p>“0304. <hi rendition="#italic">Polos</hi> evacuating Changsha as soon as
                            possible. Labor agitation developing over night makes this imperative.
                            Consul estimates will be ready leave April 7. 1329.”</p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps">MacMurray</hi></signed></closer>
            </div>
        </body>
