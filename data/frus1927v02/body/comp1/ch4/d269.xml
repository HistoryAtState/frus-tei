                <pb facs="0376" n="268" sameAs="frus:frus1927v02/pg268"/>

                <note rend="inline" type="source">393.11/499: Telegram</note>
                <head><hi rendition="#italic">The Consul at Mukden</hi> (<hi
                            rendition="#italic">Sokobin</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mukden</hi></placeName>, <date calendar="gregorian"
                            when="1927-03-28T09:00:00+08:00"><hi rendition="#italic">March 28,
                                1927—9 a.m.</hi></date><lb/>[Received March 28—6:08
                    a.m.]</dateline></opener>
                <p>I venture to suggest full publicity be given to the fact that Americans in
                    Manchuria are in nowise affected by the events in the Yangtze Valley; situation
                    here absolutely normal.</p>
                <closer><signed><hi rendition="#small-caps">Sokobin</hi></signed></closer>
            </div>
        </body>
