            <div xml:id="d262">

                <pb facs="0374" n="266" sameAs="frus:frus1927v02/pg266"/>

                <note rend="inline" type="source">393.11/496: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Consul General at
                        Shanghai</hi> (<hi rendition="#italic">Gauss</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1927-03-26T14:00:00-05:00"><hi rendition="#italic">March 26,
                                1927—2 p.m.</hi></date></dateline></opener>
                <p>Your March 25, 10 p.m. You are authorized to draw upon the Department of State up
                    to $10,000. This sum appropriated by the American Red Cross for use as described
                    in your telegram.</p>
                <closer><signed><hi rendition="#small-caps">Kellogg</hi></signed></closer>
            </div>
        </body>
    </text>
