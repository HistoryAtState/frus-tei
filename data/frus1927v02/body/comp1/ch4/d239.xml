            <div xml:id="d239">

                <pb facs="0361" n="253" xml:id="pg253"/>

                <note rend="inline" type="source">393.11/425; Telegram</note>
                <head><hi rendition="#italic">The Chargé in China</hi> (<hi
                            rendition="#italic">Mayer</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1927-01-26T11:00:00+08:00"><hi rendition="#italic">January 26,
                                1927—11 a.m.</hi></date><lb/>[Received January 27—10:30
                        a.m.]</dateline></opener>
                <p>83. Following from Canton: <quote rend="blockquote">
                        <p>“I am discreetly advising Americans in the interior to leave for places
                            of safety. This includes Canton and environs.”</p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps">Mayer</hi></signed></closer>
            </div>
        </body>
    </text>
