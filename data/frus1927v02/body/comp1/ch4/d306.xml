            <div xml:id="d306">

                <pb facs="0390" n="282" sameAs="frus:frus1927v02/pg282"/>

                <note rend="inline" type="source">393.11/555: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">MacMurray</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1927-04-07T09:00:00+08:00"><hi rendition="#italic">April 7, 1927—9
                                a.m.</hi></date><lb/>[Received April 7—3:22
                    a.m.]</dateline></opener>
                <p>367. Following from American consul at Chungking: <quote rend="blockquote">
                        <p>“April 4, 11 a.m. We sailed from Chungking this morning on friendly terms
                            with Chinese authorities.”</p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps">MacMurray</hi></signed></closer>
            </div>
        </body>
