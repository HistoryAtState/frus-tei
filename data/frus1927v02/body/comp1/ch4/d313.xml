    <text>
        <body>
            <div xml:id="d313">

                <pb facs="0393" n="285" sameAs="frus:frus1927v02/pg285"/>

                <note rend="inline" type="source">125.494/5: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >MacMurray</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1927-04-08T17:00:00+08:00"><hi rendition="#italic">April 8, 1927—5
                                p.m.</hi></date><lb/>[Received April 8—4:27
                    p.m.]</dateline></opener>
                <p>385. My 260, March 26, 4 p.m.<anchor n="19" xml:id="d313-f1"/> Americans in
                    Kalgan have been instructed to withdraw. I respectfully repeat recommendation
                    that consulate there be closed, as soon as Americans evacuated.<anchor n="20"
                        xml:id="d313-f2"/></p>
                <closer><signed><hi rendition="#small-caps">MacMurray</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d313-f1" n="19" xml:id="d313-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d313-f2" n="20" xml:id="d313-f2-content">
                <p>The consulate at Kalgan was temporarily closed April 23. It was permanently
                    closed September 30 and the consular district incorporated into the Tientsin
                    consular district.</p>
            </note>
        </listAnnotation>
    </standOff>
