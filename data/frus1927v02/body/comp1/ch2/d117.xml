    <text>
        <body>
            <div xml:id="d117">

                <pb facs="0246" n="138" xml:id="pg138"/>

                <note rend="inline" type="source">893.00/9141½</note>
                <head><hi rendition="#italic">President Coolidge to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Rapid City, S. Dak.</hi></placeName>, <date calendar="gregorian"
                            when="1927-06-23"><hi rendition="#italic">June 23,
                        1927</hi></date>.<lb/>[Received June 27.]</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I have your letter,
                    together with the substance of the recent dispatch from Minister MacMurray. I
                    approve the suggestions made by the Minister and referred to in your own letter,
                    subject of course to your judgment on them.</p>
                <p>Very truly yours,</p>
                <closer><signed><hi rendition="#small-caps">Calvin Coolidge</hi></signed></closer>
            </div>
        </body>
    </text>
