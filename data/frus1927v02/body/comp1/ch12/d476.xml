                <pb facs="0525" n="417" sameAs="frus:frus1927v02/pg417"/>

                <note rend="inline" type="source">893.512/680: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Chargé in China</hi>
                        (<hi rendition="#italic">Mayer</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1927-10-01T16:00:00-05:00"><hi rendition="#italic">October 1,
                                1927—4 p.m.</hi></date></dateline></opener>
                <p>354. Your 896, September 29, 11 a.m. You are authorized to interpose no objection
                    to the proposed surtax provided other interested Legations take similar
                    stand.</p>
                <closer><signed><hi rendition="#small-caps">Kellogg</hi></signed></closer>
            </div>
        </body>
    </text>
