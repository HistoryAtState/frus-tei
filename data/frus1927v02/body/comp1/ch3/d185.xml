    <text>
        <body>
            <div xml:id="d185">

                <pb facs="0316" n="208" xml:id="pg208"/>

                <note rend="inline" type="source">893.00 Nanking/106: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">MacMurray</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1927-04-22T18:00:00+08:00"><hi rendition="#italic">April 22,
                                1927—6 p.m.</hi></date><lb/>[Received April 22—11:10
                        a.m.]</dateline></opener>
                <p>474. The Ministers of the four other interested powers agreed at meeting this
                    morning to recommend to their respective Foreign Offices that their Governments
                    act on the basis of the recommendations which were stated in my telegram No. 440
                    of April 15, 7 p.m.</p>
                <closer><signed><hi rendition="#small-caps">MacMurray</hi></signed></closer>
            </div>
        </body>
