                <pb facs="0296" n="188" sameAs="frus:frus1927v02/pg188"/>

                <note rend="inline" type="source">893.00 Nanking/62: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >MacMurray</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1927-04-11T14:00:00+08:00"><hi rendition="#italic">April 11,
                                1927—2 p.m.</hi></date><lb/>[Received April 11—3:45
                    a.m.]</dateline></opener>
                <p>405. Following from American consul, Shanghai: <quote rend="blockquote">
                        <p>“5. April 9, 8 p.m. Chiang Kai-shek left for Nanking this morning.”</p>
                    </quote></p>
                <closer><signed><hi rendition="#small-caps">MacMurray</hi></signed></closer>
            </div>
        </body>
