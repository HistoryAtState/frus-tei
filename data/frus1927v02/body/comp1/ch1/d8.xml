    <text>
        <body>
            <div xml:id="d8">

                <pb facs="0119" n="11" sameAs="frus:frus1927v02/pg11"/>

                <note rend="inline" type="source">893.00/9291</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >MacMurray</hi>) <hi rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1927-06-22"><hi rendition="#italic">June 22,
                        1927</hi></date>.<lb/>[Received August 8.]</dateline>
                    <seg rendition="#float-left">No. 1099</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Adverting to the Department’s instruction
                    No. 78, of October 9th, 1925,<anchor n="18" xml:id="d8-f1"/> I have the honor to
                    transmit herewith enclosed a summary of events and conditions in China during
                    the month of May, 1927.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">J. V. A.
                    MacMurray</hi></signed></closer>


                <xi:include href="d8-a1.xml" xpointer="d8-a1"/>
            </div>
        </body>
    </text>
