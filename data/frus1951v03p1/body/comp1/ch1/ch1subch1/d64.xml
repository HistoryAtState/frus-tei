            </note>
            <note corresp="#d64-f4" n="4" xml:id="d64-f4-content">
                <p>Not printed; for text of the agreement dated April 3, concerning industrial
                    controls, see <ref target="frus1951v03p2#pg_1395">p. 1395</ref>.</p>
            </note>
        </listAnnotation>
