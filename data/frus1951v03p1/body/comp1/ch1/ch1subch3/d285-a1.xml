                <head>
                    <hi rendition="#italic">Draft Proposal Prepared by the United Kingdom Chiefs of
                        Staff Committee</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >London</hi>
                        </placeName>? <date calendar="gregorian" when="1951-06-08">June 8,
                            1951</date>.]</dateline>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Command Arrangements in the Mediterranean:
                        Alternative Solution</hi>
                </p>
                <figure>
                    <graphic url="figure_0571"/>
                </figure>
                <p>
                    <hi rendition="#italic">Note:</hi>
                    SACME (Brit) Command would be a fully
                    integrated command linked to N.A.T.O.<lb/>Greece and Turkey would be associated
                    with this Command.</p>
