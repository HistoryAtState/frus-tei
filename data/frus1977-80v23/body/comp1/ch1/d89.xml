                <pb facs="0248" n="201" sameAs="frus:frus1977-80v23/pg201"/>

                <head>89. Summary of Conclusions of a Mini-Special Coordination Committee
                        Meeting<anchor n="1" xml:id="d89-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>Washington</placeName>, <date calendar="gregorian"
                            from="1980-04-09T08:35:00-05:00" to="1980-04-09T10:00:00-05:00">April 9,
                            1980, 8:35–10:00 a.m.</date>
                    </dateline>
                </opener>
                <list subtype="subject" type="description">
                    <label>SUBJECT</label>
                    <item>Cuban Refugees in the Peruvian Embassy (S)</item>
                </list>
