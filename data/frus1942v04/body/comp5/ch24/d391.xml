    <text>
        <body>
            <div xml:id="d391">

                <pb facs="0347" n="335" sameAs="frus:frus1942v04/pg335"/>

                <note rend="inline" type="source">701.9491/23: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Iran</hi> (<hi rendition="#italic"
                        >Dreyfus</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tehran</hi></placeName>, <date
                            calendar="gregorian" when="1942-04-23T16:00:00+03:25">April 23, 1942—4
                            p.m.</date>
                        <lb/> [Received 9:21 p.m.]</dateline>
                </opener>
                <p>120. Referring to my 104,<anchor n="4" xml:id="d391-f1"/> the Japanese Legation
                    left Tehran this morning en route to Japan via Russia.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Dreyfus</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
