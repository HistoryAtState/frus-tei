    <text>
        <body>
            <div xml:id="d374">

                <pb facs="0337" n="325" sameAs="frus:frus1942v04/pg325"/>

                <note rend="inline" type="source">701.9491/16: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Iran</hi> (<hi
                        rendition="#italic">Dreyfus</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-01-19T21:00:00-05:00">January 19, 1942—9
                            p.m.</date>
                    </dateline>
                </opener>
                <p>13. Your no. 8, January 13, 4 p.m. You may inquire informally of the Prime
                        Minister<anchor n="80" xml:id="d374-f1"/> as to the intentions of the
                    Iranian Government regarding the maintenance or severance of diplomatic
                    relations with Japan.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d374-f1" n="80" xml:id="d374-f1-content">
                <p>Mohammed Ali Foroughi.</p>
            </note>
        </listAnnotation>
    </standOff>
