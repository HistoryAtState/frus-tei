    <text>
        <body>
            <div xml:id="d139">

                <pb facs="0133" n="121" sameAs="frus:frus1942v04/pg121"/>

                <note rend="inline" type="source">891.48/303</note>
                <head>
                    <hi rendition="#italic">The Chief of the Division of Near Eastern Affairs</hi>
                        (<hi rendition="#italic">Murray</hi>) <hi
                        rendition="#italic">to the Chief of the Iranian Trade and Economic
                        Commission</hi> (<hi rendition="#italic"
                        >Saleh</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-03-07">March 7, 1942</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Saleh</hi>: Reference is made to your
                    letter of February 24, 1942 regarding the possibility of assistance by this
                    Government in furnishing wheat for Iran. As you are aware as a result of
                    subsequent conversations with you regarding this matter, the question which you
                    have raised is being given careful consideration.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wallace Murray</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
