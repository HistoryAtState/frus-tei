                <pb facs="0163" n="151" sameAs="frus:frus1942v04/pg151"/>

                <note rend="inline" type="source">891.24/222a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in the United Kingdom</hi> (<hi
                            rendition="#italic">Winant</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-07-29T19:00:00-04:00">July 29, 1942—7
                            p.m.</date>
                    </dateline>
                </opener>
                <p>3533. Department’s 3475, July 25. Tehran reports UKCC has advised Iranian Finance
                    Ministry that 3,000 requisitioned tires will be delivered immediately to Iranian
                    Government. Consequently, you may disregard last paragraph of telegram under
                    reference.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
