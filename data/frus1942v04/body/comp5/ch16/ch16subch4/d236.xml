            <div xml:id="d236">

                <pb facs="0232" n="220" sameAs="frus:frus1942v04/pg220"/>

                <note rend="inline" type="source">891.00/1969: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi rendition="#italic">Winant</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1942-12-15T20:00:00+01:00">December 15,
                            1942—8 p.m.</date>
                        <lb/> [Received December 15—6:09 p.m.]</dateline>
                </opener>
                <p>7114. Foreign Office has been given substance of Department’s 6280, December 11,
                    9 p.m., concerning Iran. Foreign Office states that it will give immediate
                    attention to the points raised by the Department and let the Embassy have its
                    comments on them as soon as possible.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Winant</hi>
                    </signed>
                </closer>
            </div>
        </body>
