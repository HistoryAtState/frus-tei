                <pb facs="0252" n="240" sameAs="frus:frus1942v04/pg240"/>

                <note rend="inline" type="source">891.00/1881: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in the United
                        Kingdom</hi> (<hi rendition="#italic">Winant</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-06-13T17:00:00-04:00">June 13, 1942—5
                            p.m.</date>
                    </dateline>
                </opener>
                <p>2728. Your 3037, June 1 and Department’s 2417, May 22 [<hi rendition="#italic"
                        >27</hi>]. War Department prefers not to undertake organization of a mission
                    to Iran at this time but indicates it may be willing to reconsider proposal
                    later.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
