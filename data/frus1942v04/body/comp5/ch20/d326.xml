            <div xml:id="d326">

                <pb facs="0301" n="289" sameAs="frus:frus1942v04/pg289"/>

                <note rend="inline" type="source">891.20/133</note>
                <head>
                    <hi rendition="#italic">President Roosevelt to the Lend-Lease Administrator</hi>
                        (<hi rendition="#italic">Stettinius</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-03-10">March 10, 1942</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Stettinius</hi>: For purposes of
                    implementing the authority conferred upon you as Lend-Lease Administrator by
                    Executive Order No. 8926, dated October 28, 1941, and in order to enable you to
                    arrange for Lend-Lease aid to the Government of Iran, I hereby find that the
                    defense of the Government of Iran is vital to the defense of the United
                    States.</p>
                <p>Very truly yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Franklin</hi> D. <hi rendition="#small-caps"
                            >Roosevelt</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
