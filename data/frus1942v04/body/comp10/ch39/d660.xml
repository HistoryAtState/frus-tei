    <text>
        <body>
            <div xml:id="d660">

                <pb facs="0561" n="549" xml:id="pg549"/>

                <note rend="inline" type="source">867N.01/1835</note>
                <head>
                    <hi rendition="#italic">The Chairman of the American Palestine Committee</hi>
                        (<hi rendition="#italic">Wagner</hi>
                    <anchor n="21" xml:id="d660-f1"/>) <hi rendition="#italic">to President
                        Roosevelt </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">New York</hi></placeName>, <date
                            calendar="gregorian" when="1942-12-04">December 4,
                        1942</date>.<lb/>[Received December 7.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. President</hi>: I am privileged to transmit
                    herewith a statement commemorating the 25th Anniversary of the Balfour
                    Declaration, signed by sixty-three members of the Senate and one hundred
                    eighty-two members of the House of Representatives.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert</hi> F. <hi rendition="#small-caps"
                            >Wagner</hi>
                    </signed>
                </closer>


                <xi:include href="d660-a1.xml" xpointer="d660-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d660-f1" n="21" type="source" xml:id="d660-f1-content">
                <p>Robert F. Wagner, Senator from New York.</p>
            </note>
