            <div xml:id="d782">

                <pb facs="0678" n="666" sameAs="frus:frus1942v04/pg666"/>

                <note rend="inline" type="source">123 W 111/419: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul at Beirut</hi> (<hi
                            rendition="#italic">Gwynn</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Beirut</hi></placeName>, <date
                            calendar="gregorian" when="1942-11-16T17:00:00+02:00">November 16,
                            1942—5 p.m.</date>
                        <lb/> [Received November 17—12:16 p.m.]</dateline>
                </opener>
                <p>455. Wadsworth arrived, am relinquishing charge as of close of business
                    today.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gwynn</hi>
                    </signed>
                </closer>
            </div>
        </body>
