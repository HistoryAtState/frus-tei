    <text>
        <body>
            <div xml:id="d582">

                <pb facs="0480" n="468" xml:id="pg468"/>

                <note rend="inline" type="source">740.00112 European War 1939/5814½</note>
                <head>
                    <hi rendition="#italic">The First Secretary of the British Embassy</hi> (<hi
                        rendition="#italic">Wyndham White</hi>) <hi rendition="#italic">to the Chief
                        of the Division of Near Eastern Affairs</hi> (<hi rendition="#italic"
                        >Alling</hi>)</head>
                <opener>
                    <seg rendition="#float-left">(W. T. 109/43/42)</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-06-19">June 19, 1942</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Alling</hi>: In view of our conversation
                    yesterday evening<anchor n="38" xml:id="d582-f1"/> about the proposed economic
                    negotiation with General Orgaz, you will be interested in the attached
                    paraphrases of two telegrams we have had on this subject, one from the Foreign
                    Office and one from the British Embassy in Madrid.<anchor n="39"
                        xml:id="d582-f2"/>
                </p>
                <p>Yours sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Eric Wyndham White</hi>
                    </signed>
                </closer>


                <xi:include href="d582-a1.xml" xpointer="d582-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d582-f1" n="38" xml:id="d582-f1-content">
                <p>No record of conversation found in Department files.</p>
            </note>
            <note corresp="#d582-f2" n="39" xml:id="d582-f2-content">
                <p>Telegram from the British Embassy in Madrid not attached to file copy.</p>
            </note>
        </listAnnotation>
