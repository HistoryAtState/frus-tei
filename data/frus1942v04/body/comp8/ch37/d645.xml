            <div xml:id="d645">

                <pb facs="0541" n="529" xml:id="pg529"/>

                <note rend="inline" type="source">740.0011 European War 1939/26831: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé at Tangier</hi> (<hi rendition="#italic"
                            >Childs</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1943-01-02T20:00:00-04:00">January 2, 1943—8
                            p.m.</date>
                    </dateline>
                </opener>
                <p>2. Your 926, December 30, 8 p.m. The Department approves your acceptance of
                    Orgaz’ invitation.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
