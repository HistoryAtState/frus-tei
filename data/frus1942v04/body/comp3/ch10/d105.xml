    <text>
        <body>
            <div xml:id="d105">

                <pb facs="0105" n="93" xml:id="pg93"/>

                <note rend="inline" type="source">811.203/172: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Egypt</hi> (<hi rendition="#italic"
                            >Kirk</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-12-05T15:00:00-04:00">December 5, 1942—3
                            p.m.</date>
                    </dateline>
                </opener>
                <p>1565. Department’s no. 1200, October 6, 10 p.m. Please report what progress has
                    been made in negotiating an informal agreement with the Egyptian authorities
                    according to American military authorities exclusive jurisdiction in criminal
                    matters over military personnel.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
