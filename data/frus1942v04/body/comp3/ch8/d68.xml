            <note corresp="#d68-f2" n="6" xml:id="d68-f2-content">
                <p>Egyptian Prime Minister, 1938–39.</p>
            </note>
            <note corresp="#d68-f3" n="7" xml:id="d68-f3-content">
                <p>Gen. Brwin Rommel, in command of Italo-German forces in Libya.</p>
            </note>
