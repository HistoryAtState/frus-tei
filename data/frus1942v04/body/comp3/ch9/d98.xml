    <text>
        <body>
            <div xml:id="d98">

                <pb facs="0099" n="87" sameAs="frus:frus1942v04/pg87"/>

                <note rend="inline" type="source">740.0011European War 1939/25048: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Egypt</hi> (<hi
                            rendition="#italic">Kirk</hi>) <hi rendition="#italic">to the
                            Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Cairo</hi></placeName>, <date
                            calendar="gregorian" when="1942-10-24T10:00:00+03:00">October 24,
                            1942—10 a.m.</date>
                        <lb/> [Received October 24—7:19 a.m.]</dateline>
                </opener>
                <p>1870. My 1819, October 14, 5 p.m.<anchor n="29" xml:id="d98-f1"/> The British
                    started an offensive in Western Desert last night. No announcement has as yet
                    been made.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Kirk</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
