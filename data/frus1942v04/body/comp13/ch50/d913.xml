    <text>
        <body>
            <div xml:id="d913">

                <pb facs="0816" n="804" sameAs="frus:frus1942v04/pg804"/>

                <note rend="inline" type="source">811.248/824: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Egypt</hi> (<hi rendition="#italic"
                        >Kirk</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Cairo</hi></placeName>, <date
                            calendar="gregorian" when="1942-12-30T09:00:00+02:00">December 30,
                            1942—9 a.m.</date>
                        <lb/> [Received December 31—11 p.m.]</dateline>
                </opener>
                <p>2276. My 2225, December 20, 5 p.m.<anchor n="1" xml:id="d913-f1"/> Following
                    telegram has been sent to Ankara.</p>
                <quote rend="blockquote">
                    <p>“December 29, 9 a.m. Legation’s December 24, noon.</p>
                    <p>Army now advises that 30 days required repair plane and requests you inform
                        Washington whether you consider time element still sufficiently important
                        warrant sending another B–24 to Turkey in substitution.</p>
                    <p>Please repeat here for Army’s information any recommendation you make to
                        Washington.”</p>
                </quote>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Kirk</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
