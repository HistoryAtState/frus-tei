            <div xml:id="d904">

                <pb facs="0811" n="799" sameAs="frus:frus1942v04/pg799"/>

                <note rend="inline" type="source">811.248/603: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Turkey</hi> (<hi rendition="#italic"
                            >Steinhardt</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-07-08T20:00:00-04:00">July 8, 1942—8
                            p.m.</date>
                    </dateline>
                </opener>
                <p>325. Your 663, June 25, 2 p.m. Would appreciate information regarding present
                    status of your negotiations regarding bombers.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
