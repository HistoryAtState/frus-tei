    <text>
        <body>
            <div xml:id="d837">

                <pb facs="0741" n="729" sameAs="frus:frus1942v04/pg729"/>

                <note rend="inline" type="source">867.24/359: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Turkey</hi> (<hi rendition="#italic"
                            >Steinhardt</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-07-18T20:00:00-04:00">July 18, 1942—8
                            p.m.</date>
                    </dateline>
                </opener>
                <p>347. Your 751, July 17, noon, and 752, July 17, 3 p.m. Department is giving
                    immediate attention to Turkish Premier’s request in cooperation with interested
                    American and British agencies, with <pb facs="0742" n="730" xml:id="pg730"/>
                    particular regard to recourse to MESC.<anchor n="60" xml:id="d837-f1"/> We
                    assume Turkish Ambassador has been or is being instructed in the matter.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d837-f1" n="60" xml:id="d837-f1-content">
                <p>Middle East Supply Center.</p>
            </note>
        </listAnnotation>
    </standOff>
