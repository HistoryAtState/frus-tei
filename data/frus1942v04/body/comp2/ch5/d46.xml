    <text>
        <body>
            <div xml:id="d46">

                <pb facs="0062" n="50" sameAs="frus:frus1942v04/pg50"/>

                <note rend="inline" type="source">124.90H/78: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Afghanistan</hi> (<hi rendition="#italic"
                        >Thayer</hi>)<anchor n="7" xml:id="d46-f1"/>
                    <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Kabul</hi></placeName>, <date
                            calendar="gregorian" when="1942-06-06T18:00:00+04:00">June 6, 1942—6
                            p.m.</date>
                        <lb/> [Received June 30—9:49 a.m.<anchor n="8" xml:id="d46-f2"/>]</dateline>
                </opener>
                <p>7. The Legation at Kabul has been opened today. Repeated to Calcutta, Karachi,
                    Tehran, Ankara and Kuibyshev.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Thayer</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d46-f1" n="7" type="source" xml:id="d46-f1-content">
                <p>Thayer had arrived at Kabul on May 31.</p>
            </note>
            <note corresp="#d46-f2" n="8" xml:id="d46-f2-content">
                <p>Reason for this delayed receipt not apparent from available documents.</p>
            </note>
        </listAnnotation>
    </standOff>
