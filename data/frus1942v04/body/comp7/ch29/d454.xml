            <div xml:id="d454">

                <pb facs="0389" n="377" sameAs="frus:frus1942v04/pg377"/>

                <note rend="inline" type="source">882.7962/79: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Liberia</hi> (<hi rendition="#italic"
                        >Wharton</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Monrovia</hi></placeName>, <date
                            calendar="gregorian" when="1942-04-20T13:00:00-00:44">April 20, 1942—1
                            p.m.</date>
                        <lb/> [Received April 20—12:39 p.m.]</dateline>
                </opener>
                <p>132. Referring to my 120, April 7, 2 p.m. Fisherman Lake agreement signed
                    today.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wharton</hi>
                    </signed>
                </closer>
            </div>
        </body>
