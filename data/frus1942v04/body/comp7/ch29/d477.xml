            <div xml:id="d477">

                <pb facs="0406" n="394" sameAs="frus:frus1942v04/pg394"/>

                <note rend="inline" type="source">740.0011 European War 1939/24511: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Chargé in Liberia</hi>
                        (<hi rendition="#italic">Hibbard</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-10-01T22:00:00-04:00">October 1, 1942—10
                            p.m.</date>
                    </dateline>
                </opener>
                <p>242. Your 308, September 25, 5 p.m. For McBride. Department approves of exchange
                    of notes with wording proposed by you. It is believed, however, that the word
                    “and” should be substituted for “in” immediately after the phrase “military use
                    of airports”.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
