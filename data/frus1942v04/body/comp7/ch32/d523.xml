                <pb facs="0433" n="421" sameAs="frus:frus1942v04/pg421"/>

                <note rend="inline" type="source">882.20/570: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in Liberia</hi> (<hi rendition="#italic"
                            >Wharton</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1942-05-29T21:00:00-04:00">May 29, 1942—9
                            p.m.</date>
                    </dateline>
                </opener>
                <p>129. Your 168, May 26, 11 a.m. For certain important reasons it would be
                    desirable to have all Germans, including Von Waldheim, leave Liberia within the
                    next 10 days if possible. Please endeavor to persuade President Barclay to carry
                    out this suggestion.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
