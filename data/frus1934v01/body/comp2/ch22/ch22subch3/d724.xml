    <text>
        <body>
            <div xml:id="d724">

                <pb facs="1071" n="971" xml:id="pg971"/>

                <note rend="inline" type="source">711.42157SA29/1271½</note>
                <head>
                    <hi rendition="#italic">President Roosevelt to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1934-03-21">March 21, 1934</date>.]</dateline>
                </opener>
                <p>C. H.: Will you talk with Frank Walsh<anchor n="63" xml:id="d724-f1"/> about the
                    next steps on the St. Lawrence Treaty? &amp; then talk with me?</p>
                <closer>
                    <signed>F[<hi rendition="#small-caps">ranklin</hi>] D. R[<hi
                            rendition="#small-caps">oosevelt</hi>]</signed>
                </closer>


                <xi:include href="d724-a1.xml" xpointer="d724-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d724-f1" n="63" xml:id="d724-f1-content">
                <p>Chairman of the New York State Authority.</p>
            </note>
        </listAnnotation>
