            <div xml:id="d730">

                <pb facs="1078" n="978" sameAs="frus:frus1934v01/pg978"/>

                <note rend="inline" type="source">711.42157SA29/1323a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Canada</hi>
                        (<hi rendition="#italic">Robbins</hi>)</head>
                <opener>
                    <seg rendition="#float-left">No. 551</seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1934-11-19">November 19, 1934</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: For your confidential information there is
                    enclosed a copy of that portion of a memorandum of a press conference at the
                    White House on November 9, 1934, which pertains to a discussion of the Great
                    Lakes–St. Lawrence Deep Waterway Treaty.</p>
                <p>Very truly yours,</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">William Phillips</hi>
                    </signed>
                </closer>


                <xi:include href="d730-a1.xml" xpointer="d730-a1"/>
