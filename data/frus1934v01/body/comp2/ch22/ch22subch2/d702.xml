    <text>
        <body>
            <div xml:id="d702">

                <pb facs="1034" n="934" sameAs="frus:frus1934v01/pg934"/>

                <note rend="inline" type="source">711.4215 Air Pollution/500</note>
                <head>
                    <hi rendition="#italic">The Chargé in Canada</hi> (<hi rendition="#italic"
                        >Boal</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 536</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Ottawa</hi></placeName>, <date
                            calendar="gregorian" when="1934-04-19">April 19,
                        1934</date>.<lb/>[Received April 23.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to report that I have
                    today discussed with the Prime Minister the Trail Smelter question and enclose
                    herewith a memorandum of the conversation which I have prepared.</p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Pierre de L. Boal</hi>
                    </signed>
                </closer>


                <xi:include href="d702-a1.xml" xpointer="d702-a1"/>
            </div>
