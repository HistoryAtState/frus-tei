    <text>
        <body>
            <div xml:id="d698">

                <pb facs="1023" n="923" xml:id="pg923"/>

                <note rend="inline" type="source">711.4215 Air Pollution/492</note>
                <head>
                    <hi rendition="#italic">The Minister in Canada</hi> (<hi rendition="#italic"
                        >Robbins</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 517</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Ottawa</hi></placeName>, <date
                            calendar="gregorian" when="1934-04-11">April 11,
                        1934</date>.<lb/>[Received April 13.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to refer to previous
                    correspondence on the subject of the Trail Smelter question and to transmit
                    herewith copy of a note on this subject received this morning from the Secretary
                    of State for External Affairs.</p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Warren D. Robbins</hi>
                    </signed>
                </closer>


                <xi:include href="d698-a1.xml" xpointer="d698-a1"/>
            </div>
        </body>
    </text>
