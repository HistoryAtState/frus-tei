    <text>
        <body>
            <div xml:id="d662">

                <pb facs="0929" n="829" sameAs="frus:frus1934v01/pg829"/>

                <note rend="inline" type="source">890F.6363 Standard Oil Co./38: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Great Britain</hi> (<hi rendition="#italic">Atherton</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1934-02-20T11:00:00+00:00">February 20,
                            1934—11 a.m.</date>
                        <lb/> [Received February 20—7:30 a.m.]</dateline>
                </opener>
                <p>70. Department’s 50, February 19, 6 p.m.<anchor n="19" xml:id="d662-f1"/> Saudi
                    Arabian Minister conveys his Government’s authorization for the use of aeroplane
                    for geological purposes and states that details regulating this flight have been
                    completed by the Saudi Arabian Government and the representatives of the
                    California-Arabian Standard Oil Company there.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Atherton</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
