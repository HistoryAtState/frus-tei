    <text>
        <body>
            <div xml:id="d652">

                <pb facs="0907" n="807" sameAs="frus:frus1934v01/pg807"/>

                <note rend="inline" type="source">341.1154L58/216</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Bingham</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 137</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1933-08-04">August 4,
                        1933</date>.<lb/>[Received August 12.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to refer to my telegram
                    No. 233 of August 3rd, 7 p.m., in relation to the Armes Automatiques Lewis, and
                    to forward a copy of the Foreign Office note, with enclosure, referred to
                    therein.</p>
                <p>Respectfully yours,</p>
                <closer>For the Ambassador: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Ray Atherton</hi>
                    </signed>
                    <lb/>
                    <hi rendition="#italic">Counselor of Embassy</hi>
                </closer>




                <xi:include href="d652-a1.xml" xpointer="d652-a1"/>
                <xi:include href="d652-a2.xml" xpointer="d652-a2"/>
