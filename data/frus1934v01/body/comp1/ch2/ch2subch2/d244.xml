                <pb facs="0395" n="295" sameAs="frus:frus1934v01/pg295"/>

                <note rend="inline" type="source">500.A15A/144: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Bingham</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1934-07-13T17:00:00-04:00">July 13, 1934—5
                            p.m.</date>
                    </dateline>
                </opener>
                <p>299. For Norman Davis. Your 406, July 12, 8 p.m. The course you propose seems to
                    me the wisest one possible given all the circumstances.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
