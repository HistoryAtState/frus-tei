            <div xml:id="d54">

                <pb facs="0158" n="58" sameAs="frus:frus1934v01/pg58"/>

                <note rend="inline" type="source">500.A15A4 General Committee/883: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        American Delegate</hi> (<hi rendition="#italic"
                            >Wilson</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1934-04-25T19:00:00-05:00">April 25, 1934—7
                            p.m.</date>
                    </dateline>
                </opener>
                <p>411. Your 834, April 23, 7 p.m. You may address a communication to Henderson
                    informing him that the proposed change in the dates for the convening of the
                    Bureau and the General Commission are satisfactory to this Government.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
