    <text>
        <body>
            <div xml:id="d15">

                <pb facs="0119" n="19" sameAs="frus:frus1934v01/pg19"/>

                <note rend="inline" type="source">500.A15A4 General Committee/778</note>
                <head>
                    <hi rendition="#italic">The British Ambassador</hi> (<hi rendition="#italic"
                        >Lindsay</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 52</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1934-02-13">13 February,
                        1934</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honour, under instructions from
                    His Majesty’s Principal Secretary of State for Foreign Affairs, to transmit to
                    you herewith, for your information, a copy of the Memorandum on Disarmament
                    issued by His Majesty’s Government in the United Kingdom.<anchor n="55"
                        xml:id="d15-f1"/>
                </p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">R. C. Lindsay</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d15-f1" n="55" xml:id="d15-f1-content">
                <p>For text of British memorandum of January 29, 1934, see Department of State, <hi
                        rendition="#italic">Press Releases</hi>, March 3, 1934, p. 110; also Great
                    Britain, Cmd. 4512, p. 21.</p>
            </note>
        </listAnnotation>
    </standOff>
