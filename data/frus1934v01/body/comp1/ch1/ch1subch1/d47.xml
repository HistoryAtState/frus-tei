            <div xml:id="d47">

                <pb facs="0151" n="51" sameAs="frus:frus1934v01/pg51"/>

                <note rend="inline" type="source">500.A15A4/2490: Telegram</note>
                <head>
                    <hi rendition="#italic">The American Delegate</hi> (<hi
                            rendition="#italic">Wilson</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Geneva</hi></placeName>, <date
                            calendar="gregorian" when="1934-04-19T12:00:00+01:00">April 19,
                            1934—noon</date>.<lb/>[Received April 19—7:28 a.m.]</dateline>
                </opener>
                <p>833. Until we can ascertain the effect most recent French note to Great Britain
                    it might be advisable to postpone decision on my 832 April 15, 8 p.m.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilson</hi>
                    </signed>
                </closer>
            </div>
        </body>
