                <note rend="inline" type="source">500.A15A4 General Committee/974: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Chairman of the
                        American Delegation</hi> (<hi rendition="#italic">Davis</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1934-06-11T13:00:00-04:00">June 11, 1934—1
                            p.m.</date>
                    </dateline>
                </opener>
                <p>432. Your 889, June 9, 2 p.m. Recommendations approved.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Phillips</hi>
                    </signed>
                </closer>
            </div>
