            <div xml:id="d591">

                <pb facs="0836" n="736" sameAs="frus:frus1934v01/pg736"/>

                <note rend="inline" type="source">500.C115/346a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Consul at Geneva</hi> (<hi rendition="#italic"
                            >Gilbert</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1934-07-11T12:00:00-04:00">July 11,
                            1934—noon</date>.</dateline>
                </opener>
                <p>77. Please inquire with the greatest discretion what would be the annual
                    contribution of the United States toward the expenses of the International Labor
                    Organization in the event that the United States should accept the invitation to
                    join. A brief statement of the total <pb facs="0837" n="737" xml:id="pg737"/> is
                    desired by telegram and a full statement by mail showing method of computing
                    this total.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
