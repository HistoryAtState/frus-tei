            <note corresp="#d586-f2" n="2" xml:id="d586-f2-content">
                <p>Eighteenth session of the International Labor Conference, which opened at Geneva,
                    June 4.</p>
            </note>
            <note corresp="#d586-f3" n="3" xml:id="d586-f3-content">
