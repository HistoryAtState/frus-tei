                <pb facs="0608" n="508" sameAs="frus:frus1934v01/pg508"/>

                <note rend="inline" type="source">740.0011 Mutual Guarantee (Eastern Locarno)/42:
                    Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Poland</hi> (<hi
                            rendition="#italic">Cudahy</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Warsaw</hi></placeName>, <date
                            calendar="gregorian" when="1934-09-05T16:00:00+01:00">September 5,
                            1934—4 p.m.</date>
                        <lb/> [Received September 5—2:15 p.m.]</dateline>
                </opener>
                <p>46. Beck expresses opinion Eastern Locarno will fail.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Cudahy</hi>
                    </signed>
                </closer>
            </div>
        </body>
