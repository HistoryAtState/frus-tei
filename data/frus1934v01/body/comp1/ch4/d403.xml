    <text>
        <body>
            <div xml:id="d403">

                <pb facs="0584" n="484" sameAs="frus:frus1934v01/pg484"/>

                <note rend="inline" type="source">500.A14/702: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Persia</hi> (<hi rendition="#italic"
                        >Hornibrook</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Teheran</hi></placeName>, <date
                            calendar="gregorian" when="1934-09-15T12:00:00+03:25">September 15,
                            1934—noon</date>.<lb/>[Received September 15—9:40 a.m.]</dateline>
                </opener>
                <p>31. Commenting upon instruction No. 39<anchor n="59" xml:id="d403-f1"/> Chief of
                    the Third Political Division stated that failure on the part of the American
                    Government to follow lead of the Senate would result in important repercussions
                    in the cordial relations now existing between the two countries. In view of this
                    threat suggest objectionable reservation be not approved.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hornibrook</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d403-f1" n="59" xml:id="d403-f1-content">
                <p>Not printed; it contained a copy of the memorandum by the Secretary of State of a
                    conversation with the Persian Minister, August 9, <ref target="#pg469">p.
                        469</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
