    <text>
        <body>
            <div xml:id="d555">

                <pb facs="0782" n="682" sameAs="frus:frus1934v01/pg682"/>

                <note rend="inline" type="source">195 Code/8</note>
                <head>
                    <hi rendition="#italic">The Assistant Deputy Administrator of the National
                        Recovery Administration</hi> (<hi rendition="#italic">Scott</hi>) <hi
                        rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1933-11-21">November 21,
                        1933</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: Reference is made to
                    your communication, Le 195 Code/7, dated November 18.</p>
                <pb facs="0783" n="683" xml:id="pg683"/>
                <p>The cooperation of the Department of State with our office in the construction of
                    a code for the shipping industry is appreciated, and I assure you that we shall
                    continue to inform you of all developments.</p>
                <p>Very truly yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Joseph Scott</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
