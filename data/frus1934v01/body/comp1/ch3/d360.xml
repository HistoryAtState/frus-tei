    <text>
        <body>
            <div xml:id="d360">

                <pb facs="0545" n="445" xml:id="pg445"/>

                <note rend="inline" type="source">811.113 Senate Investigation/69: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Johnson</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Peiping</hi></placeName>, <date
                            calendar="gregorian" when="1934-09-25T15:00:00+08:00">September 25,
                            1934—3 p.m.</date>
                        <lb/> [Received September 25—11:25 a.m.]</dateline>
                </opener>
                <p>429. The following telegram has been received from Gauss<anchor n="38"
                        xml:id="d360-f1"/> at Nanking.</p>
                <quote rend="blockquote">
                    <p>“September 24, noon. The Political Vice Minister for Foreign Affairs<anchor
                            n="39" xml:id="d360-f2"/> sent for me this morning to say that General
                        Chiang Kai Shek has urged the Foreign Office to press its request already
                        made through the Chinese Minister at Washington<anchor n="40"
                            xml:id="d360-f3"/> for disclosure to Chinese Government of names of
                        Chinese officials and Military officers who received commissions in arms
                        transactions.”</p>
                </quote>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Johnson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d360-f1" n="38" xml:id="d360-f1-content">
                <p>Clarence E. Gauss, Counselor of Legation in China.</p>
            </note>
            <note corresp="#d360-f2" n="39" xml:id="d360-f2-content">
                <p>Hsu Mo.</p>
            </note>
            <note corresp="#d360-f3" n="40" xml:id="d360-f3-content">
                <p>See memorandum by the Secretary of State, September 18, <ref target="#pg438">p.
                        438</ref>.</p>
            </note>
