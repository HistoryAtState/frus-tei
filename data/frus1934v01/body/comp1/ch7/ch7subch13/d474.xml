    <text>
        <body>
            <div xml:id="d474">

                <pb facs="0693" n="593" sameAs="frus:frus1934v01/pg593"/>

                <note rend="inline" type="source">800.51W89 Yugoslavia/161</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Yugoslav Chargé</hi> (<hi rendition="#italic"
                            >Stoianovitch</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1934-05-28">May 28, 1934</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I am requested by the Secretary of the
                    Treasury to transmit to you a statement of the amounts due from your Government
                    June 15, 1932, June 15, 1933, and June 15, 1934, under the provisions of the
                    Debt Agreement of May 3, 1926,<anchor n="75" xml:id="d474-f1"/> and to advise
                    you that payment may be made either at the Treasury in Washington or at the
                    Federal Reserve Bank of New York.<anchor n="76" xml:id="d474-f2"/>
                </p>
                <p rendition="#center">
                    <hi rendition="#small-caps">Statement of Amounts Due From the Government of the
                        Kingdom of Yugoslavia June</hi> 15, 1932, <hi rendition="#small-caps"
                        >June</hi> 15, 1933 <hi rendition="#small-caps">and June</hi> 15, 1934</p>
                <table cols="3" rows="6">
                    <row role="label">
                        <cell cols="3">
                            <hi rendition="#italic">Amount due June 15, 1932:</hi>
                        </cell>
                    </row>
                    <row>
                        <cell/>
                        <cell>Principal of bond No. 7 due June 15, 1932</cell>
                        <cell role="num">$250,000.00</cell>
                    </row>
                    <row>
                        <cell cols="3">
                            <hi rendition="#italic">Amount due June 15, 1933:</hi>
                        </cell>
                    </row>
                    <row>
                        <cell/>
                        <cell>Principal of bond No. 8 due June 15, 1933</cell>
                        <cell role="num">275,000.00</cell>
                    </row>
                    <row>
                        <cell cols="3">
                            <hi rendition="#italic">Amount due June 15, 1934:</hi>
                        </cell>
                    </row>
                    <row>
                        <cell/>
                        <cell>Principal of bond No. 9 due June 15, 1934</cell>
                        <cell role="num">300,000.00</cell>
                    </row>
                </table>
                <p>Accept [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">William Phillips</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d474-f1" n="75" xml:id="d474-f1-content">
