    <text>
        <body>
            <div xml:id="d527">

                <pb facs="0750" n="650" sameAs="frus:frus1934v01/pg650"/>

                <note rend="inline" type="source">856D.6176/225: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Bingham</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1934-04-24T19:00:00-05:00">April 24, 1934—7
                            p.m.</date>
                    </dateline>
                </opener>
                <p>160. Mr. Harvey Firestone<anchor n="30" xml:id="d527-f1"/> informs the Department
                    that information received from London indicates the rubber restriction agreement
                    will be signed April 28 to enter into effect almost immediately.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Phillips</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d527-f1" n="30" xml:id="d527-f1-content">
                <p>Chairman of the Board of Directors of the Firestone Tire &amp; Rubber Co.</p>
            </note>
        </listAnnotation>
    </standOff>
