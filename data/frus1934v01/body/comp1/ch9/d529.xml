            <div xml:id="d529">

                <pb facs="0752" n="652" sameAs="frus:frus1934v01/pg652"/>

                <note rend="inline" type="source">856D.6176/228: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Great Britain</hi> (<hi
                            rendition="#italic">Bingham</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1934-04-26T18:00:00-05:00">April 26, 1934—6
                            p.m.</date>
                    </dateline>
                </opener>
                <p>164. Your 203, April 26. The oral statement you made to Vansittart seems to the
                    Department well advised. Assume you are cabling reply received from the Foreign
                    Office to your earlier communications.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
