            <div xml:id="d685">

                <pb facs="0790" n="688" xml:id="pg688"/>

                <note rend="inline" type="source">793.94/770: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Chargé in
                        Japan</hi> (<hi rendition="#italic">MacMurray</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-03-11T16:00:00-05:00"><hi rendition="#italic">March 11, 1919,
                                4 p.m.</hi></date></dateline></opener>
                <p>Your March 5, 5 p.m.</p>
                <p>You may at your discretion categorically deny the reports in so far as the acts
                    and purposes of this Government are concerned.</p>
                <closer><signed><hi rendition="#small-caps">Polk</hi></signed></closer>
            </div>
        </body>
