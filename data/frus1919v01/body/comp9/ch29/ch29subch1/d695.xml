    <text>
        <body>
            <div xml:id="d695">

                <pb facs="0797" n="695" xml:id="pg695"/>

                <note rend="inline" type="source">793.94/823: Telegram</note>
                <head><hi rendition="#italic">The Commission to Negotiate
                            Peace to the Acting Secretary of
                        State</hi><anchor n="20" xml:id="d695-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1919-05-29T21:00:00+01:00"><hi rendition="#italic">May 29, 1919, 9
                                p.m.</hi></date><lb/>[<hi rendition="#italic">Received May 29, 8.43
                            p.m.</hi>]</dateline></opener>
                <p>2336. Your 2082 May 24, 3 p.m.<anchor n="21" xml:id="d695-f2"/> President asks
                    that Legation Peking acknowledge message from American Chamber of Commerce of
                    China and state that matter which it presents will receive his most attentive
                    consideration. Lansing.</p>
                <closer><hi rendition="#small-caps">American Mission</hi></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d695-f1" n="20" type="source" xml:id="d695-f1-content">
                <p>Transmitted to the Minister in China May 31.</p>
            </note>
            <note corresp="#d695-f2" n="21" xml:id="d695-f2-content">
