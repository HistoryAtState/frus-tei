    <text>
        <body>
            <div xml:id="d598">

                <pb facs="0723" n="621" xml:id="pg621"/>

                <note rend="inline" type="source">893.811/301</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Reinsch</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1918-05-17"><hi rendition="#italic">May 17,
                            1918</hi>.</date><lb/>[<hi rendition="#italic">Received June
                        11.</hi>]</dateline>
                    <seg rendition="#float-left">No. 2051</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Confirming my telegram to you of May 17, 11
                        A.M.,<anchor n="48" xml:id="d598-f1"/> I have the honor to enclose herewith
                    the treasury note of the Chinese Government for G. $250,000.00.</p>
                <p>This is in conformity with the instructions contained in your telegram of May
                    2nd, 3 P.M.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Paul S. Reinsch</hi></signed></closer>
            </div>
        </body>
    </text>
