    <text>
        <body>
            <div xml:id="d595">

                <pb facs="0718" n="616" sameAs="frus:frus1919v01/pg616"/>

                <note rend="inline" type="source">893.811/287</note>
                <head><hi rendition="#italic">The Vice President of the American International
                        Corp</hi>. (<hi rendition="#italic"
                        >Tinsley</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >New York</hi></placeName>, <date calendar="gregorian"
                            when="1918-03-23"><hi rendition="#italic">March 23,
                            1918</hi>.</date><lb/>[<hi rendition="#italic">Received March
                        25.</hi>]</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honour to lay before the
                    Department, for its information, certain correspondence showing the measures the
                    Corporation is prepared to take with reference to the improvement of the Grand
                    Canal in China.</p>
                <p>The Corporation would greatly appreciate it if the Department will be good enough
                    to inform the Legation at Peking, by mail, of the substance of this
                    correspondence, and begs to thank the Department now for its compliance with
                    this request.<anchor n="44" xml:id="d595-f1"/></p>
                <p>I am [etc.]</p>
                <closer><signed><hi rendition="#small-caps">R. P. Tinsley</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d595-f1" n="44" xml:id="d595-f1-content">
                <p>Correspondence not printed; it was transmitted to the Minister in China, in
                    instruction No. 780, Mar. 28, 1918.</p>
            </note>
        </listAnnotation>
    </standOff>
