    <text>
        <body>
            <div xml:id="d380">

                <pb facs="0541" n="439" sameAs="frus:frus1919v01/pg439"/>

                <note rend="inline" type="source">893.51/2251a, 2839</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the British Chargé</hi> (<hi
                            rendition="#italic">Barclay</hi>)<anchor n="4"
                        xml:id="d380-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-06-05"><hi rendition="#italic">June 5,
                        1919</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Supplementing the Department’s note of May
                    31, 1919, regarding the organization of a new international consortium for the
                    purpose of making loans to the Chinese Government, I have the honor to enclose
                    herewith for your information copy of the draft agreement entered into by the
                    representatives of the banking groups of Great Britain, France, Japan and the
                    United States at a meeting held in Paris on May 12th.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Frank L. Polk</hi></signed></closer>


                <xi:include href="d380-a1.xml" xpointer="d380-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d380-f1" n="4" type="source" xml:id="d380-f1-content">
                <p>The same, <hi rendition="#italic">mutatis mutandis</hi>, June 5, to the
                    diplomatic representatives of China, France, and Japan.</p>
            </note>
        </listAnnotation>
    </standOff>
