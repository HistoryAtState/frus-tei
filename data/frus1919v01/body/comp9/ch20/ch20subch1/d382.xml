    <text>
        <body>
            <div xml:id="d382">

                <pb facs="0545" n="443" sameAs="frus:frus1919v01/pg443"/>

                <note rend="inline" type="source">893.51/2271</note>
                <head><hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Wallace</hi>) <hi rendition="#italic">to the Acting Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1919-06-07"><hi rendition="#italic">June 7,
                            1919</hi></date>.<lb/>[<hi rendition="#italic">Received, June
                        20.</hi>]</dateline>
                    <seg rendition="#float-left">No. 169</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Confirming my telegram No. 649 of June 6th,
                    11 p.m.,<anchor n="5" xml:id="d382-f1"/> I have the honor to enclose herewith,
                    in copy and translation, the text of the note which formed the body of that
                    telegram.</p>
                <p>A copy of the note has also been sent to Mr. Hugh D. Marshall, Special Assistant
                    to the Department of State at present in Paris.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Hugh C. Wallace</hi></signed></closer>


                <xi:include href="d382-a1.xml" xpointer="d382-a1"/>
            </div>
        </body>
    </text>
