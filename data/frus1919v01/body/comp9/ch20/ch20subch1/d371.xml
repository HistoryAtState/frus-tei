    <text>
        <body>
            <div xml:id="d371">

                <pb facs="0536" n="434" xml:id="pg434"/>

                <note rend="inline" type="source">893.51/2165: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Ambassador in France</hi> (<hi
                            rendition="#italic">Sharp</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-04-11T16:00:00-04:00"><hi rendition="#italic">April 11, 1919,
                                4 p.m.</hi></date></dateline></opener>
                <p>8001. Your 8029 April 5, 8 p.m.</p>
                <p>Department agrees that representatives of banking groups shall arrange place and
                    date of meeting. American Group advises it will take pleasure in being
                    represented in either London or Paris and suggests meeting be held not later
                    than May 15.</p>
                <p>Repeat to London.</p>
                <closer><signed><hi rendition="#small-caps">Polk</hi></signed></closer>
            </div>
        </body>
    </text>
