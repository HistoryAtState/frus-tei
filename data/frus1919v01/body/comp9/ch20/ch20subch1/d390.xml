    <text>
        <body>
            <div xml:id="d390">

                <pb facs="0553" n="451" sameAs="frus:frus1919v01/pg451"/>

                <note rend="inline" type="source">893.51/2266: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Ambassador in France</hi> (<hi
                            rendition="#italic">Wallace</hi>)<anchor n="15"
                        xml:id="d390-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-06-17T16:00:00-04:00"><hi rendition="#italic">June 17, 1919,
                                4 p.m.</hi></date></dateline></opener>
                <p>8616. The following just received from Tokio <hi rendition="#italic">re</hi>
                    consortium: [Here follows text of telegram of June It) from the Ambassador in
                    Japan, printed <hi rendition="#italic">supra.</hi>]</p>
                <p>You will please do all you can to have the group representing the interest of the
                    Government to which you are accredited authorized to complete the new Consortium
                    tomorrow.</p>
                <closer><signed><hi rendition="#small-caps">Phillips</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d390-f1" n="15" type="source" xml:id="d390-f1-content">
                <p>The same, June 17, to the Ambassador in Great Britain, No. 5519.</p>
            </note>
        </listAnnotation>
    </standOff>
