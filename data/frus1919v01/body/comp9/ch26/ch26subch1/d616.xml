    <text>
        <body>
            <div xml:id="d616">

                <pb facs="0743" n="641" sameAs="frus:frus1919v01/pg641"/>

                <note rend="inline" type="source">693.003/438: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Minister in
                        China</hi> (<hi rendition="#italic">Reinsch</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1917-11-17T16:00:00-05:00"><hi rendition="#italic">November 17,
                                1917, 4 p.m.</hi></date></dateline></opener>
                <p>Your October 2, 2 p.m.</p>
                <p>Arnold<anchor n="64" xml:id="d616-f1"/> is designated to represent the United
                    States Government on the international tariff commission to meet at Shanghai
                    December 1 for the revision of the tariff. He should bear in mind <pb
                        facs="0744" n="642" xml:id="pg642"/> the understanding of this Government
                    stated in the Department’s October 15, 6 p.m.</p>
                <closer><signed><hi rendition="#small-caps">Polk</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d616-f1" n="64" xml:id="d616-f1-content">
                <p>Julean Arnold, Commercial Attaché in China.</p>
            </note>
        </listAnnotation>
    </standOff>
