    <text>
        <body>
            <div xml:id="d647">

                <pb facs="0760" n="658" xml:id="pg658"/>

                <note rend="inline" type="source">693.003/563</note>
                <head><hi rendition="#italic">The Chairman of the American Delegation</hi>
                        (<hi rendition="#italic">Arnold</hi>) <hi
                        rendition="#italic">to the Acting Secretary of
                            State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1919-04-03"><hi rendition="#italic">April 3,
                            1919</hi>.</date><lb/>[<hi rendition="#italic">Received May
                        19.</hi>]</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose three
                    additional copies of the Draft of the Revised Import Tariff as finally agreed
                    upon by the China Tariff Revision Commission,<anchor n="80" xml:id="d647-f1"/>
                    to which I was detailed as Chairman of the American Delegation.</p>
                <p>Six copies of this draft were forwarded to the Department from Shanghai December
                    27th, but it appears from instructions received at the Legation that they were
                    never received by the Department.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Julean Arnold</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d647-f1" n="80" xml:id="d647-f1-content">
                <p>Not printed; the tariff list comprises 598 numbered items with many unnumbered
                    subdivisions.</p>
            </note>
        </listAnnotation>
