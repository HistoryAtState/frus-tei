    <text>
        <body>
            <div xml:id="d657">

                <pb facs="0768" n="666" sameAs="frus:frus1919v01/pg666"/>

                <note rend="inline" type="source">693.003/574</note>
                <head><hi rendition="#italic">The Chinese Chargé</hi> (<hi
                            rendition="#italic">Tung Kwai</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-11-14"><hi rendition="#italic">November 14,
                        1919</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that I have
                    received a cablegram from the Waichiao Pu (Ministry of Foreign Affairs), dated
                        <pb facs="0769" n="667" xml:id="pg667"/> the 8th instant, authorizing me to
                    sign with you a treaty between China and the United States giving effect to the
                    new Chinese Import Tariff as revised by the Tariff Commission which completed
                    its labors at Shanghai on December 20, 1918.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Yung Kwai</hi></signed></closer>
            </div>
        </body>
    </text>
