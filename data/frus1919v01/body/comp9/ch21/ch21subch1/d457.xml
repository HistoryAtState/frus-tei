    <text>
        <body>
            <div xml:id="d457">

                <pb facs="0607" n="505" sameAs="frus:frus1919v01/pg505"/>

                <note rend="inline" type="source">893.51/2206</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Reinsch</hi>) <hi rendition="#italic">to the Acting Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1919-04-04"><hi rendition="#italic">April 4,
                            1919</hi>.</date><lb/>[<hi rendition="#italic">Received May
                        5</hi>.]</dateline>
                    <seg rendition="#float-left">No. 2660</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In connection with my despatch No. 2626 of
                    March 21st<anchor n="89" xml:id="d457-f1"/> relating to a protest against the
                    8th Year Internal Loan, I have the honor to forward copies of the identic note
                    directed to the Foreign Office by the Ministers representing Consortium
                    Powers.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Paul S. Reinsch</hi></signed></closer>


                <xi:include href="d457-a1.xml" xpointer="d457-a1"/>
            </div>
        </body>
    </text>
