                <pb facs="0609" n="507" sameAs="frus:frus1919v01/pg507"/>

                <note rend="inline" type="source">893.51/2173: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Minister in
                        China</hi> (<hi rendition="#italic">Reinsch</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-04-11T17:00:00-04:00"><hi rendition="#italic">April 11, 1919,
                                5 p.m.</hi></date></dateline></opener>
                <p>Your undated telegram received April 10.</p>
                <p>Department will leave to the discretion of yourself and Abbott matter of
                    extension of currency loan option.</p>
                <closer><signed><hi rendition="#small-caps">Polk</hi></signed></closer>
            </div>
        </body>
