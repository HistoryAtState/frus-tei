    <text>
        <body>
            <div xml:id="d467">

                <pb facs="0614" n="512" sameAs="frus:frus1919v01/pg512"/>

                <note rend="inline" type="source">893.51/2350</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Reinsch</hi>) <hi rendition="#italic">to the Acting Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1919-07-07"><hi rendition="#italic">July 7,
                            1919</hi>.</date><lb/>[<hi rendition="#italic">Received August
                        6.</hi>]</dateline>
                    <seg rendition="#float-left">No. 2883</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose copies of a
                    translation of a memorandum given to me by the Minister of Finance. This was
                    prepared <pb facs="0615" n="513" xml:id="pg513"/> in connection with the request
                    for an advance of $50,000,000 which was communicated to you telegraphically on
                    June 10th [<hi rendition="#italic">11th</hi>].<anchor n="2" xml:id="d467-f1"
                    /></p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Paul S. Reinsch</hi></signed></closer>


                <xi:include href="d467-a1.xml" xpointer="d467-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d467-f1" n="2" xml:id="d467-f1-content">
                <p>Telegram of June 11 not printed; see memorandum of June 20 from the Chinese
                    Chargé <ref target="#pg453">p. 453</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
