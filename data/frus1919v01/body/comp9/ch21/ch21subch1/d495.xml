    <text>
        <body>
            <div xml:id="d495">

                <pb facs="0635" n="533" sameAs="frus:frus1919v01/pg533"/>

                <note rend="inline" type="source">893.51/2456: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Chargé in China</hi> (<hi rendition="#italic"
                            >Tenney</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-11-07T18:00:00-05:00"><hi rendition="#italic">November 7,
                                1919, 6 p.m.</hi></date></dateline></opener>
                <p>With reference to Department’s telegram of October 10, 2 p.m.,<anchor n="33"
                        xml:id="d495-f1"/> please report by telegraph present status of Currency
                    loan option and action taken by Legation.</p>
                <closer><signed><hi rendition="#small-caps">Lansing</hi></signed></closer>
            </div>
        </body>
    </text>
