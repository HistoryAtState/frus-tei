                <pb facs="0622" n="520" sameAs="frus:frus1919v01/pg520"/>

                <note rend="inline" type="source">893.51/2381: Telegram</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Reinsch</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1919-08-23T13:00:00+08:00"><hi rendition="#italic">August 23,
                                1919, 1 p.m.</hi></date><lb/>[<hi rendition="#italic">Received
                            August 23, 11.14 a.m.</hi>]</dateline></opener>
                <p>Referring to my cable of August 21, 7 p.m. It is reliably reported that the
                    Shensi Provincial Government has negotiated a loan with Japanese interests of
                    $3,000,000.</p>
                <closer><signed><hi rendition="#small-caps">Reinsch</hi></signed></closer>
            </div>
        </body>
    </text>
