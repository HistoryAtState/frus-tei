            <div xml:id="d349">

                <pb facs="0497" n="395" sameAs="frus:frus1919v01/pg395"/>

                <note rend="inline" type="source">893.00/3545</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Crane</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1920-09-01"><hi rendition="#italic">September 1,
                            1920</hi></date>.<lb/>[<hi rendition="#italic">Received October
                        14.</hi>]</dateline>
                    <seg rendition="#float-left">No. 173</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith the
                    Legation’s Quarterly Report on conditions in China for the period ending
                    December 31st, 1919. A copy of this report is being forwarded to the Embassy at
                    Tokyo for its information.</p>
                <p>I have [etc.]</p>
                <closer>(For the Minister)<lb/><signed><hi rendition="#small-caps">A. B.
                            Ruddock</hi></signed></closer>



                <xi:include href="d349-a1.xml" xpointer="d349-a1"/>
            </div>
