    <text>
        <body>
            <div xml:id="d333">

                <pb facs="0444" n="342" sameAs="frus:frus1919v01/pg342"/>

                <note rend="inline" type="source">893.51/2229</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Reinsch</hi>) <hi rendition="#italic">to the Acting Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1919-04-12"><hi rendition="#italic">April 12,
                            1919</hi></date>.<lb/>[<hi rendition="#italic">Received May
                        17.</hi>]</dateline>
                    <seg rendition="#float-left">No. 2681</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    enclosed the translation of the Chinese text of the War Participation Loan
                        Agreement<anchor n="46" xml:id="d333-f1"/> as published in the <hi
                        rendition="#italic">Peking Leader</hi> of April 10th, 1919.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Paul S. Reinsch</hi></signed></closer>



                <xi:include href="d333-a1.xml" xpointer="d333-a1"/>
                <xi:include href="d333-a2.xml" xpointer="d333-a2"/>
            </div>
        </body>
    </text>
