                <pb facs="0446" n="344" xml:id="pg344"/>

                <note rend="inline" type="source">893.00/3099: Telegram</note>
                <head><hi rendition="#italic">The Consul General at Shanghai</hi> (<hi rendition="#italic">Sammons</hi>) <hi
                        rendition="#italic">to the Acting Secretary of
                            State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Shanghai</hi></placeName>, <date calendar="gregorian"
                            when="1919-05-13"><hi rendition="#italic">May 13,
                            1919</hi></date>.<lb/>[<hi rendition="#italic">Received May 14, 8.12
                            a.m.</hi>]</dateline></opener>
                <p>Internal Peace Conference disagrees; all resign.</p>
                <closer><signed><hi rendition="#small-caps">Sammons</hi></signed></closer>
            </div>
        </body>
