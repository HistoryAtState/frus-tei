                <pb facs="0446" n="344" sameAs="frus:frus1919v01/pg344"/>

                <note rend="inline" type="source">893.00/3099: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Consul General at
                        Shanghai</hi> (<hi rendition="#italic">Sammons</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-05-14T17:00:00-04:00"><hi rendition="#italic">May 14, 1919, 5
                                p.m.</hi></date></dateline></opener>
                <p>Your May 13. Please give further details Peace Conference break, reason for
                    disagreement and its bearing upon situation.</p>
                <closer><signed><hi rendition="#small-caps">Polk</hi></signed></closer>
            </div>
        </body>
