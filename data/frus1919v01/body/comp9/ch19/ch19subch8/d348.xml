                <pb facs="0497" n="395" sameAs="frus:frus1919v01/pg395"/>

                <note rend="inline" type="source">893.00/3244: Telegram</note>
                <head><hi rendition="#italic">The Chargé in China</hi> (<hi rendition="#italic"
                        >Tenney</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1919-11-06T12:00:00+08:00"><hi rendition="#italic">November 6,
                                1919, noon.</hi></date><lb/>[<hi rendition="#italic">Received
                            November 6, 7.46 a.m.</hi>]</dateline></opener>
                <p>Premier Chin informs me that all Northern military governors have agreed to
                    disband 20 per cent [of] their forces.</p>
                <closer><signed><hi rendition="#small-caps">Tenney</hi></signed></closer>
            </div>
        </body>
    </text>
