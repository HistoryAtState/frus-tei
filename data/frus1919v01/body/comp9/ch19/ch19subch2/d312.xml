    <text>
        <body>
            <div xml:id="d312">

                <pb facs="0399" n="297" xml:id="pg297"/>

                <note rend="inline" type="source">893.00/3005</note>
                <head><hi rendition="#italic">The Consul General at Shanghai</hi> (<hi
                        rendition="#italic">Sammons</hi>) <hi rendition="#italic">to the Minister in
                        China</hi> (<hi rendition="#italic">Reinsch</hi>)<anchor n="16"
                        xml:id="d312-f1"/></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Shanghai</hi></placeName>, <date calendar="gregorian"
                            when="1919-02-14"><hi rendition="#italic">February 14,
                        1919</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 2636</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith a
                    self-explanatory bulletin, as issued by the so-called Constitutional Government
                    of China, containing a further statement by Mr. Tong Shao-yi, as telegraphed to
                    the President of China, …</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Thomas Sammons</hi></signed></closer>


                <xi:include href="d312-a1.xml" xpointer="d312-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d312-f1" n="16" type="source" xml:id="d312-f1-content">
                <p>Copy forwarded to the Department by the Consul General under covering letter of
                    same date; received Apr. 1.</p>
            </note>
        </listAnnotation>
