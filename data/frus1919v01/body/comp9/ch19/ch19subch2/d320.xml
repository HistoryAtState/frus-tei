    <text>
        <body>
            <div xml:id="d320">

                <pb facs="0409" n="307" sameAs="frus:frus1919v01/pg307"/>

                <note rend="inline" type="source">893.00/3030</note>
                <head><hi rendition="#italic">The Consul General at Shanghai</hi> (<hi rendition="#italic">Sammons</hi>) <hi
                        rendition="#italic">to the Minister in China</hi> (<hi
                            rendition="#italic">Reinsch</hi>)<anchor n="27"
                        xml:id="d320-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Shanghai</hi></placeName>, <date calendar="gregorian"
                            when="1919-03-04"><hi rendition="#italic">March 4,
                        1919</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 2771</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose a copy of
                    Bulletin No. 22, as issued by the “Intelligence Bureau of the Constitutional
                    Government of China”, on the third instant, which embodies the Manifesto issued,
                    on the second instant, by the Southern peace delegation, to the Chinese press,
                    Provincial legislatures, commercial, educational and other bodies, in
                    explanation of the present situation as regards the peace conference in
                    China.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Thomas Sammons</hi></signed></closer>


                <xi:include href="d320-a1.xml" xpointer="d320-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d320-f1" n="27" type="source" xml:id="d320-f1-content">
                <p>Copy forwarded to the Department by the Consul General under covering letter of
                    same date; received Apr. 7.</p>
            </note>
        </listAnnotation>
    </standOff>
