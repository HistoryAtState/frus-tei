    <text>
        <body>
            <div xml:id="d548">

                <pb facs="0676" n="574" sameAs="frus:frus1919v01/pg574"/>

                <note rend="inline" type="source">893.77/1768</note>
                <head><hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Reinsch</hi>) <hi rendition="#italic">to
                        the Acting Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1919-04-12"><hi rendition="#italic">April 12,
                            1919</hi>.</date><lb/>[<hi rendition="#italic">Received May
                        17.</hi>]</dateline>
                    <seg rendition="#float-left">No. 2680</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    enclosed the texts of agreements<anchor n="87" xml:id="d548-f1"/> as given out
                    by the Foreign Office in a translation appearing in the <hi rendition="#italic"
                        >Peking Leader.</hi><anchor n="88" xml:id="d548-f2"/></p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Paul S. Reinsch</hi></signed></closer>



                <xi:include href="d548-a1.xml" xpointer="d548-a1"/>
                <xi:include href="d548-a2.xml" xpointer="d548-a2"/>
            </div>
        </body>
    </text>
