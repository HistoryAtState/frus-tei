    <text>
        <body>
            <div xml:id="d546-a2">

                <pb facs="0674" n="572" sameAs="frus:frus1919v01/pg572"/>

                <opener><seg rendition="#center">[Enclosure 2—Translation]</seg></opener>
                <head><hi rendition="#italic">The Chinese Minister in Japan</hi> (<hi
                        rendition="#italic">Chang Tsung-hsiang</hi>) <hi rendition="#italic">to the
                        Japanese Minister for Foreign Affairs</hi> (<hi rendition="#italic"
                        >Goto</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tokyo</hi></placeName>, <date
                            ana="#date_undated-inferred-from-document-content-and-sibling-dates"
                            calendar="gregorian" when="1918-09-24"><hi rendition="#italic"
                                >undated.</hi></date></dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honour to acknowledge receipt of
                    your letter couched in the following terms:—</p>
                <p>(Quotes in full letter from Minister for Foreign Affairs of September 24,
                    1918.)</p>
                <p>I have the honour to inform you that the Government of China accepts with
                    pleasure the proposal contained in the letter quoted above.</p>
                <p>I have [etc.]</p>
                <closer><hi rendition="#small-caps">Seal of</hi>
                    <signed><hi rendition="#small-caps">Chang Tsung Hsiang</hi></signed></closer>
            </div>
        </body>
    </text>
