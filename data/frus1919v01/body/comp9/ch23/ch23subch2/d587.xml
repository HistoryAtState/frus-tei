    <text>
        <body>
            <div xml:id="d587">

                <pb facs="0715" n="613" xml:id="pg613"/>

                <note rend="inline" type="source">861.77/1019: Telegram</note>
                <head><hi rendition="#italic">The President of the Technical Board</hi> (<hi
                        rendition="#italic">Stevens</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Harbin</hi></placeName>, <date calendar="gregorian"
                            when="1919-08-15T16:00:00+08:26"><hi rendition="#italic">August 15,
                                1919, 4 p.m.</hi></date><lb/>[<hi rendition="#italic">Received
                            August 15, 12 noon.</hi>]</dateline></opener>
                <p>Chinese Government yesterday deposited $500,000 gold Harbin my credit for use of
                    Board.</p>
                <closer><signed><hi rendition="#small-caps">Stevens</hi></signed></closer>
            </div>
        </body>
    </text>
