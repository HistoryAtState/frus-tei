                <pb facs="0198" n="96" sameAs="frus:frus1919v01/pg96"/>

                <note rend="inline" type="source">714.1515/78: Telegram</note>
                <head><hi rendition="#italic">The Minister in Guatemala</hi> (<hi rendition="#italic">Leavell</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1918-02-08T17:00:00-06:36"><hi rendition="#italic">February 8,
                                1918, 5 p.m.</hi></date><lb/>[<hi rendition="#italic">Received
                            February 9, 11 a.m.</hi>]</dateline></opener>
                <p>Your January 29, 8 p.m. Foreign Office today announces that Guatemala accepts
                    with pleasure the invitation to send this special plenipotentiary to
                    [Washington]. His name and date of departure will be announced shortly.</p>
                <closer><signed><hi rendition="#small-caps">Leavell</hi></signed></closer>
            </div>
        </body>
