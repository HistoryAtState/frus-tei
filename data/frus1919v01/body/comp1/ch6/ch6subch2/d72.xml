            <div xml:id="d72">

                <pb facs="0168" n="66" xml:id="pg66"/>

                <note rend="inline" type="source">711.5221/24: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Spain</hi> (<hi rendition="#italic">Willard</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-09-05T18:00:00-04:00"><hi rendition="#italic">September 5,
                                1919, 6 p.m.</hi></date></dateline></opener>
                <p>2255. Telegraph whether reply received to representations made pursuant
                    Department’s 2199, June 13, 5 p.m. If not, request reply.</p>
                <closer><signed><hi rendition="#small-caps">Phillips</hi></signed></closer>
            </div>
        </body>
