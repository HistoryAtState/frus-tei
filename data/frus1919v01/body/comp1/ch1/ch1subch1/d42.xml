                <pb facs="0134" n="32" sameAs="frus:frus1919v01/pg32"/>

                <note rend="inline" type="source">763.72119/8594: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Ambassador in
                        France</hi> (<hi rendition="#italic">Wallace</hi>)</head>
                <opener><seg rendition="#center">[Paraphrase]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1920-01-09T10:00:00-05:00"><hi rendition="#italic">January 9,
                                1920, 10 a.m.</hi></date></dateline></opener>
                <p>61. Mission. Your 57 of January 7. The Department does not object to your
                    attending unofficially and as an observer, meetings of Committee of Ambassadors,
                    provided your colleagues should request or offer no objection to your attending
                    the meetings in such capacity.</p>
                <closer><signed><hi rendition="#small-caps">Lansing</hi></signed></closer>
            </div>
        </body>
