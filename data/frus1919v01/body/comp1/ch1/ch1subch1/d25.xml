            <div xml:id="d25">

                <pb facs="0123" n="21" sameAs="frus:frus1919v01/pg21"/>

                <note rend="inline" type="source">763.72119P43/804: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Commission to Negotiate Peace</hi></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-11-18T11:00:00-05:00"><hi rendition="#italic">November 18,
                                1919, 11 a.m.</hi></date></dateline></opener>
                <p>3801. Your 5221, November 15, 11 p.m.<anchor n="10" xml:id="d25-f1"/></p>
                <p>You are instructed to bring to a close the American Mission to the Conference to
                    Negotiate Peace on or about December 1, and to inform the Commissioners and all
                    the personnel that they are expected to return home on the <hi
                        rendition="#italic">America</hi>, sailing between the 1st and the 5th of
                    December.</p>
                <p rendition="#center">. . . . . . .</p>
                <closer><signed><hi rendition="#small-caps">Lansing</hi></signed></closer>
            </div>
        </body>
    </text>
