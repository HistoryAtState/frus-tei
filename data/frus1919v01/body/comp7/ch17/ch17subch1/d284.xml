            <div xml:id="d284">

                <pb facs="0331" n="229" sameAs="frus:frus1919v01/pg229"/>

                <note rend="inline" type="source">711.428/536a</note>
                <head><hi rendition="#italic">The Secretary of State to
                        President Wilson</hi></head>
                <p><hi rendition="#small-caps">The President</hi>: The undersigned the Secretary of
                    State has the honor to lay before the President with a view to its transmission
                    to the Senate, if his judgment approve thereof, to receive the advice and
                    consent of the Senate to its ratification, a Convention signed September 2,
                    1919, between the United States and Great Britain, providing effective measures
                    for the protection, preservation and propagation of the salmon fishes in the
                    waters contiguous to the United States and the Dominion of Canada, and in the
                    Fraser River System.</p>
                <p>Respectfully submitted,</p>
                <closer>
                    <signed><hi rendition="#small-caps">Robert Lansing</hi></signed>
                    <lb/><dateline rendition="#float-left">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1919-09-02"><hi
                                rendition="#italic">September 2, 1919</hi></date>.</dateline>
                </closer>



