            <div xml:id="d278">

                <pb facs="0326" n="224" sameAs="frus:frus1919v01/pg224"/>

                <note rend="inline" type="source">711.428/519</note>
                <head><hi rendition="#italic">The British Chargê</hi> (<hi
                            rendition="#italic">Barclay</hi>) <hi rendition="#italic">to
                        the Acting Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-05-20"><hi rendition="#italic">May 20,
                        1919</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 365</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to your note of March 21st,
                    enclosing copy of a tentative draft of a Convention between Great Britain and
                    the United States concerning the Sockeye Salmon Fisheries, I have the honour to
                    transmit, herewith, copies of an Approved Minute of the Privy Council for
                    Canada, which I have received from the Governor General, representing that the
                    draft enclosed in your above mentioned note is acceptable to the Canadian
                    Government with certain modifications noted in the Minute.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Colville Barclay</hi></signed></closer>


                <xi:include href="d278-a1.xml" xpointer="d278-a1"/>
            </div>
        </body>
