    <text>
        <body>
            <div xml:id="d236">

                <pb facs="0285" n="183" sameAs="frus:frus1919v01/pg183"/>

                <note rend="inline" type="source">835.73/112: Telegram</note>
                <head><hi rendition="#italic">The Ambassador in Argentina</hi> (<hi
                        rendition="#italic">Stimson</hi>) <hi rendition="#italic">to the Secretary
                        of State ad interim</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Buenos Aires</hi></placeName>, <date calendar="gregorian"
                            when="1920-02-21T11:00:00-04:16"><hi rendition="#italic">February 21,
                                1920, 11 a.m.</hi></date><lb/>[<hi rendition="#italic">Received
                            February 22, 7.15 p.m.</hi>]</dateline></opener>
                <p>48. My December 19th, 10 a.m.<anchor n="10" xml:id="d236-f1"/> Official notice is
                    given that the Central and South American Telegraph Company has been authorized
                    to establish two additional cables between Buenos Aires and Montevideo, under
                    the decree of August 1, 1918.</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
