    <text>
        <body>
            <div xml:id="d243">

                <pb facs="0290" n="188" sameAs="frus:frus1919v01/pg188"/>

                <note rend="inline" type="source">123H16/177: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Commission to Negotiate
                        Peace</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-11-17T17:00:00-05:00"><hi rendition="#italic">November 17,
                                1919, 5 p.m.</hi></date></dateline></opener>
                <p>3794. For Halstead.</p>
                <p>7. Your 39, November 12, 3 p.m.<anchor n="5" xml:id="d243-f1"/></p>
                <p>You will continue after the close of the Peace Mission in Paris in the capacity
                    of United States Commissioner until the sending of diplomatic and consular
                    representatives to Vienna.</p>
                <closer><signed><hi rendition="#small-caps">Lansing</hi></signed></closer>
            </div>
        </body>
    </text>
