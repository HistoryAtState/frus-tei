    <text>
        <body>
            <div xml:id="d854">

                <pb facs="0948" n="846" xml:id="pg846"/>

                <note rend="inline" type="source">818.00/823</note>
                <head><hi rendition="#italic">Vice President Marshall to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-07-25"><hi rendition="#italic">July 25,
                        1919</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Secretary</hi>: The rules of the Senate
                    provide that no communication from a foreign government shall be handed down,
                    unless transmitted by the President.</p>
                <p>I accordingly hand you the enclosed for his determination.</p>
                <p>Very respectfully,</p>
                <closer><signed><hi rendition="#small-caps">Thos. R. Marshall</hi></signed></closer>


                <xi:include href="d854-a1.xml" xpointer="d854-a1"/>
