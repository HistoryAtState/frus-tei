                <pb facs="0938" n="836" sameAs="frus:frus1919v01/pg836"/>

                <note rend="inline" type="source">818.00/702: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Consul at San José</hi> (<hi
                            rendition="#italic">Chase</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-06-20T16:00:00-04:00"><hi rendition="#italic">June 20, 1919,
                                4 p.m.</hi></date></dateline></opener>
                <p>Your June 19, 9 a.m.</p>
                <p>You are instructed not to interest yourself in any way in matter at this
                    time.</p>
                <closer><signed><hi rendition="#small-caps">Polk</hi></signed></closer>
            </div>
        </body>
