            <div xml:id="d817">

                <pb facs="0923" n="821" sameAs="frus:frus1919v01/pg821"/>

                <note rend="inline" type="source">818.00/627</note>
                <head><hi rendition="#italic">Senator George H.
                            Moses to the Acting Secretary of
                            State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-05-21"><hi rendition="#italic">May 21,
                        1919</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Polk</hi>: I am enclosing with this a
                    letter today received by me from the attorney for the Costa Rican
                    Government.</p>
                <p>The subject matter is self-explanatory; and I will be glad to have any comment
                    upon it which you choose to make.</p>
                <p>Sincerely yours,</p>
                <closer><signed><hi rendition="#small-caps">Geo. H. Moses</hi></signed></closer>


                <xi:include href="d817-a1.xml" xpointer="d817-a1"/>
