    <text>
        <body>
            <div xml:id="d887-a1">

                <pb facs="0964" n="862" sameAs="frus:frus1919v01/pg862"/>

                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Managua</hi></placeName>, <date calendar="gregorian"
                            when="1919-09-10"><hi rendition="#italic">September 10,
                            1919</hi>.</date></dateline></opener>
                <p>Don Julio Acosta cheerfully accepted. Will leave this evening for San José with
                    his friends without arms [<hi rendition="#italic">unarmed</hi>].</p>
                <closer><signed><hi rendition="#small-caps">Chamorro</hi></signed></closer>
            </div>
