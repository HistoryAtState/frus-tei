            <div xml:id="d863">

                <pb facs="0952" n="850" sameAs="frus:frus1919v01/pg850"/>

                <note rend="inline" type="source">818.00/820: Telegram</note>
                <head><hi rendition="#italic">The Consul at San José</hi> (<hi
                            rendition="#italic">Chase</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >San José</hi></placeName>, <date calendar="gregorian"
                            when="1919-08-11T09:00:00-05:36"><hi rendition="#italic">August 11,
                                1919, 9 a.m.</hi></date><lb/>[<hi rendition="#italic">Received
                            August 12, 4 p.m.</hi>]</dateline></opener>
                <p>Your August 9, 3 p.m. Joaquin Tinoco was assassinated last night. Funeral takes
                    place this morning.</p>
                <closer><signed><hi rendition="#small-caps">Chase</hi></signed></closer>
            </div>
        </body>
    </text>
