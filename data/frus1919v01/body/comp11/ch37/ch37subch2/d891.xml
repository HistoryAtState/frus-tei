    <text>
        <body>
            <div xml:id="d891">

                <pb facs="0965" n="863" sameAs="frus:frus1919v01/pg863"/>

                <note rend="inline" type="source">818.00/886: Telegram</note>
                <head><hi rendition="#italic">The Costa Rican Minister of Foreign Affairs</hi>
                        (<hi rendition="#italic">Venegas</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><seg rendition="#center">[Translation]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >San José</hi></placeName>, <date calendar="gregorian"
                            when="1919-09-15"><hi rendition="#italic">September 15,
                            1919</hi></date>.<lb/>[<hi rendition="#italic">Received 10.45
                        p.m.</hi>]</dateline></opener>
                <p>I have the honor to inform Your Excellency that my Government, on the strength of
                    the Constitution of 1871 now in force, has decreed that the elections of the
                    President of the Republic and deputies to the National Congress be held on the
                    first of December next.</p>
                <closer><signed><hi rendition="#small-caps">Venegas</hi></signed></closer>
            </div>
        </body>
