                <pb facs="0975" n="873" sameAs="frus:frus1919v01/pg873"/>

                <note rend="inline" type="source">818.6363Am6/3: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Costa Rica</hi> (<hi rendition="#italic">Johnson</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >San José</hi></placeName>, <date calendar="gregorian"
                            when="1918-06-26T11:00:00-05:36"><hi rendition="#italic">June 26, 1918,
                                11 a.m.</hi></date><lb/>[<hi rendition="#italic">Received June 27,
                            9.57 a.m.</hi>]</dateline></opener>
                <p>Amory oil concession passed Congress and approved by Executive yesterday
                    published today, copy by mail.<anchor n="43" xml:id="d908-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Johnson</hi></signed></closer>
            </div>
        </body>
    </text>
