    <text>
        <body>
            <div xml:id="d123">

                <pb facs="0260" n="198" sameAs="frus:frus1945v01/pg198"/>

                <note rend="inline" type="source">500.CC/4–345</note>
                <head>
                    <hi rendition="#italic">The Secretary of the Interior</hi> (<hi
                        rendition="#italic">Ickes</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi><anchor n="5" xml:id="d123-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1945-04-05">April 5, 1945</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Ed</hi>: Enclosed is a copy of a memorandum
                    which I have sent to the President and which I think may be helpful to you. I
                    hope that you will steadfastly hold the line.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Harold L. Ickes</hi>
                    </signed>
                </closer>


                <xi:include href="d123-a1.xml" xpointer="d123-a1"/>
            </div>
        </body>
    </text>
