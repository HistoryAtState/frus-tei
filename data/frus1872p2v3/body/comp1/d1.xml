    <text>
        <body>
            <div xml:id="d1">

                <pb facs="0021" n="3" xml:id="pg3"/>

                <head ana="#head_untitled-inferred-from-chapter-head">[Argument.]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <hi rendition="#small-caps"><date calendar="gregorian" when="1872-06-10"
                                >June 10, 1872</date>.</hi>
                    </dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir:</hi> We have the honor to hand you herewith the
                    argument prepared by us as counsel of the United States, in order that, in
                    pursuance of Article V of the treaty of Washington, it may be presented in their
                    behalf to the tribunal of arbitration constituted by that treaty.</p>
                <p>We have the honor, sir, to be your obedient servants,</p>
                <closer>
                    <signed>C. CUSHING.</signed>
                    <signed>WM. M. EVARTS.</signed>
                    <signed>M. E. WAITE.</signed>
                </closer>
                <postscript>
                    <p><hi rendition="#small-caps">J. C. Bancroft Davis,</hi> Esq., <hi
                            rendition="#italic">Agent of the United States.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
