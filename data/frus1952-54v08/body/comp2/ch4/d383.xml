    <text>
        <body>
            <div xml:id="d383">

                <pb facs="0744" n="710" sameAs="frus:frus1952-54v08/pg710"/>

                <note rend="inline" type="source">Eisenhower
                    Library, Eisenhower papers, Whitman
                    file</note>
                <head>No. 383<lb/><hi rendition="#italic">The British Ambassador (Makins) to President Eisenhower</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1954-09-20">September 20, 1954</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. President</hi>: With reference to the
                    message to you from the Prime Minister about Cyprus which I sent to you on
                    September 18,<anchor n="1" xml:id="d383-f1"/> I enclose the factual note
                    referred to in that message.</p>
                <p>Yours sincerely,</p>
                <closer><signed><hi rendition="#small-caps">Roger
                                Makins</hi></signed></closer>



                <xi:include href="d383-a1.xml" xpointer="d383-a1"/>
            </div>
        </body>
    </text>
