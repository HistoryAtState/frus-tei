    <text>
        <body>
            <div xml:id="d334">

                <pb facs="0905" n="691" sameAs="frus:frus1871/pg691"/>

                <opener><seg rendition="#center">No. 313.</seg></opener>
                <head>Mr. Torbert to Mr.
                        Fish</head>
                <opener>
                    <seg rendition="#float-left">No. 44.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">United States Legation</hi>, <hi
                                rendition="#italic">San Salvador</hi></placeName>, <date
                            calendar="gregorian" when="1871-04-07"><hi rendition="#italic"
                                >April</hi> 7, 1871</date>. (Received May 2.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to inclose herewith a
                    translation copy (marked A) of a note received from the minister of foreign
                    affairs of Honduras, in regard to the Honduras Railroad. I furnished a copy of
                    said note to the government of Salvador, and the translation copy (marked B)
                    herewith is their answer to the same.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>ALFRED T. A. TORBERT.</signed></closer>



                <xi:include href="d334-a1.xml" xpointer="d334-a1"/>
                <xi:include href="d334-a2.xml" xpointer="d334-a2"/>
