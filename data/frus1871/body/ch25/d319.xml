    <text>
        <body>
            <div xml:id="d319">

                <pb facs="0874" n="660" sameAs="frus:frus1871/pg660"/>

                <opener><seg rendition="#center">No. 299.</seg></opener>
                <head>Mr. Nelson to Mr.
                        Fish</head>
                <opener>
                    <seg rendition="#float-left">No. 447.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">Mexico,</hi></placeName>
                        <date calendar="gregorian" when="1871-09-26"><hi rendition="#italic"
                                >September</hi> 26, 1871</date>. (Received October
                    13.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Herewith I inclose a translation of a
                    decree issued by the Mexican government on the 21st instant, closing the port of
                    Magdalena Bay, Lower California, which was opened by a decree of the 24th of
                    February last.</p>
                <p>Your obedient servant,</p>
                <closer>
                    <signed>THOMAS H. NELSON.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">Hamilton Fish</hi>, <hi rendition="#italic"
                            >Secretary of State, Washington.</hi></p>
                </postscript>



                <xi:include href="d319-a1.xml" xpointer="d319-a1"/>
            </div>
