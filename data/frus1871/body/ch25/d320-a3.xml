                <pb facs="0877" n="663" sameAs="frus:frus1871/pg663"/>


                <opener><seg rendition="#center">[Unofficial.]</seg></opener>
                <head>Mr. Nelson to Mr.
                        Mariscal</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">Mexico,</hi></placeName>
                        <date calendar="gregorian" when="1871-09-21"><hi rendition="#italic"
                                >September</hi> 21, 1871.</date></dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Mariscal</hi>: I send you some
                    newspapers, recently received from Texas, containing articles relating to cattle
                    stealing on the border, and the extraordinary conduct of General Cortina, to
                    which I invite your attention.</p>
                <p>Very truly yours,</p>
                <closer>
                    <signed>THOMAS H. NELSON.</signed></closer>
            </div>
        </body>
