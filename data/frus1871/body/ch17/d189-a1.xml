    <text>
        <body>
            <div xml:id="d189-a1">

                <pb facs="0597" n="383" sameAs="frus:frus1871/pg383"/>

                <head>No. 4.</head>

                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1871-03-21"><hi rendition="#italic"
                                >March</hi> 21, 1871.</date></dateline></opener>
                <p>In the name of His Majesty the Emperor, the undersigned, chancellor of the
                    empire, has the honor to submit to the diet, for its action, the annexed plan of
                    a law regarding the constitution of the German Empire as it has been adopted by
                    the Federal Council.</p>
                <closer>
                    <signed>V. BISMARCK.</signed></closer>
                <postscript>
                    <p>To the <hi rendition="#small-caps">Diet.</hi></p>
                </postscript>



