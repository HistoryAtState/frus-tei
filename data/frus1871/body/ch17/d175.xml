    <text>
        <body>
            <div xml:id="d175">

                <pb facs="0585" n="371" sameAs="frus:frus1871/pg371"/>

                <opener><seg rendition="#center">No. 157.</seg></opener>
                <head>Mr. Fish to Mr. Bancroft</head>
                <opener>
                    <seg rendition="#float-left">No. 281.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1871-01-17"><hi rendition="#italic"
                                >January</hi> 17, 1871.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I inclose for your information a
                    translation of a note of the 14th instant, from Baron Gerolt, and a copy of my
                    reply of the same date, in regard to the revocation of the declaration made by
                    the government of North Germany at the commencement of the existing war,
                    exempting private property on the high seas from seizure by the cruisers of
                    North Germany.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>HAMILTON FISH.</signed></closer>
                <postscript>
                    <p>[For copies of these inclosures see <hi rendition="#italic">post,</hi>
                        correspondence between the Department of State and the German legation in
                        Washington.]</p>
                </postscript>
            </div>
        </body>
    </text>
