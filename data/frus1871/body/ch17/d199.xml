    <text>
        <body>
            <div xml:id="d199">

                <pb facs="0617" n="403" xml:id="pg403"/>

                <opener><seg rendition="#center">No. 181.</seg></opener>
                <head>Baron Gerolt to Mr.
                        Fish</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of North Germany,</hi>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1871-01-14"><hi rendition="#italic"
                                >January</hi> 14, 1871</date>. (Received January
                    14.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor of inclosing the
                    translation of a telegram, received at a late hour last night, from Count
                    Bismarck.</p>
                <p>With the assurances of my highest consideration, I remain your most obedient
                    servant,</p>
                <closer>
                    <signed>FR. v. GEROLT.</signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">Hamilton Fish</hi>, <hi rendition="#italic"
                            >Secretary of State, &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d199-a1.xml" xpointer="d199-a1"/>
