                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <head>General Schenck to Mr.
                        Fish</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>L<hi rendition="#small-caps">ondon</hi></placeName>, <date
                            calendar="gregorian" when="1871-06-16"><hi rendition="#italic">June</hi>
                            16, 1871.</date></dateline></opener>
                <p>Will exchange ratifications to-morrow.</p>
                <closer>
                    <signed>SCHENCK.</signed></closer>
            </div>
