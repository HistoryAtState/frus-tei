    <text>
        <body>
            <div xml:id="d220-a2">

                <pb facs="0645" n="431" sameAs="frus:frus1871/pg431"/>

                <head>[Telegram.]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1871-01-24"><hi rendition="#italic"
                                >January</hi> 24</date>. (Received at about 3 a. m. January 25,
                        1871.)</dateline></opener>
                <p>To <hi rendition="#small-caps">Moran</hi>, <hi rendition="#italic">Chargé</hi>,
                        <hi rendition="#italic">American Legation, London:</hi></p>
                <p>Get from Stevens dispatch of Secretary of Navy to Captain Wells, Send it to
                    Washburne.</p>
                <closer>
                    <signed>FISH.</signed></closer>
            </div>
        </body>
    </text>
