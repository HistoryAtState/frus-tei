    <text>
        <body>
            <div xml:id="d249">

                <pb facs="0706" n="492" sameAs="frus:frus1871/pg492"/>

                <opener><seg rendition="#center">No. 228.</seg></opener>
                <head>Mr. Pakenham to Mr.
                        Davis</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1871-07-26"><hi rendition="#italic">July</hi>
                            26, 1871</date>. (Received July 27.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to inform you that
                    intelligence has reached me from the lieutenant governor of Prince Edward
                    Island, to the effect that that government yesterday decided not to enforce the
                    fishery laws during the present season, and pending the consideration of the
                    treaty by the legislature of that portion of Her Majesty’s dominions.</p>
                <p>I have the honor, &amp;c.,</p>
                <closer>
                    <signed>J. PAKENHAM.</signed></closer>
            </div>
        </body>
