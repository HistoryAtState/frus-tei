                <pb facs="0694" n="480" sameAs="frus:frus1871/pg480"/>

                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <head>General Schenck to Mr. Davis</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1871-08-13"><hi rendition="#italic"
                                >August</hi> 13, 1871.</date></dateline></opener>
                <p><hi rendition="#small-caps">Davis</hi>, <hi rendition="#italic">Acting
                        Secretary:</hi></p>
                <p>Alexander Cockburn, Lord Chief Justice, appointed Arbitrator. Sir Roundell
                    Palmer, counsel.</p>
                <closer>
                    <signed>SCHENCK.</signed></closer>
            </div>
        </body>
