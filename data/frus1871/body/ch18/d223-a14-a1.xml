    <text>
        <body>
            <div xml:id="d223-a14-a1">

                <pb facs="0659" n="445" xml:id="pg445"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <head>Lord Lyons to Mr.
                        Blount</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>B<hi rendition="#small-caps">ordeaux</hi></placeName>, <date
                            calendar="gregorian" when="1871-01-26"><hi rendition="#italic"
                                >January</hi> 26, 1871.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I subjoin a list of applications which have
                    been made to me respecting persons and property in Paris, and I shall be very
                    much obliged if you will give such attention to the case as circumstances may
                    allow when this dispatch reaches you.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>LYONS.</signed></closer>
            </div>
        </body>
    </text>
