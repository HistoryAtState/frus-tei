    <text>
        <body>
            <div xml:id="d252">

                <pb facs="0707" n="493" sameAs="frus:frus1871/pg493"/>

                <opener><seg rendition="#center">No. 231.</seg></opener>
                <head>Mr. Pakenham to Mr. Davis</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1871-08-15"><hi rendition="#italic"
                                >August</hi> 15, 1871</date>. (Received August
                    16.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acquaint you that
                    official information has this day reached me to the effect that Sir Alexander
                    Cockburn, chief justice of England, has been appointed arbitrator on behalf of
                    Her Majesty’s government, under article I of the treaty of Washington of the 8th
                    of May last.</p>
                <p>I have the honor, &amp;c.,</p>
                <closer>
                    <signed>F. J. PAKENHAM.</signed></closer>
            </div>
        </body>
