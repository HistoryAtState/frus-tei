    <text>
        <body>
            <div xml:id="d288-a4">

                <pb facs="0814" n="600" sameAs="frus:frus1871/pg600"/>

                <opener><seg rendition="#center">No. 3.</seg></opener>
                <opener><seg rendition="#center">Translation.</seg></opener>
                <head>His excellency Junie Ewackura Tamochika to Mr. De Long</head>
                <opener><dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Tokie</hi></placeName>, <date
                            calendar="japanese-nengō gregorian" when="1871-07-14">7<hi
                                rendition="#italic">th month,</hi> 14<hi rendition="#italic">th
                                day,</hi> 4<hi rendition="#italic">th year
                        Miji</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Your Excellency:</hi> I have the honor to advise you
                    that I have recently been appointed to the office of guamssshio, (chief minister
                    for foreign affairs.)</p>
                <p>It is my great desire that hereafter you will establish with myself the very
                    intimate and exceedingly kind relations that you have formerly held with my
                    predecessor.</p>
                <p>I have, &amp;c., &amp;c.,</p>
                <closer>
                    <signed>JUNIE EWACKURA TOMOCHIKA.</signed></closer>
            </div>
        </body>
    </text>
