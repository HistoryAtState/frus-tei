    <text>
        <body>
            <div xml:id="d407">

                <pb facs="1020" n="806" sameAs="frus:frus1871/pg806"/>

                <opener><seg rendition="#center">No. 385.</seg></opener>
                <head>C. C. Andrews to Mr. Fish</head>
                <opener>
                    <seg rendition="#float-left">No. 110.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">Stockholm</hi></placeName>, <date
                            calendar="gregorian" when="1871-06-10"><hi rendition="#italic">June</hi>
                            10, 1871</date>. (Received July 5.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a
                    report which I have prepared on the finances of Sweden, including an explanation
                    of the various kinds of taxes and a statement of the public debt.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>C. C. ANDREWS. </signed></closer>




