    <text>
        <body>
            <div xml:id="d161-a4">

                <pb facs="0568" n="354" sameAs="frus:frus1871/pg354"/>

                <head>[Untitled]</head>
                <opener><dateline rendition="#float-right">
                        <date calendar="gregorian" when="1871-04-28"><hi rendition="#small-caps"
                                >April</hi> 28, 1871.</date></dateline></opener>
                <p>I beg his excellency the minister of the United States to receive the homage of
                    my respect, and to have the goodness to send the inclosed letter to
                    Versailles.</p>
                <p>The address of Mr. LaGarde, in case the representative of his excellency does not
                    know it, can be found either at the residence of the nuncio or at the Episcopal
                    palace at Versailles.</p>
                <closer>
                    <signed>G. DARBOY, <hi rendition="#italic">Archbishop of
                    Paris.</hi></signed></closer>


                <xi:include href="d161-a4-a1.xml" xpointer="d161-a4-a1"/>
