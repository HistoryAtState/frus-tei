    <text>
        <body>
            <div xml:id="d161-a2">

                <pb facs="0567" n="353" sameAs="frus:frus1871/pg353"/>

                <head>[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Republic of France</hi>, <hi
                                rendition="#italic">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1871-04-23"><hi rendition="#italic"
                                >April</hi> 23, 1871.</date></dateline></opener>
                <p rendition="#center"><hi rendition="#italic">Prefecture of the Police,—Cabinet of
                        the Secretary General.</hi></p>
                <p>(See the 23d April; 25th April; 9th May, and 10th May, 1871.)</p>
                <p>We, member of the commune, civil delegate to the exprefecture of police,
                    authorize the citizen Washburne, minister of the United States, and his
                    secretary, to communicate freely with the citizen Darboy, archbishop of
                    Paris.</p>
                <p rendition="#right">RAOUL RIGAULT. [<hi rendition="#small-caps">seal</hi>.]</p>
                <p>Examined May 9, 1871.</p>
                <p>The chief of the division.</p>
                <closer>
                    <signed>EDWARD ERNAUD. [<hi rendition="#small-caps"
                    >seal</hi>.]</signed></closer>
            </div>
