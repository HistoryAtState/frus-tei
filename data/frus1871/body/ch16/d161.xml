    <text>
        <body>
            <div xml:id="d161">

                <pb facs="0566" n="352" sameAs="frus:frus1871/pg352"/>

                <opener><seg rendition="#center">No. 147.</seg></opener>
                <head>Mr. Washburne to Mr. Fish</head>
                <opener>
                    <seg rendition="#float-left">No. 473.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1871-06-29"><hi rendition="#italic"
                                >June</hi> 29, 1871</date>. (Received July 13.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> As connected with the history of the
                    insurrection and of the tragic fate of the archbishop of Paris, I have the honor
                    to send you herewith, to go into the archives of the Department, a copy of all
                    the correspondence and papers in regard to the imprisonment of the archbishop,
                    and the measures taken to obtain his release.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed>E. B. WASHBURNE.</signed></closer>











