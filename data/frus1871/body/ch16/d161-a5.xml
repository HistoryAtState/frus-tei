    <text>
        <body>
            <div xml:id="d161-a5">

                <pb facs="0570" n="356" sameAs="frus:frus1871/pg356"/>

                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Commune of Paris</hi>, <hi
                                rendition="#italic">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1871-05-18"><hi rendition="#italic"
                                >May</hi> 18, 1871.</date></dateline></opener>
                <p rendition="#center"><hi rendition="#italic">Cabinet of the procureur of the
                        commune.</hi></p>
                <p>The director of the Mazas will permit Citizens Washburne and McKean to
                    communicate with the prisoner Darboy.</p>
                <p>Permanent.</p>
                <closer>
                    <signed>RAOUL REGOULT, <hi rendition="#italic">Procureur of the
                        Commune.</hi></signed></closer>
                <postscript>
                    <p>Examined the 21st May, 1871.</p>
                </postscript>
            </div>
        </body>
    </text>
