    <text>
        <body>
            <div xml:id="d103">

                <pb facs="0487" n="273" sameAs="frus:frus1871/pg273"/>

                <opener><seg rendition="#center">No. 89.</seg></opener>
                <head>Mr. Washburne to Mr.
                        Fish</head>
                <opener>
                    <seg rendition="#float-left">No 332.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1870-12-12"><hi rendition="#italic"
                                >December</hi> 12, 1870</date>. (Received January 4,
                        1871.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to send you herewith a
                    translation from the “Journal Officiel” of December 8 of the government report
                    of the battle of Villiers, and of the military movements immediately connected
                    therewith.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>E. B. WASHBURNE.</signed></closer>


                <xi:include href="d103-a1.xml" xpointer="d103-a1"/>
