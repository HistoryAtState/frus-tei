            <div xml:id="d115">

                <pb facs="0504" n="290" sameAs="frus:frus1871/pg290"/>

                <opener><seg rendition="#center">No. 101.</seg></opener>
                <head>Mr. Washburne to Mr.
                        Fish</head>
                <opener>
                    <seg rendition="#float-left">No. 353.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1871-01-30"><hi rendition="#italic"
                                >January</hi> 30, 1871</date>. (Received February
                    18.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to inclose you herewith a
                    copy of a letter I have received from Count de Bismarck, in reply to my letter
                    to him on the subject of the dispatch-bag.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed>E. B. WASHBURNE.</signed></closer>



                <xi:include href="d115-a1.xml" xpointer="d115-a1"/>
