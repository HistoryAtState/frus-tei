    <text>
        <body>
            <div xml:id="d120">

                <pb facs="0512" n="298" xml:id="pg298"/>

                <opener><seg rendition="#center">No. 106.</seg></opener>
                <head>Mr. Washburne to Mr.
                        Fish</head>
                <opener>
                    <seg rendition="#float-left">No. 367.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Legation of the United States</hi>,
                                <hi rendition="#italic">Paris,</hi></placeName>
                        <date calendar="gregorian" when="1871-02-18"><hi rendition="#italic"
                                >February</hi> 18, 1871</date>. (Received March
                    9.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to send you herewith a
                    copy of a translation of an official letter from. M. Jules Favre, acknowledging
                    the receipt of thirty-five thousand francs sent to him by me from the fund
                    remitted from New York for the poor of France, and also a translation of a copy
                    of an unofficial note of the same purport.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed>E. B. WASHBURNE.</signed></closer>



                <xi:include href="d120-a1.xml" xpointer="d120-a1"/>
