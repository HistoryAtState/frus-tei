    <text>
        <body>
            <div xml:id="d323-a4">

                <pb facs="0887" n="673" sameAs="frus:frus1871/pg673"/>

                <opener><seg rendition="#center">[Inclosure 3.]</seg></opener>
                <head>Mr. Riotte to Mr.
                        Balladares.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">United States Legation in
                                Nicaragua</hi>, <hi rendition="#italic">Leon</hi></placeName>, <date
                            calendar="gregorian" when="1871-06-15"><hi rendition="#italic">June</hi>
                            15, 1871.</date></dateline></opener>
                <p>Hon. <hi rendition="#small-caps">Don Francisco Balladares</hi>, <hi
                        rendition="#italic">&amp;c</hi>., <hi rendition="#italic">&amp;c</hi>.:</p>
                <p>* * * I have the honor of herewith acknowledging the receipt of your note of the
                    10th instant, and of a parcel directed to me, stamped with the seal of your
                    department, and delivered to me by Don Buenaventura Selva, which I will forward
                    to my Government with the next steamer, that of the 24th instant.</p>
                <p>I beg Mr. Minister Balladares, &amp;c.,</p>
                <closer>
                    <signed>C. N. RIOTTE.</signed></closer>
            </div>
        </body>
    </text>
