    <text>
        <body>
            <div xml:id="d46-a3">

                <pb facs="0338" n="124" sameAs="frus:frus1871/pg124"/>

                <head>No. 2.</head>
                <opener><seg rendition="#center"><hi rendition="#italic">Copy of a telegram sent
                            this day to George F. Seward</hi>, <hi rendition="#italic"
                        >Shanghai</hi>, <hi rendition="#italic">to be forwarded from thence by
                            telegraph,</hi>
                        <hi rendition="#italic">June</hi> 3, 1871.</seg></opener>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Coast of Corea</hi></placeName>,
                            <date calendar="gregorian" when="1871-06-03"><hi rendition="#italic"
                                >June</hi> 3, 1871.</date></dateline></opener>
                <p>My overtures of peace have been met by wanton attack upon surveying party. See
                    admiral’s telegram to Secretary of Navy.</p>
                <closer>
                    <signed>LOW.</signed></closer>
                <postscript>
                    <p>
                        <placeName><hi rendition="#small-caps">Secretary of State</hi>, <hi
                                rendition="#italic">Washington, United States.</hi></placeName></p>
                    <p>The above is a true copy.</p>
                </postscript>
                <closer>
                    <signed>F. F. LOW.</signed></closer>
            </div>
        </body>
    </text>
