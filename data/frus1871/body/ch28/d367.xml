    <text>
        <body>
            <div xml:id="d367">

                <pb facs="0962" n="748" xml:id="pg748"/>

                <opener><seg rendition="#center">No. 346.</seg></opener>
                <head>Mr. Fish to General
                        Sickles</head>
                <opener>
                    <seg rendition="#float-left">No. 131.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State</hi>, <hi
                                rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1870-12-23"><hi rendition="#italic"
                                >December</hi> 23, 1870.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> The following telegram was sent to Mr.
                    Moran on the 22d, for transmission to you:</p>
                <p><hi rendition="#small-caps">Moran</hi>, <hi rendition="#italic">Chargé</hi>, <hi
                        rendition="#italic">London:</hi></p>
                <p>Telegraph, and send by mail to Sickles:</p>
                <p>“Telegram of 19th received; bases enumerated therein are entirely
                    inadmissible.”</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>HAMILTON FISH.</signed></closer>
            </div>
        </body>
    </text>
