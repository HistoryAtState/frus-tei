    <text>
        <body>
            <div xml:id="d215">

                <pb facs="0382" n="266" sameAs="frus:frus1915/pg266"/>

                <note rend="inline" type="source">File No. 817.00/2395.</note>
                <head>
                    <hi rendition="#italic">Minister Hale to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 56.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">San José</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-18">
                            <hi rendition="#italic">January 18, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt of the Department’s telegram [of January 14].</p>
                <p>As will be seen from my despatches Nos. 51, 52, 53 and 55, I have endeavored to
                    remove the effect of the Department’s instruction of December 18.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">E. J. Hale.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
