    <text>
        <body>
            <div xml:id="d1915">

                <pb facs="1425" n="1309" sameAs="frus:frus1915/pg1309"/>

                <note rend="inline" type="source">File No. 833.032/12.</note>
                <head>
                    <hi rendition="#italic">Chargé Schoenfeld to the Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 845.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Montevideo</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-26">
                            <hi rendition="#italic">February 26, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith the
                    official text of the presidential message. I beg leave respectfully to call the
                    Department’s attention to the statement making special mention of the high
                    appreciation in which Minister Nicolay A. Greystad was held by the Government.
                    Minister Greystad is described to have won high regard because of “his
                    intelligent and serene activity, inspired in the highest ideals of American
                    solidarity.”</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">H. F. Arthur Schoenfeld.</hi>
                    </signed>
                </closer>


                <xi:include href="d1915-a1.xml" xpointer="d1915-a1"/>
            </div>
        </body>
    </text>
