    <text>
        <body>
            <div xml:id="d1814-a3">

                <pb facs="1326" n="1210" sameAs="frus:frus1915/pg1210"/>

                <opener>
                    <seg rendition="#center">[Inclosure 3.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Minister Price to the Secretary of State for Foreign
                        Affairs.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 210.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Panama</hi></placeName>, <date
                            calendar="gregorian" when="1915-08-18">
                            <hi rendition="#italic">August 18, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: I have the honor to refer to my
                    note No. 206 of August 9 last and to the notes therein referred to and likewise
                    to our recent conference and <pb facs="1327" n="1211" xml:id="pg1211"/> again
                    respectfully to request the attention of your excellency to the importance of
                    this matter with the hope that a full response herein may be received by my
                    Government without further delay.</p>
                <p>I avail [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. Jennings Price.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
