    <text>
        <body>
            <div xml:id="d1808">

                <pb facs="1316" n="1200" sameAs="frus:frus1915/pg1200"/>

                <note rend="inline" type="source">File No. 319.1123L25/6.</note>
                <head>
                    <hi rendition="#italic">Consul Gale to the Secretary of State.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Colon</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-04">
                            <hi rendition="#italic">May 4, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to forward for the
                    Department’s information copy of a report I have prepared on the subject for the
                    benefit of the American Legation at Panama, at the request of the Minister.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. H. Gale</hi>.</signed>
                </closer>


                <xi:include href="d1808-a1.xml" xpointer="d1808-a1"/>
            </div>
