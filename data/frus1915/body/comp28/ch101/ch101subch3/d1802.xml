    <text>
        <body>
            <div xml:id="d1802">

                <pb facs="1310" n="1194" sameAs="frus:frus1915/pg1194"/>

                <note rend="inline" type="source">File No. 319.1123L25/2.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Price.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-06">
                            <hi rendition="#italic">April 6, 1915</hi></date>.</dateline>
                </opener>
                <p>Your April 4. Insist that policeman mentioned be speedily tried and protest
                    urgently against any indicated attempt to shield him.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
