            <div xml:id="d1774">

                <pb facs="1293" n="1177" sameAs="frus:frus1915/pg1177"/>

                <note rend="inline" type="source">File No. 419.11D29/96.</note>
                <head>
                    <hi rendition="#italic">The Department of State to
                        the Legation of Panama.</hi>
                </head>
                <p>The Department has received the memorandum of the Panaman Legation dated June 17,
                    1915, quoting the proposition submitted to the American Minister at Panama by
                    the Secretary of Foreign Relations of that Republic for the settlement of the
                    claim growing out of the events which took place at Cocoa Grove on July 4,
                    1912.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <hi rendition="#small-caps">Department of State</hi>, <lb/>
                        <placeName>
                            <hi rendition="#italic">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1915-06-30"><hi
                                rendition="#italic">June 30, 1915</hi></date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
