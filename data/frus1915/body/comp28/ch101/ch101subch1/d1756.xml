    <text>
        <body>
            <div xml:id="d1756">

                <pb facs="1282" n="1166" sameAs="frus:frus1915/pg1166"/>

                <note rend="inline" type="source">File No. 419.11D29/78.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Minister Price.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 108.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-04">
                            <hi rendition="#italic">March 4, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received your No. 415,
                    of the 19th ultimo, forwarding a copy of a note and translation from the Panaman
                    Foreign Office on the subject of the demands made by the United States based
                    upon the Cocoa Grove riot of July 4, 1912.</p>
                <p>In reply the Department refers you to its instructions No. 104, of February 18
                    last, advising you of its views on the subject.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
