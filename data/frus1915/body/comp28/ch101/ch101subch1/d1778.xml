    <text>
        <body>
            <div xml:id="d1778">

                <pb facs="1294" n="1178" sameAs="frus:frus1915/pg1178"/>

                <note rend="inline" type="source">File No. 419.11D29/103.</note>
                <head>
                    <hi rendition="#italic">Minister Price to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 582.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Panama</hi></placeName>, <date
                            calendar="gregorian" when="1915-08-13">
                            <hi rendition="#italic">August 13, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to my telegram of July 27 and
                    the Department’s reply telegram of August 7 and my cable response of this date,
                    I have the honor to transmit a copy of the Foreign Office note and of its
                    translation received late to-day from Secretary Lefevre, and referred to in my
                    said cable last mentioned. * * *</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. Jennings Price.</hi>
                    </signed>
                </closer>


                <xi:include href="d1778-a1.xml" xpointer="d1778-a1"/>
            </div>
