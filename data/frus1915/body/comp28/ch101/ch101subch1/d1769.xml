    <text>
        <body>
            <div xml:id="d1769">

                <pb facs="1291" n="1175" sameAs="frus:frus1915/pg1175"/>

                <note rend="inline" type="source">File No. 419.11D29/94.</note>
                <head>
                    <hi rendition="#italic">Minister Price to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 516.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Panama</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-19">
                            <hi rendition="#italic">May 19, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to my telegram of May 18, I have
                    the honor to enclose a copy of a Foreign Office note transmitted by me pursuant
                    to the Department’s telegram of May 14.</p>
                <p>There is herewith enclosed a copy of the response of the Secretary of Foreign
                    Affairs to said note.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. Jennings Price.</hi>
                    </signed>
                </closer>



                <xi:include href="d1769-a1.xml" xpointer="d1769-a1"/>
