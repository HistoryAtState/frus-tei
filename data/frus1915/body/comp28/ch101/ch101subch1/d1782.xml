    <text>
        <body>
            <div xml:id="d1782">

                <pb facs="1297" n="1181" sameAs="frus:frus1915/pg1181"/>

                <note rend="inline" type="source">File No. 419.11D29/104.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Netherlands Minister.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 129.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-10-23">
                            <hi rendition="#italic">October 23, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt of your note of August 30, 1915, expressing your willingness to act as
                    arbitrator to determine the amount of indemnities to be paid by the Government
                    of Panama on account of the death and injury of American citizens in a riot
                    which occurred in the city of Panama on July 4, 1912, and to assure you of my
                    deep appreciation of your decision in the matter.</p>
                <p>The Department is taking steps to conclude arrangements for the arbitration and
                    will communicate with you further when they shall have been completed.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
