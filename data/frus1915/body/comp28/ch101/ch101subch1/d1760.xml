    <text>
        <body>
            <div xml:id="d1760">

                <pb facs="1284" n="1168" xml:id="pg1168"/>

                <note rend="inline" type="source">File No. 419.11D29/82.</note>
                <head>
                    <hi rendition="#italic">Minister Price to the
                            Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 440.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Panama</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-12">
                            <hi rendition="#italic">March 12, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose a copy of a
                    note which I have transmitted this morning to the Secretary of Foreign Affairs
                    of Panama in the matter of the Cocoa Grove affair of July 4, 1912, in compliance
                    with the directions of the Department contained in its instruction No. 104 of
                    February 18 last, and its telegram of March 10, 1915.</p>
                <p>I shall report duly further developments.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. Jennings Price.</hi>
                    </signed>
                </closer>


                <xi:include href="d1760-a1.xml" xpointer="d1760-a1"/>
            </div>
        </body>
    </text>
