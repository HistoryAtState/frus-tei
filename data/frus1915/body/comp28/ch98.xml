            <div xml:id="ch98">

                <pb facs="1239" n="1123" sameAs="frus:frus1915/pg1123"/>

                <head>Panama Canal Zone boundary convention between the United States and
                    Panama</head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at Panama, September 2, 1914; ratification
                        advised by the Senate, October 22, 1914; ratified by the President, January
                        4, 1915; ratified by Panama, February 8, 1915; ratifications exchanged at
                        Panama, February 11, 1915; proclaimed, February 18, 1915.</hi>
                </p>

