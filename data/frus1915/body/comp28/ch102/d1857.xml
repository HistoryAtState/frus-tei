    <text>
        <body>
            <div xml:id="d1857">

                <pb facs="1368" n="1252" xml:id="pg1252"/>

                <note rend="inline" type="source">File No. 419.11H23/35.</note>
                <head>
                    <hi rendition="#italic">Minister Price to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 390.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Panama</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-26">
                            <hi rendition="#italic">January 26, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith a
                    copy of a note dated January 25, sent to the Secretary of Foreign Affairs of
                    Panama in the matter of the case of William T. Harrington.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. Jennings Price.</hi>
                    </signed>
                </closer>


                <xi:include href="d1857-a1.xml" xpointer="d1857-a1"/>
            </div>
