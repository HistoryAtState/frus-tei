            <div xml:id="d1741">

                <pb facs="1266" n="1150" sameAs="frus:frus1915/pg1150"/>

                <note rend="inline" type="source">File No. 718.1915/240.</note>
                <head>
                    <hi rendition="#italic">Minister Price to the
                            Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 574.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Panama</hi></placeName>, <date
                            calendar="gregorian" when="1915-08-02">
                            <hi rendition="#italic">August 2, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit a copy of a
                    note and of its translation received from the Secretary of Foreign Affairs of
                    Panama in response to a note sent in accordance with the Department’s
                    instruction No. 137 of April 28 last, regarding the matter of the award made by
                    Chief Justice White of the United States Supreme Court in the boundary
                    controversy between Panama and Costa Rica. A copy of my note last mentioned was
                    forwarded to the Department with my despatch No. 521 of June 3.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. Jennings Price.</hi>
                    </signed>
                </closer>



                <xi:include href="d1741-a1.xml" xpointer="d1741-a1"/>
            </div>
        </body>
    </text>
