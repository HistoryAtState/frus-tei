    <text>
        <body>
            <div xml:id="d1744">

                <pb facs="1271" n="1155" xml:id="pg1155"/>

                <note rend="inline" type="source">File No. 718.1915/243.</note>
                <head>
                    <hi rendition="#italic">Minister Price to the
                            Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 638.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Panama</hi></placeName>, <date
                            calendar="gregorian" when="1915-10-08">
                            <hi rendition="#italic">October 8, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit a copy of a
                    note sent to the Secretary of Foreign Affairs of Panama in the matter of the
                    boundary dispute between Panama and Costa Rica, and in compliance with the
                    Department’s instruction No. 169 of September 9.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. Jennings Price</hi>,</signed>
                </closer>


                <xi:include href="d1744-a1.xml" xpointer="d1744-a1"/>
            </div>
        </body>
    </text>
