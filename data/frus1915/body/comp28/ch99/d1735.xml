    <text>
        <body>
            <div xml:id="d1735">

                <pb facs="1254" n="1138" sameAs="frus:frus1915/pg1138"/>

                <note rend="inline" type="source">File No. 718.1915/236.</note>
                <head>
                    <hi rendition="#italic">Minister Hale to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 72.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">San José</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-03">
                            <hi rendition="#italic">April 3, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to Department’s telegram of
                    November 25<anchor n="6" xml:id="d1735-f1"/>; to my despatch No. 49, of December
                        5<anchor n="6" xml:id="d1735-f2"/>; to my despatch No. 50, of December
                        18<anchor n="6" xml:id="d1735-f3"/>; and to my despatch No. 58, of January
                    23—I have the honor to report that I have received another communication from
                    the Minister for Foreign Affairs, dated March 5, a copy of which and its
                    enclosures, together with translations of all, I enclose.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">E. J. Hale.</hi>
                    </signed>
                </closer>





                <xi:include href="d1735-a1.xml" xpointer="d1735-a1"/>
