            <div xml:id="ch115">

                <pb facs="1406" n="1290" sameAs="frus:frus1915/pg1290"/>

                <head>Treaty for the advancement of general peace, concluded between the United
                    States and Sweden</head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at Washington, October 13, 1914; ratification
                        advised by the Senate, October 22, 1914; ratified by the President, January
                        4, 1915; ratified by Sweden, November 13, 1914; ratifications exchanged at
                        Washington, January 11, 1915; proclaimed, January 12, 1915.</hi>
                </p>

                <xi:include href="ch115/d1898.xml" xpointer="d1898"/>
