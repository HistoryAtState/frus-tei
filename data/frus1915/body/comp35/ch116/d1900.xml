    <text>
        <body>
            <div xml:id="d1900">

                <pb facs="1409" n="1293" sameAs="frus:frus1915/pg1293"/>

                <head>
                    <hi rendition="#italic">The Swedish Minister to the
                            Secretary of State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Legation of Sweden</hi>, <lb/>
                            <hi rendition="#italic">Washington, D. C.</hi>
                        </placeName>
                        <date calendar="gregorian" when="1915-11-16">
                            <hi rendition="#italic">November 16, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to inform your excellency
                    that my Government accepts the suggestion contained in your excellency’s note of
                    today’s date that the time specified in the Treaty of the 13th October 1914,
                    between the United States and Sweden, for the appointment of the International
                    Commission therein provided, be extended from July 11, 1915 to January 15,
                    1916.</p>
                <p>With renewed assurances of my highest consideration I have the honor to remain
                    your excellency’s most obedient servant.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. A. F. Ekengren.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
