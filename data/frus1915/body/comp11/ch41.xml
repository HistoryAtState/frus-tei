            <div xml:id="ch41">

                <pb facs="0392" n="276" sameAs="frus:frus1915/pg276"/>

                <head>Treaty for the advancement of general peace, concluded between the United
                    States and Denmark</head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at Washington, April 17, 1914; ratification
                        advised by the Senate, September 30, 1914; ratified by the President,
                        January 14, 1915; ratified by Denmark, November 21, 1914; ratifications
                        exchanged at Washington, January 19, 1915; proclaimed, January 20,
                        1915.</hi>
                </p>

