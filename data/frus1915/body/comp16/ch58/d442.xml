    <text>
        <body>
            <div xml:id="d442">

                <pb facs="0543" n="427" xml:id="pg427"/>

                <note rend="inline" type="source">File No. 811.54441/11.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Ambassador Page</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-02">
                            <hi rendition="#italic">January 2, 1915</hi></date>.</dateline>
                </opener>
                <p>869. Presidential Proclamation has been issued effective January 1, 1915, on
                    understanding British Order in Council will be issued to take effect same date.
                    Bring this at once to attention Foreign Office.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>.</signed>
                </closer>
            </div>
        </body>
