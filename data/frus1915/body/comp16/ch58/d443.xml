    <text>
        <body>
            <div xml:id="d443">

                <pb facs="0543" n="427" sameAs="frus:frus1915/pg427"/>

                <note rend="inline" type="source">File No. 811.54441/16.</note>
                <head>
                    <hi rendition="#italic">Ambassador Page to the
                            Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 899.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">London</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-15">
                            <hi rendition="#italic">February 15, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    enclosed a copy of the British Order in Council issued on the 3rd. instant
                    relative to the application to the United States of the Copyright Act 1911.</p>
                <p>This Order came into operation on 1st. of January, 1915.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Walter Hines Page</hi>.</signed>
                </closer>


                <xi:include href="d443-a1.xml" xpointer="d443-a1"/>
            </div>
