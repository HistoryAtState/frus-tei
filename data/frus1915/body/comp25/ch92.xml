            <div xml:id="ch92">

                <pb facs="1215" n="1099" sameAs="frus:frus1915/pg1099"/>

                <head>Arbitration agreement between the United States and the Netherlands extending
                    the duration of the Convention of May 2, 1908</head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at Washington, May 9, 1914; ratification advised
                        by the Senate, May 20, 1914; ratified by the President, May 28, 1914;
                        ratified by The Netherlands, July 10, 1915; ratifications exchanged at
                        Washington, August 20, 1915; proclaimed, August 21, 1915.</hi>
                </p>

                <xi:include href="ch92/d1700.xml" xpointer="d1700"/>
