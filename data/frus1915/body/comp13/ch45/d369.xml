                <pb facs="0490" n="374" sameAs="frus:frus1915/pg374"/>

                <note rend="inline" type="source">File No. 322.112St8.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Minister Hartman</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-26">
                            <hi rendition="#italic">April 26, 1915</hi></date>.</dateline>
                </opener>
                <p>Your April 24. Insist that authorities permit American prisoner free
                    communication with his diplomatic and consular representatives.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>.</signed>
                </closer>
            </div>
        </body>
