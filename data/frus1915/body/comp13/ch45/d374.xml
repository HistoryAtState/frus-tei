    <text>
        <body>
            <div xml:id="d374">

                <pb facs="0491" n="375" sameAs="frus:frus1915/pg375"/>

                <note rend="inline" type="source">File No. 322.112St8/2.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Minister Hartman</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-14">
                            <hi rendition="#italic">May 14, 1915</hi></date>.</dateline>
                </opener>
                <p>Your April 29. Guayaquil reports consular agent investigated arrest Strong, found
                    no evidence against prisoner. Use best efforts obtain Strong’s release.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
