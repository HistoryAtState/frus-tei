    <text>
        <body>
            <div xml:id="d1399">

                <pb facs="1085" n="969" sameAs="frus:frus1915/pg969"/>

                <note rend="inline" type="source">File No. 812.512/647</note>
                <head>
                    <hi rendition="#italic">Consul General Shanklin to the Secretary of
                    State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate General at Mexico
                                City</hi>, <lb/>
                            <hi rendition="#italic">Written at Vera Cruz, Mexico</hi></placeName>,
                            <date calendar="gregorian" when="1915-05-01">
                            <hi rendition="#italic">May 1, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge receipt,
                    today, of the Department’s instruction of March 12, No. 710, the contents of
                    which will be transmitted by me to American citizens inquiring in regard to the
                    payment of their mining taxes.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Arnold Shanklin.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
