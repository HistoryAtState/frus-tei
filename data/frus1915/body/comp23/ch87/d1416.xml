    <text>
        <body>
            <div xml:id="d1416">

                <pb facs="1094" n="978" sameAs="frus:frus1915/pg978"/>

                <note rend="inline" type="source">File No. 812.512/772.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Special Agent
                    Carothers</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-08-23">
                            <hi rendition="#italic">August 23, 1915</hi></date>.</dateline>
                </opener>
                <p>Report action taken on cotton tax as affecting Tlahualilo Company and
                    results.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing.</hi>
                    </signed>
                </closer>
            </div>
        </body>
