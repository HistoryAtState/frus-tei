    <text>
        <body>
            <div xml:id="d1414">

                <pb facs="1093" n="977" sameAs="frus:frus1915/pg977"/>

                <note rend="inline" type="source">File No. 812.512/758.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Special Agent Carothers</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-08-13">
                            <hi rendition="#italic">August 13, 1915</hi></date>.</dateline>
                </opener>
                <p rendition="#flush">Tlahualilo Company reports: <quote rend="blockquote">
                        <p>Villa decree is worse than, reported, 10 per cent of invoice value and 7
                            per cent of cotton produced must be delivered in bales to cuartel
                            general.</p>
                    </quote>
                </p>
                <p>Continue earnest efforts for repeal of this decree.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
