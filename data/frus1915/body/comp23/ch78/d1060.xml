    <text>
        <body>
            <div xml:id="d1060">

                <pb facs="0915" n="799" xml:id="pg799"/>

                <note rend="inline" type="source">File No. 812.00/15567.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Confidential Agent of the Provisional Government of
                            Mexico</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-07-22">
                            <hi rendition="#italic">July 22, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department acknowledges the receipt of
                    your letter of July 21, regarding the action of General Calles of the Carranza
                    forces in taking the town of Naco in violation of an agreement entered into
                    between General Calles and Governor Maytorena.</p>
                <p>In view of the conditions surrounding the making of this agreement, special
                    attention is being given to the matter referred to by you in your letter of July
                    21, as a result of communications from the War Department.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
