        <body>
            <div xml:id="d1097">

                <pb facs="0931" n="815" sameAs="frus:frus1915/pg815"/>

                <note rend="inline" type="source">File No. 812.00/16545.</note>
                <head>
                    <hi rendition="#italic">The Secretary of War to the
                            Secretary of State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">War Department</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-10-22">
                            <hi rendition="#italic">October 22, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My dear Mr. Secretary</hi>: I have just received the
                    enclosed telegram from General Funston and transmit it for your consideration.
                    If consistent with your views, I recommend that action on the lines suggested by
                    General Funston be taken by the Department of State as early as practicable.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">L. M. Garrison.</hi>
                    </signed>
                </closer>



                <xi:include href="d1097-a1.xml" xpointer="d1097-a1"/>
