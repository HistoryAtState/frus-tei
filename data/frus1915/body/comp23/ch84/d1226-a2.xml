    <text>
        <body>
            <div xml:id="d1226-a2">

                <pb facs="0983" n="867" sameAs="frus:frus1915/pg867"/>

                <opener>
                    <seg rendition="#center">[Inclosure 2—Translation.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The Post Commander to the Brazilian
                    Minister</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Comandancia Militar</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-12">
                            <hi rendition="#italic">March 12, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Minister</hi>: This office has received your
                    letter of yesterday, in reply to which I have the pleasure of informing you that
                    the requests therein made have been complied with.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Amador Salazar.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
