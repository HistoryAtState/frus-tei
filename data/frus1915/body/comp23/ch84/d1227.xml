            <div xml:id="d1227">

                <pb facs="0986" n="870" sameAs="frus:frus1915/pg870"/>

                <note rend="inline" type="source">File No. 312.112M22/32.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Brazilian Minister to Mexico</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-13">
                            <hi rendition="#italic">May 13, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt of your No. 149 of April 16, transmitting correspondence regarding the
                    payment of indemnity by the Administration of the Convention for the death of
                    John B. McManus, which has been read with interest.</p>
                <p>Thanking you [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
