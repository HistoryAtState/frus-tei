                <pb facs="0982" n="866" sameAs="frus:frus1915/pg866"/>

                <note rend="inline" type="source">File No. 312.112M22/32.</note>
                <head>
                    <hi rendition="#italic">The Brazilian Minister in charge of
                            American interests to the Secretary of
                            State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 149.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Brazilian Legation</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-16">
                            <hi rendition="#italic">April 16, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to the death of John B.
                    McManus, for which an indemnity of $160,000 Mexican currency was paid by the
                    Government of the Convention on the 29th day of March last, I have the honor to
                    enclose herewith the following documents.</p>
                <p>Assuring you [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. M. Cardoso de Oliveira.</hi>
                    </signed>
                </closer>













