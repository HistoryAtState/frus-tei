        <body>
            <div xml:id="d1225">

                <pb facs="0978" n="862" sameAs="frus:frus1915/pg862"/>

                <note rend="inline" type="source">File No. 312.11/7153.</note>
                <head>
                    <hi rendition="#italic">The Secretary of the Navy to the Secretary of
                    State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Navy Department</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-28">
                            <hi rendition="#italic">December 28, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith copy
                    of a report of operations of the U. S. Pacific Fleet in Mexican waters, dated
                    December 11, 1915.</p>
                <p>Very sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Josephus Daniels.</hi>
                    </signed>
                </closer>





