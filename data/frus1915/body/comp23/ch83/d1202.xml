    <text>
        <body>
            <div xml:id="d1202">

                <pb facs="0970" n="854" sameAs="frus:frus1915/pg854"/>

                <note rend="inline" type="source">File No. 312.11/7058.</note>
                <head>
                    <hi rendition="#italic">Consul Alger to the Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 706.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Mazatlan</hi></placeName>, <date
                            calendar="gregorian" when="1915-11-29">
                            <hi rendition="#italic">November 29, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor, referring to my Nos. 697
                    of November 19, and 698 of November 23 [and 699 of November 26] to enclose copy
                    of reply from General Muñoz to my request for protection instead of
                    protests.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. E. Alger.</hi>
                    </signed>
                </closer>


                <xi:include href="d1202-a1.xml" xpointer="d1202-a1"/>
            </div>
        </body>
    </text>
