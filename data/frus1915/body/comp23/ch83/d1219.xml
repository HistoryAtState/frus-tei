    <text>
        <body>
            <div xml:id="d1219">

                <pb facs="0976" n="860" sameAs="frus:frus1915/pg860"/>

                <note rend="inline" type="source">File No. 312.11/7108.</note>
                <head>
                    <hi rendition="#italic">The Secretary of the Navy to
                        Admiral Winslow</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Navy Department</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-21">
                            <hi rendition="#italic">December 21, 1915</hi></date>.</dateline>
                </opener>
                <p>Troops will not be landed without instructions from the Department. It is desired
                    that you keep the Department fully informed as to conditions.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Daniels.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
