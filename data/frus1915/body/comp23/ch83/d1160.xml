    <text>
        <body>
            <div xml:id="d1160">

                <pb facs="0954" n="838" xml:id="pg838"/>

                <note rend="inline" type="source">File No. 312.11/6801a.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to certain American Consuls
                        </hi><anchor n="68" xml:id="d1160-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-10-09">
                            <hi rendition="#italic">October 9, 1915</hi></date>.</dateline>
                </opener>
                <p>Advise confidentially all Americans in your district to leave Sonora for border.
                    If you should be in personal danger after compliance with these instructions,
                    you are authorized to close your office and come to the United States.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1160-f1" n="68" type="source" xml:id="d1160-f1-content">
                <p>Sent to Nogales, Cananea, Hermosillo and Guaymas.</p>
            </note>
        </listAnnotation>
    </standOff>
