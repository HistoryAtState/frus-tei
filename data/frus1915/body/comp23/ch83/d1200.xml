    <text>
        <body>
            <div xml:id="d1200">

                <pb facs="0969" n="853" sameAs="frus:frus1915/pg853"/>

                <note rend="inline" type="source">File No. 312.11/6993.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of the Navy to the Secretary of
                        State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Navy Department</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-11-29">
                            <hi rendition="#italic">November 29, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to invite the particular
                    attention of your Department to the copy of message (M–3149) which has been
                    received from Admiral Winslow, relative to conditions in the Yaqui Valley, and
                    forwarded to your Department under separate cover.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Franklin D. Roosevelt.</hi>
                    </signed>
                </closer>
            </div>
        </body>
