            <div xml:id="d1192">

                <pb facs="0964" n="848" sameAs="frus:frus1915/pg848"/>

                <note rend="inline" type="source">File No. 312.11/7063.</note>
                <head>
                    <hi rendition="#italic">Consul Alger to the Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 698.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Mazatlan</hi></placeName>, <date
                            calendar="gregorian" when="1915-11-23">
                            <hi rendition="#italic">November 23, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose copies of
                    messages and replies to same regarding the sacking of Los Mochis, Sinaloa; the
                    fleeing of the American colony to Topolobampo; and the request for
                    protection.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. E. Alger.</hi>
                    </signed>
                </closer>








