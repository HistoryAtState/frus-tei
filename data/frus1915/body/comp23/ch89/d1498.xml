    <text>
        <body>
            <div xml:id="d1498">

                <pb facs="1126" n="1010" sameAs="frus:frus1915/pg1010"/>

                <note rend="inline" type="source">File No. 812.404/47.</note>
                <head>
                    <hi rendition="#italic">Vice Consul Bevan to the Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 1346.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Tampico</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-18">
                            <hi rendition="#italic">January 18, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>. I have the honor to acknowledge receipt of
                    the Department’s telegraphic instruction of January 14 [etc.]</p>
                <pb facs="1127" n="1011" xml:id="pg1011"/>
                <p>There were no outrages committed either against the priests or nuns in this
                    consular district during the year 1914. * * *</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Thos. H. Bevan.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
