    <text>
        <body>
            <div xml:id="d1607">

                <pb facs="1175" n="1059" sameAs="frus:frus1915/pg1059"/>

                <note rend="inline" type="source">File No. 812.48/2053.</note>
                <head>
                    <hi rendition="#italic">The Secretary of the Navy to
                        the Secretary of State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Navy Department</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-08">
                            <hi rendition="#italic">February 8, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith, for
                    your information, a copy of a report received from the Commander in Chief of the
                    Pacific Fleet.</p>
                <p>Very sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Josephus Daniels.</hi>
                    </signed>
                </closer>


                <xi:include href="d1607-a1.xml" xpointer="d1607-a1"/>
