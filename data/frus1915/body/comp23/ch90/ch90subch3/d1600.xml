    <text>
        <body>
            <div xml:id="d1600">

                <pb facs="1173" n="1057" xml:id="pg1057"/>

                <note rend="inline" type="source">File No. 812.00/14234.</note>
                <head>
                    <hi rendition="#italic">The Secretary of the Navy to the Secretary of
                    State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Navy Department</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-16">
                            <hi rendition="#italic">January 16, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith, for
                    your information, copies of telegrams received by this Department relative to
                    conditions in Mexico.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Josephus Daniels.</hi>
                    </signed>
                </closer>


                <xi:include href="d1600-a1.xml" xpointer="d1600-a1"/>
