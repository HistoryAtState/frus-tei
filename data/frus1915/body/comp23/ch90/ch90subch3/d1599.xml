    <text>
        <body>
            <div xml:id="d1599">

                <pb facs="1172" n="1056" sameAs="frus:frus1915/pg1056"/>

                <note rend="inline" type="source">File No. 312.51/103.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Vice Consul Stadden</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-09">
                            <hi rendition="#italic">January 9, 1915</hi></date>.</dateline>
                </opener>
                <p>At request French Ambassador use good offices to secure release steamer <hi
                        rendition="#italic">Korrigan II</hi> reported captured at Manzanillo said to
                    belong to French Boleo Company.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan.</hi>
                    </signed>
                </closer>
            </div>
        </body>
