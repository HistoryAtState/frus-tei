    <text>
        <body>
            <div xml:id="d1610">

                <pb facs="1176" n="1060" sameAs="frus:frus1915/pg1060"/>

                <note rend="inline" type="source">File No. 312.51/108.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Vice-Consul Blocker</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 285.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-18">
                            <hi rendition="#italic">February 18, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received your telegram
                    of January 31, 1915, reporting that you have refused to certify invoices of coal
                    entered for export to the United States by the Constitutionalist authorities for
                    the reason that the coal was taken from the Rio Escondido and Agujita coal
                    mines, owned by French and American citizens.</p>
                <p>Your action in the matter is approved by the Department.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Wilbur J. Carr.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
