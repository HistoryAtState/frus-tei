    <text>
        <body>
            <div xml:id="d1648">

                <pb facs="1190" n="1074" sameAs="frus:frus1915/pg1074"/>

                <note rend="inline" type="source">File No. 312.67/27.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico City</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-17">
                            <hi rendition="#italic">February 17, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to my cablegrams of February 13
                    and February 16, I now have the honor to submit to the Department
                        correspondence<anchor n="72" xml:id="d1648-f1"/>
                    <pb facs="1191" n="1075" xml:id="pg1075"/> referring to the request of the
                    Syrians here for American protection, and also regarding the execution of three
                    Syrians by General Obregon on February 13, 1915.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John R. Silliman.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
