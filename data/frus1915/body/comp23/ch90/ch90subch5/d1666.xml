            <div xml:id="d1666">

                <pb facs="1200" n="1084" sameAs="frus:frus1915/pg1084"/>

                <note rend="inline" type="source">File No. 312.67/57</note>
                <head>
                    <hi rendition="#italic">Special Agent Silliman
                        to the Secretary of State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Vera Cruz</hi></placeName>, <date
                            calendar="gregorian" when="1915-08-26">
                            <hi rendition="#italic">August 26, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    copy of my representation to the Foreign Office No. 278 of August 26, 1915, in
                    compliance with the Department’s instruction in its communication of July 23,
                    1915, regarding representation for Ottoman subjects in Mexico.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John R. Silliman.</hi>
                    </signed>
                </closer>


                <xi:include href="d1666-a1.xml" xpointer="d1666-a1"/>
            </div>
