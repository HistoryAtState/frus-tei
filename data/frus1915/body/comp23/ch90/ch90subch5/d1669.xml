            <div xml:id="d1669">

                <pb facs="1202" n="1086" xml:id="pg1086"/>

                <note rend="inline" type="source">File No. 312.67/58.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Mr. J. E. Touche</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-17">
                            <hi rendition="#italic">September 17, 1915</hi></date>.</dateline>
                </opener>
                <p>Carothers, El Paso, and Consul, Chihuahua, instructed render good offices your
                    behalf.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing.</hi>
                    </signed>
                </closer>
            </div>
        </body>
