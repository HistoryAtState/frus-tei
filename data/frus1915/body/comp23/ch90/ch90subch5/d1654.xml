    <text>
        <body>
            <div xml:id="d1654">

                <pb facs="1193" n="1077" sameAs="frus:frus1915/pg1077"/>

                <note rend="inline" type="source">File No. 704.6712/6a.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Chargé d’Affaires of Turkey</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-06">
                            <hi rendition="#italic">May 6, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: In compliance with your recent oral
                    request, I take pleasure in sending you enclosed a memorandum on the subject of
                    the protection by diplomatic and consular officers of the United States of the
                    interests of citizens or subjects of a third country at places where their own
                    government has no diplomatic or consular representatives.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing.</hi>
                    </signed>
                </closer>


                <xi:include href="d1654-a1.xml" xpointer="d1654-a1"/>
            </div>
        </body>
    </text>
