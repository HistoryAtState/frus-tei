                <pb facs="1147" n="1031" sameAs="frus:frus1915/pg1031"/>

                <note rend="inline" type="source">File No. 312.41/369.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Consul Letcher</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 350.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-06">
                            <hi rendition="#italic">April 6, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received your despatch
                    No. 601 of March 25, 1915, reporting that certain portions of the ranch
                    [etc.]</p>
                <p>You are instructed to inform Mr. Harvie that the matter should be taken up with
                    the British Vice Consul.</p>
                <p>If so requested, you may cooperate with the British representative to obtain
                    relief for Mrs. Benton.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Wilbur J. Carr.</hi>
                    </signed>
                </closer>
            </div>
        </body>
