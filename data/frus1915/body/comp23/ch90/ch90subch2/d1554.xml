    <text>
        <body>
            <div xml:id="d1554">

                <pb facs="1159" n="1043" sameAs="frus:frus1915/pg1043"/>

                <note rend="inline" type="source">File No. 312.52/629.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Consul Garrett</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-07-09">
                            <hi rendition="#italic">July 9, 1915</hi></date>.</dateline>
                </opener>
                <p>Your July 2. Unless requested by the Spanish Embassy in this city to take action
                    regarding the reported theft from José Pereda, the Department would not be
                    justified in taking such action.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>.</signed>
                </closer>
            </div>
        </body>
