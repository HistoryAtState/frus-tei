    <text>
        <body>
            <div xml:id="d1551">

                <pb facs="1158" n="1042" sameAs="frus:frus1915/pg1042"/>

                <note rend="inline" type="source">File No. 312.52/622.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to Consul Alger</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 290.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-06-29">
                            <hi rendition="#italic">June 29, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received your despatch
                    No. 617 of May 22, 1915, in regard to the protest made by you against the
                    expropriation of the water plant at Mazatlan.</p>
                <p>The Department approves the course pursued by you in this matter.</p>
                <p>I am [etc.]</p>
                <closer>For the Acting Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Wilbur J. Carr.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
