    <text>
        <body>
            <div xml:id="d1557">

                <pb facs="1160" n="1044" xml:id="pg1044"/>

                <note rend="inline" type="source">File No. 701.5212/52.</note>
                <head>
                    <hi rendition="#italic">Special Agent Carothers to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">El Paso</hi></placeName>, <date
                            calendar="gregorian" when="1915-08-11">
                            <hi rendition="#italic">August 11, 1915</hi></date>.</dateline>
                </opener>
                <p>Señor Zapico is here, having arrived on the 9th from Chihuahua.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Carothers.</hi>
                    </signed>
                </closer>
            </div>
        </body>
