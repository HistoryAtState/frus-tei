    <text>
        <body>
            <div xml:id="d1543">

                <pb facs="1155" n="1039" sameAs="frus:frus1915/pg1039"/>

                <note rend="inline" type="source">File No. 312.52/622.</note>
                <head>
                    <hi rendition="#italic">Consul Alger to the Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 617.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Mazatlan</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-22">
                            <hi rendition="#italic">May 22, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose translation of
                    a decree issued by the municipality of Mazatlan on May 19. I have made protest
                    against the carrying out of this decree, copy of the same enclosed, and submit
                    my action to the Department for approval or otherwise.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. E. Alger.</hi>
                    </signed>
                </closer>



                <xi:include href="d1543-a1.xml" xpointer="d1543-a1"/>
                <xi:include href="d1543-a2.xml" xpointer="d1543-a2"/>
