    <text>
        <body>
            <div xml:id="d1534">

                <pb facs="1151" n="1035" xml:id="pg1035"/>

                <note rend="inline" type="source">File No. 312.52/533.</note>
                <head>
                    <hi rendition="#italic">Consul Canada to the Secretary of State</hi>.<anchor
                        n="93" xml:id="d1534-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1128.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Vera Cruz</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-05">
                            <hi rendition="#italic">February 5, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to supplement my despatch
                    No. 1119 of January 28, 1915, relative to molestations to Spaniards and their
                    property, and to transmit enclosed herewith a second reply from the
                    Constitutionalist Foreign Office, quoting a statement of Governor of the State
                    of Vera Cruz in regard to the matter.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. W. Canada.</hi>
                    </signed>
                </closer>


                <xi:include href="d1534-a1.xml" xpointer="d1534-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1534-f1" n="93" type="source" xml:id="d1534-f1-content">
                <p>Communicated to the Spanish Ambassador March 4, 1915.</p>
            </note>
        </listAnnotation>
    </standOff>
