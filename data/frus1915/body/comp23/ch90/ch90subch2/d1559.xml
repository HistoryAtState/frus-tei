    <text>
        <body>
            <div xml:id="d1559">

                <pb facs="1160" n="1044" sameAs="frus:frus1915/pg1044"/>

                <note rend="inline" type="source">File No. 312.52/656.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Spanish Ambassador</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-08-19">
                            <hi rendition="#italic">August 19, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of your telegram of the 12th instant in which you ask [etc.]</p>
                <p>I have the honor to say in reply that the Department has communicated a copy of
                    your telegram to the Secretary of the Navy, and asked him to have the
                    instructions desired by you given by wire to the commanders of American vessels
                    in Mexican waters.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
