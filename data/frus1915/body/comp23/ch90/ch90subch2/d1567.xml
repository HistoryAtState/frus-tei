    <text>
        <body>
            <div xml:id="d1567">

                <pb facs="1162" n="1046" sameAs="frus:frus1915/pg1046"/>

                <note rend="inline" type="source">File No. 312.115/226.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Consul Alger</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-10-19">
                            <hi rendition="#italic">October 19, 1915</hi></date>.</dateline>
                </opener>
                <p>At request Spanish Embassy, ask General Diéguez to withdraw forced loan 100,000
                    pesos imposed on Bank of Mazatlan, majority of stock of which said to be owned
                    by Spaniards.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing.</hi>
                    </signed>
                </closer>
            </div>
        </body>
