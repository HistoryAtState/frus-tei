    <text>
        <body>
            <div xml:id="d1556">

                <pb facs="1159" n="1043" sameAs="frus:frus1915/pg1043"/>

                <note rend="inline" type="source">File No. 701.5212/52a.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to Special Agent
                        Carothers</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-08-10">
                            <hi rendition="#italic">August 10, 1915</hi></date>.</dateline>
                </opener>
                <p>Please telegraph for Spanish Ambassador any news you have of Señor Zapico,
                    confidential agent of Spain, of whom nothing has been heard for a month.<anchor
                        n="97" xml:id="d1556-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Osborne.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1556-f1" n="97" xml:id="d1556-f1-content">
                <p>See telegrams of May 20 and 21, <ref target="#pg1039">p. 1039</ref>.</p>
            </note>
        </listAnnotation>
