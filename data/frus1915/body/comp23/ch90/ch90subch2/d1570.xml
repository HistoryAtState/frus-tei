    <text>
        <body>
            <div xml:id="d1570">

                <pb facs="1163" n="1047" xml:id="pg1047"/>

                <note rend="inline" type="source">File No. 312.52/681.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Consul Bonney</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-10-23">
                            <hi rendition="#italic">October 23, 1915</hi></date>.</dateline>
                </opener>
                <p>Your October 8. Foreign Secretary of de facto government requests representations
                    regarding Spanish interests be made directly by accredited Spanish
                    representatives in Mexico.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing.</hi>
                    </signed>
                </closer>
            </div>
        </body>
