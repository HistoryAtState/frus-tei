    <text>
        <body>
            <div xml:id="d1674">

                <pb facs="1204" n="1088" xml:id="pg1088"/>

                <note rend="inline" type="source">File No. 312.93/82.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Special Agent Carothers</hi>.<anchor n="10"
                        xml:id="d1674-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-03">
                            <hi rendition="#italic">February 3, 1915</hi></date>.</dateline>
                </opener>
                <p>At request Chinese Minister ask Villa order authorities Mexicali repeal law
                    claimed to be unjust and discriminatory requiring Chinese residents pay monthly
                    tax two dollars.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1674-f1" n="10" type="source" xml:id="d1674-f1-content">
                <p>Similar telegram to the American consul at Ensenada.</p>
            </note>
        </listAnnotation>
    </standOff>
