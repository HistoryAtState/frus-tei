    <text>
        <body>
            <div xml:id="d1685">

                <pb facs="1208" n="1092" xml:id="pg1092"/>

                <note rend="inline" type="source">File No. 312.93/103.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Special Agent Silliman</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-20">
                            <hi rendition="#italic">April 20, 1915</hi></date>.</dateline>
                </opener>
                <p>At request Chinese Legation ask General Carranza to give instructions to
                    authorities Mazatlan to prevent threatened removal of Chinese retail merchants
                    there to separate suburb.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan.</hi>
                    </signed>
                </closer>
            </div>
        </body>
