    <text>
        <body>
            <div xml:id="d1675">

                <pb facs="1204" n="1088" sameAs="frus:frus1915/pg1088"/>

                <note rend="inline" type="source">File No. 812.00/14358.</note>
                <head>
                    <hi rendition="#italic">Collector Cobb to the Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram—Extract.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">El Paso</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-06">
                            <hi rendition="#italic">February 6, 1915</hi></date>.</dateline>
                </opener>
                <p>Following from Carothers, Irapuato: <quote rend="blockquote">
                        <p>General Villa has ordered authorities at Mexicali to abstain from
                            collecting the two dollars tax from Chinese subjects.</p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Cobb.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
