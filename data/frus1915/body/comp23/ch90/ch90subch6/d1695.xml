    <text>
        <body>
            <div xml:id="d1695">

                <pb facs="1211" n="1095" sameAs="frus:frus1915/pg1095"/>

                <note rend="inline" type="source">File No. 312.93/126.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Consular Agent
                    Taylor</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-08-03">
                            <hi rendition="#italic">August 3, 1915</hi></date>.</dateline>
                </opener>
                <p>At request Chinese Legation, you are instructed exercise good offices behalf
                    Chinese in vicinity Guaymas, cooperating with Navy.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing.</hi>
                    </signed>
                </closer>
            </div>
        </body>
