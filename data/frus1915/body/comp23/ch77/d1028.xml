    <text>
        <body>
            <div xml:id="d1028">

                <pb facs="0896" n="780" sameAs="frus:frus1915/pg780"/>

                <note rend="inline" type="source">File No. 812.113/3704a.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Secretary of the
                        Treasury</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-10-09">
                            <hi rendition="#italic">October 9, 1915</hi></date>.</dateline>
                </opener>
                <p>This Department requests that you instruct the Collectors of Customs at El Paso,
                    Texas, and other border ports to the west of that city, to detain, until the
                    receipt of further advices from this Department, all shipments of arms and
                    ammunition intended for use in Mexico.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing.</hi>
                    </signed>
                </closer>
            </div>
        </body>
