            <div xml:id="d1454">

                <pb facs="1109" n="993" sameAs="frus:frus1915/pg993"/>

                <note rend="inline" type="source">File No. 312.115/150.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-13">
                            <hi rendition="#italic">March 13, 1915</hi></date>.</dateline>
                </opener>
                <p>At request German Ambassador support protest German Consul, Guadalajara, against
                    imposition Jalisco State Government upon <pb facs="1110" n="994" xml:id="pg994"
                    /> German colony, including Guillermo Collignen &amp; Co., extraordinary tax
                    150,000 pesos.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan.</hi>
                    </signed>
                </closer>
            </div>
        </body>
