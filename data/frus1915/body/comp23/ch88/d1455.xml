            <div xml:id="d1455">

                <pb facs="1110" n="994" sameAs="frus:frus1915/pg994"/>

                <note rend="inline" type="source">File No. 312.115/153.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-15">
                            <hi rendition="#italic">March 15, 1915</hi></date>.</dateline>
                </opener>
                <p>At request German Ambassador ask Villa order suspension special tax imposed on
                    German colony Guadalajara default in payment of which Embassy states will result
                    in seizure beginning March 15.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan.</hi>
                    </signed>
                </closer>
            </div>
        </body>
