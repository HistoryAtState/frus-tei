    <text>
        <body>
            <div xml:id="d1430">

                <pb facs="1100" n="984" sameAs="frus:frus1915/pg984"/>

                <note rend="inline" type="source">File No. 312.115/115.</note>
                <head>
                    <hi rendition="#italic">Consul Bonney to the
                            Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">San Luis Potosí</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-16">
                            <hi rendition="#italic">February 16, 1915</hi></date>.</dateline>
                </opener>
                <p>Have secured exemption for the present at least from a forced loan attempted to
                    be levied against Americans by General Tomás Urbina in the aggregate
                    $130,000.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bonney.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
