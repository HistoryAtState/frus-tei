                <pb facs="1107" n="991" sameAs="frus:frus1915/pg991"/>

                <note rend="inline" type="source">File No. 312.115/142.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Vice Consul Davis</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-06">
                            <hi rendition="#italic">March 6, 1915</hi></date>.</dateline>
                </opener>
                <p>Protest against forced loan assessed against Singer Sewing Machine Company.
                    Consult company’s agent, R. N. Lane.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan.</hi>
                    </signed>
                </closer>
            </div>
        </body>
