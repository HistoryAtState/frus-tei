                <pb facs="0943" n="827" sameAs="frus:frus1915/pg827"/>

                <note rend="inline" type="source">File No. 812.001H87/10.</note>
                <head>
                    <hi rendition="#italic">Consul General Hurst to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate General</hi>, <lb/>
                            <hi rendition="#italic">Barcelona</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-08">
                            <hi rendition="#italic">April 8, 1915</hi></date>.</dateline>
                </opener>
                <p>Spanish line Company Transatlantic steamer <hi rendition="#italic">Antonio
                        Lopez</hi> due New York April 12 with General Huerta on board.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hurst.</hi>
                    </signed>
                </closer>
            </div>
        </body>
