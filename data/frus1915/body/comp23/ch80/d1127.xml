    <text>
        <body>
            <div xml:id="d1127">

                <pb facs="0941" n="825" sameAs="frus:frus1915/pg825"/>

                <note rend="inline" type="source">File No. 812.00/14616.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Governor of
                    Texas</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-18">
                            <hi rendition="#italic">March 18, 1915</hi></date>.</dateline>
                </opener>
                <p>General Ricaut, Nuevo Laredo, requests permission to transport over Texas
                    territory wounded soldiers to Matamoros. Please telegraph whether the State of
                    Texas agrees to their transportation over Texas soil from Nuevo Laredo.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan.</hi>
                    </signed>
                </closer>
            </div>
        </body>
