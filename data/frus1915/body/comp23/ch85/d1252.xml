                <pb facs="1003" n="887" sameAs="frus:frus1915/pg887"/>

                <note rend="inline" type="source">File No. 812.6363/176.</note>
                <head>
                    <hi rendition="#italic">Special Agent Silliman to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegrams.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Vera Cruz</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-10">
                            <hi rendition="#italic">March 10, 1915</hi></date>.</dateline>
                </opener>
                <p>Department’s March 9. Immediate order requested preventing threatened
                    destruction.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Silliman.</hi>
                    </signed>
                </closer>
            </div>
        </body>
