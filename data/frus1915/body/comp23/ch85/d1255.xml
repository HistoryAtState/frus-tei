            <div xml:id="d1255">

                <pb facs="1004" n="888" sameAs="frus:frus1915/pg888"/>

                <note rend="inline" type="source">File No. 812.512/576.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Vice Consul Bevan</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 786.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-26">
                            <hi rendition="#italic">March 26, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received your despatch
                    No. 1369 of March 6, 1915, transmitting a copy of a notice in regard to the
                    payments on the stamp tax for petroleum, [etc.].</p>
                <p>You are instructed to report the developments in this case.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Wilbur J. Carr.</hi>
                    </signed>
                </closer>
            </div>
        </body>
