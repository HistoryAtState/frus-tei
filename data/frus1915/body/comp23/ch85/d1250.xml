            <div xml:id="d1250">

                <pb facs="1003" n="887" sameAs="frus:frus1915/pg887"/>

                <note rend="inline" type="source">File No. 812.6363/178.</note>
                <head>
                    <hi rendition="#italic">Consul Canada to the Secretary of State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Vera Cruz</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-08">
                            <hi rendition="#italic">March 8, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge receipt of
                    the Department’s telegraphic instructions of January 13, 1915, protesting
                    against the application to Americans and other foreigners of the decree
                    suspending the operation of oil wells, and to transmit enclosed herewith the
                    reply of the Constitutionalist Foreign Office to my representations.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. W. Canada.</hi>
                    </signed>
                </closer>


                <xi:include href="d1250-a1.xml" xpointer="d1250-a1"/>
            </div>
        </body>
    </text>
