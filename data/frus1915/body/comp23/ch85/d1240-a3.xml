    <text>
        <body>
            <div xml:id="d1240-a3">

                <pb facs="0996" n="880" sameAs="frus:frus1915/pg880"/>

                <opener>
                    <seg rendition="#center">[Inclosure 3.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Vice Consul Bevan to
                        the Chief Inspector</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Tampico</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-08">
                            <hi rendition="#italic">February 8, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have received your esteemed note No. 53
                    dated the 6th instant and that literally says: [quoting Inclosure 1 above]. And
                    I am today taking the matter up with the Cortez Oil Corporation, sending them a
                    copy of your note. I thank you for your prompt answer [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Thomas H. Bevan.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
