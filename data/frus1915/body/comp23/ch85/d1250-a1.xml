    <text>
        <body>
            <div xml:id="d1250-a1">

                <pb facs="1003" n="887" sameAs="frus:frus1915/pg887"/>

                <opener>
                    <seg rendition="#center">[Inclosure—Translation.]</seg>
                </opener>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of Foreign Relations</hi>, <lb/>
                            <hi rendition="#italic">Vera Cruz</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-14">
                            <hi rendition="#italic">January 14, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Consul</hi>: Answering your note of yesterday’s
                    date, in which in the name of your Government you formulate a protest with
                    regard to the suspension of work on oil wells, I inform you that due note has
                    been taken of your protest.</p>
                <p>Please accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">M. Dávalos</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
