            <div xml:id="d1242">

                <pb facs="0997" n="881" sameAs="frus:frus1915/pg881"/>

                <note rend="inline" type="source">File No. 812.6363/171.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Vice Consul Bevan</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 720.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-18">
                            <hi rendition="#italic">February 18, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received your despatch
                    No. 1355 of February 7, 1915, enclosing [etc.]</p>
                <p>If the American companies concerned desire the Department to protest against the
                    application to them of the provisions of the decree referred to, they should so
                    inform the Department.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Wilbur J. Carr.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
