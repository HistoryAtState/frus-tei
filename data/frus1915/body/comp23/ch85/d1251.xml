                <pb facs="1003" n="887" sameAs="frus:frus1915/pg887"/>

                <note rend="inline" type="source">File No. 812.6363/174.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Special Agent Silliman</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-09">
                            <hi rendition="#italic">March 9, 1915</hi></date>.</dateline>
                </opener>
                <p>See Canada’s March 6. Make vigorous protest against threatened destruction.
                    Request appropriate immediate orders.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan.</hi>
                    </signed>
                </closer>
            </div>
        </body>
