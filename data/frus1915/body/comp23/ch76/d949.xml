            <div xml:id="d949">

                <pb facs="0843" n="727" sameAs="frus:frus1915/pg727"/>

                <note rend="inline" type="source">File No. 812.00/15519a.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Brazilian Minister to
                        Mexico</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-07-20T18:00:00-05:00">
                            <hi rendition="#italic">July 20, 1915—6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>827. Should Conventionistas or Villistas secure control Mexico City you may, in
                    your discretion, communicate to them Department’s 808, July 8, 1 p.m.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing.</hi>
                    </signed>
                </closer>
            </div>
        </body>
