                <pb facs="0782" n="666" sameAs="frus:frus1915/pg666"/>

                <note rend="inline" type="source">File No. 812.00/14550.</note>
                <head>
                    <hi rendition="#italic">Special Agent Silliman to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Vera Cruz</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-10">
                            <hi rendition="#italic">March 10, 1915</hi></date>.</dateline>
                </opener>
                <p>The following communication in Spanish and English addressed to the President of
                    the United States was received last night through the Secretary of Foreign
                    Relations.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Silliman.</hi>
                    </signed>
                </closer>


                <xi:include href="d840-a1.xml" xpointer="d840-a1"/>
