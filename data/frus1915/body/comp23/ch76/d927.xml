            <div xml:id="d927">

                <pb facs="0833" n="717" sameAs="frus:frus1915/pg717"/>

                <note rend="inline" type="source">File No. 812.00/15306.</note>
                <head>
                    <hi rendition="#italic">Special Agent Carothers to the Secretary of State ad
                        interim</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">El Paso</hi></placeName>, <date
                            calendar="gregorian" when="1915-06-19">
                            <hi rendition="#italic">June 19, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose a
                    communication received from Lic. Miguel Diaz Lombardo, in charge of the Office
                    of Foreign Relations for the Conventionist Government, in which he requests me
                    to notify you of the appointment of Lic. Francisco Lagos Cházaro as President of
                    the Convention.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">G. C. Carothers.</hi>
                    </signed>
                </closer>



                <xi:include href="d927-a1.xml" xpointer="d927-a1"/>
            </div>
        </body>
    </text>
