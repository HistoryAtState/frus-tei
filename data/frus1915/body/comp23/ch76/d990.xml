    <text>
        <body>
            <div xml:id="d990">

                <pb facs="0879" n="763" sameAs="frus:frus1915/pg763"/>

                <note rend="inline" type="source">File No. 812.00/16593.</note>
                <head>
                    <hi rendition="#italic">The Ambassador of Chile to
                        the Secretary of State</hi>.<anchor n="46"
                        xml:id="d990-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Translation.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Embassy of Chile</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-10-06">
                            <hi rendition="#italic">October 6, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My dear Mr. Secretary</hi>: I have not the least
                    objection to attending the meeting to which your excellency invites me in your
                    letter of yesterday, for the purpose of discussing the affairs of Mexico, on
                    Saturday the 9th of October at 2.30 p.m.</p>
                <p>Cordially yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Ed’o Suárez Mujica.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d990-f1" n="46" type="source" xml:id="d990-f1-content">
                <p>Similar acceptances from the other conferees.</p>
            </note>
        </listAnnotation>
