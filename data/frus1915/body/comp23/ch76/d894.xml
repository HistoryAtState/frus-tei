    <text>
        <body>
            <div xml:id="d894">

                <pb facs="0814" n="698" sameAs="frus:frus1915/pg698"/>

                <note rend="inline" type="source">File No. 812.00/15194.</note>
                <head>
                    <hi rendition="#italic">Consul Schmutz to the Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Aguascalientes</hi></placeName>, <date
                            calendar="gregorian" when="1915-06-05">
                            <hi rendition="#italic">June 5, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt of the President’s messages to the leaders of the several armed factions
                    in Mexico. * * * Up to this moment the local paper has limited itself to
                    publishing a translation of the message without comment.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gaston Schmutz.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
