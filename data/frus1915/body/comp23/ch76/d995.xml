    <text>
        <body>
            <div xml:id="d995">

                <pb facs="0883" n="767" sameAs="frus:frus1915/pg767"/>

                <note rend="inline" type="source">File No. 812.00/16597.</note>
                <head>
                    <hi rendition="#italic">The Minister of Bolivia to the Secretary of
                    State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Legation of Bolivia</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-10-13">
                            <hi rendition="#italic">October 13, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My dear Mr. Secretary</hi>: I am pleased to advise
                    you that I am authorized by my Government to recognize Carranza, and am ready to
                    act in the matter as soon as will decide [sic].</p>
                <p>I remain [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Y. Calderón.</hi>
                    </signed>
                </closer>
            </div>
        </body>
