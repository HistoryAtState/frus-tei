                <pb facs="0862" n="746" sameAs="frus:frus1915/pg746"/>

                <note rend="inline" type="source">File No. 812.00/16037.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Mr.
                            Parker, representing American interests
                        in Mexico</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-09T16:00:00-05:00">
                            <hi rendition="#italic">September 9, 1915—4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>45. Your 50, September 4. Department is again making representations to Carranza
                    behalf suffering poor in Mexico City.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing.</hi>
                    </signed>
                </closer>
            </div>
