    <text>
        <body>
            <div xml:id="d955">

                <pb facs="0846" n="730" sameAs="frus:frus1915/pg730"/>

                <note rend="inline" type="source">File No. 812.00/17547a.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Ambassador of Brazil.</hi><anchor n="31"
                        xml:id="d955-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-07-29">
                            <hi rendition="#italic">July 29, 1915</hi></date>.</dateline>
                </opener>
                <p>Can you meet here for informal conference with other diplomatic representatives
                    in accordance with our recent conversations, on August 5 at 2.30 in the
                    afternoon?</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d955-f1" n="31" type="source" xml:id="d955-f1-content">
                <p>Similar communications were made to the Ambassadors of Argentina and Chile and
                    the Ministers of Bolivia, Guatemala, and Uruguay. See the Guatemalan Minister’s
                    letter of July 10 and the accompanying notes.</p>
            </note>
        </listAnnotation>
    </standOff>
