    <text>
        <body>
            <div xml:id="d834">

                <pb facs="0777" n="661" sameAs="frus:frus1915/pg661"/>

                <note rend="inline" type="source">File No. 812.00/14501.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Ambassador of Spain.</hi><anchor n="9"
                        xml:id="d834-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-06">
                            <hi rendition="#italic">March 6, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Ambassador</hi>: I desire to call to
                    your attention that in view of the peril to Americans in Mexico City the
                    Department is tonight telegraphing to Mexico City and Vera Cruz messages for
                    delivery to General Carranza and General Obregon to the effect that this
                    Government will hold them personally responsible for their conduct.</p>
                <p>Sincerely yours,</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d834-f1" n="9" type="source" xml:id="d834-f1-content">
                <p>The same to the Ambassadors of Brazil, Germany and Great Britain.</p>
            </note>
        </listAnnotation>
    </standOff>
