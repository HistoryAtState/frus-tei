    <text>
        <body>
            <div xml:id="d908">

                <pb facs="0824" n="708" sameAs="frus:frus1915/pg708"/>

                <note rend="inline" type="source">File No. 812.00/15312.</note>
                <head>
                    <hi rendition="#italic">Consul Bonney to the
                            Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">San Luis Potosi</hi></placeName>, <date
                            calendar="gregorian" when="1915-06-13">
                            <hi rendition="#italic">June 13, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to report that the note
                    addressed by President Wilson to leaders of factions in Mexico, as published,
                    was well received by all classes, and in this district is regarded as an
                    exceedingly fortunate expression.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilbert L. Bonney.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
