    <text>
        <body>
            <div xml:id="d984">

                <pb facs="0867" n="751" xml:id="pg751"/>

                <note rend="inline" type="source">File No. 812.00/16163.</note>
                <head>
                    <hi rendition="#italic">The Ambassador of Brazil to
                        the Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Long Branch, N. J.</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-13">
                            <hi rendition="#italic">September 13, 1915</hi></date>.</dateline>
                </opener>
                <p>Regret that owing to inflammation in eyes cannot make trip to Washington and beg
                    to be excused.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gama.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
