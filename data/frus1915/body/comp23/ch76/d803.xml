    <text>
        <body>
            <div xml:id="d803">

                <pb facs="0764" n="648" xml:id="pg648"/>

                <note rend="inline" type="source">File No. 812.00/14252a.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Brazilian Minister to Mexico</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-21">
                            <hi rendition="#italic">January 21, 1915</hi></date>.</dateline>
                </opener>
                <p>417. Please refer to my number 360, December 16,<anchor n="3" xml:id="d803-f1"/>
                    and present the same instructions, therein conveyed, to Provisional President
                    Garza.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
