    <text>
        <body>
            <div xml:id="d804">

                <pb facs="0764" n="648" sameAs="frus:frus1915/pg648"/>

                <note rend="inline" type="source">File No. 812.00/14273.</note>
                <head>
                    <hi rendition="#italic">Vice Consul Silliman to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegrams—Extracts.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico City</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-22">
                            <hi rendition="#italic">January 22, 1915</hi></date>.</dateline>
                </opener>
                <p>The Convention has approved the plan of government<anchor n="4" xml:id="d804-f1"
                    /> as far as Article 7. Cabinet ministers have been made individually and
                    collectively responsible to the Convention for their conduct.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Silliman.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d804-f1" n="4" xml:id="d804-f1-content">
                <p>Quoted in his January 14, 4 p.m.</p>
            </note>
        </listAnnotation>
