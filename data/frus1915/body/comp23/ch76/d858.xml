            <div xml:id="d858">

                <pb facs="0792" n="676" sameAs="frus:frus1915/pg676"/>

                <note rend="inline" type="source">File No. 812.00/15106.</note>
                <head>
                    <hi rendition="#italic">The Special Envoy from President Gutierrez to the
                        Secretary of State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-24">
                            <hi rendition="#italic">March 24, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: My note to your excellency expressing my
                    mission to the United States as the Envoy of President Gutierrez of Mexico, will
                    be handed to you personally by the General Counsel of the Mexican Government in
                    the United States, Joseph R. Wilson Esq., of Philadelphia, who will give your
                    excellency any further information that you may desire in connection with said
                    note.</p>
                <p>With high esteem [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">José Vasconcelos.</hi>
                    </signed>
                </closer>



                <xi:include href="d858-a1.xml" xpointer="d858-a1"/>
