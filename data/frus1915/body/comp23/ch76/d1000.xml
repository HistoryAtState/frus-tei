    <text>
        <body>
            <div xml:id="d1000">

                <pb facs="0886" n="770" xml:id="pg770"/>

                <note rend="inline" type="source">File No. 812.00/17556a.</note>
                <head>
                    <hi rendition="#italic">Secretary Crane to the Ambassador of
                        Argentina.</hi><anchor n="48" xml:id="d1000-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-10-18">
                            <hi rendition="#italic">October 18, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My dear Mr. Ambassador</hi>: Confirming my telephone
                    conversation of Saturday, I have the honor to inform you that a meeting of the
                    Conferees on the Mexican situation has been called by the Secretary of State to
                    assemble at the Department this afternoon at three o’clock.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Richard Crane</hi>. <lb/>
                        <hi rendition="#italic">Private Secretary.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1000-f1" n="48" type="source" xml:id="d1000-f1-content">
                <p>The same to the other conferees.</p>
            </note>
        </listAnnotation>
    </standOff>
