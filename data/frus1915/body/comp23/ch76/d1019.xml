    <text>
        <body>
            <div xml:id="d1019">

                <pb facs="0893" n="777" sameAs="frus:frus1915/pg777"/>

                <note rend="inline" type="source">File No. 812.00/16964.</note>
                <head>
                    <hi rendition="#italic">Consul Edwards to the
                            Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">El Paso</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-17">
                            <hi rendition="#italic">December 17, 1915</hi></date>.</dateline>
                </opener>
                <p>The following communication was handed this Consul by Governor Fidel Avila,
                    Military Governor of the State of Chihuahua, who had just returned from the
                    State capital where he left General Villa, with the request that it be laid
                    before the President. This office holds the original, of which this is a true
                    copy, said original being signed in my presence by Fidel Avila.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Edwards.</hi>
                    </signed>
                </closer>


                <xi:include href="d1019-a1.xml" xpointer="d1019-a1"/>
            </div>
