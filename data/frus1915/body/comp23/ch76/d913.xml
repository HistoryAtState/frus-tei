            <div xml:id="d913">

                <pb facs="0827" n="711" sameAs="frus:frus1915/pg711"/>

                <note rend="inline" type="source">File No. 812.00/15294.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State ad interim to the Brazilian
                        Minister to Mexico</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-06-15T15:00:00-05:00">
                            <hi rendition="#italic">June 15, 1915—3 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>777. Please deliver the following message to President Lagos Cházaro, and a copy
                    to Gonzalez Garza.</p>
                <p>[Quotes message from Villa transmitted in Mr. Carothers’ June 11, noon.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing.</hi>
                    </signed>
                </closer>
            </div>
        </body>
