    <text>
        <body>
            <div xml:id="d956">

                <pb facs="0846" n="730" sameAs="frus:frus1915/pg730"/>

                <note rend="inline" type="source">File No. 812.00/17548.</note>
                <head>
                    <hi rendition="#italic">The Ambassador of Brazil to the Secretary of
                        State.</hi><anchor n="32" xml:id="d956-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Long Branch, N. J.</hi></placeName>, <date
                            calendar="gregorian" when="1915-07-29">
                            <hi rendition="#italic">July 29, 1915</hi></date>.</dateline>
                </opener>
                <p>Will be present August 5 at 3 o’clock. Am cabling again to Rio.<anchor n="33"
                        xml:id="d956-f2"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gama.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d956-f1" n="32" type="source" xml:id="d956-f1-content">
                <p>Similar acceptances received from the other diplomatic representatives.</p>
            </note>
            <note corresp="#d956-f2" n="33" xml:id="d956-f2-content">
                <p>Refers to the Secretary’s message to him dated July 26.</p>
            </note>
        </listAnnotation>
    </standOff>
