    <text>
        <body>
            <div xml:id="d985">

                <pb facs="0867" n="751" sameAs="frus:frus1915/pg751"/>

                <note rend="inline" type="source">File No. 812.00/16163.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Ambassador of Brazil</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-14">
                            <hi rendition="#italic">September 14, 1915</hi></date>.</dateline>
                </opener>
                <p>In accordance with the suggestion of Ambassador Suárez, conference has been
                    postponed until September 18 at two p.m. at Hotel Biltmore, New York City.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing.</hi>
                    </signed>
                </closer>
            </div>
        </body>
