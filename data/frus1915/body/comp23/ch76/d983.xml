    <text>
        <body>
            <div xml:id="d983">

                <pb facs="0866" n="750" sameAs="frus:frus1915/pg750"/>

                <note rend="inline" type="source">File No. 812.00/17552a.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister of
                        Guatemala</hi>.<anchor n="43" xml:id="d983-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-13">
                            <hi rendition="#italic">September 13, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Minister</hi>: I have arranged for a
                    meeting of the Conferees on the Mexican situation, to be held in my office on
                    September 15 at three o’clock. If you cannot arrange to be present, please be
                    good enough to let me know in advance.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d983-f1" n="43" type="source" xml:id="d983-f1-content">
                <p>Similar communications to the other conferees.</p>
            </note>
        </listAnnotation>
