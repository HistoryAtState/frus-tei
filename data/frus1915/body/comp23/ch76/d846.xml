    <text>
        <body>
            <div xml:id="d846">

                <pb facs="0786" n="670" sameAs="frus:frus1915/pg670"/>

                <note rend="inline" type="source">File No. 812.00/14552.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Spanish Ambassador.</hi><anchor n="15"
                        xml:id="d846-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-11">
                            <hi rendition="#italic">March 11, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My dear Mr. Ambassador</hi>: I enclose herewith, for
                    your information, a copy of a telegram<anchor n="16" xml:id="d846-f2"/> from Mr.
                    John R. Silliman, the Department’s special representative at Vera Cruz, Mexico,
                    in regard to an intimation given by General Venustiano Carranza that he does not
                    understand the Department’s position in making representations in behalf of
                    other nationals who have their own representatives at Vera Cruz.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d846-f1" n="15" type="source" xml:id="d846-f1-content">
                <p>The same to the Ambassadors of Russia, France, Germany and Great Britain.</p>
            </note>
            <note corresp="#d846-f2" n="16" xml:id="d846-f2-content">
                <p>Of March 10, 4 p.m.</p>
            </note>
        </listAnnotation>
    </standOff>
