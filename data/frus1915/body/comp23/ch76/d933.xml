    <text>
        <body>
            <div xml:id="d933">

                <pb facs="0836" n="720" xml:id="pg720"/>

                <note rend="inline" type="source">File No. 812.00/15873.</note>
                <head>
                    <hi rendition="#italic">Special Agent Silliman to the Secretary of
                    State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Vera Cruz</hi></placeName>, <date
                            calendar="gregorian" when="1915-06-30">
                            <hi rendition="#italic">June 30, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to Department’s instruction to
                    make representation for American interests in various parts of the country, and
                    to the special representations made lately in regard to the depreciations
                    committed on American properties in this State, I have the honor to enclose
                    herewith a reply just received from the Foreign Office which I think well to
                    transmit immediately.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. R. Silliman.</hi>
                    </signed>
                </closer>


                <xi:include href="d933-a1.xml" xpointer="d933-a1"/>
            </div>
        </body>
    </text>
