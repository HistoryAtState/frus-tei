    <text>
        <body>
            <div xml:id="d886">

                <pb facs="0808" n="692" sameAs="frus:frus1915/pg692"/>

                <note rend="inline" type="source">File No. 812.00/15103.</note>
                <head>
                    <hi rendition="#italic">The Confidential Agent of the Provisional Government of
                        Mexico to the Secretary of State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-29">
                            <hi rendition="#italic">May 29, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: By instructions of Mr. Diaz
                    Lombardo, I have the honor to transmit herewith copy of decree of the
                    Provisional Government, No. 7, dated May 7, 1915, relating to the alienation of
                    real and personal property of certain persons concerned in the coup d’état of
                    February, 1913, and more lately in the fomentation of rebellion against the
                    authority of said Government.</p>
                <p>Please accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Enrique C. Llorente.</hi>
                    </signed>
                </closer>


                <xi:include href="d886-a1.xml" xpointer="d886-a1"/>
            </div>
        </body>
    </text>
