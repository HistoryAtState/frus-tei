    <text>
        <body>
            <div xml:id="d800">

                <pb facs="0761" n="645" sameAs="frus:frus1915/pg645"/>

                <note rend="inline" type="source">File No. 812.00/14322.</note>
                <head>
                    <hi rendition="#italic">The</hi><hi rendition="#italic"> Confidential Agent of
                        the Provisional</hi> [<hi rendition="#italic">Conventionist</hi>] <hi
                        rendition="#italic">Government</hi><hi rendition="#italic"> to the Secretary
                        of State</hi>.</head>
                <p rendition="#center">
                    <hi rendition="#small-caps">memorandum.</hi>
                </p>
                <p>Enrique C. Llorente, Confidential Agent of the Provisional Government of Mexico,
                    presents his respectful compliments to the Honorable <pb facs="0762" n="646"
                        xml:id="pg646"/> William Jennings Bryan, Secretary of State of the United
                    States, and by instruction of his Government, has the honor to transmit,
                    herewith, copy of a telegram received this afternoon from the President of the
                    Sovereign Convention of Mexico, Roque Ganzalez Garza, charged by the Convention
                    with the Executive Power of the Nation, following the removal of ex-President
                    Gutierrez, relative to the situation in Mexico.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <hi rendition="#small-caps">Confidential Agency of the Provisional</hi>
                        <lb/>
                        <hi rendition="#small-caps">Government of Mexico</hi>, <lb/>
                        <placeName>
                            <hi rendition="#italic">Washington, D. C.</hi>
                        </placeName>, <date calendar="gregorian" when="1915-01-20"><hi
                                rendition="#italic">January 20, 1915</hi></date>.</dateline>
                </closer>


                <xi:include href="d800-a1.xml" xpointer="d800-a1"/>
            </div>
