                <pb facs="0828" n="712" sameAs="frus:frus1915/pg712"/>

                <note rend="inline" type="source">File No. 812.00/15251.</note>
                <head>
                    <hi rendition="#italic">The Brazilian Minister to Mexico to the Secretary of
                        State ad interim</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram—Translation.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Brazilian Legation</hi>, <lb/>
                            <hi rendition="#italic">Mexico City</hi></placeName>, <date
                            calendar="gregorian" when="1915-06-16T11:00:00-06:36">
                            <hi rendition="#italic">June 16, 1915—11 a.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>643. I beg to transmit following note delivered to me yesterday night.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Cardoso de Oliveira</hi>.</signed>
                </closer>


                <xi:include href="d917-a1.xml" xpointer="d917-a1"/>
