    <text>
        <body>
            <div xml:id="d964">

                <pb facs="0850" n="734" xml:id="pg734"/>

                <note rend="inline" type="source">File No. 812.00/15794b</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister of
                        Guatemala.</hi><anchor n="33" xml:id="d964-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-08-09">
                            <hi rendition="#italic">August 9, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Minister</hi>: In accordance with the
                    understanding reached at the last session of the Conference on Mexican Affairs,
                    I call the Conference to reassemble Wednesday afternoon, August 11, at 2 o’clock
                    at the Hotel Biltmore, New York City. I would be obliged if you would let me
                    know that you will be present at the meeting.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d964-f1" n="33" type="source" xml:id="d964-f1-content">
                <p>The same to the other conferees.</p>
            </note>
        </listAnnotation>
    </standOff>
