            <div xml:id="d1320">

                <pb facs="1046" n="930" sameAs="frus:frus1915/pg930"/>

                <note rend="inline" type="source">File No. 812.512/735.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to Consul General
                        Hanna</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 481.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-07-30">
                            <hi rendition="#italic">July 30, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received your despatch
                    No. 548 of July 13, 1915, referring [etc.]</p>
                <p>The Department encloses for your information a copy of its instruction [of July
                    23] in the matter to Mr. John R. Silliman, American Consul, who is now at Vera
                    Cruz.</p>
                <p>The Department quotes for your information the following telegram dated July 27,
                    from Mr. Silliman: [See ante.]</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Alvey A. Adee.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
