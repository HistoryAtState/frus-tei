        <body>
            <div xml:id="d1338">

                <pb facs="1052" n="936" sameAs="frus:frus1915/pg936"/>

                <note rend="inline" type="source">File No. 812.512/789.</note>
                <head>
                    <hi rendition="#italic">Special Agent Silliman to the Secretary of
                    State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Vera Cruz</hi></placeName>, <date
                            calendar="gregorian" when="1915-08-13">
                            <hi rendition="#italic">August 13, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to the Department’s unnumbered
                    instruction of May 18, 1915, regarding mining decree, I have the honor to
                    enclose herewith copy of my representation to the Foreign Office, and replies
                    thereto.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John R. Silliman.</hi>
                    </signed>
                </closer>




