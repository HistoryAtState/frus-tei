                <pb facs="1037" n="921" sameAs="frus:frus1915/pg921"/>

                <note rend="inline" type="source">File No. 812.63/125.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to A. J. McQuatters</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-06-29">
                            <hi rendition="#italic">June 29, 1915</hi></date>.</dateline>
                </opener>
                <p>Department telegraphing Carothers for immediate report on result his efforts for
                    repeal mining decree.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John E. Osborne.</hi>
                    </signed>
                </closer>
            </div>
        </body>
