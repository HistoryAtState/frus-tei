            <div xml:id="d1384">

                <pb facs="1079" n="963" sameAs="frus:frus1915/pg963"/>

                <note rend="inline" type="source">File No. 812.512/952.</note>
                <head>
                    <hi rendition="#italic">Special Agent Silliman
                        to the Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Saltillo</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-29">
                            <hi rendition="#italic">December 29, 1915</hi></date>.</dateline>
                </opener>
                <p>In compliance with Department’s December 28, will leave tomorrow to deliver
                    Department’s message to General Carranza.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Silliman.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
