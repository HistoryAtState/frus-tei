    <text>
        <body>
            <div xml:id="d1372">

                <pb facs="1070" n="954" sameAs="frus:frus1915/pg954"/>

                <note rend="inline" type="source">File No. 812.63/153.</note>
                <head>
                    <hi rendition="#italic">Special Agent Carothers to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegrams.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">El Paso</hi></placeName>, <date
                            calendar="gregorian" when="1915-11-23">
                            <hi rendition="#italic">November 23, 1915</hi></date>.</dateline>
                </opener>
                <p>Following received from Douglas today: <quote rend="blockquote">
                        <p>Obregon yesterday advised mining companies to resume work in Sonora,
                            guaranteeing safety of themselves and their properties.</p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Carothers.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
