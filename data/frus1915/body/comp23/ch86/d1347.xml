                <pb facs="1058" n="942" sameAs="frus:frus1915/pg942"/>

                <note rend="inline" type="source">File No. 812.512/784.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Acting Consul General Robertson</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-04">
                            <hi rendition="#italic">September 4, 1915</hi></date>.</dateline>
                </opener>
                <p>Silliman telegraphs September 1 as follows in reply Department’s telegram August
                    31 communicating your August 28:</p>
                <p>[Quotes Mr. Silliman’s telegram of September 1.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing.</hi>
                    </signed>
                </closer>
            </div>
