    <text>
        <body>
            <div xml:id="d1348">

                <pb facs="1058" n="942" sameAs="frus:frus1915/pg942"/>

                <note rend="inline" type="source">File No. 812.512/786.</note>
                <head>
                    <hi rendition="#italic">Acting Consul General Roberston to the Secretary of
                        State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate General</hi>, <lb/>
                            <hi rendition="#italic">Monterey</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-05">
                            <hi rendition="#italic">September 5, 1915</hi></date>.</dateline>
                </opener>
                <p>Your September 4, 1915. Understand four-month period payments specified in new
                    decree are the rate per annum and are payable in Constitutionalist currency. Is
                    this correct?</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robertson.</hi>
                    </signed>
                </closer>
            </div>
        </body>
