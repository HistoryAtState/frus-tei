    <text>
        <body>
            <div xml:id="d1293">

                <pb facs="1034" n="918" sameAs="frus:frus1915/pg918"/>

                <note rend="inline" type="source">File No. 812.63/105.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Special Agent
                    Silliman</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-06-02">
                            <hi rendition="#italic">June 2, 1915</hi></date>.</dateline>
                </opener>
                <p>Consul, Mazatlan, requests information about reported decree issued Vera Cruz
                    prohibiting exportation mine products. Investigate. Report.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
