    <text>
        <body>
            <div xml:id="d1350">

                <pb facs="1059" n="943" sameAs="frus:frus1915/pg943"/>

                <note rend="inline" type="source">File No. 812.512/786.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Special Agent Silliman</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-09">
                            <hi rendition="#italic">September 9, 1915</hi></date>.</dateline>
                </opener>
                <p>Your September 1. Robertson, Monterey, telegraphs: <quote rend="blockquote">
                        <p>Understand four months period payments specified in new decree are the
                            rate per annum and are payable in constitutionalist currency. Is this
                            correct?</p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
