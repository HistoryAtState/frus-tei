    <text>
        <body>
            <div xml:id="d1288">

                <pb facs="1032" n="916" sameAs="frus:frus1915/pg916"/>

                <note rend="inline" type="source">File No. 812.63/100.</note>
                <head>
                    <hi rendition="#italic"> Inde Gold Mining Company to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">New York</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-20">
                            <hi rendition="#italic">May 20, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: For your information I am enclosing
                    herewith translation of a decree issued by General Tomas Urbina R. on April 14,
                    1915.</p>
                <p>Respectfully,</p>
                <closer>
                    <hi rendition="#small-caps">Inde Gold Mining Company</hi>, <lb/> By <signed>
                        <hi rendition="#small-caps">W. Rowland Cox</hi>
                    </signed>
                </closer>



                <xi:include href="d1288-a1.xml" xpointer="d1288-a1"/>
            </div>
