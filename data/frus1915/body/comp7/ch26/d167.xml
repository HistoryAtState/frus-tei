    <text>
        <body>
            <div xml:id="d167">

                <pb facs="0330" n="214" sameAs="frus:frus1915/pg214"/>

                <note rend="inline" type="source">File No. 893.811/198.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Minister Reinsch.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-11-06">
                            <hi rendition="#italic">November 6, 1915</hi></date>.</dateline>
                </opener>
                <p>Your telegram October 25. Red Cross reports matter having careful attention.
                    Bankers will hold conference on subject Monday in New York. Carey due in
                    Shanghai today.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing.</hi>
                    </signed>
                </closer>
            </div>
        </body>
