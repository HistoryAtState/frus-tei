                <note rend="inline" type="source">File No. 893.811/201.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Reinsch.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegrams.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-18">
                            <hi rendition="#italic">December 18, 1915</hi></date>.</dateline>
                </opener>
                <p>Your telegram of December 17. American International Corporation considering and
                    will reply in few days.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing.</hi>
                    </signed>
                </closer>
            </div>
