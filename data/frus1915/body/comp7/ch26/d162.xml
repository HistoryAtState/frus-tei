                <pb facs="0329" n="213" sameAs="frus:frus1915/pg213"/>

                <note rend="inline" type="source">File No. 893.811/180.</note>
                <head>
                    <hi rendition="#italic">The Central Committee of the American
                            Red Cross to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">National Headquarters</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-20">
                            <hi rendition="#italic">January 20, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The American Red Cross would be very glad
                    if the American Minister at Peking could be asked by telegraph to urge the
                    extension of the option for placing a loan for the Chinese River Conservancy
                    which will expire on the 31st instant.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Geo. W. Davis</hi>, <lb/>
                        <hi rendition="#italic">Chairman.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
