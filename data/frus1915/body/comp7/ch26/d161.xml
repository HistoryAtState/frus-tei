    <text>
        <body>
            <div xml:id="d161">

                <pb facs="0329" n="213" xml:id="pg213"/>

                <note rend="inline" type="source">File No. 893.811/175.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Reinsch.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 233.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-11">
                            <hi rendition="#italic">January 11, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: In further reply to your despatch No. 424
                    of October 28, 1914, relating to the need of an advance of $5,000,000 on the
                    proposed Huai River loan, I send you herewith copy of a letter dated January 6,
                    1915, from the American Red Cross to the Department of State on these
                    matters.</p>
                <p>The Department has today telegraphed you in the sense suggested by the Red
                    Cross.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
