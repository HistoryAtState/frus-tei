    <text>
        <body>
            <div xml:id="d172">

                <pb facs="0332" n="216" sameAs="frus:frus1915/pg216"/>

                <note rend="inline" type="source">File No. 893.811/202.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            American Red Cross.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-31">
                            <hi rendition="#italic">December 31, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Gentlemen</hi>: I have to enclose herewith for your
                    information paraphrase of a telegram of December 30, 1915, from the American
                    Minister at Peking, relative to the proposed Huai River Conservancy loan.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Alvey A. Adee.</hi>
                    </signed>
                </closer>
            </div>
        </body>
