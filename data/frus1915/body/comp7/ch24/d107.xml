            <div xml:id="d107">

                <pb facs="0229" n="113" xml:id="pg113"/>

                <note rend="inline" type="source">File No. 793.94/251.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Ambassador Guthrie.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-17T17:00:00-05:00">
                            <hi rendition="#italic">March 17, 1915—5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your telegram of March 17, 1 p.m. Our note was not presented at the request or
                    suggestion of China or any other Power.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan.</hi>
                    </signed>
                </closer>
            </div>
