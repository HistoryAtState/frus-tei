            <div xml:id="d145">

                <pb facs="0262" n="146" sameAs="frus:frus1915/pg146"/>

                <note rend="inline" type="source">File No. 793.94/352.</note>
                <head>
                    <hi rendition="#italic">Chargé Wheeler to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Tokyo</hi>
                        </placeName> [<date
                            ana="#date_undated-inferred-from-document-content-and-sibling-dates"
                            calendar="gregorian" notAfter="1915-05-13T23:59:59-05:00"
                            notBefore="1915-05-12T00:00:00-05:00"><hi rendition="#italic">not
                                dated</hi></date><hi rendition="#italic">; received May 13,
                            1915.</hi>]</dateline>
                </opener>
                <p>Your cable of May 11, 5 p.m. Note was handed to Japanese Minister for Foreign
                    Affairs at 2.30 this afternoon.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wheeler.</hi>
                    </signed>
                </closer>
            </div>
