    <text>
        <body>
            <div xml:id="d135-a1">

                <pb facs="0258" n="142" sameAs="frus:frus1915/pg142"/>

                <opener>
                    <seg rendition="#center">[Annex 1.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Chinese counter-demands relating to Kiao-chau.</hi>
                </head>
                <list>
                    <label>1.</label>
                    <item>Unconditional restitution to China of the leased territory of
                        Kiao-chau.</item>
                    <label>2.</label>
                    <item>Agreement by Japan to the participation of China in the peace conference
                        to be held between Japan and Germany.</item>
                    <label>3.</label>
                    <item>The Japanese Government to bear the entire damages incident to the
                        hostilities between Japan and Germany.</item>
                    <label>4.</label>
                    <item>Immediate removal of all the Japanese military establishments connected
                        with the hostilities between Japan and Germany; and prompt withdrawal of the
                        troops from within the occupied territory.</item>
                </list>
            </div>
        </body>
