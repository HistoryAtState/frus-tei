    <text>
        <body>
            <div xml:id="d153">

                <pb facs="0275" n="159" sameAs="frus:frus1915/pg159"/>

                <note rend="inline" type="source">File No. 793.94/430.</note>
                <head>
                    <hi rendition="#italic">Chargé Wheeler to the Secretary of State.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Tokyo</hi></placeName>, <date
                            calendar="gregorian" when="1915-06-08">
                            <hi rendition="#italic">June 8, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    printed copy (with translation) of the documents relative to the recent
                    negotiations between Japan and China, which will be made public tomorrow.</p>
                <p>The treaties were ratified by the Emperor yesterday and the ratifications were
                    exchanged here this afternoon.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Post Wheeler.</hi>
                    </signed>
                </closer>


                <xi:include href="d153-a1.xml" xpointer="d153-a1"/>
            </div>
        </body>
    </text>
