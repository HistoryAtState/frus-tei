            <div xml:id="d70">

                <pb facs="0196" n="80" sameAs="frus:frus1915/pg80"/>

                <note rend="inline" type="source">File No. 793.94/214.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Reinsch.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-28T16:00:00-05:00">
                            <hi rendition="#italic">January 28, 1915—4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your telegrams of January 23, 7 p.m., January 24, 2 a.m., January 26, 8 p.m. The
                    matter is having careful and prompt attention. Keep the Department fully
                    informed.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>.</signed>
                </closer>
            </div>
        </body>
