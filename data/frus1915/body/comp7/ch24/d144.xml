    <text>
        <body>
            <div xml:id="d144">

                <pb facs="0262" n="146" sameAs="frus:frus1915/pg146"/>

                <note rend="inline" type="source">File No. 793.94/351a, b.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Japanese Ambassador.</hi><anchor n="50"
                        xml:id="d144-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 118.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-12">
                            <hi rendition="#italic">May 12, 1915</hi></date>,</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: I have the honor to enclose
                    herewith for your information copy of a telegram sent by the Department of State
                    yesterday afternoon to the American Embassy at Tokyo, relative to the treaty
                    rights of the United States and its citizens in China in connection with any
                    agreement or undertaking which has been entered into between the Governments of
                    Japan and China as a result of the negotiations which have recently been
                    conducted between those two Governments and which are still pending.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d144-f1" n="50" type="source" xml:id="d144-f1-content">
                <p>Mutatis mutandis to the Chinese Minister.</p>
            </note>
        </listAnnotation>
    </standOff>
