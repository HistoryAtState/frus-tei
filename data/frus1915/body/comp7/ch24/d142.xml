    <text>
        <body>
            <div xml:id="d142">

                <pb facs="0261" n="145" sameAs="frus:frus1915/pg145"/>

                <note rend="inline" type="source">File No. 793.94/342.</note>
                <head>
                    <hi rendition="#italic">Chargé Wheeler to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Tokyo</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-09T10:00:00+09:00">
                            <hi rendition="#italic">May 9, 1915—10 a.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Japanese Minister for Foreign Affairs informs me that a telegram has been
                    received from Hioki in Peking stating that the Chinese Government has
                    unconditionally accepted the ultimatum.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wheeler.</hi>
                    </signed>
                </closer>
            </div>
        </body>
