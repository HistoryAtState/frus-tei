            <div xml:id="ch21">

                <pb facs="0157" n="41" sameAs="frus:frus1915/pg41"/>

                <head>Treaty for the advancement of general peace, concluded between the United
                    States and China</head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at Washington, September 15, 1914; ratification
                        advised by the Senate, October 12, 1914; ratified by the President, June 17,
                        1915; ratified by China, June 18, 1915; ratifications exchanged at
                        Washington, October 22, 1915; proclaimed October 23, 1915.</hi>
                </p>

                <xi:include href="ch21/d42.xml" xpointer="d42"/>
