    <text>
        <body>
            <div xml:id="d48">

                <pb facs="0176" n="60" sameAs="frus:frus1915/pg60"/>

                <note rend="inline" type="source">File No. 893.01/24.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Chargé MacMurray.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-07">
                            <hi rendition="#italic">September 7, 1915</hi></date>.</dateline>
                </opener>
                <p>The Department approves the Legation’s position as indicated in your September
                    4.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing.</hi>
                    </signed>
                </closer>
            </div>
        </body>
