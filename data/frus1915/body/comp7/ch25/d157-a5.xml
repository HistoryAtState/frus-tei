    <text>
        <body>
            <div xml:id="d157-a5">

                <pb facs="0324" n="208" sameAs="frus:frus1915/pg208"/>

                <opener>
                    <seg rendition="#center">[Subinclosure 4.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The Japanese Minister to the
                            Dean of the Diplomatic Corps.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Japanese Legation</hi>, <lb/>
                            <hi rendition="#italic">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-20">
                            <hi rendition="#italic">February 20, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to your Circular No. 194,
                    dated the 29th December last, re the disposal of the surplus claims funds, I
                    have now the honour to inform you under instructions that I have no objection to
                    the procedure proposed by the Wai Chiao Pu.</p>
                <p>I avail [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">E. Hioki.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
