    <text>
        <body>
            <div xml:id="d200">

                <pb facs="0371" n="255" sameAs="frus:frus1915/pg255"/>

                <note rend="inline" type="source">File No. 893.543 C 42/7.</note>
                <head>
                    <hi rendition="#italic">Minister Reinsch to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 826.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1915-11-18">
                            <hi rendition="#italic">November 18, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: In continuation of my dispatch No. 770 of
                    September 30, concerning the Vaseline trade-mark case, I have the honor to
                    enclose a translation of the note from the Ministry for Foreign Affairs to the
                    American Chargé d’Affaires, dated September 22 last, which was substituted for
                    the form enclosed with the above-mentioned dispatch, and which constitutes the
                    closing of this case.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Paul S. Reinsch.</hi>
                    </signed>
                </closer>



                <xi:include href="d200-a1.xml" xpointer="d200-a1"/>
                <xi:include href="d200-a2.xml" xpointer="d200-a2"/>
