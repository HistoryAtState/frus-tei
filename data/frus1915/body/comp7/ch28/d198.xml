    <text>
        <body>
            <div xml:id="d198">

                <pb facs="0371" n="255" xml:id="pg255"/>

                <note rend="inline" type="source">File No. 893.543 C 42/5.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Reinsch.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 350.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-11-06">
                            <hi rendition="#italic">November 6, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received the Legation’s
                    dispatch No. 761 of September 22, 1915, with its inclosures, relative to the
                    Vaseline trade-mark case.</p>
                <p>The attitude of the Legation as set forth in the above mentioned dispatch [is]
                    approved.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State; <lb/>
                    <signed>
                        <hi rendition="#small-caps">Frank L. Polk</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
