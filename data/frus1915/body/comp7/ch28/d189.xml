    <text>
        <body>
            <div xml:id="d189">

                <pb facs="0354" n="238" xml:id="pg238"/>

                <note rend="inline" type="source">File No. 893.54/310.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Minister Reinsch.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-27T16:00:00-05:00">
                            <hi rendition="#italic">February 27, 1915—4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your February 15, 8 p.m. Department approves your attitude. Authorizes you to
                    instruct Consul General at Shanghai accordingly.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan.</hi>
                    </signed>
                </closer>
            </div>
        </body>
