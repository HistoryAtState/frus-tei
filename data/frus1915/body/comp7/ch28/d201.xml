    <text>
        <body>
            <div xml:id="d201">

                <pb facs="0372" n="256" sameAs="frus:frus1915/pg256"/>

                <note rend="inline" type="source">File No. 893.543 C 42/7.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Reinsch.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 369.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-27">
                            <hi rendition="#italic">December 27, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received your dispatch
                    No. 826 of November 18, 1915, with its enclosures, concerning the Vaseline
                    trademark case.</p>
                <p>The dispatch and its enclosure have been read with satisfaction.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Frank L. Polk.</hi>
                    </signed>
                </closer>
            </div>
        </body>
