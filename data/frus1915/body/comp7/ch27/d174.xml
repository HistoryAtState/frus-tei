    <text>
        <body>
            <div xml:id="d174">

                <pb facs="0336" n="220" sameAs="frus:frus1915/pg220"/>

                <note rend="inline" type="source">File No. 893.512/36.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Minister Reinsch.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-22">
                            <hi rendition="#italic">April 22, 1915</hi></date>.</dateline>
                </opener>
                <p>Your July 20, and my July 21, 1914.</p>
                <p>Does Legation believe it still advisable to withhold consent to stamp tax?</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
