    <text>
        <body>
            <div xml:id="d1907">

                <pb facs="1413" n="1297" sameAs="frus:frus1915/pg1297"/>

                <note rend="inline" type="source">File No. 704.5467/3.</note>
                <head>
                    <hi rendition="#italic">Ambassador Morgenthau to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 286.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Constantinople</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-20">
                            <hi rendition="#italic">April 20, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to my despatch No. 272 of April
                    3, 1915, in regard to the protection of Swiss interests in Turkey, I have the
                    honor to transmit herewith, for communication to the Swiss Government should the
                    Department deem it necessary, a copy and translation of the reply of the Sublime
                    Porte to this Embassy’s note verbale of April 3, 1915. A copy of this latter
                    note verbale was forwarded to the Department with the aforementioned despatch of
                    this Embassy.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">H. Morgenthau.</hi>
                    </signed>
                </closer>


                <xi:include href="d1907-a1.xml" xpointer="d1907-a1"/>
            </div>
