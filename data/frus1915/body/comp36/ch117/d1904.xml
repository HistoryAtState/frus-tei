    <text>
        <body>
            <div xml:id="d1904">

                <pb facs="1410" n="1294" sameAs="frus:frus1915/pg1294"/>

                <note rend="inline" type="source">File No. 367.54/18.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Ambassador
                    Morgenthau</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-04">
                            <hi rendition="#italic">March 4, 1915</hi></date>.</dateline>
                </opener>
                <p>459. In view of situation in Turkey, Swiss Minister here requests that you use
                    your good offices to afford Swiss citizens in Turkey ample protection.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan.</hi>
                    </signed>
                </closer>
            </div>
        </body>
