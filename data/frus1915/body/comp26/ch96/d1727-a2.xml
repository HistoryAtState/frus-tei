    <text>
        <body>
            <div xml:id="d1727-a2">

                <pb facs="1236" n="1120" xml:id="pg1120"/>

                <opener>
                    <seg rendition="#center">[Inclosure 2.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Minister Jefferson to certain Chinese residents of
                        Nicaragua.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Managua</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-15">
                            <hi rendition="#italic">May 15, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Gentlemen</hi>: Referring to your note of May 1,
                    with regard to certain instructions concerning Chinese citizens [etc.]</p>
                <p>In reply I have the honor to inform you that up to the present time I have not
                    received such instructions from my Government, but will take pleasure in laying
                    the contents of your note before the Department of State of the United
                    States.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Benjamin L. Jefferson.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
