    <text>
        <body>
            <div xml:id="d1895">

                <pb facs="1404" n="1288" sameAs="frus:frus1915/pg1288"/>

                <note rend="inline" type="source">File No. 816.032/14.</note>
                <head>
                    <hi rendition="#italic">Minister Long to the
                            Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 30.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">San Salvador</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-23">
                            <hi rendition="#italic">February 23, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    copies of the Annual Message which the President of Salvador delivered at the
                    opening of Congress on February 15. The attention of the Department is
                    respectfully called to that part of the message which deals with foreign
                    relations and particularly the protest of Salvador to the Nicaraguan canal
                    convention.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Boaz W. Long.</hi>
                    </signed>
                </closer>


                <xi:include href="d1895-a1.xml" xpointer="d1895-a1"/>
            </div>
        </body>
    </text>
