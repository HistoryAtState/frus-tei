    <text>
        <body>
            <div xml:id="d758">

                <pb facs="0742" n="626" sameAs="frus:frus1915/pg626"/>

                <note rend="inline" type="source">File No. 882.032/15.</note>
                <head>
                    <hi rendition="#italic">Chargé Bundy to the
                            Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 151.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Monrovia</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-17">
                            <hi rendition="#italic">December 17, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to report for the
                    information of the Department that the Legislature of Liberia met for its
                    regular annual session on Dec. 6, 1915. The President delivered his message on
                    Dec. 15, 1915. * * * A copy of the message is herewith enclosed.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Richard C. Bundy.</hi>
                    </signed>
                </closer>


                <xi:include href="d758-a1.xml" xpointer="d758-a1"/>
            </div>
        </body>
    </text>
