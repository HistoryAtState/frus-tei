    <text>
        <body>
            <div xml:id="d783">

                <pb facs="0752" n="636" sameAs="frus:frus1915/pg636"/>

                <note rend="inline" type="source">File No. 882.51/638.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Buckner</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-23">
                            <hi rendition="#italic">January 23, 1915</hi></date>.</dateline>
                </opener>
                <p>Your January 2. Mr. Farnham, National City Bank, informs Department that article
                    4, loan agreement, bottom page 8, and same article bottom page 12, application
                    assigned revenues, would give Clark authority to pay from customs collections
                    back pay and necessary running expenses armed guard.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
