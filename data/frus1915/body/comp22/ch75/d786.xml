    <text>
        <body>
            <div xml:id="d786">

                <pb facs="0753" n="637" sameAs="frus:frus1915/pg637"/>

                <note rend="inline" type="source">File No. 882.51/646.</note>
                <head>
                    <hi rendition="#italic">Minister Buckner to the
                            Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 91.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Monrovia</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-19">
                            <hi rendition="#italic">March 19, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: For the information of the Department I
                    have the honor to transmit herewith a copy of a letter from Mr. Reed Paige
                    Clark, General Receiver, concerning a loan to the Liberian Government by the
                    Excelsior Mining Co.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Geo. W. Buckner.</hi>
                    </signed>
                </closer>


                <xi:include href="d786-a1.xml" xpointer="d786-a1"/>
            </div>
        </body>
    </text>
