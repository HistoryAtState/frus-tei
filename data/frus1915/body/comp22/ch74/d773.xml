                <pb facs="0747" n="631" sameAs="frus:frus1915/pg631"/>

                <note rend="inline" type="source">File No. 882.00/515.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Monrovia</hi></placeName>, <date
                            calendar="gregorian" when="1915-11-28">
                            <hi rendition="#italic">November 28, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#italic">Chester</hi> here. The port of Sinoe opened after fight.
                    Twenty natives and two soldiers killed. Campaign against rebellious tribes
                    proceeding.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bundy.</hi>
                    </signed>
                </closer>
            </div>
