    <text>
        <body>
            <div xml:id="d761">

                <pb facs="0744" n="628" sameAs="frus:frus1915/pg628"/>

                <note rend="inline" type="source">File No. 882.00/525.</note>
                <head>
                    <hi rendition="#italic">The President to the Acting Secretary of State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">White House</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-10-01">
                            <hi rendition="#italic">October 1, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Polk</hi>: I think that the <hi
                        rendition="#italic">Chester</hi> ought by all means to be sent.</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>W. W. <lb/> [<hi rendition="#small-caps">Woodrow Wilson</hi>]</signed>
                </closer>
            </div>
        </body>
