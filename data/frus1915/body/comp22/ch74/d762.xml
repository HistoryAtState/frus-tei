            <div xml:id="d762">

                <pb facs="0744" n="628" sameAs="frus:frus1915/pg628"/>

                <note rend="inline" type="source">File No. 882.00/496.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Chargé Bundy</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-10-04">
                            <hi rendition="#italic">October 4, 1915</hi></date>.</dateline>
                </opener>
                <p>Your September 28. United States Cruiser <hi rendition="#italic">Chester</hi>, at
                    present in Turkish waters, will proceed immediately Monrovia, arriving about
                    November 1.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing.</hi>
                    </signed>
                </closer>
            </div>
        </body>
