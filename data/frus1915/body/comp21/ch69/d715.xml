    <text>
        <body>
            <div xml:id="d715">

                <pb facs="0702" n="586" sameAs="frus:frus1915/pg586"/>

                <note rend="inline" type="source">File No. 894.001Y8/28a.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Ambassador
                    Guthrie</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegrams.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-11">
                            <hi rendition="#italic">December 11, 1915</hi></date>.</dateline>
                </opener>
                <p>You are instructed to express to the Japanese Government thanks of the American
                    people for courtesies extended to American diplomatic and naval representation
                    during ceremonies and festivities in honor of the formal accession of the
                    Emperor.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing.</hi>
                    </signed>
                </closer>
            </div>
        </body>
