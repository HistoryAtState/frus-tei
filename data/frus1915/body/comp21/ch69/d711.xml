                <pb facs="0701" n="585" sameAs="frus:frus1915/pg585"/>

                <note rend="inline" type="source">File No. 894.001Y8/9.</note>
                <head>
                    <hi rendition="#italic">Chargé Wheeler to the Secretary of State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Tokyo</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-21">
                            <hi rendition="#italic">April 21, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to report that, the
                    period of mourning for the late Empress. Dowager having ended, the date of the
                    coronation of the Emperor has been officially announced, the ceremonies to take
                    place at Kyoto on November 15 next.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Post Wheeler.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
