    <text>
        <body>
            <div xml:id="d748">

                <pb facs="0727" n="611" sameAs="frus:frus1915/pg611"/>

                <note rend="inline" type="source">File No. 893.773/36.</note>
                <head>
                    <hi rendition="#italic">Vice Consul Hanson to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 70.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Newchwang</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-28">
                            <hi rendition="#italic">January 28, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: For the information of the Department, I
                    have the honor to transmit a copy of an instruction to this office, dated
                    January 14, <pb facs="0728" n="612" xml:id="pg612"/> 1915, received from the
                    Embassy at Tokyo, and a copy of this office’s despatch in reply thereto, dated
                    January 28, 1915, on the subject of the apparent discrimination in freight rates
                    instituted by the South Manchuria Railway on foreign importations.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">G. C. Hanson</hi>.</signed>
                </closer>



                <xi:include href="d748-a1.xml" xpointer="d748-a1"/>
                <xi:include href="d748-a2.xml" xpointer="d748-a2"/>
