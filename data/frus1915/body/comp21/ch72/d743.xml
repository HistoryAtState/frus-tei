    <text>
        <body>
            <div xml:id="d743">

                <pb facs="0723" n="607" sameAs="frus:frus1915/pg607"/>

                <note rend="inline" type="source">File No. 893.773/32.</note>
                <head>
                    <hi rendition="#italic">Consul Pontius to the Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 52.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Newchwang</hi></placeName>, <date
                            calendar="gregorian" when="1914-11-28">
                            <hi rendition="#italic">November 28, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: For the information of the Department, I
                    have the honor to transmit herewith copy of my No. 44, of even date, reporting
                    further to the Legation at Peking concerning the question of rate discrimination
                    in connection with the reduction instituted by the South Manchuria Railway
                    covering railway freights on foreign importations.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Albert Pontius.</hi>
                    </signed>
                </closer>


                <xi:include href="d743-a1.xml" xpointer="d743-a1"/>
            </div>
        </body>
    </text>
