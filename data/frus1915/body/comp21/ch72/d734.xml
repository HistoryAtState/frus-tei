            <div xml:id="d734">

                <pb facs="0715" n="599" sameAs="frus:frus1915/pg599"/>

                <note rend="inline" type="source">File No. 893.773/23.</note>
                <head>
                    <hi rendition="#italic">Ambassador Guthrie to the Secretary of
                    State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Tokyo</hi></placeName>, <date
                            calendar="gregorian" when="1914-10-08">
                            <hi rendition="#italic">October 8, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Continuing my correspondence with the
                    Department on the subject of the apparent discrimination in the freight rates of
                    the South Manchuria Railway against shipments from Shanghai to Newchwang and
                    Dalny, I have the honor to transmit a copy of a memorandum recently given me, at
                    my request, by the British Ambassador.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">George W. Guthrie.</hi>
                    </signed>
                </closer>


                <xi:include href="d734-a1.xml" xpointer="d734-a1"/>
            </div>
