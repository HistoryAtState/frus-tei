    <text>
        <body>
            <div xml:id="d729">

                <pb facs="0711" n="595" sameAs="frus:frus1915/pg595"/>

                <note rend="inline" type="source">File No. 893.773/12.</note>
                <head>
                    <hi rendition="#italic">Consul Pontius to the Secretary of State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Newchwang</hi></placeName>, <date
                            calendar="gregorian" when="1914-06-30">
                            <hi rendition="#italic">June 30, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith copy
                    of my No. 5, with enclosures, reporting to the Legation at Peking concerning the
                    reduction in railway freights instituted by the South Manchuria Railway on
                    importations from Japan through the port of Dairen.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Albert W. Pontius.</hi>
                    </signed>
                </closer>


                <xi:include href="d729-a1.xml" xpointer="d729-a1"/>
            </div>
        </body>
    </text>
