                <pb facs="0736" n="620" sameAs="frus:frus1915/pg620"/>

                <note rend="inline" type="source">File No. 893.773/43.</note>
                <head>
                    <hi rendition="#italic">Chargé Wheeler to the
                            Secretary of State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Tokyo</hi></placeName>, <date
                            calendar="gregorian" when="1915-06-23">
                            <hi rendition="#italic">June 23, 1915</hi>
                        </date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to my despatch of the 9th
                    instant, No. 296, I have the honor herewith to transmit a copy of a letter with
                    enclosures, dated June 16, received from the Consul at Dairen.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Post Wheeler.</hi>
                    </signed>
                </closer>









