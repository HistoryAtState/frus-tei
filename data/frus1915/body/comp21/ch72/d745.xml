    <text>
        <body>
            <div xml:id="d745">

                <pb facs="0724" n="608" sameAs="frus:frus1915/pg608"/>

                <note rend="inline" type="source">File No. 893.773/32.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Ambassador Guthrie</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 90.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-01-04">
                            <hi rendition="#italic">January 4, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to the Department’s No. 81 of
                    December 8, 1914, to you, regarding the freight rate reductions instituted by
                    the South Manchuria Railway on foreign importations, there is enclosed herewith
                    for your information copy of Despatch No. 52 of November 28, <pb facs="0725"
                        n="609" xml:id="pg609"/> 1914, from the American Consul at Newchwang, with
                    its enclosure, relating to this subject.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
