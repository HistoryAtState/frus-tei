            <div xml:id="ch15">

                <pb facs="0146" n="30" sameAs="frus:frus1915/pg30"/>

                <head>Treaty for the advancement of general peace, concluded between the United
                    States and Bolivia</head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at Washington, January 22, 1914; ratification
                        advised by the Senate, August 13, 1914; ratified by the President, January
                        4, 1915; ratified by Bolivia, November 14, 1914; ratifications exchanged at
                        Washington January 8, 1915; proclaimed, January 9, 1915.</hi>
                </p>

