        <body>
            <div xml:id="d30">

                <pb facs="0142" n="26" sameAs="frus:frus1915/pg26"/>

                <note rend="inline" type="source">File No. 711.0021/69.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-31">
                            <hi rendition="#italic">December 31, 1915</hi></date>.</dateline>
                </opener>
                <p rendition="#flush">
                    <hi rendition="#italic">To the Diplomatic Officers of the United States
                        accredited to Maritime Countries</hi>.</p>
                <p>
                    <hi rendition="#small-caps">Gentlemen</hi>: In accordance with a suggestion made
                    in a letter of the Department of Commerce dated the 16th instant, I enclose
                    herewith two copies of that Department’s circular No. 268 with reference to the
                    application of certain provisions of Section 13 of the Seamen’s Act to foreign
                    vessels in trade with the United States.</p>
                <p>You will transmit one of the copies to the Government to which you are
                    respectively accredited, retaining the other for the files of your mission.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Frank L. Polk.</hi>
                    </signed>
                </closer>


                <xi:include href="d30-a1.xml" xpointer="d30-a1"/>
