    <text>
        <body>
            <div xml:id="d31">

                <pb facs="0144" n="28" sameAs="frus:frus1915/pg28"/>

                <note rend="inline" type="source">File No. 835.032/15.</note>
                <head>
                    <hi rendition="#italic">Ambassador Stimson to
                        the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 45.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Buenos Aires</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-12">
                            <hi rendition="#italic">May 12, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to report that on Monday,
                    May 10, I assisted at the formal opening of Congress by the President of the
                    Nation, and enclose herewith a copy of the message which he read on that
                    occasion. * * *</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">F. J. Stimson.</hi>
                    </signed>
                </closer>


                <xi:include href="d31-a1.xml" xpointer="d31-a1"/>
            </div>
