        <body>
            <div xml:id="d705">

                <pb facs="0696" n="580" sameAs="frus:frus1915/pg580"/>

                <note rend="inline" type="source">File No. 365.117/238.</note>
                <head>
                    <hi rendition="#italic">Ambassador Page to the Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 396.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Rome</hi></placeName>, <date
                            calendar="gregorian" when="1915-10-25">
                            <hi rendition="#italic">October 25, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to my telegram No. 389 of
                    September 5, I have the honor to enclose, herewith, copy of a note verbale
                    received from the Royal Italian Ministry for Foreign Affairs, dated October 2,
                    1915.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Thomas Nelson Page.</hi>
                    </signed>
                </closer>


                <xi:include href="d705-a1.xml" xpointer="d705-a1"/>
            </div>
