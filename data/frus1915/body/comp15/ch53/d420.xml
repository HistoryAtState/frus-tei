            <div xml:id="d420">

                <pb facs="0528" n="412" sameAs="frus:frus1915/pg412"/>

                <note rend="inline" type="source">File No. 702.6211/231.</note>
                <head>
                    <hi rendition="#italic">The German Ambassador to the Secretary of
                    State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">German Embassy</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-21">
                            <hi rendition="#italic">May 21, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary of State</hi>: I have the honor to
                    acknowledge receipt of your kind note, No. 1428, of the 18th instant. I am
                    gratified to learn therefrom that the authorities of the State of Washington
                    have now acknowledged as unfounded the charge against Imperial Consul Müller and
                    Secretary Schulz and have dismissed the case.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. Bernstorff</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
