    <text>
        <body>
            <div xml:id="d249">

                <pb facs="0400" n="284" sameAs="frus:frus1915/pg284"/>

                <note rend="inline" type="source">File No. 839.00/1686.</note>
                <head>
                    <hi rendition="#italic">Minister Sullivan to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegrams.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Santo Domingo</hi></placeName>, <date
                            calendar="gregorian" when="1915-04-15T12:00:00-04:40">
                            <hi rendition="#italic">April 15, 1915—noon</hi></date>.</dateline>
                </opener>
                <p>Your instruction of April 9, 7 p.m has been followed; in consequence better
                    situation exists.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sullivan.</hi>
                    </signed>
                </closer>
            </div>
        </body>
