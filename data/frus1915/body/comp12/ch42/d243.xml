    <text>
        <body>
            <div xml:id="d243">

                <pb facs="0398" n="282" sameAs="frus:frus1915/pg282"/>

                <note rend="inline" type="source">File No. 839.00/1674.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Minister Sullivan.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-09T16:00:00-05:00">
                            <hi rendition="#italic">February 9, 1915—4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your February 8, 8 a.m. We are pleased to learn of peaceful termination of
                    controversy between Puerto Plata and President Jiménes.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan.</hi>
                    </signed>
                </closer>
            </div>
        </body>
