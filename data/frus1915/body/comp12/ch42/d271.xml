                <note rend="inline" type="source">File No. 839.00/1740.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Chargé Johnson.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegrams.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-08-23T17:00:00-05:00">
                            <hi rendition="#italic">August 23, 1915—5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your August 17, 3 p.m. U. S. S. <hi rendition="#italic">Marietta</hi> being
                    despatched Santo Domingo City.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>.</signed>
                </closer>
