        <body>
            <div xml:id="d245">

                <pb facs="0399" n="283" xml:id="pg283"/>

                <note rend="inline" type="source">File No. 839.00/1682.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Santo Domingo</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-25T10:00:00-04:40">
                            <hi rendition="#italic">March 25, 1915—10 a.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>I believe highly desirable that a gunboat be at this city as soon as
                    possible.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sullivan.</hi>
                    </signed>
                </closer>
            </div>
        </body>
