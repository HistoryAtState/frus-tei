            <div xml:id="d246">

                <pb facs="0399" n="283" sameAs="frus:frus1915/pg283"/>

                <note rend="inline" type="source">File No. 839.00/1682.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Minister Sullivan.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-27T13:00:00-05:00">
                            <hi rendition="#italic">March 27, 1915—1 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your March 25, 10 a.m. Navy Department has directed fleet commander in chief send
                    gunboat Santo Domingo City.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan.</hi>
                    </signed>
                </closer>
            </div>
