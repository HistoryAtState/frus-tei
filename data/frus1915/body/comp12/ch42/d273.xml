    <text>
        <body>
            <div xml:id="d273">

                <pb facs="0410" n="294" sameAs="frus:frus1915/pg294"/>

                <note rend="inline" type="source">File No. 839.00/1746.</note>
                <head>
                    <hi rendition="#italic">Chargé Johnson to the
                            Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegrams.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Santo Domingo</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-03T14:00:00-04:40">
                            <hi rendition="#italic">September 3, 1915—2 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your September 2, 4 p.m. Presence of United States ship and marines in Haitian
                    rather than Dominican waters subject to duty here in case of necessity coincides
                    with recommendation intended to be conveyed in my telegram August 17, 3 p.m.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Johnson.</hi>
                    </signed>
                </closer>
            </div>
        </body>
