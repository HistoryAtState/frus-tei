            <div xml:id="d298">

                <pb facs="0424" n="308" sameAs="frus:frus1915/pg308"/>

                <note rend="inline" type="source">File No. 839.00/1705.</note>
                <head>
                    <hi rendition="#italic">The Secretary to the President to the Secretary of
                        State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The White House</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-15">
                            <hi rendition="#italic">May 15, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: By the President’s
                    direction, I am sending to you a communication left with him last night by the
                    Special Dominican Commission.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. P. Tumulty</hi>.</signed>
                </closer>


                <xi:include href="d298-a1.xml" xpointer="d298-a1"/>
