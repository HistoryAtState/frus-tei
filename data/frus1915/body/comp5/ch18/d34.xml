    <text>
        <body>
            <div xml:id="d34">

                <pb facs="0150" n="34" sameAs="frus:frus1915/pg34"/>

                <note rend="inline" type="source">File No. 832. 032/10.</note>
                <head>
                    <hi rendition="#italic">Ambassador Morgan to
                        the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 584.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Rio de Janeiro</hi></placeName>, <date
                            calendar="gregorian" when="1915-05-10">
                            <hi rendition="#italic">May 10, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose duplicate
                    copies of the Message which President Wenceslau Braz sent to the Federal
                    Congress when it convened in the first session of the new legislature on the 3rd
                    instant. I have also the honor to enclose an English translation of the salient
                    portions of the Message relating to foreign affairs. * * *</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Edwin V. Morgan</hi>.</signed>
                </closer>


                <xi:include href="d34-a1.xml" xpointer="d34-a1"/>
            </div>
        </body>
    </text>
