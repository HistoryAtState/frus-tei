    <text>
        <body>
            <div xml:id="d609">

                <pb facs="0635" n="519" sameAs="frus:frus1915/pg519"/>

                <note rend="inline" type="source">File No. 838.00/1269.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of the
                            Navy to the Secretary of
                    State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Navy Department</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-08-24">
                            <hi rendition="#italic">August 24, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith, for
                    your information, a copy of a report, dated August 13, 1915, received from the
                    Commander of the Cruiser Squadron, Atlantic Fleet, relative to conditions in
                    Haitian waters from August 7 to 12, inclusive.</p>
                <p>Very sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. S. Benson.</hi>
                    </signed>
                </closer>


                <xi:include href="d609-a1.xml" xpointer="d609-a1"/>
            </div>
