    <text>
        <body>
            <div xml:id="d610">

                <pb facs="0636" n="520" sameAs="frus:frus1915/pg520"/>

                <note rend="inline" type="source">File No. 838.00/1280.</note>
                <head>
                    <hi rendition="#italic">Admiral Caperton to the Secretary of Navy</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram—Paraphrase.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Port au Prince</hi></placeName>, <date
                            calendar="gregorian" when="1915-09-01">
                            <hi rendition="#italic">September 1, 1915</hi></date>.</dateline>
                </opener>
                <p>Will occupy and begin to administer customhouse at Port au Prince at 10 o’clock,
                    September 2, unless otherwise directed.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Caperton.</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
