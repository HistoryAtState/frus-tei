    <text>
        <body>
            <div xml:id="d515">

                <pb facs="0584" n="468" sameAs="frus:frus1915/pg468"/>

                <note rend="inline" type="source">File No. 838.00/1142.</note>
                <head>
                    <hi rendition="#italic">Minister Blanchard to
                        the Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegrams.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Port au Prince</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-15">
                            <hi rendition="#italic">March 15, 1915</hi></date>.</dateline>
                </opener>
                <p>Commission left here on the <hi rendition="#italic">Nashville</hi> this morning
                    for Santiago de Cuba.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Blanchard</hi>.</signed>
                </closer>
            </div>
        </body>
