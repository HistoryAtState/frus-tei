                <pb facs="0599" n="483" sameAs="frus:frus1915/pg483"/>

                <note rend="inline" type="source">File No. 838.00/1277.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Chargé Johnson</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-08-28T21:00:00-05:00">
                            <hi rendition="#italic">August 28, 1915—9 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Department has no objection to Bobo being landed at Santiago de Cuba.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>.</signed>
                </closer>
            </div>
        </body>
