    <text>
        <body>
            <div xml:id="d580">

                <pb facs="0609" n="493" sameAs="frus:frus1915/pg493"/>

                <note rend="inline" type="source">File No. 838.00/1373.</note>
                <head>
                    <hi rendition="#italic">Admiral Caperton to the
                            Secretary of the Navy</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegrams.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Port au Prince</hi></placeName>, <date
                            calendar="gregorian" when="1915-11-22">
                            <hi rendition="#italic">November 22, 1915</hi></date>.</dateline>
                </opener>
                <p>All operations except protective patrolling have been suspended. Directions have
                    been given that loss of life both sides be avoided if possible.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Caperton</hi>.</signed>
                </closer>
            </div>
        </body>
