    <text>
        <body>
            <div xml:id="d582">

                <pb facs="0609" n="493" sameAs="frus:frus1915/pg493"/>

                <note rend="inline" type="source">File No. 838.00/1370.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of the
                            Navy to the Secretary of
                    State</hi>.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Navy Department</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-08">
                            <hi rendition="#italic">December 8, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith, for
                    the information of your Department, a copy of a letter dated November 20, 1915,
                    received from Rear Admiral Caperton, Commander of the Cruiser Squadron, Atlantic
                    Fleet, relative to the operations of the Cruiser Squadron in Haitian waters from
                    November 7 to 19, inclusive.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. S. Benson</hi>.</signed>
                </closer>


                <xi:include href="d582-a1.xml" xpointer="d582-a1"/>
            </div>
