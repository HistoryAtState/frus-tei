            <div xml:id="d498">

                <pb facs="0579" n="463" sameAs="frus:frus1915/pg463"/>

                <note rend="inline" type="source">File No. 838.00/1107.</note>
                <head>
                    <hi rendition="#italic">Minister Blanchard to the Secretary of
                    State</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegrams.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Port au Prince</hi></placeName>, <date
                            calendar="gregorian" when="1915-02-08T17:00:00-04:49">
                            <hi rendition="#italic">February 8, 1915—5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>My January 26, 5 p.m. Haitian gunboat <hi rendition="#italic">Pacifique</hi> at
                    Gonaives to enforce blockade.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Blanchard</hi>.</signed>
                </closer>
            </div>
        </body>
