                <pb facs="0583" n="467" sameAs="frus:frus1915/pg467"/>

                <note rend="inline" type="source">File No. 838.00/1124.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Consul Livingston</hi>.</head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-03-01">
                            <hi rendition="#italic">March 1, 1915</hi></date>.</dateline>
                </opener>
                <p>U. S. S. <hi rendition="#italic">Wheeling</hi> will arrive Cape Haitien Wednesday
                    morning, March 3, to take you Port au Prince. Be ready when vessel arrives.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi>.</signed>
                </closer>
            </div>
        </body>
