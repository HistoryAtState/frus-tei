    <text>
        <body>
            <div xml:id="d491">

                <pb facs="0576" n="460" sameAs="frus:frus1915/pg460"/>

                <note rend="inline" type="source">File No. 711.38/61.</note>
                <head>
                    <hi rendition="#italic">Minister Blanchard to
                        the Secretary of State</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 51.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Port au Prince</hi></placeName>, <date
                            calendar="gregorian" when="1915-12-06">
                            <hi rendition="#italic">December 6, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to my November 29, 6 p.m., I
                    have the honor to enclose herewith the original and copy of the modus vivendi
                    signed on that date.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">A. Bailly Blanchard</hi>.</signed>
                </closer>


                <xi:include href="d491-a1.xml" xpointer="d491-a1"/>
            </div>
