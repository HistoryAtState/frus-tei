    <text>
        <body>
            <div xml:id="d452">

                <pb facs="0551" n="435" sameAs="frus:frus1915/pg435"/>

                <note rend="inline" type="source">File No. 711.38/58a.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Chargé Davis</hi>.</head>
                <opener>
                    <seg rendition="#float-left">No. 36.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1915-08-19">
                            <hi rendition="#italic">August 19, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to the Department’s telegram of
                    the 14th instant, I enclose herewith the President’s full power<anchor n="5"
                        xml:id="d452-f1"/> authorizing you to negotiate and sign the treaty
                    mentioned in that telegram.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>.</signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d452-f1" n="5" xml:id="d452-f1-content">
                <p>Printed in the telegram referred to.</p>
            </note>
        </listAnnotation>
    </standOff>
