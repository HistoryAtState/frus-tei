    <text>
        <body>
            <div xml:id="ch104">

                <pb facs="1391" n="1275" sameAs="frus:frus1915/pg1275"/>

                <head>Treaty for the advancement of general peace, concluded between the United
                    States and Paraguay</head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at Asunción, August 29, 1914; ratification
                        advised by the Senate, October 22, 1914; ratified by the President, October
                        26, 1914; ratified by Paraguay, March 9, 1915; ratifications exchanged at
                        Asunción, March 9, 1915; proclaimed, March 17, 1915.</hi>
                </p>

                <xi:include href="ch104/d1887.xml" xpointer="d1887"/>
