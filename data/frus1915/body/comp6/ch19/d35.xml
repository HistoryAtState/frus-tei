    <text>
        <body>
            <div xml:id="d35">

                <pb facs="0151" n="35" sameAs="frus:frus1915/pg35"/>

                <note rend="inline" type="source">File No. 825.02/9.</note>
                <head>
                    <hi rendition="#italic">Chargé Summerlin to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 642.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Santiago</hi></placeName>, <date
                            calendar="gregorian" when="1915-06-15">
                            <hi rendition="#italic">June 15, 1915</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to report that the
                    President of the Republic opened the ordinary sessions of the Congress on the
                    first instant * * * at which the President’s Message was read. Copies of the
                    Message, with translations of the most important passages, are enclosed
                    herewith. * * *</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">George T. Summerlin.</hi>
                    </signed>
                </closer>


                <xi:include href="d35-a1.xml" xpointer="d35-a1"/>
            </div>
        </body>
    </text>
