    <text>
        <body>
            <div xml:id="d209">

                <pb facs="0430" n="404" sameAs="frus:frus1961-63v19/pg404"/>

                <head>209. Telegram From the Embassy in India to the
                        Department of State<anchor n="0" xml:id="d209-f1"
                    /></head>
                <opener><dateline rendition="#float-right"><placeName>New Delhi</placeName>, <date
                            calendar="gregorian" when="1962-11-21T11:00:00+05:30">November 21, 1962,
                            11 a.m.</date></dateline></opener>
                <p>1973. Eyes Only Secretary. Verbatim Text. Department Telegram 2196.<anchor n="1"
                        xml:id="d209-f2"/></p>
                <p>M.J. Desai handed me this afternoon copy
                    Prime Minister’s response, dated today, to message contained reference
                    telegram.</p>
                <p><hi rendition="#italic">Begin text:</hi></p>
                <p>[This letter has not been declassified by the Indian Government.]</p>
                <closer><signed><hi rendition="#bold">Galbraith</hi></signed></closer>
            </div>
        </body>
    </text>
