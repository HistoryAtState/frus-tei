    <text>
        <body>
            <div xml:id="d334">

                <pb facs="0585" n="571" xml:id="pg571"/>

                <note rend="inline" type="source">103.918/12–1544</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Secretary of State to President
                        Roosevelt </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-12-15">December 15,
                        1944</date>.</dateline>
                </opener>
                <p>In accordance with your request, there is transmitted herewith a suggested
                    memorandum for reply to General Donovan.</p>
                <closer>
                    <signed>E. R. <hi rendition="#small-caps">Stettinius, Jr.</hi>
                    </signed>
                </closer>


                <xi:include href="d334-a1.xml" xpointer="d334-a1"/>
