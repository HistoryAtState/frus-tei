    <text>
        <body>
            <div xml:id="d304">

                <pb facs="0551" n="537" sameAs="frus:frus1944v01/pg537"/>

                <note rend="inline" type="source">740.0011 European War 1939/7–2644</note>
                <head>
                    <hi rendition="#italic">Miss K. Isabel Poate,
                        Attaché in the British Embassy, to Mr. Fletcher
                            Warren, Executive Assistant to the Assistant Secretary of
                        State</hi> (<hi rendition="#italic">Berle</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-07-26">26 July, 1944</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Warren</hi>: I enclose herein paraphrases
                    of telegrams<anchor n="71" xml:id="d304-f1"/> exchanged between His Majesty’s
                    Ambassador at Madrid<anchor n="72" xml:id="d304-f2"/> and the Foreign Office in
                    London. His Majesty’s Ambassador at Madrid has, as you will notice, been
                    instructed to consult his United States colleague, so no doubt you will have
                    heard of this further approach, but you may nevertheless be interested to have
                    these telegrams for your files.</p>
                <p>Yours sincerely,</p>
                <closer>
                    <signed>K. <hi rendition="#small-caps">Isabel Poate</hi>
                    </signed>
                </closer>


                <xi:include href="d304-a1.xml" xpointer="d304-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d304-f1" n="71" xml:id="d304-f1-content">
                <p>Only one telegram was found enclosed with this document in Department files.</p>
            </note>
            <note corresp="#d304-f2" n="72" xml:id="d304-f2-content">
                <p>Sir Samuel Hoare.</p>
            </note>
        </listAnnotation>
    </standOff>
