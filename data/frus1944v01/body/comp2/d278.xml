    <text>
        <body>
            <div xml:id="d278">

                <pb facs="0523" n="509" sameAs="frus:frus1944v01/pg509"/>

                <note rend="inline" type="source">740.00119 European War 1939/2491: Telegram</note>
                <head>
                    <hi rendition="#italic">President Roosevelt to
                        the Secretary of State
                    </hi><anchor n="86" xml:id="d278-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Georgetown</hi>, S.C.</placeName>,] <date calendar="gregorian"
                            when="1944-04-15">15 April, 1944</date>.</dateline>
                </opener>
                <p>Referring to S50325 from Stettinius, any reply thereto should have my approval
                    before being sent.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d278-f1" n="86" type="source" xml:id="d278-f1-content">
                <p>Transmitted through the White House Map Room, where it was received at 7:40 p.m.
                    on April 15, 1944. At this time, President Roosevelt was recuperating from an
                    attack of bronchitis at Bernard Baruch’s estate in Georgetown, South
                    Carolina.</p>
            </note>
        </listAnnotation>
    </standOff>
