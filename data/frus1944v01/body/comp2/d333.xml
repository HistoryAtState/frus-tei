    <text>
        <body>
            <div xml:id="d333">

                <pb facs="0581" n="567" xml:id="pg567"/>

                <note rend="inline" type="source">740.00119 E.W./12–1144</note>
                <head>
                    <hi rendition="#italic">The Director of the Office of Strategic Services</hi>
                        (<hi rendition="#italic">Donovan</hi>) <hi rendition="#italic">to the
                        Director of the Office of European Affairs, Department of State</hi> (<hi
                        rendition="#italic">Dunn</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-12-11">11 December,
                        1944</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Jimmie</hi>: I am inclosing a paper that I am
                    sending to the Secretary but I would like you to look at it before it goes
                    in.</p>
                <p>Sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bill</hi>
                    </signed>
                </closer>




