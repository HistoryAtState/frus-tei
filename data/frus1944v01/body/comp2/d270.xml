            </note>
            <note corresp="#d270-f2" n="61" xml:id="d270-f2-content">
                <p>Field Marshal Wilhelm Keitel, Chief of the High Command of the German Armed
                    Forces.</p>
            </note>
            <note corresp="#d270-f3" n="62" xml:id="d270-f3-content">
                <p>Werner Best, German Minister to Denmark.</p>
            </note>
            <note corresp="#d270-f4" n="63" xml:id="d270-f4-content">
                <p>Fedor Tarasovich Gusev.</p>
            </note>
        </listAnnotation>
