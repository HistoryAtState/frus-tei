    <text>
        <body>
            <div xml:id="d305">

                <pb facs="0552" n="538" sameAs="frus:frus1944v01/pg538"/>

                <note rend="inline" type="source">740.00119 European War 1939/8–744</note>
                <head>
                    <hi rendition="#italic">The Second Secretary of the British Embassy</hi>
                        (<hi rendition="#italic">King</hi>) <hi
                        rendition="#italic">to the Chief of the Division of Central European
                        Affairs</hi> (<hi rendition="#italic"
                        >Riddleberger</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-08-07">7 August, 1944</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Riddleberger</hi>: With reference to our recent
                    conversation, I have pleasure in sending you the attached paraphrase of a
                    telegram from the Foreign Office to Moscow about alleged German peace
                    feelers.</p>
                <p>Yours very sincerely,</p>
                <closer>
                    <signed>C. E. <hi rendition="#small-caps">King</hi>
                    </signed>
                </closer>


                <xi:include href="d305-a1.xml" xpointer="d305-a1"/>
