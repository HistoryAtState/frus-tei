    <text>
        <body>
            <div xml:id="d836">

                <pb facs="1330" n="1316" xml:id="pg1316"/>

                <note rend="inline" type="source">740.00116 European War 1939/1428: Airgram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Brazil</hi> (<hi rendition="#italic"
                        >Caffery</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Rio de Janeiro</hi></placeName>, <date
                            calendar="gregorian" when="1944-05-06T12:00:00-03:00">May 6,
                            1944—noon</date>.<lb/>[Received May 13—4 p.m.]</dateline>
                </opener>
                <p>A–820. The Minister for Foreign Affairs and the Secretary General of the Foreign
                    Office both disclaim any knowledge in connection with the report set out in the
                    Department’s secret instruction No. 5884 of April 29, 1944,<anchor n="47"
                        xml:id="d836-f1"/> to the effect that the Brazilian Ambassador at London had
                    approached the British Government regarding the question of Brazilian membership
                    on the War Crimes Commission.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Caffery</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
