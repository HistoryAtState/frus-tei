    <text>
        <body>
            <div xml:id="d635">

                <pb facs="1094" n="1080" xml:id="pg1080"/>

                <note rend="inline" type="source">840.48 Refugees/6–2744</note>
                <head>
                    <hi rendition="#italic">The United States Political Adviser, Allied Force
                        Headquarters</hi> (<hi rendition="#italic">Murphy</hi>) <hi
                        rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 568</seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Algiers</hi></placeName>,] <date calendar="gregorian"
                            when="1944-06-27">June 27, 1944</date>.<lb/>[Received July
                        12.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit as of
                    possible interest to the Department a copy of a letter addressed to General
                    Bethouart, Chief of Staff of National Defense of the French Committee of
                    National Liberation, by Lt. General Gammell, Chief of Staff, AFHQ, with regard
                    to the accommodation and maintenance of refugees in French North Africa.</p>
                <p>Respectfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert</hi> D. <hi rendition="#small-caps"
                            >Murphy</hi>
                    </signed>
                </closer>


                <xi:include href="d635-a1.xml" xpointer="d635-a1"/>
            </div>
        </body>
    </text>
