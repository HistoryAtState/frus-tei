                <pb facs="1223" n="1209" sameAs="frus:frus1944v01/pg1209"/>

                <note rend="inline" type="source">740.00113 E.W./10–544: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Switzerland</hi> (<hi rendition="#italic">Harrison</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Bern</hi></placeName>, <date
                            calendar="gregorian" when="1944-10-05">October 5,
                        1944</date>.<lb/>[Received October 5—11:35 p.m.]</dateline>
                </opener>
                <p>6637. American Interests—Bulgaria—Private Property. Swiss Legation, Sofia,
                    telegraphs Bulgarian decree September 15 abrogates all valid laws concerning
                    enemy property, terminates sequestrations and orders restitution property to
                    owners.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Harrison</hi>
                    </signed>
                </closer>
            </div>
        </body>
