    <text>
        <body>
            <div xml:id="d741">

                <pb facs="1220" n="1206" sameAs="frus:frus1944v01/pg1206"/>

                <note rend="inline" type="source">340.1115A/9–2244: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Switzerland</hi> (<hi rendition="#italic">Harrison</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Bern</hi></placeName>, <date
                            calendar="gregorian" when="1944-09-22">September 22,
                        1944</date>.<lb/>[Received September 22—11:55 p.m.]</dateline>
                </opener>
                <p>6296. American Interests—Baltic Countries. Legation’s 4991, August 3,
                    Department’s 2852, August 19.<anchor n="59" xml:id="d741-f1"/>
                </p>
                <p>Swiss Legation Berlin reports September 15 no recipients financial assistance
                    Baltic countries.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Harrison</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
