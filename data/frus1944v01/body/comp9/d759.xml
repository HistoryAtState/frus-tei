            <div xml:id="d759">

                <pb facs="1235" n="1221" sameAs="frus:frus1944v01/pg1221"/>

                <note rend="inline" type="source">703.5451/12–144: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Caffery</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1944-12-01">December 1,
                        1944</date>.<lb/>[Received December 1—6:55 p.m.]</dateline>
                </opener>
                <p>747. American interests taken back today from Swiss in all of France except Lyon
                    district. Embassy and Consulates in Marseille, Nice and Cherbourg officially
                    open to the public.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Caffery</hi>
                    </signed>
                </closer>
            </div>
        </body>
