    <text>
        <body>
            <div xml:id="d520">

                <pb facs="0955" n="941" sameAs="frus:frus1944v01/pg941"/>

                <note rend="inline" type="source">500.CC/11–2744</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to Diplomatic
                        Representatives in the American Republics </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-11-27">November 27,
                        1944</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sirs</hi>: There is enclosed herewith a copy of a
                    summary which has been prepared regarding a discussion held in the Department of
                    State on November 9 with respect to international organization. A list of the
                    persons present and a copy of the press release issued in connection with this
                    meeting are also enclosed herewith.<anchor n="60" xml:id="d520-f1"/> The latter
                    was approved by the Ambassadors at the meeting.</p>
                <p>Very truly yours,</p>
                <closer>
                    <signed>E. R. <hi rendition="#small-caps">Stettinius, Jr.</hi>
                    </signed>
                </closer>


                <xi:include href="d520-a1.xml" xpointer="d520-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d520-f1" n="60" xml:id="d520-f1-content">
                <p>List of persons not printed; for text of press release dated November 9, 1944,
                    see Department of State <hi rendition="#italic">Bulletin</hi>, November 12,
                    1944, p. 565.</p>
            </note>
        </listAnnotation>
