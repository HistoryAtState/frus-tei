                <pb facs="0425" n="411" sameAs="frus:frus1944v01/pg411"/>

                <note rend="inline" type="source">740.00119 EW/11–2244</note>
                <head>
                    <hi rendition="#italic">Memorandum by the Acting Secretary of
                            State to President Roosevelt
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1944-11-22">November 22, 1944</date>.</dateline>
                </opener>
                <p rendition="#flush">Subject: Economic Treatment of Germany</p>
                <p>At the time that you redraft the memorandum on the Economic Treatment of Germany
                    you might find the attached memorandum useful.</p>
                <closer>
                    <signed>E. R. <hi rendition="#small-caps">Stettinius, Jr.</hi>
                    </signed>
                </closer>



