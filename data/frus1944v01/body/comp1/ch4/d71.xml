                <pb facs="0108" n="98" sameAs="frus:frus1944v01/pg98"/>

                <note rend="inline" type="source">740.00119 EAC/11–844: Telegram</note>
                <head>
                    <hi rendition="#italic">President Roosevelt to
                        the Acting Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps">Hyde
                                Park</hi>, N.Y.</placeName>] <date calendar="gregorian"
                            when="1944-11-08">November 8, 1944</date>.</dateline>
                </opener>
                <p>Approve French Membership on European Advisory Commission to be announced
                    November 11th, but this should be so worded as to make advisory character of
                    Commission clear.</p>
            </div>
