    <text>
        <body>
            <div xml:id="d58">

                <pb facs="0098" n="88" sameAs="frus:frus1944v01/pg88"/>

                <note rend="inline" type="source">740.00119 European War/9–144: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in the United Kingdom</hi> (<hi
                            rendition="#italic">Winant</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-09-05T00:00:00-04:00">September 5,
                            1944—midnight</date>.</dateline>
                </opener>
                <p>7185. Referring to your telegrams 6953, August 26, 7 p.m.,<anchor n="89"
                        xml:id="d58-f1"/> and 7138, September 1, 8 p.m.,<anchor n="90"
                        xml:id="d58-f2"/> the Department is prepared to meet the request of the
                    French National Committee of Liberation for an opportunity to consult with the
                    EAC on those questions directly affecting French interests.</p>
                <p>Accordingly you are authorized to agree to the submission to the representatives
                    of the French National Committee of Liberation of the text of the instrument of
                    unconditional surrender for Germany<anchor n="91" xml:id="d58-f3"/> and to an
                    invitation to the French to consult with the Commission with regard to the
                    surrender terms and other questions arising from them.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
