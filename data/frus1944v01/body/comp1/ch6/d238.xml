    <text>
        <body>
            <div xml:id="d238">

                <pb facs="0469" n="455" xml:id="pg455"/>

                <note rend="inline" type="source">740.00119 EAC/8–2344</note>
                <head>
                    <hi rendition="#italic">Memorandum by the United Kingdom Representative to the
                        European Advisory Commission</hi> (<hi rendition="#italic"
                        >Strang</hi>)<anchor n="71" xml:id="d238-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">E.A.C. (44) 24</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1944-08-21">21 August, 1944</date>.<anchor
                            n="72" xml:id="d238-f2"/>
                    </dateline>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Control Machinery for Austria</hi>
                </p>
                <p>I circulate, for consideration by the European Advisory Commission, the annexed
                    memorandum containing proposals for Control Machinery for Austria.</p>
                <closer>
                    <signed>W[<hi rendition="#small-caps">illiam</hi>] S[<hi rendition="#small-caps"
                            >trang</hi>]</signed>
                </closer>


                <xi:include href="d238-a1.xml" xpointer="d238-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d238-f1" n="71" type="source" xml:id="d238-f1-content">
                <p>Copy transmitted to the Department by the Ambassador in the United Kingdom in his
                    despatch 17616, August 23; received August 28.</p>
            </note>
            <note corresp="#d238-f2" n="72" xml:id="d238-f2-content">
                <p>Memorandum originally circulated in the European Advisory Commission by the
                    United Kingdom Representative on August 19.</p>
            </note>
        </listAnnotation>
