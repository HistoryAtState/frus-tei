    <text>
        <body>
            <div xml:id="d51">

                <pb facs="0090" n="80" sameAs="frus:frus1944v01/pg80"/>

                <note rend="inline" type="source">740.00119 European Advisory
                    Commission/10–2944</note>
                <head>
                    <hi rendition="#italic">The Soviet Ambassador</hi> (<hi rendition="#italic"
                        >Gromyko</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1944-10-29">October 29,
                        1944</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: I enclose herewith under
                    instructions from the Soviet Government a memorandum on the question of the
                    participation of France and other Allied Governments in the work of the European
                    Advisory Commission.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>A. <hi rendition="#small-caps">Gromyko</hi>
                    </signed>
                </closer>


                <xi:include href="d51-a1.xml" xpointer="d51-a1"/>
