    <text>
        <body>
            <div xml:id="d77">

                <pb facs="0133" n="126" sameAs="frus:frus1894Nicaragua/pg126"/>

                <head>No. 77.<lb/><hi rendition="#italic">Mr. Herbert to Mr. Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Navy Department</hi>,<lb/><hi rendition="#italic">Washington, D.
                                C.</hi></placeName>, <date calendar="gregorian" when="1894-07-19"
                                ><hi rendition="#italic">July 19,
                    1894</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith for
                    your information copy of a dispatch received this day from the commanding
                    officer of the U. S. S. <hi rendition="#italic">Marblehead</hi> in relation to
                    affairs on the Mosquito Coast.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">H. A. Herbert</hi>,<lb/><hi
                            rendition="#italic">Secretary of the Navy.</hi></signed></closer>


                <xi:include href="d77-a1.xml" xpointer="d77-a1"/>
            </div>
