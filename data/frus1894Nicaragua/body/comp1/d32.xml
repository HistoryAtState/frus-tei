    <text>
        <body>
            <div xml:id="d32">

                <pb facs="0054" n="47" sameAs="frus:frus1894Nicaragua/pg47"/>

                <head>No. 32.<lb/><hi rendition="#italic">Mr. Baker
                        to Mr. Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Managua</hi></placeName>, <date calendar="gregorian"
                            when="1894-04-10"><hi rendition="#italic">April 10, 1894</hi></date>.
                        (Received May 15.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Herewith I hand yon a copy of the agreement
                    entered into at Bluefields on the 19th of March for the temporary government and
                    the preservation of the peace of that place. The Spanish copy of this agreement
                    was furnished me by the foreign office of Nicaragua, and I accompany it with an
                    English translation.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Lewis Baker.</hi></signed></closer>




                <xi:include href="d32-a1.xml" xpointer="d32-a1"/>
