    <text>
        <body>
            <div xml:id="d20">

                <pb facs="0039" n="32" sameAs="frus:frus1894Nicaragua/pg32"/>

                <head>No. 20.<lb/><hi rendition="#italic">Mr. Braida to Mr. Uhl</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate of the United States</hi>,<lb/><hi rendition="#italic"
                                >Bluefields</hi></placeName>, <date calendar="gregorian"
                            when="1894-03-22"><hi rendition="#italic">March 22, 1894</hi></date>.
                        (Received March 31.)</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith copy
                    of my dispatch to Hon. L. Baker, United States minister at Managua.</p>
                <p>I beg to report that I shall stay here until the arrival of a United States war
                    ship or other orders, considering lives and property of our citizens not at all
                    secured.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">S. C. Braida</hi>,<lb/><hi
                            rendition="#italic">United States Consul</hi></signed></closer>


                <xi:include href="d20-a1.xml" xpointer="d20-a1"/>
            </div>
