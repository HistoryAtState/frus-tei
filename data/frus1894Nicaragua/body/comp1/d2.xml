    <text>
        <body>
            <div xml:id="d2">

                <pb facs="0016" n="9" sameAs="frus:frus1894Nicaragua/pg9"/>

                <head>No. 2.<lb/><hi rendition="#italic">Mr. Gresham to Mr. Baker.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-02-01"><hi rendition="#italic">February 1,
                        1894</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit for your information a copy of a
                        telegram<anchor n="1" xml:id="d2-f1"/> from our consular agent at
                    Blueflelds, Nicaragua, touching an invasion of the troops of Honduras at Cape
                    Gracias; also a copy of a letter of the Secretary of the Navy by which you will
                    see that the <hi rendition="#italic">Kearsarge</hi> has been ordered to that
                    quarter.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. Q. Gresham.</hi></signed></closer>



                <xi:include href="d2-a1.xml" xpointer="d2-a1"/>
            </div>
        </body>
    </text>
