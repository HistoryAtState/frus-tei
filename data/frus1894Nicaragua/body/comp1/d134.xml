    <text>
        <body>
            <div xml:id="d134">

                <pb facs="0209" n="202" xml:id="pg202"/>

                <head>No. 134.<lb/><hi rendition="#italic">Mr. McAdoo to Mr. Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Navy Department</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-12-21"><hi rendition="#italic">December 21,
                        1894</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith
                    extracts from a letter received this day from Capt. G. W. Sumner, U. S. N.,
                    commanding the U. S. S. <hi rendition="#italic">Columbia</hi>, and dated off
                    Kingston, Jamaica, December 11,</p>
                <p>Very respectfully,</p>
                <closer><signed><hi rendition="#small-caps">Wm. McAdoo</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>




                <xi:include href="d134-a1.xml" xpointer="d134-a1"/>
