    <text>
        <body>
            <div xml:id="d70-a3">

                <pb facs="0127" n="120" sameAs="frus:frus1894Nicaragua/pg120"/>

                <opener><seg rendition="#center">[Inclosure 3 in No. 70.]</seg></opener>
                <head><hi rendition="#italic">Proclamation.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Mosquito Reservation</hi>,<lb/><hi rendition="#italic"
                                >Bluefields</hi></placeName>, <date calendar="gregorian"
                            when="1894-07-06"><hi rendition="#italic">July 6,
                        1894</hi></date>.</dateline></opener>
                <p>I, Robert Henry Clarence, hereditary chief of Mosquito, hereby proclaim that I
                    have reassumed my rightful authority as chief of Mosquito; and I call upon all
                    law-abiding and loyal residents to obey my authority and that of my office.</p>
                <closer><signed><hi rendition="#small-caps">Robert Henry Clarence</hi>,<lb/><hi
                            rendition="#italic">Chief of Mosquito.</hi></signed></closer>
            </div>
        </body>
