    <text>
        <body>
            <div xml:id="d75">

                <pb facs="0131" n="124" sameAs="frus:frus1894Nicaragua/pg124"/>

                <head>No. 75.<lb/><hi rendition="#italic">Admiral Ramsay to Mr. Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Navy Department</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-07-17"><hi rendition="#italic">July 17,
                        1894</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith, for
                    your information, translation of a cipher dispatch, dated July 17, from the
                    commanding officer of the U. S. S. <hi rendition="#italic">Marblehead</hi>,
                    regarding the situation at Bluefields, Nicaragua.</p>
                <p>Very respectfully, etc.,</p>
                <closer><signed><hi rendition="#small-caps">F.M. Ramsay</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary of the Navy.</hi></signed></closer>



                <xi:include href="d75-a1.xml" xpointer="d75-a1"/>
            </div>
        </body>
    </text>
