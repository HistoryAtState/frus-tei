                <pb facs="0151" n="144" sameAs="frus:frus1894Nicaragua/pg144"/>

                <head>F.<lb/><hi rendition="#italic">Proclamation.</hi></head>
                <p>I, Robert Henry Clarence, hereditary chief of Mosquito, do hereby proclaim: That
                    I have reassumed my rightful authority as Chief of Mosquito, and I call upon nil
                    law-abiding and loyal residents to obey my authority and that of my
                    officers.</p>
                <closer><signed><hi rendition="#small-caps">Robert Henry Clarence</hi>,<lb/><hi
                            rendition="#italic">Chief of Mosquito</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps"
                                >Bluefields Mosquito Reserve</hi></placeName>. <date
                            calendar="gregorian" when="1804-07-06"><hi rendition="#italic">July 6,
                                1894</hi></date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
