    <text>
        <body>
            <div xml:id="d38-a10">

                <pb facs="0069" n="62" sameAs="frus:frus1894Nicaragua/pg62"/>

                <head><hi rendition="#small-caps">notice.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Bluefields</hi></placeName>, <date calendar="gregorian"
                            when="1894-03-15"><hi rendition="#italic">March 15,
                        1894</hi></date>.</dateline></opener>
                <p>Liquor shops, bars, and drinking saloons may now remain open from 6 a.m. until 6
                    p.m.</p>
                <closer>By order of: <signed><hi rendition="#small-caps">Reginald B.
                            Colmore</hi>,<lb/><hi rendition="#italic">Lieutenant,
                    etc</hi>.</signed></closer>
                <postscript>
                    <p>The above are copies of proclamations issued by Lieutenant Colmore, R. N.</p>
                </postscript>
            </div>
        </body>
    </text>
