    <text>
        <body>
            <div xml:id="d35">

                <pb facs="0056" n="49" sameAs="frus:frus1894Nicaragua/pg49"/>

                <head>No. 35.<lb/><hi rendition="#italic">Mr. Herbert to Mr. Gresham.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Navy Department</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1894-04-21"><hi rendition="#italic">April 21,
                        1894</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith for
                    your information a copy of a cablegram received on yesterday from the commanding
                    officer of the U. S. S, <hi rendition="#italic">San Francisco.</hi></p>
                <p>Very respectfully, etc.,</p>
                <closer><signed><hi rendition="#small-caps">H. A. Herbert.</hi></signed></closer>



                <xi:include href="d35-a1.xml" xpointer="d35-a1"/>
