    <text>
        <body>
            <div xml:id="d142">

                <pb facs="0237" n="157" sameAs="frus:frus1936v01/pg157"/>

                <note rend="inline" type="source">500.A15A3/1864</note>
                <head>
                    <hi rendition="#italic">The Japanese Ambassador</hi> (<hi
                            rendition="#italic">Saito</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 291</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1936-12-29">December 29,
                        1936</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor, under instructions from
                    my Government, to communicate to you the following:— <quote rend="blockquote">
                        <p>In response to the invocation of Article 21 of the London Naval Treaty of
                            1930 by the British Government to retain five subcategory (<hi
                                rendition="#italic">b</hi>) cruisers, namely the <hi
                                rendition="#italic">Cardiff, Ceres, Caledon, Calypso</hi> and <hi
                                rendition="#italic">Caradoc</hi>, the Government of Japan has
                            decided to retain the <hi rendition="#italic">Tsushima</hi> (3,120
                            tons), one of the subcategory (<hi rendition="#italic">b</hi>) cruisers
                            which are, under the Treaty above referred to, to be disposed of before
                            the end of this year.</p>
                    </quote>
                </p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hirosi Saito</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
