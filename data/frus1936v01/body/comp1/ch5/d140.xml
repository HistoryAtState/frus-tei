    <text>
        <body>
            <div xml:id="d140">

                <pb facs="0236" n="156" sameAs="frus:frus1936v01/pg156"/>

                <note rend="inline" type="source">500.A15A3/1861</note>
                <head>
                    <hi rendition="#italic">The Japanese Ambassador</hi> (<hi rendition="#italic"
                        >Saito</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 284</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1936-12-28">December 28,
                        1936</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor, under instructions from
                    my Government, to communicate to you the following: <quote rend="blockquote">
                        <p>The Government of Japan, perceiving that, in view of the present
                            international situation, the requirements of the national security of
                            Japan has made it necessary to retain 15,598 tons of submarines in
                            excess of the maximum tonnage which is permitted in Article 16, Clause 1
                            of the London Naval Treaty of 1930, has decided to invoke Article 21 of
                            that Treaty to retain the excess tonnage above referred to.</p>
                    </quote>
                </p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hirosi Saito</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
