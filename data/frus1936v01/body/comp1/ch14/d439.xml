    <text>
        <body>
            <div xml:id="d439">

                <pb facs="0613" n="533" sameAs="frus:frus1936v01/pg533"/>

                <note rend="inline" type="source">561.35E1/163</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi
                        rendition="#italic">Bingham</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 2439</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1936-08-10">August 10,
                        1936</date>.<lb/>[Received August 18.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to refer to my despatch
                    No. 2426 of August 6, 1936,<anchor n="20" xml:id="d439-f1"/> and to previous
                    correspondence relating to the proposed International Sugar Conference. I now
                    have the honor to forward a copy of a letter under date of August 7, 1936, which
                    has been received from the Foreign Office in regard to this matter.</p>
                <p>Respectfully yours,</p>
                <closer>For the Ambassador: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Herschel V. Johnson</hi>
                    </signed>
                    <lb/>
                    <hi rendition="#italic">First Secretary of Embassy</hi>
                </closer>


                <xi:include href="d439-a1.xml" xpointer="d439-a1"/>
            </div>
        </body>
    </text>
