                <pb facs="0128" n="48" sameAs="frus:frus1936v01/pg48"/>

                <note rend="inline" type="source">500.A15A5/638a: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chairman of the American Delegation</hi> (<hi
                            rendition="#italic">Davis</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1936-01-29T18:00:00-05:00">January 29, 1936—6
                            p.m.</date>
                    </dateline>
                </opener>
                <p>28. Has there been any discussion on the question of the scrapping called for
                    under the present treaties?</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
