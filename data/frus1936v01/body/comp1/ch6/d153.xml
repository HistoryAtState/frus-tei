    <text>
        <body>
            <div xml:id="d153">

                <pb facs="0244" n="164" xml:id="pg164"/>

                <note rend="inline" type="source">500.A15A3/1838: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi
                        rendition="#italic">Bingham</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1936-11-06T14:00:00+00:00">November 6, 1936—2
                            p.m.</date>
                        <lb/> [Received November 6—11:25 a.m.]</dateline>
                </opener>
                <p>515. Department’s instruction 1454, October 8.<anchor n="8" xml:id="d153-f1"/> I
                    signed submarine procès-verbal at the F[oreign] O[ffice] at noon today.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bingham</hi>
                    </signed>
                </closer>
                <postscript>
                    <p>[Text of the procès-verbal signed at London, November 6, 1936, is printed in
                        Department of State, <hi rendition="#italic">Treaty Information</hi>,
                        Bulletin No. 86, November 30, 1936, page 35, and in British Cmd. 5302; see
                        also statement issued by the Department of State, September 30, 1941, <ref
                            target="frus:frus1930v01/pg_130">
                            <hi rendition="#italic">Foreign Relations</hi>, 1930, volume I, page
                            130</ref>.]</p>
                </postscript>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d153-f1" n="8" xml:id="d153-f1-content">
                <p>Not printed; see Department’s telegram No. 367, October 8, 8 p.m., <hi
                        rendition="#italic">supra</hi>.</p>
