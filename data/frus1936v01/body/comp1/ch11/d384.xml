    <text>
        <body>
            <div xml:id="d384">

                <pb facs="0549" n="469" sameAs="frus:frus1936v01/pg469"/>

                <note rend="inline" type="source">500.C1199/242: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul at Geneva</hi> (<hi rendition="#italic"
                        >Gilbert</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Geneva</hi></placeName>, <date
                            calendar="gregorian" when="1936-10-02T17:00:00+01:00">October 2, 1936—5
                            p.m.</date>
                        <lb/> [Received October 2—1:05 p.m.]</dateline>
                </opener>
                <p>386. Have conveyed to Saavedra Lamas the contents of your 113, October 1, 6 p.m.,
                    and in the course of our conversation he expressed agreement with the points
                    covered therein and his appreciation for your message.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gilbert</hi>
                    </signed>
                </closer>
            </div>
        </body>
