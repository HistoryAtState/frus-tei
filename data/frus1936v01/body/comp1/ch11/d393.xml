        <body>
            <div xml:id="d393">

                <pb facs="0557" n="477" xml:id="pg477"/>

                <note rend="inline" type="source">500.C1199/247: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Consul at
                        Geneva</hi> (<hi rendition="#italic">Gilbert</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1936-11-23T12:00:00-05:00">November 23,
                            1936—noon</date>.</dateline>
                </opener>
                <p>146. Department will probably wish to offer suggestion concerning appointment of
                    American to Economic Committee. Ascertain from Stoppani latest date at which
                    suggestion could be made.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Moore</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
