    <text>
        <body>
            <div xml:id="d511">

                <pb facs="0704" n="624" sameAs="frus:frus1936v01/pg624"/>

                <note rend="inline" type="source">811.801 Wireless/104</note>
                <head>
                    <hi rendition="#italic">Representative Schuyler O.
                            Bland to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1936-06-11">June 11, 1936</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: I have your letter of the
                    11th instant<anchor n="8" xml:id="d511-f1"/> transmitting copy of a note from
                    the Belgian Embassy regarding S. 4619, amending the Communications Act of 1934
                    and requiring radio installations on shipboard.</p>
                <p>The Committee yesterday decided to table this bill for the remainder of the
                        session;<anchor n="9" xml:id="d511-f2"/> however, I am placing your letter
                    and the accompanying note on file for further consideration in the event the
                    matter is taken up at a later date.</p>
                <p>Yours very sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">S. O. Bland</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d511-f1" n="8" xml:id="d511-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d511-f2" n="9" xml:id="d511-f2-content">
                <p>This information was communicated on June 11 by telephone to the interested
                    Embassies and Legations.</p>
            </note>
        </listAnnotation>
    </standOff>
