                <pb facs="0324" n="244" sameAs="frus:frus1936v01/pg244"/>

                <note rend="inline" type="source">740.0011 Mutual Guarantee (Locarno)/431:
                    Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Chargé in the United Kingdom</hi> (<hi
                            rendition="#italic">Atherton</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1936-03-13T19:00:00-05:00">March 13, 1936—7
                            p.m.</date>
                    </dateline>
                </opener>
                <p>80. Your 117, March 13, 6 p.m. Considering all the circumstances we think it
                    would be preferable for you not to attend.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Phillips</hi>
                    </signed>
                </closer>
            </div>
        </body>
