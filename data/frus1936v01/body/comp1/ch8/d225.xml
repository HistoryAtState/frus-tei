    <text>
        <body>
            <div xml:id="d225">

                <pb facs="0345" n="265" sameAs="frus:frus1936v01/pg265"/>

                <note rend="inline" type="source">740.0011 Mutual Guarantee (Locarno)/496a:
                    Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in the United Kingdom</hi> (<hi
                            rendition="#italic">Atherton</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1936-03-23T16:00:00-05:00">March 23, 1936—4
                            p.m.</date>
                    </dateline>
                </opener>
                <p>89. I wish to express my appreciation of the careful and complete manner in which
                    you have kept us informed of the progress of the meeting in London of the
                    Council and of the Locarno powers.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
