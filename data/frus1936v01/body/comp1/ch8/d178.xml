    <text>
        <body>
            <div xml:id="d178">

                <pb facs="0287" n="207" sameAs="frus:frus1936v01/pg207"/>

                <note rend="inline" type="source">740.0011 Mutual Guarantee (Locarno)/394a:
                    Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in France</hi> (<hi rendition="#italic"
                            >Straus</hi>)<anchor n="51" xml:id="d178-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1936-03-07T15:00:00-05:00">March 7, 1936—3
                            p.m.</date>
                    </dateline>
                </opener>
                <p>67. Please keep us closely informed, hourly if necessary, of all important
                    developments in situation arising out of German action of today.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d178-f1" n="51" type="source" xml:id="d178-f1-content">
                <p>Also sent to the American Embassies in the United Kingdom and Germany as
                    Department’s telegrams Nos. 75 and 20, respectively.</p>
            </note>
        </listAnnotation>
    </standOff>
