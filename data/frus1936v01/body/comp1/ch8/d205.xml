    <text>
        <body>
            <div xml:id="d205">

                <pb facs="0324" n="244" sameAs="frus:frus1936v01/pg244"/>

                <note rend="inline" type="source">740.0011 Mutual Guarantee (Locarno)/431:
                    Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in the United Kingdom</hi> (<hi rendition="#italic">Atherton</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1936-03-13T18:00:00+00:00">March 13, 1936—6
                            p.m.</date>
                        <lb/> [Received March 13—2:55 p.m.]</dateline>
                </opener>
                <p>117. Aghnides<anchor n="93" xml:id="d205-f1"/> has offered me visitors ticket for
                    Council meeting tomorrow morning to give me the same facilities that Minister
                    Wilson has in Geneva on similar occasions. Are there any objections to my
                    attending?</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Atherton</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d205-f1" n="93" xml:id="d205-f1-content">
                <p>Thanassis Aghnides, director In the office of the Secretary-General, League of
                    Nations Secretariat.</p>
            </note>
        </listAnnotation>
    </standOff>
