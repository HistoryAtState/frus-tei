    <text>
        <body>
            <div xml:id="d571">

                <pb facs="0808" n="728" sameAs="frus:frus1936v01/pg728"/>

                <note rend="inline" type="source">811.79640/328</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi rendition="#italic">Bingham</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 2569</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1936-10-09">October 9,
                        1936</date>.<lb/>[Received October 16.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith copy
                    of the Embassy’s note to the Foreign Office No. 2085, of October 9, 1936, sent
                    pursuant to the Department’s telegraphic instruction No. 366, October 8, 7
                        p.m.<anchor n="93" xml:id="d571-f1"/>
                </p>
                <p>Respectfully yours,</p>
                <closer>For the Ambassador: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Ray Atherton</hi>
                    </signed>
                    <lb/>
                    <hi rendition="#italic">Counselor of Embassy</hi>
                </closer>


                <xi:include href="d571-a1.xml" xpointer="d571-a1"/>
            </div>
        </body>
    </text>
