    <text>
        <body>
            <div xml:id="d940">

                <pb facs="0955" n="867" sameAs="frus:frus1904/pg867"/>

                <head><hi rendition="#italic">Mr. Russell to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Caracas</hi></placeName>, <date calendar="gregorian" when="1903-12-06"
                                ><hi rendition="#italic">December 6, 1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 228.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a copy with
                    translation of a letter from the foreign office referring to the protest of
                    Venezuela against the award of the umpire in the Belgian claims. I also inclose
                    a copy with translation of the protest of the attorney-general of Venezuela
                    referred to.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">William W.
                    Russell.</hi></signed></closer>



                <xi:include href="d940-a1.xml" xpointer="d940-a1"/>
