    <text>
        <body>
            <div xml:id="d941">

                <pb facs="0957" n="869" sameAs="frus:frus1904/pg869"/>

                <head><hi rendition="#italic">Mr. Russell to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Caracas</hi></placeName>, <date calendar="gregorian" when="1903-12-27"
                                ><hi rendition="#italic">December 27, 1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 237.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that the
                    United States-Venezuelan claims commission which met in Caracas on June 1, 1903,
                    completed its work on the 26th instant. Several claims are still awaiting the
                    umpire’s decision.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">William W.
                    Russell.</hi></signed></closer>
            </div>
        </body>
    </text>
