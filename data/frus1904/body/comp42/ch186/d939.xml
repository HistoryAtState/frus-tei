    <text>
        <body>
            <div xml:id="d939">

                <pb facs="0954" n="866" sameAs="frus:frus1904/pg866"/>

                <head><hi rendition="#italic">Mr. Russell to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Caracas</hi></placeName>, <date calendar="gregorian" when="1903-11-29"
                                ><hi rendition="#italic">November 29, 1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 225.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: At the request of the minister for foreign
                    affairs I have the honor to inclose two documents, copies of attachments<anchor
                        n="a" xml:id="d939-f1"/> issued by the <pb facs="0955" n="867"
                        xml:id="pg867"/> local courts here against the property of the heirs of
                    Henry F. Rudloff.</p>
                <p>I am,</p>
                <closer><signed><hi rendition="#small-caps">William W.
                    Russell.</hi></signed></closer>
            </div>
        </body>
    </text>
