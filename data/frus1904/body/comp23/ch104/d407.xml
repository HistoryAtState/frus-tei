    <text>
        <body>
            <div xml:id="d407">

                <pb facs="0512" n="424" sameAs="frus:frus1904/pg424"/>

                <head><hi rendition="#italic">Mr. Griscom to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Tokyo,
                                Japan</hi></placeName>, <date calendar="gregorian" when="1904-08-15"
                                ><hi rendition="#italic">August 15,
                    1904</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    copy of a resume of official reports received by the Japanese Government
                    regarding the capture of the Russian destroyer <hi rendition="#italic"
                        >Ryeshitelni</hi> at Chefoo, informally communicated to me to-day by Baron
                    Komura.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Lloyd C. Griscom.</hi></signed></closer>


                <xi:include href="d407-a1.xml" xpointer="d407-a1"/>
            </div>
