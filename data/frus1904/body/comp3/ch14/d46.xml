    <text>
        <body>
            <div xml:id="d46">

                <pb facs="0134" n="46" sameAs="frus:frus1904/pg46"/>

                <head><hi rendition="#italic">Mr. Storer to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Vienna</hi></placeName>, <date calendar="gregorian" when="1904-05-18"
                                ><hi rendition="#italic">May 18, 1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 131.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to report that last
                    evening I received the official answer of the Government of Austria-Hungary to
                    the request for permission to visit Trieste and Fiume, as well as to remain in
                    Austro-Hungarian waters, on the part of our fleet.</p>
                <p>It will be seen from the copy and translation I have the honor to inclose that
                    the answer is in the affirmative. * * *</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Bellamy Storer.</hi></signed></closer>


                <xi:include href="d46-a1.xml" xpointer="d46-a1"/>
            </div>
