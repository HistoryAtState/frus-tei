    <text>
        <body>
            <div xml:id="d48">

                <pb facs="0155" n="67" sameAs="frus:frus1904/pg67"/>

                <head><hi rendition="#italic">Mr. Hengelmüller to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Imperial and Royal Austro-Hungarian Embassy</hi>,<lb/><hi
                                rendition="#italic">Washington</hi></placeName>, <hi
                            rendition="#italic">Monday</hi>, <date calendar="gregorian"
                            when="1904-04-18"><hi rendition="#italic">April 18,
                        1904</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: Referring to our
                    conversation of this morning, I beg to inclose herewith a memorandum with regard
                    to amendment to the Dillingham bill and Hungarian contracts with Cunard
                    Line.</p>
                <p>Yours, very truly,</p>
                <closer><signed><hi rendition="#small-caps">Hengelmüller.</hi></signed></closer>


                <xi:include href="d48-a1.xml" xpointer="d48-a1"/>
