    <text>
        <body>
            <div xml:id="d339">

                <pb facs="0439" n="351" sameAs="frus:frus1904/pg351"/>

                <head><hi rendition="#italic">Mr. Brown to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation,<lb/>Guatemala and Honduras</hi>,<lb/><hi
                                rendition="#italic">Guatemala</hi></placeName>, <date
                            calendar="gregorian" when="1904-05-18"><hi rendition="#italic">May 18,
                                1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 173.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>:</p>
                <p rendition="#center">* * * * * * *</p>
                <p>Concerning the relations of Guatemala to the other republics to the south, I
                    inclose herewith a copy and translation of the treaty of peace recently ratified
                    by the National Assembly of Guatemala, wherein the principles of noninterference
                    in the domestic affairs of each other and compulsory arbitration of disputes
                    between the signatory governments are recognized.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Philip Brown.</hi></signed></closer>



                <xi:include href="d339-a1.xml" xpointer="d339-a1"/>
                <xi:include href="d339-a2.xml" xpointer="d339-a2"/>
