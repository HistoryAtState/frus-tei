    <text>
        <body>
            <div xml:id="d21">

                <pb facs="0112" n="24" sameAs="frus:frus1904/pg24"/>

                <head><hi rendition="#italic">Mr. Dodge to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Berlin</hi></placeName>, <date calendar="gregorian" when="1904-04-25"
                                ><hi rendition="#italic">April 25, 1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 347.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to send to you inclosed
                    herewith two copies (with English translations) of the neutrality proclamation
                    of the German Government relating to the war now in progress between Russia and
                    Japan, dated February 13, 1904.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">H. Percival
                    Dodge.</hi></signed></closer>


                <xi:include href="d21-a1.xml" xpointer="d21-a1"/>
