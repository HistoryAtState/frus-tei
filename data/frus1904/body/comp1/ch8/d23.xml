    <text>
        <body>
            <div xml:id="d23">

                <pb facs="0113" n="25" xml:id="pg25"/>

                <head><hi rendition="#italic">Mr. Iddings to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic">Rome,
                            Italy</hi></placeName>, <date calendar="gregorian" when="1904-10-10"><hi
                                rendition="#italic">October 10, 1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 413.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In compliance with your unnumbered
                    instruction of September 23, 1904, I beg leave to send you herewith a copy of
                    the Official Gazette of February 11, 1904, containing the neutrality
                    proclamation issued by the Italian Government after the beginning of the war
                    between Japan and Russia.<anchor n="a" xml:id="d23-f1"/></p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Lewis Morris
                    Iddings.</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d23-f1" n="a" xml:id="d23-f1-content">
                <p>Not printed. The proclamation is expressed in the same terms as the proclamation
                    of April 25, 1898, printed in <ref target="frus1898#pg_874">Foreign Relations
                        1898, page 874</ref> et seq.</p>
            </note>
        </listAnnotation>
    </standOff>
