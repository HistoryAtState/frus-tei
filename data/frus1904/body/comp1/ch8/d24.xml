    <text>
        <body>
            <div xml:id="d24">

                <pb facs="0113" n="25" sameAs="frus:frus1904/pg25"/>

                <head><hi rendition="#italic">Mr. Clayton to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Mexico</hi></placeName>, <date calendar="gregorian" when="1904-10-07"
                                ><hi rendition="#italic">October 7, 1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 2467.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>:</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have the honor to inclose a copy and translation of Mr. Mariseal’s note of the
                    5th instant informing me that he had transmitted therewith two copies of the
                    Diario Oficial containing Mexico’s official declaration of neutrality.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Powell Clayton.</hi></signed></closer>



                <xi:include href="d24-a1.xml" xpointer="d24-a1"/>
                <xi:include href="d24-a2.xml" xpointer="d24-a2"/>
