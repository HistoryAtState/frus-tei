    <text>
        <body>
            <div xml:id="d11">

                <pb facs="0102" n="14" sameAs="frus:frus1904/pg14"/>

                <head><hi rendition="#italic">Mr. Loomis to Mr.________.</hi><anchor n="a"
                        xml:id="d11-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1904-09-23"><hi rendition="#italic">September 23,
                        1904</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: It is desired to have you obtain and
                    forward to the Department with the least possible delay copies of the neutrality
                    proclamations issued by the Government of ________ during the war between Russia
                    and Japan.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">F. B. Loomis</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d11-f1" n="a" type="source" xml:id="d11-f1-content">
                <p>This instruction was sent mutatis mutandis to the American representatives in
                    Austria, Belgium, Brazil, Chile, Great Britain, Italy, Mexico, The Netherlands,
                    Peru, and Spain.</p>
            </note>
        </listAnnotation>
    </standOff>
