    <text>
        <body>
            <div xml:id="d22">

                <pb facs="0112" n="24" sameAs="frus:frus1904/pg24"/>

                <head><hi rendition="#italic">Mr. Choate to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >London</hi></placeName>, <date calendar="gregorian" when="1904-10-15"
                                ><hi rendition="#italic">October 15, 1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1453.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: * * * I have the honor to inclose the
                    following documents, viz:</p>
                <p>(1) The King’s proclamation of neutrality issued on February 11 last.<anchor
                        n="a" xml:id="d22-f1"/> (2) Copy of a letter dated February 11 last,
                    addressed to the principal departments of His Majesty’s Government, informing
                    them of His Majesty’s resolution to maintain neutrality.<anchor n="b"
                        xml:id="d22-f2"/></p>
                <p rendition="#center">* * * * * * *</p>
                <p>I am, sir, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Joseph H. Choate.</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d22-f1" n="a" xml:id="d22-f1-content">
                <p>Printed in <ref target="frus1898#pg_862">Foreign Relations 1898, p.
                    862</ref>.</p>
            </note>
            <note corresp="#d22-f2" n="b" xml:id="d22-f2-content">
                <p>Not printed. The proclamation and the letter of instruction are expressed in the
                    same terms as the proclamation of April 26, 1898, and the letter of instruction
                    of April 23, 1898, printed on <ref target="frus1898#pg_865">pp. 865</ref> and
                        <ref target="frus1898#pg_869">869, respectively, in Foreign Relations
                        1898</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
