    <text>
        <body>
            <div xml:id="d7">

                <pb facs="0096" n="8" sameAs="frus:frus1904/pg8"/>

                <head>[Untitled]</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1904-08-05"><hi rendition="#italic">August 5,
                        1904</hi></date>.</dateline></opener>
                <p rendition="#flush"><hi rendition="#italic">To the Diplomatic Officers of the
                        United States.</hi></p>
                <p><hi rendition="#small-caps">Gentlemen</hi>: You are instructed to advise the
                    Government to which you are accredited that by an order, dated June 24, 1904,
                    the President has declared the Canal Zone of the Isthmus of Panama open to
                    commerce with friendly nations, and has established Ancon and Crystobal as ports
                    of entry in the said zone.</p>
                <p>I am, etc</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
