    <text>
        <body>
            <div xml:id="d1">

                <pb facs="0089" n="1" sameAs="frus:frus1904/pg1"/>

                <head><hi rendition="#italic">Mr. Hay to Mr._______</hi>.<anchor n="a"
                        xml:id="d1-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1904-01-19"><hi rendition="#italic">January 19,
                        1904</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information copy of a
                    circular instruction to the consular officers of the United States, including
                    those in the directing them to discharge, in representation of Panaman interests
                    until consular officers are appointed by that Government, and so far as may be
                    permitted by the Government of the _______ _________, the duties ordinarily
                    devolving upon consular officers.</p>
                <p>You will advise the Government of the ______ _______ of this, and request its
                    consent to the arrangement.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>


                <xi:include href="d1-a1.xml" xpointer="d1-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1-f1" n="a" type="source" xml:id="d1-f1-content">
                <p>Same instruction, mutatis mutandi, to all diplomatic representatives of the
                    United States.</p>
            </note>
        </listAnnotation>
    </standOff>
