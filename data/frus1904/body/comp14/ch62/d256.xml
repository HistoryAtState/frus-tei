    <text>
        <body>
            <div xml:id="d256">

                <pb facs="0382" n="294" sameAs="frus:frus1904/pg294"/>

                <head><hi rendition="#italic">Mr. Sampson to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Ecuador</hi></placeName>, <date calendar="gregorian" when="1904-01-04"
                                ><hi rendition="#italic">January 4, 1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 374.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: A treaty between Ecuador and Italy has
                    recently been published, and I send you a copy of the same and a hasty
                    translation., substantially correct.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Archibald J.
                    Sampson.</hi></signed></closer>


                <xi:include href="d256-a1.xml" xpointer="d256-a1"/>
