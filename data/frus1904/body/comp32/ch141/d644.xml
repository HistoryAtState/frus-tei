                <pb facs="0771" n="683" sameAs="frus:frus1904/pg683"/>

                <head><hi rendition="#italic">Mr. Adee to Mr. Neill.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1904-09-17"><hi rendition="#italic">September 17,
                        1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 341.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: * * * In relation to a hostile encounter
                    near Aguarico between Peruvian and Ecuadoran armed forces, you will inquire as
                    to the facts and express, unofficially, the earnest desire of the President that
                    peace may be preserved.</p>
                <p>I am, etc.</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
