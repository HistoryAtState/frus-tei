    <text>
        <body>
            <div xml:id="d646">

                <pb facs="0772" n="684" sameAs="frus:frus1904/pg684"/>

                <head><hi rendition="#italic">Mr. Dudley to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Lima,
                            Peru</hi></placeName>, <date calendar="gregorian" when="1904-01-30"><hi
                                rendition="#italic">January 30, 1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 852.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    translation of each of the two recent boundary treaties between Peru and
                    Bolivia, with an additional translation, “Modifications made by the Congress of
                    Bolivia to the treaties of September 23 and December 30, 1902.”</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Irving B. Dudley.</hi></signed></closer>




