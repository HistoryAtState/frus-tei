    <text>
        <body>
            <div xml:id="d143">

                <pb facs="0256" n="168" sameAs="frus:frus1904/pg168"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Conger.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1904-06-16"><hi rendition="#italic">June 16,
                        1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 810.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith a copy of a telegram
                    from Miss Anna B. Etzel, requesting that inquiry be made into the circumstances
                    of the death of her brother, Lewis L. Etzel, war correspondent, who was killed
                    by Chinese soldiers at Niuchwang on the 6th instant.</p>
                <p>You will investigate the matter and report your findings to the Department.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>


                <xi:include href="d143-a1.xml" xpointer="d143-a1"/>
