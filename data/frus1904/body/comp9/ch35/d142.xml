    <text>
        <body>
            <div xml:id="d142">

                <pb facs="0256" n="168" sameAs="frus:frus1904/pg168"/>

                <head><hi rendition="#italic">Mr. Loomis to Mr.
                            Conger.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1904-06-08"><hi rendition="#italic">June 8,
                        1904</hi></date>.</dateline></opener>
                <p>Have cabled Miller that Etzel’s relatives desire body sent to this country.</p>
                <closer><signed><hi rendition="#small-caps">Loomis.</hi></signed></closer>
            </div>
        </body>
    </text>
