    <text>
        <body>
            <div xml:id="d135">

                <pb facs="0237" n="149" sameAs="frus:frus1904/pg149"/>

                <head><hi rendition="#italic">Mr. Hay to Sir Chentung Liang-Cheng.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1904-05-31"><hi rendition="#italic">May 31,
                        1904</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Minister</hi>: I send you herewith,
                    according to the promise made to Prince Pu Lun, a letter from the President to
                    His Majesty the Emperor of China, to be delivered by His Imperial Highness.</p>
                <p>Yours, faithfully,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>


                <xi:include href="d135-a1.xml" xpointer="d135-a1"/>
            </div>
