                <pb facs="0236" n="148" sameAs="frus:frus1904/pg148"/>

                <head><hi rendition="#italic">Mr. Hay to Sir Chentung Liang-Cheng.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1904-04-12"><hi rendition="#italic">April 12,
                        1904</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Minister</hi>: The President will have
                    great pleasure in receiving His Imperial Highness Prince Pu Lun at the White
                    House on Monday, the 25th, at half past 2. He will also detail Colonel Symons,
                    of the United States Army, to be in attendance upon His Highness during his stay
                    in Washington.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
