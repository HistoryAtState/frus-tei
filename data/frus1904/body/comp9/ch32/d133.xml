    <text>
        <body>
            <div xml:id="d133">

                <pb facs="0236" n="148" sameAs="frus:frus1904/pg148"/>

                <head><hi rendition="#italic">Sir Chentung
                            Liang-Cheng to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Chinese Legation</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1904-04-22"><hi rendition="#italic">April 22,
                        1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 31.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith for
                    your information a translation of the letter from His Majesty the Emperor of
                    China to His Excellency the President of the United States, the original of
                    which Prince Pu Lun will deliver to its high destination on Monday.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Chentung
                    Liang-Cheng.</hi></signed></closer>



                <xi:include href="d133-a1.xml" xpointer="d133-a1"/>
