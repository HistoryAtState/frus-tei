    <text>
        <body>
            <div xml:id="d115">

                <pb facs="0223" n="135" sameAs="frus:frus1904/pg135"/>

                <head><hi rendition="#italic">Mr. Conger to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Peking,
                                China</hi></placeName>, <date calendar="gregorian" when="1904-05-25"
                                ><hi rendition="#italic">May 25, 1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1617.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith copy
                    of a translation of a Japanese proclamation which is being posted in various
                    places in Manchuria as rapidly as it is occupied by the Japanese army.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. H. Conger.</hi></signed></closer>


                <xi:include href="d115-a1.xml" xpointer="d115-a1"/>
