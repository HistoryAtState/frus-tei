    <text>
        <body>
            <div xml:id="d114">

                <pb facs="0222" n="134" sameAs="frus:frus1904/pg134"/>

                <head><hi rendition="#italic">Mr. Conger to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Peking,
                                China</hi></placeName>, <date calendar="gregorian" when="1904-05-24"
                                ><hi rendition="#italic">May 24, 1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1615.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith copy
                    of an Imperial edict of May 22, 1904, evidently issued for the purpose of
                    inspiring the people with confidence in the ability of the Government to
                    preserve peace, and urging them not to allow any idle rumors to disturb the
                    regular order of business.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. H. Conger.</hi></signed></closer>



                <xi:include href="d114-a1.xml" xpointer="d114-a1"/>
