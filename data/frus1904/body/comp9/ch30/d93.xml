    <text>
        <body>
            <div xml:id="d93">

                <pb facs="0210" n="122" sameAs="frus:frus1904/pg122"/>

                <head><hi rendition="#italic">Mr. Conger to Mr. Hay</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Peking,
                                China</hi></placeName>, <date calendar="gregorian" when="1904-02-15"
                                ><hi rendition="#italic">February 15, 1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1504.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Since writing my dispatch No. 1500, of
                    February 10, 1904, I have received two notes from the foreign office expressing
                    the fixed purpose of the Imperial court to remain in Peking and preserve order.
                    I inclose copies.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. H. Conger.</hi></signed></closer>




