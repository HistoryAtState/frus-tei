    <text>
        <body>
            <div xml:id="d98">

                <pb facs="0213" n="125" sameAs="frus:frus1904/pg125"/>

                <head><hi rendition="#italic">Mr. Conger to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Peking</hi></placeName>, <date calendar="gregorian" when="1904-02-23"
                                ><hi rendition="#italic">February 23, 1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1509.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to confirm your telegram of the 19th
                    instant. I have communicated this information to the Chinese Government in a
                    note, copy of which I inclose.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. H. Conger.</hi></signed></closer>



                <xi:include href="d98-a1.xml" xpointer="d98-a1"/>
