    <text>
        <body>
            <div xml:id="d94">

                <pb facs="0211" n="123" sameAs="frus:frus1904/pg123"/>

                <head><hi rendition="#italic">Mr. Conger to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Peking,
                                China</hi></placeName>, <date calendar="gregorian" when="1904-02-15"
                                ><hi rendition="#italic">February 15, 1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1505.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Continuing the subject-matter of my No.
                    1502, of the 13th instant, I have the honor to transmit translation of another
                    note received from Prince Ch’ing, embodying an imperial edict of February 12,
                    1904.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. H. Conger.</hi></signed></closer>



                <xi:include href="d94-a1.xml" xpointer="d94-a1"/>
