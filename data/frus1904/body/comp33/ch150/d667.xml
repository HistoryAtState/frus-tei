    <text>
        <body>
            <div xml:id="d667">

                <pb facs="0789" n="701" sameAs="frus:frus1904/pg701"/>

                <head><hi rendition="#italic">Mr. Bryan to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Lisbon</hi></placeName>, <date calendar="gregorian" when="1904-06-18"
                                ><hi rendition="#italic">June 18, 1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 85.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to send inclosed the
                    Portuguese version, with translation, of the arbitration treaty between this
                    country and Spain.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles Page
                    Bryan.</hi></signed></closer>


                <xi:include href="d667-a1.xml" xpointer="d667-a1"/>
