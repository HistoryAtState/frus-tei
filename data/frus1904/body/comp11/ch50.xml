                <pb facs="0331" n="243" xml:id="pg243"/>

                <head>Treaty between the United States and Cuba embodying the provisions defining
                    the future relations of the United States with Cuba contained in the act of
                    Congress approved March 2, 1901, making appropriations for the Army</head>
                <p><hi rendition="#italic">Signed at Habana, May 22, 1903.<lb/>Ratification advised
                        by the Senate, March 22, 1904.<lb/>Ratified by the President, June 25,
                        1904.<lb/>Ratified by Cuba, June 20, 1904.<lb/>Ratifications exchanged at
                        Washington, July 1, 1904.<lb/>Proclaimed, July 2, 1904.</hi></p>

                <xi:include href="ch50/d207.xml" xpointer="d207"/>
