    <text>
        <body>
            <div xml:id="d210">

                <pb facs="0338" n="250" xml:id="pg250"/>

                <head><hi rendition="#italic">Mr. Sleeper to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Habana</hi></placeName>, <date calendar="gregorian" when="1904-10-28"
                                ><hi rendition="#italic">October 28, 1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1104.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith copy
                    of the September report from the consulate at Santiago relative to the general
                    conditions existing in that province.</p>
                <p>I especially desire to call the Department’s attention to the paragraphs on
                    sanitation and water supply.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Jacob Sleeper.</hi></signed></closer>


                <xi:include href="d210-a1.xml" xpointer="d210-a1"/>
