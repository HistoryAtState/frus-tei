    <text>
        <body>
            <div xml:id="d213">

                <pb facs="0340" n="252" sameAs="frus:frus1904/pg252"/>

                <head><hi rendition="#italic">Mr. Squiers to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Habana</hi></placeName>, <date calendar="gregorian" when="1904-12-03"
                                ><hi rendition="#italic">December 3, 1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1137.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith copies
                    of sanitary reports from the American consul at Santiago and the American
                    consular agent at Cardenas, the former referring to an alleged case of yellow
                    fever at Santiago city and the latter to general sanitary conditions at
                    Cardenas.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">H. G. Squiers.</hi></signed></closer>




                <xi:include href="d213-a1.xml" xpointer="d213-a1"/>
