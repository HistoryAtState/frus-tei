    <text>
        <body>
            <div xml:id="d205">

                <pb facs="0327" n="239" sameAs="frus:frus1904/pg239"/>

                <head><hi rendition="#italic">Mr. Squiers to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Habana</hi></placeName>, <date calendar="gregorian" when="1904-04-23"
                                ><hi rendition="#italic">April 23, 1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 926.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a
                    translation of the President’s message transmitted to Congress on the 4th
                    instant.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">H. G. Squiers.</hi></signed></closer>



                <xi:include href="d205-a1.xml" xpointer="d205-a1"/>
