    <text>
        <body>
            <div xml:id="d306">

                <pb facs="0417" n="329" sameAs="frus:frus1904/pg329"/>

                <head><hi rendition="#italic">Mr. White to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >London</hi></placeName>, <date calendar="gregorian" when="1904-04-13"
                                ><hi rendition="#italic">April 13, 1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1346.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith two
                    copies of a parliamentary paper, which has been issued this day, containing a
                    dispatch from the Marquess of Lansdowne to the British ambassador at Paris,
                    forwarding the agreements between the British and French Governments, which were
                    signed on the 8th instant, for the settlement of the questions at issue between
                    the two countries.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry White.</hi></signed></closer>


                <xi:include href="d306-a1.xml" xpointer="d306-a1"/>
            </div>
