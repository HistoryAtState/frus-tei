    <text>
        <body>
            <div xml:id="d917">

                <pb facs="0941" n="853" sameAs="frus:frus1904/pg853"/>

                <head><hi rendition="#italic">Mr. Finch to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Montevideo,
                                Uruguay</hi></placeName>, <date calendar="gregorian"
                            when="1904-10-19"><hi rendition="#italic">October 19,
                        1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 787.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose copy and translation of a note
                    from the minister of foreign relations of Uruguay dated the 17th instant, in
                    which he states that the Assembly General has approved the peace negotiations
                    submitted to it by the President, thereby ending the armed struggle which has
                    existed in this Republic for the preceding ten months.</p>
                <p>Respectfully,</p>
                <closer><signed><hi rendition="#small-caps">William R. Finch.</hi></signed></closer>


                <xi:include href="d917-a1.xml" xpointer="d917-a1"/>
