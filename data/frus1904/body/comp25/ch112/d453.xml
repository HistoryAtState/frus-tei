    <text>
        <body>
            <div xml:id="d453">

                <pb facs="0547" n="459" sameAs="frus:frus1904/pg459"/>

                <head><hi rendition="#italic">Mr. Lyon to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Monrovia</hi></placeName>, <date calendar="gregorian" when="1904-06-14"
                                ><hi rendition="#italic">June 14, 1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 53.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose an editorial
                    which appeared in one of the newspapers published in Monrovia, Liberia. This is
                    one of many editorial expressions in approval of the position we have, taken
                    upon the subject of emigration.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Ernest Lyon.</hi></signed></closer>



                <xi:include href="d453-a1.xml" xpointer="d453-a1"/>
            </div>
