    <text>
        <body>
            <div xml:id="d698">

                <pb facs="0807" n="719" sameAs="frus:frus1904/pg719"/>

                <head><hi rendition="#italic">Mr. McCormick to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1904-04-30"><hi rendition="#italic">April 30,
                        1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 127.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the Department’s instructions
                    No. 96, of the 11th instant, I have the honor to include a translation of a note
                    from the ministry for foreign affairs on the subject of the Japanese press boat
                        <hi rendition="#italic">Hanyei Maru</hi> and further stating that the
                    Japanese servants of Messrs. Washburn and Little have been set free.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Robert S.
                    McCormick.</hi></signed></closer>


                <xi:include href="d698-a1.xml" xpointer="d698-a1"/>
