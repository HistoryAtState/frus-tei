    <text>
        <body>
            <div xml:id="d707">

                <pb facs="0809" n="721" sameAs="frus:frus1904/pg721"/>

                <head><hi rendition="#italic">Mr. McCormick to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1904-06-30"><hi rendition="#italic">June 30,
                        1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 164.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In compliance with your instruction No. 92,
                    of April 1, 1904, I have the honor to inform you that I have forwarded to the
                    Japanese minister at Berlin a list of Japanese prisoners of war transmitted to
                    me by the imperial ministry for foreign affairs.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Robert S.
                    McCormick.</hi></signed></closer>
            </div>
        </body>
