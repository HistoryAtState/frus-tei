    <text>
        <body>
            <div xml:id="d682">

                <pb facs="0799" n="711" sameAs="frus:frus1904/pg711"/>

                <head><hi rendition="#italic">Mr. McCormick to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1904-08-19"><hi rendition="#italic">August 19,
                        1904</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith, for
                    the information of the Department, the French text of temporary regulations for
                    the protection of certain Russian ports in time of war.</p>
                <p>I have etc.,</p>
                <closer><signed><hi rendition="#small-caps">Robert S.
                    McCormick.</hi></signed></closer>


                <xi:include href="d682-a1.xml" xpointer="d682-a1"/>
