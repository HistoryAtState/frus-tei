                <pb facs="0854" n="766" xml:id="pg766"/>

                <head><hi rendition="#italic">Mr. Adee to Mr.
                            McCormick.</hi></head>
                <opener><seg rendition="#center">[Telegram.—Paraphrase.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1904-09-16"><hi rendition="#italic">September 16,
                        1904</hi></date>.</dateline></opener>
                <p>(Mr. Adee requests Mr. McCormick to send to the Department without delay the
                    answer of the minister for foreign affairs to Mr. McCormick’s notes
                    communicating Department’s Nos. 143 and 144.)</p>
            </div>
        </body>
