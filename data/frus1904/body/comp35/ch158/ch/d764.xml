    <text>
        <body>
            <div xml:id="d764">

                <pb facs="0858" n="770" xml:id="pg770"/>

                <head><hi rendition="#italic">Mr. McCormick to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1904-09-23"><hi rendition="#italic">23 September,
                        1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 189.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a list
                    of the members of the admiralty court which will hear the appeal in the cases of
                    the <hi rendition="#italic">Knight Commander, Arabia</hi>, and <hi
                        rendition="#italic">Calchas.</hi> * * *</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Robert S.
                    McCormick.</hi></signed></closer>


                <xi:include href="d764-a1.xml" xpointer="d764-a1"/>
