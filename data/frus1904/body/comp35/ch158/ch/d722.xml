    <text>
        <body>
            <div xml:id="d722">

                <pb facs="0815" n="727" sameAs="frus:frus1904/pg727"/>

                <head><hi rendition="#italic">Mr. McCormick to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1904-03-09"><hi rendition="#italic">March 9,
                        1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 98.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit to you
                    herewith the Russian text and translation of the order of His Majesty the
                    Emperor of Russia, communicated to the Senate by the minister of justice,
                    sanctioning the rules to be observed by the Russian Government during the war
                    with Japan.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Robert S.
                    McCormick.</hi></signed></closer>


                <xi:include href="d722-a1.xml" xpointer="d722-a1"/>
