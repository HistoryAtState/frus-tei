                <pb facs="0488" n="400" xml:id="pg400"/>

                <head><hi rendition="#italic">Mr. Powell to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Port an
                                Prince</hi></placeName>, <date calendar="gregorian"
                            when="1904-09-05"><hi rendition="#italic">September 5,
                        1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1530.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to communicate to the
                    Department a dispatch received from the foreign office from the Hon. M. Férère,
                    in regard to the fraudulent naturalization papers of Syrians. In this
                    communication he refers to certain statements made to him by the Hon. J. N.
                    Léger, the Haitian minister at Washington.</p>
                <p>I also inclose copy of my reply.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. F. Powell.</hi></signed></closer>




                <xi:include href="d373-a1.xml" xpointer="d373-a1"/>
