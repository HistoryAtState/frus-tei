    <text>
        <body>
            <div xml:id="d377">

                <pb facs="0491" n="403" sameAs="frus:frus1904/pg403"/>

                <head><hi rendition="#italic">Mr. Adee to Mr. Powell.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1904-09-26"><hi rendition="#italic">September 26,
                        1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 640.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your No. 1520, of August 31
                    last, I inclose for your information and guidance copy of a letter from the
                    Acting Attorney-General reporting concerning the fraudulent naturalization of
                    Antoine Kalil Hage.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>




                <xi:include href="d377-a1.xml" xpointer="d377-a1"/>
