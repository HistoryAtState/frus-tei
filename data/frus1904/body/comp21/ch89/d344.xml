    <text>
        <body>
            <div xml:id="d344">

                <pb facs="0458" n="370" sameAs="frus:frus1904/pg370"/>

                <head><hi rendition="#italic">Mr. Hay to Mr.
                            Léger.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1904-05-25"><hi rendition="#italic">May 25,
                        1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 76.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 7th instant, in which you inclose drafts of a treaty of
                    extradition between the United States and Haiti and of a treaty of amity between
                    the same parties.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>The Department will, at an early date, again communicate with you on the subject
                    of the treaty of amity.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay.</hi></signed></closer>
            </div>
        </body>
    </text>
