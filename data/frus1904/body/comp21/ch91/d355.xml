    <text>
        <body>
            <div xml:id="d355">

                <pb facs="0471" n="383" sameAs="frus:frus1904/pg383"/>

                <head><hi rendition="#italic">Mr. Powell to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Santo Domingo
                                City</hi></placeName>, <date calendar="gregorian" when="1904-02-08"
                                ><hi rendition="#italic">February 8, 1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. “Q.”]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to submit to the
                    Department a copy of a dispatch forwarded to the minister of foreign relations,
                    Hon. M. Férère, in regard to the subject of license taxes, in accordance with
                    instructions from the Department.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. F. Powell.</hi></signed></closer>


                <xi:include href="d355-a1.xml" xpointer="d355-a1"/>
