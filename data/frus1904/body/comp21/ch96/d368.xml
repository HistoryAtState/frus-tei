    <text>
        <body>
            <div xml:id="d368">

                <pb facs="0484" n="396" sameAs="frus:frus1904/pg396"/>

                <head><hi rendition="#italic">Mr. Powell to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Port au
                                Prince</hi></placeName>, <date calendar="gregorian"
                            when="1904-08-25"><hi rendition="#italic">August 25,
                        1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1510.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose to the
                    Department the correspondence that has passed between this legation and the
                    department of foreign relations regarding the law affecting the status of
                    Syrians that have become American citizens through naturalization, and which law
                    has recently been put in force.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. F. Powell.</hi></signed></closer>


                <xi:include href="d368-a1.xml" xpointer="d368-a1"/>
