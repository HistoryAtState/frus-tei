    <text>
        <body>
            <div xml:id="d538">

                <pb facs="0627" n="539" sameAs="frus:frus1904/pg539"/>

                <head><hi rendition="#italic">Mr. Merry to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">San José, Costa
                                Rica</hi></placeName>, <date calendar="gregorian" when="1904-02-25"
                                ><hi rendition="#italic">February 25, 1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 921.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In acknowledgment of your No. 575, of
                    February 4, and No. 576, of February 9, inclosing the complaint presented by the
                    attorneys <pb facs="0628" n="540" xml:id="pg540"/> of the Salvador Commercial
                    Company, elated February 3, 1904, I have the honor to forward herewith copy of
                    the dispatch which goes forward from this legation by first mail to the
                    Government of El Salvador in compliance with instructions received from you.</p>
                <p rendition="#center">* * * * * * *</p>
                <p>With assurances, etc.,</p>
                <closer><signed><hi rendition="#small-caps">William Lawrence
                    Merry.</hi></signed></closer>


                <xi:include href="d538-a1.xml" xpointer="d538-a1"/>
