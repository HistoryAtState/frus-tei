    <text>
        <body>
            <div xml:id="d471">

                <pb facs="0566" n="478" sameAs="frus:frus1904/pg478"/>

                <head><hi rendition="#italic">Mr. Hay to Señor
                            Gamhoa.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1904-10-19"><hi rendition="#italic">October 19,
                        1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 522.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to the Department’s note No. 521,
                    of the 13th instant, I have the honor to inclose herewith for your information
                    copies of a letter and of its inclosures from the governor of Texas containing
                    further information regarding the sentence imposed upon Mr. Eulogio Zambrano by
                    the court of Cameron County, Tex.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hay</hi>.</signed></closer>




                <xi:include href="d471-a1.xml" xpointer="d471-a1"/>
