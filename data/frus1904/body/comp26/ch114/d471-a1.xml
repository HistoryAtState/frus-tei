    <text>
        <body>
            <div xml:id="d471-a1">

                <pb facs="0567" n="479" xml:id="pg479"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <head><hi rendition="#italic">Mr. Cravens to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Executive Office, State of Texas</hi>,<lb/><hi rendition="#italic"
                                >Austin</hi></placeName>, <date calendar="gregorian"
                            when="1904-10-12"><hi rendition="#italic">October 12,
                        1904</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your communication of the 24th
                    ultimo, with reference to the complaint of Eulogio Zambrano, a Mexican subject,
                    with reference to his treatment by the officers of Cameron County, I have the
                    honor to inclose you herewith copies of documents relating thereto. * * *</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">N. A. Cravens</hi>,<lb/><hi
                            rendition="#italic">Private Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
