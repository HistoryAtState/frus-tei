    <text>
        <body>
            <div xml:id="d480">

                <pb facs="0573" n="485" sameAs="frus:frus1904/pg485"/>

                <head><hi rendition="#italic">Mr. Clayton to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Mexico</hi></placeName>, <date calendar="gregorian" when="1904-04-11"
                                ><hi rendition="#italic">April 11, 1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 2235.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose copy and
                    translation of the message of the President, delivered at the opening of the
                    Mexican Congress, on the 1st instant.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Powell Clayton.</hi></signed></closer>



                <xi:include href="d480-a1.xml" xpointer="d480-a1"/>
