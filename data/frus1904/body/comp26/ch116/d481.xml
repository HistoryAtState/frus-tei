    <text>
        <body>
            <div xml:id="d481">

                <pb facs="0575" n="487" sameAs="frus:frus1904/pg487"/>

                <head><hi rendition="#italic">Mr. Clayton to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Mexico</hi></placeName>, <date calendar="gregorian" when="1904-10-12"
                                ><hi rendition="#italic">October 12, 1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 2481.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    clipping from the Diario Oficial containing the message of President Diaz
                    delivered at the opening of Twenty-second Mexican Congress, on the 16th ultimo,
                    together with a clipping from the Mexican Herald containing a translation of the
                    same.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Powell Clayton.</hi></signed></closer>


                <xi:include href="d481-a1.xml" xpointer="d481-a1"/>
            </div>
        </body>
    </text>
