    <text>
        <body>
            <div xml:id="d549-a1">

                <pb facs="0649" n="561" sameAs="frus:frus1904/pg561"/>

                <opener><seg rendition="#center">[Inclosure.]</seg></opener>
                <head><hi rendition="#italic">Memorandum on yellow-fever cases submitted to Minister
                        Barrett by Doctor Garter, December 20, 1904.</hi></head>
                <table cols="6" rows="11">
                    <row role="label">
                        <cell rendition="#border-bottom #border-top #border-right">Case.</cell>
                        <cell rendition="#border-bottom #border-top #border-right">Name.</cell>
                        <cell rendition="#border-bottom #border-top #border-right"
                            >Nationality.</cell>
                        <cell cols="2" rendition="#border-bottom #border-top #border-right"
                            >Developed.</cell>
                        <cell rendition="#border-bottom #border-top">Result.</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">First</cell>
                        <cell rendition="#border-right">Charles Cunningham</cell>
                        <cell rendition="#border-right">Scotland</cell>
                        <cell>July</cell>
                        <cell rendition="#border-right" role="num">12</cell>
                        <cell>Died July 14.</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">Second</cell>
                        <cell rendition="#border-right">Antonio G. Herrera</cell>
                        <cell rendition="#border-right">Spam</cell>
                        <cell>July</cell>
                        <cell rendition="#border-right" role="num">28</cell>
                        <cell>Recovered.</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">Third</cell>
                        <cell rendition="#border-right">Damien Barbato</cell>
                        <cell rendition="#border-right">Italian</cell>
                        <cell>Sept.</cell>
                        <cell rendition="#border-right" role="num">10</cell>
                        <cell>Died Sept. 11 (12 hours after admission).</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">Fourth</cell>
                        <cell rendition="#border-right">Ernesto Rufo</cell>
                        <cell rendition="#border-right">do</cell>
                        <cell>Oct.</cell>
                        <cell rendition="#border-right" role="num">11</cell>
                        <cell>Recovered.</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">Fifth</cell>
                        <cell rendition="#border-right"/>
                        <cell rendition="#border-right">do</cell>
                        <cell>Nov.</cell>
                        <cell rendition="#border-right" role="num">17</cell>
                        <cell>Do.</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">Sixth</cell>
                        <cell rendition="#border-right">Mrs. Cody<anchor n="a" xml:id="d549-f1"
                            /></cell>
                        <cell rendition="#border-right">American</cell>
                        <cell cols="2" rendition="#border-right"/>
                        <cell>Do.</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">Seventh</cell>
                        <cell rendition="#border-right">–– ––<anchor n="b" xml:id="d549-f2"/></cell>
                        <cell rendition="#border-right">Syrian</cell>
                        <cell>Dec.</cell>
                        <cell rendition="#border-right" role="num">1</cell>
                        <cell>(<anchor n="c" xml:id="d549-f3"/>)</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">Eighth</cell>
                        <cell rendition="#border-right">Jose</cell>
                        <cell rendition="#border-right">Spain</cell>
                        <cell>Dec.</cell>
                        <cell rendition="#border-right" role="num">5</cell>
                        <cell>Recovered.</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">Ninth</cell>
                        <cell rendition="#border-right">Miss Reeves</cell>
                        <cell rendition="#border-right">Canada</cell>
                        <cell>Dec.</cell>
                        <cell rendition="#border-right" role="num">7</cell>
                        <cell>Do.</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right #border-bottom">Tenth</cell>
                        <cell rendition="#border-right #border-bottom">Allan Watson</cell>
                        <cell rendition="#border-right #border-bottom">Scotland</cell>
                        <cell rendition="#border-bottom">Dec.</cell>
                        <cell rendition="#border-right #border-bottom" role="num">14</cell>
                        <cell rendition="#border-bottom">Do.</cell>
                    </row>
                </table>
                <p>An abstract of the official record in the office of the chief sanitary
                    officer.</p>
                <closer><signed><hi rendition="#small-caps">H. R. Carter</hi>,<lb/><hi
                            rendition="#italic">Surgeon, United States Public Health and
                            Marine-Hospital Service,<lb/>Chief Quarantine
                    Officer.</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d549-f1" n="a" xml:id="d549-f1-content">
                <p>Developed in Colon; contracted in Panama.</p>
            </note>
            <note corresp="#d549-f2" n="b" xml:id="d549-f2-content">
                <p>Developed en route from Panama to Guayaquil; source of infection unknown.</p>
            </note>
            <note corresp="#d549-f3" n="c" xml:id="d549-f3-content">
                <p>Result unknown. From private advices from Guayaquil it is learned that No. 7
                    recovered.</p>
            </note>
        </listAnnotation>
    </standOff>
</TEI>
