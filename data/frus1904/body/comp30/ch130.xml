                <pb facs="0631" n="543" sameAs="frus:frus1904/pg543"/>

                <head>Convention between the United States and the Republic of Panama for the
                    construction of a ship canal to connect the waters of the Atlantic and Pacific
                    oceans</head>
                <p><hi rendition="#italic">Signed at Washington, November 18, 1903.<lb/>Ratification
                        advised by the Senate, February 23, 1904.<lb/>Ratified by the President,
                        February 25, 1904.<lb/>Ratified by Panama, December 2,
                        1903.<lb/>Ratifications exchanged at Washington, February 26,
                        1904.<lb/>Proclaimed, February 26, 1904</hi>.</p>

                <xi:include href="ch130/d542.xml" xpointer="d542"/>
