                <pb facs="0733" n="645" xml:id="pg645"/>

                <head><hi rendition="#italic">Mr. Barrett to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Panama</hi></placeName>, <date calendar="gregorian" when="1904-09-13"
                                ><hi rendition="#italic">September 13, 1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 40.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge and confirm
                    telegrams received and sent by this legation.</p>
                <p>I beg to state that the police of Panama have been notified, and that every
                    possible precaution has been taken by them and by this legation to apprehend the
                    individual in question.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Barrett.</hi></signed></closer>
            </div>
        </body>
    </text>
