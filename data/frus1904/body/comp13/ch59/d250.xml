                <pb facs="0374" n="286" sameAs="frus:frus1904/pg286"/>

                <head><hi rendition="#italic">Mr. Powell to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Santo Domingo
                                City, D. R.</hi></placeName>, <date calendar="gregorian"
                            when="1904-02-12"><hi rendition="#italic">February 12,
                        1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 766, San Domingo series.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose to the
                    Department the correspondence relating to the Villain incident.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. F. Powell.</hi></signed></closer>








