    <text>
        <body>
            <div xml:id="d227">

                <pb facs="0349" n="261" sameAs="frus:frus1904/pg261"/>

                <head><hi rendition="#italic">Mr. Powell to Mr.
                            Hay</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Santo Domingo
                                City, D. R.</hi></placeName>, <date calendar="gregorian"
                            when="1903-12-03"><hi rendition="#italic">December 3,
                        1903</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 680. Santo Domingo Series.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose to the
                    Department the correspondence that it has passed between the provisional
                    government and this legation, on the subject of recognizing the present
                    government.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. F. Powell.</hi></signed></closer>



