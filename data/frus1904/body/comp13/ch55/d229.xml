    <text>
        <body>
            <div xml:id="d229">

                <pb facs="0353" n="265" sameAs="frus:frus1904/pg265"/>

                <head><hi rendition="#italic">Mr. Loomis to Mr. Powell.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State.</hi><lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1904-01-09"><hi rendition="#italic">January 9,
                        1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 210. Santo Domingo series.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 686, of the 15th ultimo, inclosing copies of your correspondence with the
                    Morales Government, relative to the question of its recognition by the United
                    States.</p>
                <p>Your notes are approved.</p>
                <p>This Government holds the question still under consideration, awaiting a more
                    settled state of affairs in the Dominican Republic.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">F. B. Loomis</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
