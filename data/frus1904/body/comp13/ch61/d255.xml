    <text>
        <body>
            <div xml:id="d255">

                <pb facs="0381" n="293" sameAs="frus:frus1904/pg293"/>

                <head><hi rendition="#italic">Mr. Adee to Mr.
                            Dawson.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1904-08-31"><hi rendition="#italic">August 31,
                        1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 20.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    dispatch No. 14, of the 13th instant, inclosing correspondence in relation to
                    the imprisonment of Francisco Martinez, a Porto Rican, at Macoris, and to inform
                    you that your course in the case is approved by the Department.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
