                <pb facs="0357" n="269" sameAs="frus:frus1904/pg269"/>

                <opener><seg rendition="#center">[Inclosure 4.]</seg></opener>
                <head><hi rendition="#italic">Captain Miller to Mr.
                            Powell.</hi></head>
                <p>To <hi rendition="#small-caps">Minister</hi>: I shall send a guard to you at
                    12.30 to escort the Germans to the city.</p>
                <closer><signed><hi rendition="#small-caps">Miller.</hi></signed></closer>
            </div>
