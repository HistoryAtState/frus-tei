    <text>
        <body>
            <div xml:id="d524">

                <pb facs="0607" n="519" sameAs="frus:frus1904/pg519"/>

                <head><hi rendition="#italic">Mr. Newel to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">The
                            Hague</hi></placeName>, <date calendar="gregorian" when="1904-08-05"><hi
                                rendition="#italic">August 5, 1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 777.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to state that I am
                    informed that Mexico and Venezuela have paid their quotas of the honoraria to
                    the members of the arbitral tribunal constituted in virtue of the protocols of
                    Washington of May 7, 1903.</p>
                <p>It is expected that the Spanish quota will be paid in a few days.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Stanford Newel.</hi></signed></closer>
            </div>
        </body>
    </text>
