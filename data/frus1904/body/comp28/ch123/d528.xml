    <text>
        <body>
            <div xml:id="d528">

                <pb facs="0610" n="522" xml:id="pg522"/>

                <head><hi rendition="#italic">Mr. Newel to Mr. Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">The
                            Hague</hi></placeName>, <date calendar="gregorian" when="1904-02-19"><hi
                                rendition="#italic">February 19, 1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 717.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: * * * I have the honor to inclose herewith
                    a copy of the correspondence that has passed between this legation and the
                    foreign office on the subject of the neutrality of China, consisting of my note
                    of the 11th instant, the reply of the minister of foreign affairs, just
                    received, and a translation of the latter.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Stanford Newel.</hi></signed></closer>



                <xi:include href="d528-a1.xml" xpointer="d528-a1"/>
