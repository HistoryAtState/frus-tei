    <text>
        <body>
            <div xml:id="d529">

                <pb facs="0611" n="523" sameAs="frus:frus1904/pg523"/>

                <head><hi rendition="#italic">Mr. Adee to Baron Gevers.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1904-02-16"><hi rendition="#italic">February 16,
                        1904</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Minister</hi>: Mr. Hay has requested me to
                    communicate to you the accompanying memorandum in response to the inquiry you
                    made of him this morning in regard to the Japanese proclamation of coal as
                    contraband of war.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee.</hi></signed></closer>
            </div>
        </body>
    </text>
