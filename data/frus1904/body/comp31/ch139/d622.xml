    <text>
        <body>
            <div xml:id="d622">

                <pb facs="0761" n="673" sameAs="frus:frus1904/pg673"/>

                <head><hi rendition="#italic">Mr. Adee to Mr.
                            Tyler.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1904-08-31"><hi rendition="#italic">August 31,
                        1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 35.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    dispatch No. 63, of the 23d ultimo, reporting further action taken by you to
                    secure the apprehension and punishment of the murderers of Doctor Labaree.</p>
                <p>The Department commends your course in the matter, and enjoins your continued
                    discreet energy in pressing the matter.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
