    <text>
        <body>
            <div xml:id="d193">

                <pb facs="0314" n="226" sameAs="frus:frus1904/pg226"/>

                <head><hi rendition="#italic">Mr. Snyder to Mr.
                            Hay.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Bogotá</hi></placeName>, <date calendar="gregorian" when="1904-06-03"
                                ><hi rendition="#italic">June 3, 1904</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 332.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith copy
                    and translation of the decree issued on the part of the Government of Colombia
                    reestablishing diplomatic relations between the Governments of Colombia and
                    Italy.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alban G. Snyder.</hi></signed></closer>


                <xi:include href="d193-a1.xml" xpointer="d193-a1"/>
