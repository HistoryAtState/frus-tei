    <text>
        <body>
            <div xml:id="d126">

                <pb facs="0205" n="185" sameAs="frus:frus1948v01p1/pg185"/>

                <note rend="inline" type="source">501.AA/3–2648: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Belgium</hi> (<hi
                            rendition="#italic">Millard</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Brussels</hi></placeName>, <date
                            calendar="gregorian" when="1948-03-26T19:00:00+01:00">March 26, 1948—7
                            p. m.</date>
                    </dateline>
                </opener>
                <p>618. Loridan<anchor n="1" xml:id="d126-f1"/> confirms instruction sent Belgian
                    representative UN as he recommended (reported
                    Embassy’s telegram 596, March 24<anchor n="2" xml:id="d126-f2"/>), i.e., for
                    admission Italy, Transjordan, and Finland and againt Bulgaria, Rumania, and
                    Hungary.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Millard</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d126-f1" n="1" xml:id="d126-f1-content">
                <p>Walter Loridan, Director-General of Political Affairs, Belgian Ministry of
                    Foreign Affairs.</p>
            </note>
            <note corresp="#d126-f2" n="2" xml:id="d126-f2-content">
