    <text>
        <body>
            <div xml:id="d97">

                <pb facs="0181" n="161" sameAs="frus:frus1948v01p1/pg161"/>

                <note rend="inline" type="source">
                    IO Files: US(P)/A/143</note>
                <head>
                    <hi rendition="#italic">United States Delegation Position Paper</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">confidential</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>,] <date calendar="gregorian"
                            when="1948-10-07">October 7, 1948</date>.</dateline>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">United States Slate for the Security Council and the
                        Economic and Social Council</hi>
                </p>
                <p rendition="#center">
                    <hi rendition="#small-caps">1. security council</hi>
                </p>
                <p>The United States Representative should vote for the following:</p>
                <list>
                    <label>
                        <hi rendition="#italic">a</hi>.</label>
                    <item>Norway</item>
                    <label>
                        <hi rendition="#italic">b</hi>.</label>
                    <item>Cuba</item>
                    <label>
                        <hi rendition="#italic">c</hi>.</label>
                    <item>Egypt (on the first ballot)</item>
                </list>
                <p rendition="#center">
                    <hi rendition="#small-caps">2. economic and social council</hi>
                </p>
                <p>The United States Representative should vote for:</p>
                <list>
                    <label>
                        <hi rendition="#italic">a</hi>.</label>
                    <item>China</item>
                    <label>
                        <hi rendition="#italic">b</hi>.</label>
                    <item>France</item>
                    <label>
                        <hi rendition="#italic">c</hi>.</label>
                    <item>Chile</item>
                    <label>
                        <hi rendition="#italic">d</hi>.</label>
                    <item>Peru</item>
                    <label>
                        <hi rendition="#italic">e</hi>.</label>
                    <item>Belgium</item>
                    <label>
                        <hi rendition="#italic">f</hi>.</label>
                    <item>India</item>
                </list>
            </div>
        </body>
