        <body>
            <div xml:id="d87-a1">

                <pb facs="0158" n="138" sameAs="frus:frus1948v01p1/pg138"/>

                <head>Annex</head>
                <p rendition="#center">
                    <hi rendition="#small-caps">Table</hi>
                </p>
                <p rendition="#center">
                    <hi rendition="#small-caps">Present Membership on United Nations Councils and
                        Preliminary Suggestions on United States Slates</hi>
                </p>
                <p rendition="#flush">
                    <hi rendition="#italic">Present Membership</hi>
                </p>
                <p>
                    <hi rendition="#italic">Security Council</hi>
                </p>
                <p>Permanent Members: <list>
                        <item>China</item>
                        <item>France</item>
                        <item>U.S.S.R.</item>
                        <item>U.K.</item>
                        <item>U.S.</item>
                    </list>
                </p>
                <pb facs="0159" n="139" xml:id="pg139"/>
                <p>Non-Permanent Members: <list>
                        <item>Term Expires December 31, 1949: <list>
                                <item>Argentina</item>
                                <item>Canada</item>
                                <item>Ukrainian S.S.R.</item>
                            </list>
                        </item>
                        <item>Term Expires December 31, 1948: <list>
                                <item>Belgium</item>
                                <item>Colombia</item>
                                <item>Syria</item>
                            </list>
                        </item>
                    </list>
                </p>
                <p rendition="#flush">
                    <hi rendition="#italic">Economic and Social Council</hi>
                </p>
                <p>
                    <list>
                        <item>Term Expires December 31, 1950: <list>
                                <item>Australia</item>
                                <item>Brazil</item>
                                <item>Denmark</item>
                                <item>Poland</item>
                                <item>U.S.S.R.</item>
                                <item>U.K.</item>
                            </list>
                        </item>
                        <item>Term Expires December 31, 1949: <list>
                                <item>Byelorussian S.S.R.</item>
                                <item>Lebanon</item>
                                <item>New Zealand</item>
                                <item>Turkey</item>
                                <item>United States</item>
                                <item>Venezuela</item>
                            </list>
                        </item>
                        <item>Term Expires December 31, 1948: <list>
                                <item>Netherlands</item>
                                <item>Canada</item>
                                <item>Chile</item>
                                <item>China</item>
                                <item>France</item>
                                <item>Peru</item>
                            </list>
                        </item>
                    </list>
                </p>
            </div>
