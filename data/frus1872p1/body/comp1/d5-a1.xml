    <text>
        <body>
            <div xml:id="d5-a1">

                <pb facs="0100" n="4" sameAs="frus:frus1872p1/pg4"/>

                <head>Executive Order.</head>
                <p>In pursuance of the authority conferred upon me by the 16th section of the act
                    entitled “An act to regulate the diplomatic and consular systems of the United
                    States,” approved August 18, 1856, I do hereby prescribe, in addition to the
                    fees heretofore prescribed, that the sum of five dollars shall be charged for
                    the granting or issuing of each passport granted or issued in any foreign
                    country, by any diplomatic or consular officer of the United States.</p>
                <closer>
                    <signed>U. S. GRANT.</signed>
                    <lb/>
                    <dateline rendition="#float-left"><placeName>
                            <placeName type="venue"><hi rendition="#small-caps">Executive
                                    Chamber</hi></placeName>, <lb/>
                            <placeName type="city"><hi rendition="#italic">Washington, D.
                                C.</hi></placeName></placeName>, <date calendar="gregorian"
                            when="1871-10-13"><hi rendition="#italic">October</hi> 13,
                        1871</date>.</dateline>
                </closer>
            </div>
