    <text>
        <body>
            <div xml:id="d242">

                <pb facs="0411" n="315" sameAs="frus:frus1872p1/pg315"/>

                <head>No. 242.<lb/><hi rendition="#italic">Mr. Marsh to Mr. Fish.</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Borne</hi></placeName>, <date calendar="gregorian"
                            when="1871-12-27"><hi rendition="#italic">December</hi> 27, 1871</date>.
                        (Received January 18.)</dateline>
                    <seg rendition="#float-left">No. 392.]</seg>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your instruction No. 326 relating to services rendered the United States ship
                    Guerriere by officers of the Italian navy, and to inclose a copy of a note
                    which, in fulfillment of that instruction, I have addressed to the minister of
                    foreign affairs.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>GEORGE P. MARSH.</signed>
                </closer>


                <xi:include href="d242-a1.xml" xpointer="d242-a1"/>
