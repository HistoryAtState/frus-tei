    <text>
        <body>
            <div xml:id="d432-a5">

                <pb facs="0685" n="589" sameAs="frus:frus1872p1/pg589"/>

                <head><hi rendition="#italic">Table showing the number of slaves who, according to
                        their cedulas, have attained the age of fifty-nine years, which number
                        should be counted as a decrease in the rectification of the census to be
                        published December</hi> 1, <hi rendition="#italic">of the present
                    year</hi>.</head>
                <table cols="2" rows="9">
                    <row role="label">
                        <cell>Departments.</cell>
                        <cell>Slaves.</cell>
                    </row>
                    <row>
                        <cell>1. Capital</cell>
                        <cell role="num">30</cell>
                    </row>
                    <row>
                        <cell>2. Arecibo</cell>
                        <cell role="num">17</cell>
                    </row>
                    <row>
                        <cell>3. Aguadilla</cell>
                        <cell role="num">5</cell>
                    </row>
                    <pb facs="0686" n="590" xml:id="pg590"/>
                    <row>
                        <cell>4. Mayagüez</cell>
                        <cell role="num">23</cell>
                    </row>
                    <row>
                        <cell>5. Ponce</cell>
                        <cell role="num">39</cell>
                    </row>
                    <row>
                        <cell>6. Guayama</cell>
                        <cell role="num">40</cell>
                    </row>
                    <row>
                        <cell>7. Hamacao</cell>
                        <cell rendition="#border-bottom" role="num">23</cell>
                    </row>
                    <row>
                        <cell>Total</cell>
                        <cell rendition="#border-bottom" role="num">177</cell>
                    </row>
                </table>
                <closer>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps">Porto
                                Rico</hi></placeName>, <date calendar="gregorian" when="1872-07-22"
                                ><hi rendition="#italic">July</hi> 22, 1872</date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
