    <text>
        <body>
            <div xml:id="d432-a3">

                <pb facs="0685" n="589" sameAs="frus:frus1872p1/pg589"/>

                <head><hi rendition="#italic">Table showing the number of slaves who on the 31st of
                        December</hi>, 1871, <hi rendition="#italic">were fugitives, or serving out
                        sentence, or demanding civil rights.</hi></head>
                <table cols="5" rows="9">
                    <row role="label">
                        <cell rendition="#border-right #border-bottom #border-top"
                            >Departments.</cell>
                        <cell rendition="#border-right #border-bottom #border-top">Fugitives</cell>
                        <cell rendition="#border-right #border-bottom #border-top">In prison serving
                            out sentence.</cell>
                        <cell rendition="#border-right #border-bottom #border-top">Demanding civil
                            rights.</cell>
                        <cell rendition="#border-bottom #border-top">Total.</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">1. Capital</cell>
                        <cell rendition="#border-right" role="num">84</cell>
                        <cell rendition="#border-right" role="num">45</cell>
                        <cell rendition="#border-right" role="num">6</cell>
                        <cell role="num">135</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">2. Arecibo</cell>
                        <cell rendition="#border-right" role="num">42</cell>
                        <cell rendition="#border-right"/>
                        <cell rendition="#border-right" role="num">1</cell>
                        <cell role="num">43</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">3. Aguadilla</cell>
                        <cell rendition="#border-right" role="num">27</cell>
                        <cell rendition="#border-right"/>
                        <cell rendition="#border-right" role="num">2</cell>
                        <cell role="num">29</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">4. Mayagüez</cell>
                        <cell rendition="#border-right" role="num">112</cell>
                        <cell rendition="#border-right"/>
                        <cell rendition="#border-right" role="num">2</cell>
                        <cell role="num">114</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">5. Ponce</cell>
                        <cell rendition="#border-right" role="num">153</cell>
                        <cell rendition="#border-right"/>
                        <cell rendition="#border-right"/>
                        <cell role="num">153</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">6. Guayama</cell>
                        <cell rendition="#border-right" role="num">52</cell>
                        <cell rendition="#border-right"/>
                        <cell rendition="#border-right" role="num">8</cell>
                        <cell role="num">69</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right">7. Humacao</cell>
                        <cell rendition="#border-right #border-bottom" role="num">106</cell>
                        <cell rendition="#border-right #border-bottom"/>
                        <cell rendition="#border-right #border-bottom" role="num">13</cell>
                        <cell rendition="#border-bottom" role="num">110</cell>
                    </row>
                    <row>
                        <cell rendition="#border-right #border-bottom">Total</cell>
                        <cell rendition="#border-right #border-bottom" role="num">576</cell>
                        <cell rendition="#border-right #border-bottom" role="num">45</cell>
                        <cell rendition="#border-right #border-bottom" role="num">32</cell>
                        <cell rendition="#border-bottom" role="num">653</cell>
                    </row>
                </table>
                <closer>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps">Porto
                                Rico</hi></placeName>, <date calendar="gregorian" when="1872-07-22"
                                ><hi rendition="#italic">July</hi> 22, 1872</date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
