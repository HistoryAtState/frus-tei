    <text>
        <body>
            <div xml:id="d432-a4">

                <pb facs="0685" n="589" sameAs="frus:frus1872p1/pg589"/>

                <head>
                    <hi rendition="#italic">Table showing the decrease in the number of slaves, from
                        all causes, according to the census of September 1, of the present
                        year.</hi>
                </head>
                <table cols="2" rows="5">
                    <row role="label">
                        <cell>On account of voluntary manumission</cell>
                        <cell role="num">553</cell>
                    </row>
                    <row>
                        <cell>On account of compulsary manumission</cell>
                        <cell role="num">40</cell>
                    </row>
                    <row>
                        <cell>On account of purpose of freedom</cell>
                        <cell role="num">38</cell>
                    </row>
                    <row>
                        <cell>On account of death</cell>
                        <cell rendition="#border-bottom" role="num">185</cell>
                    </row>
                    <row>
                        <cell>Total</cell>
                        <cell rendition="#border-bottom" role="num">516</cell>
                    </row>
                </table>
                <closer>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps">Porto
                                Rico</hi></placeName>, <date calendar="gregorian" when="1872-07-22"
                                ><hi rendition="#italic">July 22</hi>, 1872</date>.</dateline>
                </closer>
            </div>
        </body>
