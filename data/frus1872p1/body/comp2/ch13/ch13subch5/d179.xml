    <text>
        <body>
            <div xml:id="d179">

                <pb facs="0313" n="217" sameAs="frus:frus1872p1/pg217"/>

                <head>No. 179.<lb/><hi rendition="#italic">Mr. Fish
                        to Sir Edward Thornton</hi>,</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1872-03-15"><hi rendition="#italic">March</hi> 15,
                        1872</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose, for your
                    information and use, ten copies of the circular, issued by the Secretary of the
                    Treasury on the Oth instant, for the information of citizens of the United
                    States engaged in the fishing business in waters adjacent to the British North
                    American provinces.</p>
                <p>I have, &amp;c,</p>
                <closer>
                    <signed>HAMILTON FISH.</signed>
                </closer>


                <xi:include href="d179-a1.xml" xpointer="d179-a1"/>
            </div>
