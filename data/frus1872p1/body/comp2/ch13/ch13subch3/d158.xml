                <head>No. 158.<lb/><hi rendition="#italic">Mr. Fish
                        to Mr. Holt.</hi></head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1872-06-21"><hi rendition="#italic">June</hi> 21,
                        1872</date>.</dateline>
                </opener>
                <p rendition="#flush"><hi rendition="#small-caps">Geo. H. Holt</hi>, <hi
                        rendition="#italic">Consul, Gaspe, Canada:</hi></p>
                <p>Report full particulars of schooner James Bliss.</p>
                <closer>
                    <signed>HAMILTON FISH.</signed>
                </closer>
            </div>
        </body>
