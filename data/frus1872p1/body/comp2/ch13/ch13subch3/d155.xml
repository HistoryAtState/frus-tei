                <pb facs="0296" n="200" sameAs="frus:frus1872p1/pg200"/>

                <head>No. 155.<lb/><hi rendition="#italic">Mr. Holt to Mr. Fish.</hi></head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Gaspé</hi></placeName>, <date calendar="gregorian"
                            when="1872-06-20"><hi rendition="#italic">June</hi> 20, 1872</date>.
                        (Received June 20.)</dateline>
                </opener>
                <p rendition="#flush">Hon. <hi rendition="#small-caps">H. Fish</hi>, <hi
                        rendition="#italic">Secretary of State, Washington, D. C.:</hi></p>
                <p>Schooner James Bliss, of Gloucester, seized for alleged violation of fishery
                    laws.* * * Remonstrated energetically against position of flags, Dominion over
                    American.</p>
                <closer>
                    <signed>GEO. H. HOLT.</signed>
                </closer>
            </div>
        </body>
