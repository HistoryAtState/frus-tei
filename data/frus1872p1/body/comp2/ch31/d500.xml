    <text>
        <body>
            <div xml:id="d500">

                <pb facs="0810" n="714" sameAs="frus:frus1872p1/pg714"/>

                <head>No. 501.<lb/><hi rendition="#italic">Mr. Pile to Mr. Fish.</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States of America</hi>,<lb/><hi
                                rendition="#italic">Caracas</hi></placeName>, <date
                            calendar="gregorian" when="1872-05-08"><hi rendition="#italic">May</hi>
                            8, 1872</date>. (Received May 21.)</dateline>
                    <seg rendition="#float-left">No. 44]</seg>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have received from the minister of
                    foreign relations official copy of decree removing the blockade from the mouth
                    of the Orinoco and adjacent coast. A printed copy of this decree, with
                    translation, is herewith inclosed.</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed>WM. A. PILE.</signed>
                </closer>



                <xi:include href="d500-a1.xml" xpointer="d500-a1"/>
