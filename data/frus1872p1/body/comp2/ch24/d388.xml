    <text>
        <body>
            <div xml:id="d388">

                <pb facs="0594" n="498" sameAs="frus:frus1872p1/pg498"/>

                <head>No. 389.<lb/><hi rendition="#italic">Mr. Hale
                        to Mr. Schuyler.</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1872-09-18"><hi rendition="#italic">September</hi> 18,
                        1872</date>.</dateline>
                    <seg rendition="#float-left">No. 161.]</seg>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your dispatch. No. 10, under date of August
                    21, has been received.</p>
                <p>Your course relative to the alleged persecutions of the Hebrews in Roumania is
                    approved.</p>
                <p>I am, &amp;c,</p>
                <closer>
                    <signed>CHARLES HALE,<lb/><hi rendition="#italic">Acting
                        Secretary.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
