    <text>
        <body>
            <div xml:id="d389">

                <pb facs="0594" n="498" sameAs="frus:frus1872p1/pg498"/>

                <head>No. 390.<lb/><hi rendition="#italic">Mr. Schuyler to Mr. Fish.</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1872-09-29"><hi rendition="#italic">September</hi> 29,
                        1872</date>. (Received October 15.)</dateline>
                    <seg rendition="#float-left">No. 21.</seg>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose you a
                    memorandum, marked A, on the legal position of the Hebrews in Russia.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>EUGENE SCHUYLER,<lb/><hi rendition="#italic">Chargé d’Affaires ad
                            int.</hi></signed>
                </closer>


                <xi:include href="d389-a1.xml" xpointer="d389-a1"/>
