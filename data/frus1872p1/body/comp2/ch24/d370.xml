    <text>
        <body>
            <div xml:id="d370">

                <pb facs="0575" n="479" sameAs="frus:frus1872p1/pg479"/>

                <head>No. 370.<lb/><hi rendition="#italic">Mr. Schuyler to Mr. Fish.</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1872-02-18"><hi rendition="#italic">February</hi> 18, 1872</date>.
                        (Received March 15.)</dateline>
                    <seg rendition="#float-left">No. 157.]</seg>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose you herewith
                    translations of extracts from the St. Petersburg Gazette and the Moscow Gazette
                    on the Alabama questions, which may be not without interest as expressions of
                    Russian opinion.</p>
                <p>I am, &amp;c,</p>
                <closer>
                    <signed>EUGENE SCHUYLER,<lb/><hi rendition="#italic">Chargé d’Affaires ad.
                            int.</hi></signed>
                </closer>



                <xi:include href="d370-a1.xml" xpointer="d370-a1"/>
