    <text>
        <body>
            <div xml:id="d468-a1">

                <pb facs="0772" n="676" xml:id="pg676"/>

                <opener>
                    <seg rendition="#center">[Inclosure No. 1.—Translation.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Server Pacha to Mr. Brown.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Sublime Porte, Ministry of Foreign
                            Affairs</hi></placeName>,<lb/><date calendar="gregorian"
                            when="1872-03-30"><hi rendition="#italic">March</hi> 30,
                        1872</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit to you
                    herewith, together with their translation, some copies of the new law, already
                    promulgated by an imperial ordnance, concerning the organization and the
                    attributes of the civil, correctional, and criminal courts of
                    Constantinople.</p>
                <p>Accept, sir, assurances of my perfect consideration.</p>
                <closer>
                    <signed>SERVER.</signed>
                </closer>
            </div>
        </body>
    </text>
