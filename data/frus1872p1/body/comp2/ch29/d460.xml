    <text>
        <body>
            <div xml:id="d460">

                <pb facs="0764" n="668" sameAs="frus:frus1872p1/pg668"/>

                <head>No. 461.<lb/><hi rendition="#italic">Mr. Brown to Mr. Fish.</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1871-11-25"><hi rendition="#italic">November</hi> 25, 1871</date>.
                        (Received December 31.)</dateline>
                    <seg rendition="#float-left">No. 34.]</seg>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit to the
                    Department translation of a new regulation adopted by the Ottoman government
                    with respect to drawback duties of its customs.</p>
                <p>With great respect, &amp;c.,</p>
                <closer>
                    <signed>JOHN P. BROWN.</signed>
                </closer>


                <xi:include href="d460-a1.xml" xpointer="d460-a1"/>
