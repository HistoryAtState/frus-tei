    <text>
        <body>
            <div xml:id="d481">

                <pb facs="0783" n="687" sameAs="frus:frus1872p1/pg687"/>

                <head>No. 482.<lb/><hi rendition="#italic">Mr. Hunter to Mr. Peixotto.</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1872-04-01"><hi rendition="#italic">April</hi> 1,
                        1872</date>.</dateline>
                    <seg rendition="#float-left">No. 26.]</seg>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: Tour dispatch No. 26, of the 27th of
                    February last, has been received. Your proceedings in presenting the petition of
                    the Israelites of Cabool to the Roumanian government are approved. I am, sir,
                    &amp;c.,</p>
                <closer>
                    <signed>W. HUNTER,<lb/><hi rendition="#italic">Second Assistant
                        Secretary.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
