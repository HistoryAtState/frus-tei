    <text>
        <body>
            <div xml:id="d487">

                <pb facs="0787" n="691" sameAs="frus:frus1872p1/pg691"/>

                <head>No. 488.<lb/><hi rendition="#italic">Mr. Hunter to Mr. Peixotto.</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1872-06-13"><hi rendition="#italic">June</hi> 13,
                        1872</date>.</dateline>
                    <seg rendition="#float-left">No. 32.]</seg>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your dispatch No. 31, of the 5th of May
                    last, relative to the persecution of the Hebrews in Roumania, has been
                    received.</p>
                <pb facs="0788" n="692" xml:id="pg692"/>
                <p>The representations which von have made to the Roumanian government upon the
                    subject are approved.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>W. HUNTER.</signed>
                </closer>
            </div>
        </body>
    </text>
