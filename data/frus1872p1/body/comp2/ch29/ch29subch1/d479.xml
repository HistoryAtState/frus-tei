    <text>
        <body>
            <div xml:id="d479">

                <pb facs="0781" n="685" sameAs="frus:frus1872p1/pg685"/>

                <head>No. 480.<lb/><hi rendition="#italic">Mr. Peixotto to Mr. Hunter.</hi></head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Consulate of the United States of America</hi>,<lb/><hi
                                rendition="#italic">Bucharest</hi></placeName>, <date
                            calendar="gregorian" when="1872-02-15"><hi rendition="#italic"
                                >February</hi> 15, 1872</date>. (Received March 15.)</dateline>
                    <seg rendition="#float-left">No. 25.]</seg>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>:</p>
                <p>* * * * *</p>
                <p>The Government has sent a special commission to investigate the affairs at
                    Ismail.</p>
                <p>I am, &amp;c., &amp;c.,</p>
                <closer>
                    <signed>BENJ. F. PEIXOTTO,<lb/><hi rendition="#italic">United States
                            Consul.</hi></signed>
                </closer>
            </div>
        </body>
