    <text>
        <body>
            <div xml:id="d448">

                <pb facs="0749" n="653" sameAs="frus:frus1872p1/pg653"/>

                <head>No. 449.<lb/><hi rendition="#italic">Mr. Morris to Mr. Fish</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">United
                                States Legation</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1870-06-24"><hi rendition="#italic">June</hi> 24,
                        1870</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I beg leave to invite your perusal of the
                    inclosed, relative to the alleged massacre of Jews in Roumania.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>E. JOY MORRIS.</signed>
                </closer>



