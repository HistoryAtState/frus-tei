    <text>
        <body>
            <div xml:id="d222">

                <pb facs="0385" n="289" sameAs="frus:frus1872p1/pg289"/>

                <head>No. 222.<lb/><hi rendition="#italic">Mr. Hunter to Mr. Bassett</hi></head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1872-08-09"><hi rendition="#italic">August</hi> 9,
                        1872</date>.</dateline>
                    <seg rendition="#float-left">No. 112.]</seg>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your dispatches numbered 138, 139, 140, and
                    141 have been received.</p>
                <p>Your action in regard to the ill-usage of Mr. Eldredge, which forms the subject
                    of your dispatch No. 139, is approved.</p>
                <p>* * * * * * *</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>W. HUNTER,<lb/><hi rendition="#italic">Acting Secretary.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
