    <text>
        <body>
            <div xml:id="d92">

                <pb facs="0239" n="143" sameAs="frus:frus1872p1/pg143"/>

                <head>No. 92.<lb/><hi rendition="#italic">Mr. Fish
                        to Mr. Hurlbut.</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1872-01-04"><hi rendition="#italic">January</hi> 4,
                        1872</date>.</dateline>
                    <seg rendition="#float-left">No. 56.]</seg>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit herewith, for your information,
                    a copy of a dispatch addressed to this Department, on the 6th ultimo, by Mr.
                    Long, consul of the United States at Panama, in relation to the conduct of the
                    attorney-general for the State of Panama, with reference to the persons who
                    committed the outrage against the steamer Montijo.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>HAMILTON FISH.</signed>
                </closer>


                <xi:include href="d92-a1.xml" xpointer="d92-a1"/>
            </div>
        </body>
    </text>
