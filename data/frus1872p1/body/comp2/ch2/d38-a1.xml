    <text>
        <body>
            <div xml:id="d38-a1">

                <pb facs="0153" n="57" sameAs="frus:frus1872p1/pg57"/>

                <opener>
                    <seg rendition="#center">[Inclosure 1.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Baron Schwarz to Mr.
                            Jay.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName>42 <hi rendition="#small-caps"
                                >Praterstrasse</hi> II, <hi rendition="#italic"
                            >Vienna</hi></placeName>, <date calendar="gregorian" when="1872-07-27"
                                ><hi rendition="#italic">July</hi> 27, 1872</date>.</dateline>
                </opener>
                <p rendition="#center"><hi rendition="#small-caps">Universal Exhibition</hi>, 1873,
                        <hi rendition="#small-caps">in Vienna. General Manager</hi> No. 2, 830.</p>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to our interview of
                    yesterday, I have the honor to send you herewith—</p>
                <p>1st. A note on the participation of foreign states at the Universal Exhibition of
                    Vienna, in 1873.</p>
                <p>* * * * * * *</p>
                <p>I have, &amp;c,</p>
                <closer>
                    <signed>SCHWARZ SENBORN.</signed>
                </closer>
            </div>
        </body>
    </text>
