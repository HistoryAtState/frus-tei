    <text>
        <body>
            <div xml:id="d255">

                <pb facs="0423" n="327" xml:id="pg327"/>

                <head>No. 255.<lb/><hi rendition="#italic">Mr. Turner to Mr. Fish</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States.</hi><lb/><hi rendition="#italic"
                                >Monrovia, Liberia</hi></placeName>, <date calendar="gregorian"
                            when="1871-11-01"><hi rendition="#italic">Nov</hi>. 1, 1871</date>.
                        (Received Dec. 12.)</dateline>
                    <seg rendition="#float-left">No. 20.]</seg>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: Inclosed please find correspondence between
                    this legation and the “provisional chief executive committee” now administering
                    the affairs of government for the republic of Liberia.</p>
                <p>I have, &amp;c.</p>
                <closer>
                    <signed>J. MILTON TURNER.</signed>
                </closer>




