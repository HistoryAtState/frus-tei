    <text>
        <body>
            <div xml:id="d127">

                <pb facs="0277" n="181" sameAs="frus:frus1872p1/pg181"/>

                <head>No. 127.<lb/><hi rendition="#italic">Mr. Fish to Mr. Washburne.</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1871-01-15"><hi rendition="#italic">January</hi> 15,
                        1871</date>.</dateline>
                    <seg rendition="#float-left">No. 375.]</seg>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith a translation of a
                        note<anchor n="*" xml:id="d127-f1"/> of the 15th ultimo, addressed to the
                    United States minister at Mexico by the minister for foreign affairs, concerning
                    the good offices extended by you to Mexican citizens in France.</p>
                <p>I am, &amp;c,</p>
                <closer>
                    <signed>HAMILTON FISH.</signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d127-f1" n="*" xml:id="d127-f1-content">
                <p>For note see inclosure to dispatch from United States minister to Mexico of
                    December 18, 1871.</p>
            </note>
        </listAnnotation>
    </standOff>
