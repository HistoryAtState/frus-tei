    <text>
        <body>
            <div xml:id="d438">

                <pb facs="0693" n="597" sameAs="frus:frus1872p1/pg597"/>

                <head>No. 439.<lb/><hi rendition="#italic">Mr. Andrews to Mr. Fish.</hi></head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Stockholm</hi></placeName>, <date calendar="gregorian"
                            when="1872-03-25"><hi rendition="#italic">March</hi> 25, 1872</date>.
                        (Received April 19.)</dateline>
                    <seg rendition="#float-left">No. 150.]</seg>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: * * * Herewith I beg to inclose a report
                    which I have prepared on Swedish manufactures and business.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>C. C. ANDREWS.</signed>
                </closer>


                <xi:include href="d438-a1.xml" xpointer="d438-a1"/>
