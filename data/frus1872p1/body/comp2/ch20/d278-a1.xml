    <text>
        <body>
            <div xml:id="d278-a1">

                <pb facs="0469" n="373" sameAs="frus:frus1872p1/pg373"/>

                <opener>
                    <seg rendition="#center">[Inclosure A.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Mr. Nelson to Mr. Mariscal.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States.</hi><lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1871-12-13"><hi rendition="#italic">December</hi> 13,
                        1871</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: In compliance with instructions from the
                    honorable Secretary of State of the United States, I have the pleasure of
                    transmitting a copy of a dispatch from the United States minister at Paris to
                    the State Department, Washington, reporting his action in extending his good
                    offices in behalf of Mexican citizens in France, and also a copy of the reply of
                    Mr. Fish.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>THOMAS H. NELSON.</signed>
                </closer>
            </div>
        </body>
