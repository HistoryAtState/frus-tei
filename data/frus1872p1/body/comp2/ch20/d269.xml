    <text>
        <body>
            <div xml:id="d269">

                <pb facs="0450" n="354" sameAs="frus:frus1872p1/pg354"/>

                <head>No. 269.<lb/><hi rendition="#italic">Mr. Nelson to Mr. Fish.</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1871-11-28"><hi rendition="#italic">November</hi> 28, 1871</date>.
                        (Received December 26.)</dateline>
                    <seg rendition="#float-left">No. 475.]</seg>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: As a part of the history of the present
                    revolution, I inclose a translation of a protest that was published by several
                    members of the national congress who call themselves “constitutional
                    deputies.”</p>
                <p>I have, &amp;c.,</p>
                <closer>
                    <signed>THOMAS H. NELSON.</signed>
                </closer>


                <xi:include href="d269-a1.xml" xpointer="d269-a1"/>
