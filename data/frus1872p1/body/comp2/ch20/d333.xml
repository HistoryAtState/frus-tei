    <text>
        <body>
            <div xml:id="d333">

                <pb facs="0539" n="443" sameAs="frus:frus1872p1/pg443"/>

                <head>No. 333.<lb/><hi rendition="#italic">Mr. Nelson to Mr. Fish.</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1872-07-30"><hi rendition="#italic">July</hi> 30, 1872</date>.
                        (Received August 14.)</dateline>
                    <seg rendition="#float-left">No. 602.]</seg>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: Herewith I transmit a copy and translation
                    (A and B) of a decree of amnesty, issued by President Lerdo de Tejada, on the
                    27th instant.</p>
                <p>I am, &amp;c,</p>
                <closer>
                    <signed>THOMAS H. NELSON.</signed>
                </closer>


                <xi:include href="d333-a1.xml" xpointer="d333-a1"/>
