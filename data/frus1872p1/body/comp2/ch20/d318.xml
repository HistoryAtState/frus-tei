    <text>
        <body>
            <div xml:id="d318">

                <pb facs="0525" n="429" sameAs="frus:frus1872p1/pg429"/>

                <head>No. 318.<lb/><hi rendition="#italic">Mr. Fish to Mr. Nelson.</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1872-06-03"><hi rendition="#italic">June</hi> 3,
                        1872</date>.</dateline>
                    <seg rendition="#float-left">No. 252.]</seg>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your dispatch, No. 569, of the 16th ultimo,
                    concerning passports and certificates of matriculation in behalf of American
                    citizens, has been received. Your action, as therein reported, in regard to the
                    matter is approved.</p>
                <p>Your dispatches numbered 570 and 571 have also been received.</p>
                <p>I am. &amp;c.,</p>
                <closer>
                    <signed>HAMILTON FISH.</signed>
                </closer>
            </div>
        </body>
    </text>
