                <opener>
                    <seg rendition="#center">[Indorsements.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Headquarters, Department of Texas</hi>,<lb/><hi rendition="#italic"
                                >San Antonio</hi></placeName>, <date calendar="gregorian"
                            when="1872-07-19"><hi rendition="#italic">July</hi> 19,
                        1872</date>.</dateline>
                </opener>
                <p>Respectfully forwarded to headquarters Military Division of the Missouri, for the
                    information of the Lieutenant-General commanding.</p>
                <closer>
                    <signed>C. C. AUGUR,<lb/><hi rendition="#italic">Brigadier-General
                            Commanding.</hi></signed>
                </closer>



