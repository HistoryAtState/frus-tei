    <text>
        <body>
            <div xml:id="d297">

                <pb facs="0497" n="401" sameAs="frus:frus1872p1/pg401"/>

                <head>No. 297.<lb/><hi rendition="#italic">Mr. Nelson to Mr. Fish.</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Mexico</hi></placeName>, <date calendar="gregorian"
                            when="1872-03-16"><hi rendition="#italic">March</hi> 16, 1872</date>.
                        (Received April 12.)</dateline>
                    <seg rendition="#float-left">No. 529.]</seg>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I here with inclose a copy and translation
                    of an article on the “Free Zone,” published on the 4th instant in the Progreso,
                    by Colonel Carlos de Gagern, of the federal army, but now retired from
                    service.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>THOMAS H. NELSON.</signed>
                </closer>



                <xi:include href="d297-a1.xml" xpointer="d297-a1"/>
            </div>
