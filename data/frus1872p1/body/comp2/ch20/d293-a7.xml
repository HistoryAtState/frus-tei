                <pb facs="0492" n="396" sameAs="frus:frus1872p1/pg396"/>

                <opener>
                    <seg rendition="#center">[Second indorsement.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Headquarters Department of Texas</hi>,<lb/><hi rendition="#italic"
                                >San, Antonio</hi></placeName>, <date calendar="gregorian"
                            when="1872-01-08"><hi rendition="#italic">January</hi> 8,
                        1872</date>.</dateline>
                </opener>
                <p>Official copy, respectfully forwarded to the Adjutant General United States Army,
                    through headquarters Military Division of the Missouri, for his information.</p>
                <closer>
                    <signed>J. J. REYNOLDS,<lb/><hi rendition="#italic">Colonel Third Cavalry,
                            Brevet Major-General U. S. A., Commanding.</hi></signed>
                </closer>
            </div>
