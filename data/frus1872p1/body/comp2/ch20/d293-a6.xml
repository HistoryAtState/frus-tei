        <body>
            <div xml:id="d293-a6">

                <pb facs="0492" n="396" sameAs="frus:frus1872p1/pg396"/>

                <opener>
                    <seg rendition="#center">[First indorsement.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Headquarters Post of Fort Brown, Texas</hi></placeName>,<lb/><date
                            calendar="gregorian" when="1871-12-26"><hi rendition="#italic"
                                >December</hi> 26, 1871</date>.</dateline>
                </opener>
                <p>Respectfully forwarded to the assistant adjutant-general, Department of Texas,
                    for his information.</p>
                <closer>
                    <signed>A. McD. McCOOK,<lb/><hi rendition="#italic">Lieutenant-Colon el Tenth
                            Infantry, Brevet Major-General, U. S. A., Commanding.</hi></signed>
                </closer>
                <postscript>
                    <p>Official copy:<lb/>H. CLAY WOOD, <hi rendition="#italic">Assistant
                            Adjutant-General.</hi></p>
                </postscript>
            </div>
