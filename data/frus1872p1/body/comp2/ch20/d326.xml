    <text>
        <body>
            <div xml:id="d326">

                <pb facs="0530" n="434" sameAs="frus:frus1872p1/pg434"/>

                <head>No. 326.<lb/><hi rendition="#italic">Mr. Male
                        to Mr. Nelson.</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1872-07-08"><hi rendition="#italic">July</hi> 8,
                        1872</date>.</dateline>
                    <seg rendition="#float-left">No. 265.]</seg>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit a copy of a letter of the 2d
                    instant, addressed to this Department by the Secretary of the Interior, and of
                    the one to him <pb facs="0531" n="435" xml:id="pg435"/> from the Commissioner of
                    Indian Affairs, to which it refers. These have been occasioned by your dispatch
                    557, of the 26th of April last, relative to the removal of Kickapoo Indians from
                    Mexico to their reservation in the United States.</p>
                <p>I am, &amp;c.,</p>
                <closer>
                    <signed>CHARLES HALE,<lb/><hi rendition="#italic">Acting
                        Secretary.</hi></signed>
                </closer>



                <xi:include href="d326-a1.xml" xpointer="d326-a1"/>
