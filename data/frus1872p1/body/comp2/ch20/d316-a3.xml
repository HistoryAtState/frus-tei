    <text>
        <body>
            <div xml:id="d316-a3">

                <pb facs="0522" n="426" sameAs="frus:frus1872p1/pg426"/>

                <head><hi rendition="#italic">Mr. Palacios to Mr.
                            Wilson</hi>.</head>
                <opener>
                    <seg rendition="#center">[Translation.]</seg>
                </opener>
                <p rendition="#flush">
                    <hi rendition="#italic">Garrison of the line of the Bravo general-in-chief:</hi>
                </p>
                <p>For your information, so far as it may concern the interests of the nation which
                    you represent in Mexico, I have the honor herewith to send you a military order
                    which has this day been published in this town.</p>
                <p>I renew to you the assurances of my consideration.</p>
                <p>Independence and liberty.</p>
                <closer>
                    <dateline rendition="#float-left"><placeName><hi rendition="#small-caps">H.
                                Matamoras</hi></placeName>, <date calendar="gregorian"
                            when="1872-04-08">April 8, 1872</date>.</dateline>
                    <lb/>
                    <signed>MG. PALACIOS.</signed>
                </closer>
                <postscript>
                    <p>The citizen <hi rendition="#small-caps">Consul or the United
                            States</hi><lb/><hi rendition="#italic">Of America at
                            Matamoras.—Present.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
