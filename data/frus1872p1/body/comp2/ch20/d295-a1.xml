    <text>
        <body>
            <div xml:id="d295-a1">

                <pb facs="0494" n="398" sameAs="frus:frus1872p1/pg398"/>

                <opener>
                    <seg rendition="#center">[Inclosure 1.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Mr. Belknap to Mr. Fish.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">War
                                Department</hi>,<lb/><hi rendition="#italic">Washington
                            City</hi></placeName>, <date calendar="gregorian" when="1872-02-27"><hi
                                rendition="#italic">February</hi> 27, 1872</date>. (Received March
                        1.)</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: The inclosed copy of a communication from
                    the commanding officer of Fort Davis, Texas, reporting that armed bodies of
                    Mexicans have crossed the border into the territory of the United States, is
                    respectfully transmitted for your information, and such consideration as you may
                    feel disposed to give it.</p>
                <p>Very respectfully,</p>
                <closer>
                    <signed>WM. W. BELKNAP,<lb/><hi rendition="#italic">Secretary of
                        War.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
