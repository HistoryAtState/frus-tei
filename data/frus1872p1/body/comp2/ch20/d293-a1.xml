    <text>
        <body>
            <div xml:id="d293-a1">

                <pb facs="0491" n="395" xml:id="pg395"/>

                <opener>
                    <seg rendition="#center">[Inclosure 1.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Mr. Delano to Mr.
                            Fish.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of the Interior</hi>, <hi rendition="#italic"
                                >Washington, D. C.</hi></placeName>, <date calendar="gregorian"
                            when="1872-02-23"><hi rendition="#italic">February</hi> 23, 1872</date>.
                        (Received February 24.)</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith, for
                    your information, a copy of a letter from the Secretary of War, dated the 6th
                    instant, inclosing copies of reports relative to depredations, &amp;c.,
                    committed by Kickapoo Indians from Mexico, in the vicinity of Fort Davis, Texas;
                    also, a copy of a communication from the Commissioner of Indian Affairs, dated
                    the 13th instant, giving his views in relation to the subject.</p>
                <p>Very respectfully, &amp;c.,</p>
                <closer>
                    <signed>C. DELANO, <hi rendition="#italic">Secretary of the
                        Interior.</hi></signed>
                </closer>
            </div>
        </body>
    </text>
