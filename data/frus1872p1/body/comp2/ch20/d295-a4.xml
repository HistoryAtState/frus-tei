    <text>
        <body>
            <div xml:id="d295-a4">

                <pb facs="0495" n="399" sameAs="frus:frus1872p1/pg399"/>

                <opener>
                    <seg rendition="#center">[Indorsement.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Headquarters Military Division of the Missouri</hi>,<lb/><hi
                                rendition="#italic">Chicago</hi></placeName>, <date
                            calendar="gregorian" when="1872-02-22"><hi rendition="#italic"
                                >February</hi> 22, 1872</date>.</dateline>
                </opener>
                <p>Respectfully forwarded to the Adjutant-General of the Army, for the information
                    of the Secretary of War.</p>
                <closer>
                    <signed>P. H. SHERIDAN,<lb/><hi rendition="#italic">Lieutenant-General,
                            Commanding.</hi></signed>
                </closer>
                <postscript>
                    <opener>
                        <dateline rendition="#float-right"><hi rendition="#small-caps"
                                >Adjutant-General’s Office</hi>,<lb/><placeName><hi
                                    rendition="#italic">Washington</hi></placeName>, <date
                                calendar="gregorian" when="1872-02-26"><hi rendition="#italic"
                                    >February</hi> 26, 1872</date>.</dateline>
                    </opener>
                    <p>Official copies:</p>
                    <closer>
                        <signed>E. D. TOWNSEND,<lb/><hi rendition="#italic"
                            >Adjutant-General</hi>.</signed>
                    </closer>
                </postscript>
                <postscript>
                    <p>The Honorable <hi rendition="#small-caps">Secretary of State.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
