    <text>
        <body>
            <div xml:id="d1079">

                <pb facs="1605" n="1585" sameAs="frus:frus1950v07/pg1585"/>

                <note rend="inline" type="source">320/12–1950: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the United States Mission at the United
                        Nations</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1950-12-20T19:00:00-05:00">December 20,
                            1950—7 p. m.</date>
                    </dateline>
                </opener>
                <p>603. Re Delga 453.<anchor n="1"
                        xml:id="d1079-f1"/>
                    Dept believes US shld agree with procedure and
                    timetable for Comite I advocated by Pearson. In indicating our willingness to go
                    along with proposed procedure to Entezam group, you shld point out that if Chi
                    Commies attack UN forces across 38th parallel in force we wld assume that
                    procedure wld be modified.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Webb</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
