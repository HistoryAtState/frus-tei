    <text>
        <body>
            <div xml:id="d961">

                <pb facs="1367" n="1347" sameAs="frus:frus1950v07/pg1347"/>

                <note rend="inline" type="source">795.00/12–450</note>
                <head>
                    <hi rendition="#italic">The Chairman of the Joint Chiefs of Staff</hi>
                        (<hi rendition="#italic">Bradley</hi>) <hi
                        rendition="#italic">to the Secretary of Defense</hi> (<hi rendition="#italic">Marshall</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1950-12-04">4 December
                        1950</date>.</dateline>
                </opener>
                <p rendition="#flush">Subject: Korea</p>
                <p>The Joint Chiefs of Staff recommend that the Department of State position paper
                    entitled “Korea”, prepared for use by the President in <pb facs="1368" n="1348"
                        xml:id="pg1348"/> his discussions with Prime Minister Attlee, be changed as
                    indicated in the usual manner in the attached revised draft.<anchor n="1"
                        xml:id="d961-f1"/>
                </p>
                <closer>For the Joint Chiefs of Staff: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Omar</hi> N. <hi rendition="#small-caps"
                            >Bradley</hi>
                    </signed>
                    <lb/>
                    <hi rendition="#italic">Chairman</hi>
                    <lb/>
                    <hi rendition="#italic">Joint Chiefs of Staff</hi>
                </closer>


                <xi:include href="d961-a1.xml" xpointer="d961-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d961-f1" n="1" xml:id="d961-f1-content">
                <p>In the enclosure, the underlined portions are those suggested for insertion by
                    the JCS, while those lined out represent sections of the original Department of
                    State draft recommended for deletion by the JCS.</p>
            </note>
        </listAnnotation>
    </standOff>
