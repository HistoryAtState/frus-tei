                <head>
                    <hi rendition="#italic">Memorandum Prepared in the Department of State</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1950-09-14">September 14, 1950</date>.</dateline>
                </opener>
                <p rendition="#flush">SFM D–7/3<hi rendition="#italic">a</hi> Revised</p>
                <p rendition="#center">
                    <hi rendition="#small-caps">September Foreign Ministers Meetings</hi>
                </p>
                <p rendition="#center">
                    <hi rendition="#small-caps">summary for briefing of the secretary on korea</hi>
                </p>
                <p>The attached brief has been revised<anchor n="1" xml:id="d512-f1"/> to include a
                    statement of the U.S. position as established in NSC 81/1.<anchor n="2" xml:id="d512-f2"/>
                </p>



