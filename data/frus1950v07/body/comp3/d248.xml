    <text>
        <body>
            <div xml:id="d248">

                <pb facs="0358" n="338" xml:id="pg338"/>

                <note rend="inline" type="source">795.00/7–950</note>
                <head>
                    <hi rendition="#italic">The British Embassy to the
                            Department of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                    </seg>
                </opener>
                <p rendition="#center">
                    <hi rendition="#small-caps">Memorandum</hi>
                </p>
                <p>The attached message gives the line of an oral reply which Sir David Kelly will
                    make to Mr. Gromyko. This is intended as a first step, which, if the Soviet
                    Union are now genuinely anxious to find a way out of the Korean conflict, may
                    encourage them to show their hand a little further.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <placeName><hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1950-07-09">9th July, 1950</date>.</dateline>
                </closer>


                <xi:include href="d248-a1.xml" xpointer="d248-a1"/>
