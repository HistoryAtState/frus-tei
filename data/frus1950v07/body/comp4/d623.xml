    <text>
        <body>
            <div xml:id="d623">

                <pb facs="0909" n="889" xml:id="pg889"/>

                <note rend="inline" type="source">795A.5/10–650: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Norway</hi> (<hi rendition="#italic"
                        >Snow</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">secret</hi>
                        <lb/>
                        <hi rendition="#small-caps">priority</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Oslo</hi></placeName>, <date
                            calendar="gregorian" when="1950-10-06T10:00:00+01:00">October 6, 1950—10
                            a. m.</date>
                        <lb/> [Received October 6—9:53 a. m.]</dateline>
                </opener>
                <p>353. Depcirtel 9, October 5, 11 a.m. Norwegian Foreign Office without information
                    from representative in Peiping re Chinese plans defense North Korea.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Snow</hi>
                    </signed>
                </closer>
            </div>
        </body>
