    <text>
        <body>
            <div xml:id="d590-a1">

                <pb facs="0867" n="847" sameAs="frus:frus1950v07/pg847"/>

                <opener>
                    <seg rendition="#center">[Annex]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Position Paper Prepared for the United States Delegation
                        to the United Nations General Assembly </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">confidential</hi>
                    </seg>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps">New
                                York</hi></placeName>,] <date calendar="gregorian" when="1950-10-02"
                            >October 2, 1950</date>.</dateline>
                </opener>
                <p rendition="#flush">US/A/C.1/1989</p>
                <p rendition="#center">
                    <hi rendition="#small-caps">Composition of Proposed Commission for Korea</hi>
                </p>
                <p>
                    <hi rendition="#italic">Present Composition of UNCOK </hi>
                </p>
                <list>
                    <item>Australia</item>
                    <item>China</item>
                    <item>El Salvador</item>
                    <item>France</item>
                    <item>India</item>
                    <item>Philippines</item>
                    <item>Turkey</item>
                </list>
                <p>
                    <hi rendition="#italic">Sponsors of Resolution</hi>
                </p>
                <list>
                    <item>Australia</item>
                    <item>Brazil</item>
                    <item>Cuba</item>
                    <item>Netherlands</item>
                    <item>Norway</item>
                    <item>Pakistan</item>
                    <item>Philippines</item>
                    <item>United Kingdom</item>
                </list>
                <p>
                    <hi rendition="#italic">United Kingdom Proposal</hi>
                </p>
                <list>
                    <item>Australia</item>
                    <item>Netherlands</item>
                    <item>Pakistan</item>
                    <item>Philippines</item>
                    <item>Latin America(<hi rendition="#italic">Note:</hi> The UK has spoken to all
                        the above except Turkey and a Latin American State.)</item>
                </list>
                <p>
                    <hi rendition="#italic">Countries Providing Military Assistance in Korea or
                        Enroute to Korea</hi>
                </p>
                <list>
                    <item>Australia</item>
                    <item>Belgium</item>
                    <item>Canada</item>
                    <item>Denmark</item>
                    <item>France</item>
                    <item>India</item>
                    <item>Netherlands</item>
                    <item>New Zealand</item>
                    <item>Norway</item>
                    <item>Philippines</item>
                    <item>Sweden</item>
                    <item>Thailand</item>
                    <item>Turkey</item>
                    <item>South Africa</item>
                    <item>United Kingdom</item>
                </list>
            </div>
        </body>
