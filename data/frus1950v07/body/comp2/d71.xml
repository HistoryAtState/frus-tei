                <p rendition="#flush">Nr: DA TT 3415</p>
                <p rendition="#flush">Subject: Korean Situation</p>
                <p rendition="#flush">References: C–56777; C–56775;<anchor n="1" xml:id="d71-f1"/>
                    Dept. 931; 250655Z.<anchor n="2"
                        xml:id="d71-f2"/>
                </p>
