    <text>
        <body>
            <div xml:id="d179">

                <pb facs="0283" n="263" sameAs="frus:frus1950v07/pg263"/>

                <note rend="inline" type="source">795.00/6–3050: Telegram</note>
                <head>
                    <hi rendition="#italic">The Joint Chiefs of Staff to
                        the Commander in Chief, Far East</hi> (<hi
                            rendition="#italic">MacArthur</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">top secret</hi>
                        <lb/>
                        <hi rendition="#small-caps">emergency</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1950-06-30T13:22:00-04:00">30 June 1950—1:22
                            p. m.</date>
                    </dateline>
                </opener>
                <p>JCS 84718. Restrictions on use of Army Forces imposed by JCS 84681<anchor n="1"
                        xml:id="d179-f1"/> are hereby removed and authority granted to utilize Army
                    Forces available to you as proposed your C 56942<anchor n="2" xml:id="d179-f2"/>
                    subject only to requirements for safety of Japan in the present situation which
                    is a matter for your judgment.</p>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d179-f1" n="1" xml:id="d179-f1-content">
                <p>Transmitted on June 29 at 6:59 p. m., <ref target="#pg240">p. 240</ref>.</p>
            </note>
            <note corresp="#d179-f2" n="2" xml:id="d179-f2-content">
                <p>
                    <hi rendition="#italic">Ante</hi>, <ref target="#pg248">p. 248</ref>.</p>
