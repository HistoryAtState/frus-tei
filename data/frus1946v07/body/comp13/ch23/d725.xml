    <text>
        <body>
            <div xml:id="d725">

                <pb facs="0931" n="919" sameAs="frus:frus1946v07/pg919"/>

                <note rend="inline" type="source">195.2/11–1346: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in Turkey</hi> (<hi
                            rendition="#italic">Wilson</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">confidential</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1946-11-13T17:00:00-05:00">November 13,
                            1946—5 p.m.</date>
                    </dateline>
                </opener>
                <p>749. National Advisory Council Nov 6 approved action advising Maritime Commission
                    that NAC no objection Commission consider
                    extension approx $5 million credit Turkey for purchase six ships.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
