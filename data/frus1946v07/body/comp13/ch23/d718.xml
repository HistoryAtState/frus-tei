    <text>
        <body>
            <div xml:id="d718">

                <pb facs="0923" n="911" sameAs="frus:frus1946v07/pg911"/>

                <note rend="inline" type="source">867.51/8–1646: Telegram</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Turkey</hi> (<hi rendition="#italic">Wilson</hi>)</head>
                <opener>
                    <seg rendition="#float-left">
                        <hi rendition="#small-caps">restricted</hi>
                    </seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1946-08-27T14:00:00-04:00">August 27, 1946—2
                            p.m.</date>
                    </dateline>
                </opener>
                <p>612. Urtel 880 Aug 16.<anchor n="42" xml:id="d718-f1"/> Turk Embassy advised
                    Eximbank approval exporter credits $25 million.<anchor n="43" xml:id="d718-f2"/>
                    Bank informed by Turk Govt <pb facs="0924" n="912" xml:id="pg912"/> division
                    among Ministries as follows: Economy and Affiliated Institutions 15,
                    Communications and Transport 5, Customs and Monopolies 4, Public Works 1.
                    Details period of time interest rate to be determined project by project. Turks
                    were told interest likely to average about three and half per cent.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Acheson</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d718-f1" n="42" xml:id="d718-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d718-f2" n="43" xml:id="d718-f2-content">
                <p>The Chairman of the Export-Import Bank addressed a letter to the Turkish
                    Ambassador on July 12.</p>
            </note>
        </listAnnotation>
    </standOff>
