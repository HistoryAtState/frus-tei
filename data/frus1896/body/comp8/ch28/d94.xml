    <text>
        <body>
            <div xml:id="d94">

                <pb facs="0215" n="121" sameAs="frus:frus1896/pg121"/>

                <head><hi rendition="#italic">Mr. Olney to Mr.
                            Eustis.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-04-04"><hi rendition="#italic">April 4,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 640.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Adverting to my No. 635, of the 30th
                    ultimo, I transmit for your information and tiles a copy of a further dispatch
                    from the consul of the United States at Tamatave, No. 133, of February 20 last,
                    concerning French jurisdiction over Americans in Madagascar.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Richard Olney.</hi></signed></closer>





