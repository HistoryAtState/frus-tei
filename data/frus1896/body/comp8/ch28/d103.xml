    <text>
        <body>
            <div xml:id="d103">

                <pb facs="0226" n="132" sameAs="frus:frus1896/pg132"/>

                <head><hi rendition="#italic">Mr. Eustis to Mr. Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1896-06-06"><hi rendition="#italic">June 6, 1896</hi></date>.
                        (Received June 19.)</dateline>
                    <seg rendition="#float-left">No. 512.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my dispatch, No. 511, of the
                    4th instant, concerning Madagascar, I send herewith copy of the statement which
                    Mr. Hanotaux, according to the morning papers, made yesterday to the committee
                    of the chamber charged with the bill for the annexation of the island.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">J. B. Eustis.</hi></signed></closer>


                <xi:include href="d103-a1.xml" xpointer="d103-a1"/>
