    <text>
        <body>
            <div xml:id="d422">

                <pb facs="0625" n="531" sameAs="frus:frus1896/pg531"/>

                <head><hi rendition="#italic">Mr. Olney to
                            Baron von Thielmann.</hi><anchor n="1"
                        xml:id="d422-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-03-28"><hi rendition="#italic">March 28,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 357.]</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to bring to your
                    attention, for the information of His Imperial Majesty’s Government, a copy of a
                    letter from Mr. W. L. Chambers, lately United States land commissioner to Samoa,
                    dated the 26th instant, making certain suggestions looking to the permanent and
                    safe preservation of the labors of that commission, now that they are
                    completed.</p>
                <p>The report of Mr. Chambers to which he refers will be found on pages 465 to 470
                    of Senate Ex-Doc. No. 97, Fifty-third Congress, third session, copies of which
                    have heretofore been supplied to your embassy.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Richard Olney.</hi></signed></closer>


                <xi:include href="d422-a1.xml" xpointer="d422-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d422-f1" n="1" type="source" xml:id="d422-f1-content">
                <p>Sent also <hi rendition="#italic">mutatis mutandis</hi> to the British
                    ambassador.</p>
            </note>
        </listAnnotation>
    </standOff>
