    <text>
        <body>
            <div xml:id="d221">

                <pb facs="0382" n="288" sameAs="frus:frus1896/pg288"/>

                <head><hi rendition="#italic">Mr. Bayard to Mr.
                            Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1896-05-16"><hi rendition="#italic">May 16, 1896</hi></date>.
                        (Received May 25.)</dateline>
                    <seg rendition="#float-left">No. 685.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my dispatch No. 667, of the
                    29th ultimo, I have this moment received, and hasten to transmit herewith by
                    to-day’s mail, a copy of a note from the foreign office relating to the proposed
                    extension to the westerly side of the North Pacific Ocean of the seal-fishery
                    regulations embodied in the award of the Paris Tribunal of 1893.</p>
                <p>I have, etc.</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>


                <xi:include href="d221-a1.xml" xpointer="d221-a1"/>
