    <text>
        <body>
            <div xml:id="d278">

                <pb facs="0455" n="361" sameAs="frus:frus1896/pg361"/>

                <head><hi rendition="#italic">Mr. Bayard to Mr.
                            Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1896-03-24"><hi rendition="#italic">March 24,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 637.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith, for
                    the information of your colleague, the Secretary of the Treasury, clippings from
                    to-day’s Times, giving the report of a debate in the House of Commons on the
                    “Diseases of animals bill,” together with two copies of a public document having
                    relation thereto.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">T. F. Bayard.</hi></signed></closer>
            </div>
        </body>
    </text>
