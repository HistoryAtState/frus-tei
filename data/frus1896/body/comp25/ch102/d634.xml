    <text>
        <body>
            <div xml:id="d634">

                <pb facs="0801" n="707" sameAs="frus:frus1896/pg707"/>

                <head><hi rendition="#italic">Mr. Rockhill to Mr.
                            Lee.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi></placeName>,<lb/><date
                            calendar="gregorian" when="1896-09-15"><hi rendition="#italic">September
                                15, 1896</hi></date>.</dateline></opener>
                <p>Your No. 123 received. Is answer you expected received? If not, press for
                    immediate and satisfactory one.</p>
                <closer><signed><hi rendition="#small-caps">Rockhill.</hi></signed></closer>
            </div>
        </body>
    </text>
