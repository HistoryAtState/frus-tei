    <text>
        <body>
            <div xml:id="d615">

                <pb facs="0790" n="696" sameAs="frus:frus1896/pg696"/>

                <head><hi rendition="#italic">Mr. Dupuy de Lôme to Mr. Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Spain at Washington</hi></placeName>,<lb/><date
                            calendar="gregorian" when="1896-02-29"><hi rendition="#italic">February
                                29, 1896</hi></date>.</dateline></opener>
                <p>Mr. <hi rendition="#small-caps">Secretary</hi>: I have the honor to acknowledge
                    the receipt of your excellency’s note No. 89 of the 26th instant, inclosing copy
                    of a letter and various documents relative to Messrs. E. Atkins &amp; Co.</p>
                <p>I avail, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. Dupuy de Lôme.</hi></signed></closer>
            </div>
        </body>
    </text>
