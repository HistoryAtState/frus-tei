    <text>
        <body>
            <div xml:id="d614">

                <pb facs="0789" n="695" sameAs="frus:frus1896/pg695"/>

                <head><hi rendition="#italic">Mr. Olney to Mr. Dupuy de Lôme.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-02-26"><hi rendition="#italic">February 26,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 89.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Herewith inclosed please find copy of
                    letter of E. Atkins &amp; Co., together with copies of the inclosures in said
                    letter referred to.</p>
                <p>I take this occasion, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Richard Olney.</hi></signed></closer>




