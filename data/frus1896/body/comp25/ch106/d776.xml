    <text>
        <body>
            <div xml:id="d776">

                <pb facs="0933" n="839" sameAs="frus:frus1896/pg839"/>

                <head><hi rendition="#italic">Mr. Springer to Mr.
                            Rockhill.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Consulate-General</hi>,<lb/><hi rendition="#italic"
                                >Habana</hi></placeName>, <date calendar="gregorian"
                            when="1896-12-16"><hi rendition="#italic">December 16, 1896</hi></date>.
                        (Received December 21.)</dateline>
                    <seg rendition="#float-left">No. 261.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith, for
                    the information of the Department, the accompanying clippings from the “Judicial
                    notices” of the Diario de la Marina, respecting the case of Julio Sanguily,
                    which is set down for a public hearing (juicio oral) on the 21st instant.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Joseph A. Springer</hi>,<lb/><hi
                            rendition="#italic">Vice-Consul-General.</hi></signed></closer>


                <xi:include href="d776-a1.xml" xpointer="d776-a1"/>
            </div>
