    <text>
        <body>
            <div xml:id="d781">

                <pb facs="0938" n="844" sameAs="frus:frus1896/pg844"/>

                <head><hi rendition="#italic">Mr. Lee to Mr. Olney</hi><anchor n="1"
                        xml:id="d781-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Consulate-General</hi>,<lb/><hi rendition="#italic"
                                >Habana</hi></placeName>, <date calendar="gregorian"
                            when="1897-01-22"><hi rendition="#italic">January 22, 1897</hi></date>.
                        (Received January 27.)</dateline>
                    <seg rendition="#float-left">No. 317.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith two
                    papers signed by Julio Sanguily, one in Spanish and the other in English. I
                    would suggest that the papers inclosed be not used until I telegraph to that
                    effect.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Fitzhugh Lee.</hi></signed></closer>


                <xi:include href="d781-a1.xml" xpointer="d781-a1"/>
            </div>
        </body>
    </text>
