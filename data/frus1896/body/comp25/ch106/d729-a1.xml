    <text>
        <body>
            <div xml:id="d729-a1">

                <pb facs="0866" n="772" sameAs="frus:frus1896/pg772"/>

                <opener><seg rendition="#center">[Duplicate.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Fortress Cabana</hi>, <hi rendition="#italic"
                            >Habana</hi></placeName>, <date calendar="gregorian" when="1895-08-17"
                                ><hi rendition="#italic">August 17,
                    1895</hi></date>.</dateline></opener>
                <p>Received of Ramon O. Williams, consul-general of the United States at Habana, the
                    sum of $164.25 in Spanish gold, equivalent to a draft to his order, signed by G.
                    B. Anderson, at Tampa, Fla., July 25, 1895, on the National Bank of the
                    Republic, New York, for $150 United States currency, equal to $164.25 Spanish
                    gold.</p>
                <closer><signed><hi rendition="#small-caps">Julio Sanguily.</hi></signed></closer>
            </div>
        </body>
