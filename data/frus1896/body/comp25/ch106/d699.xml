    <text>
        <body>
            <div xml:id="d699">

                <pb facs="0844" n="750" sameAs="frus:frus1896/pg750"/>

                <head><hi rendition="#italic">Message of the President.</hi></head>
                <p rendition="#flush"><hi rendition="#italic">To the Senate:</hi></p>
                <p>I transmit herewith, in response to a resolution of the Senate of the 6th ultimo,
                    a report from the Secretary of State, accompanied by copies of correspondence
                    concerning the arrest, imprisonment, trial, and condemnation to perpetual
                    imprisonment in chains of Julio Sanguily, a citizen of the United States, by the
                    authorities of Spain in Cuba.</p>
                <closer><signed><hi rendition="#small-caps">Grover Cleveland.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><hi rendition="#small-caps">Executive
                            Mansion</hi>,<lb/><placeName><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1897-02-01"><hi rendition="#italic">February 1,
                        1897</hi></date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
