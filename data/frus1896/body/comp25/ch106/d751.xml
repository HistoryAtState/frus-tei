    <text>
        <body>
            <div xml:id="d751">

                <pb facs="0911" n="817" sameAs="frus:frus1896/pg817"/>

                <head><hi rendition="#italic">Mr. Uhl to Mr.
                            Williams.</hi></head>
                <opener><dateline rendition="#float-right"><date calendar="gregorian"
                            when="1895-12-07"><hi rendition="#small-caps">December</hi> 7,
                            1895</date>.</dateline>
                    <seg rendition="#float-left">No. 1203.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information a copy of a
                    resolution of the United States Senate calling for all the correspondence
                    relating to the arrest, trial, conviction, and sentence of Julio Sanguily, and
                    directing that a copy of the record of the trial be obtained.</p>
                <p>You are instructed to obtain and forward to this Department as soon as
                    practicable a certified copy of the record.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Edwin F. Uhl</hi>,<lb/><hi
                            rendition="#italic">Assistant Secretary.</hi></signed></closer>


                <xi:include href="d751-a1.xml" xpointer="d751-a1"/>
            </div>
        </body>
