    <text>
        <body>
            <div xml:id="d709">

                <pb facs="0853" n="759" sameAs="frus:frus1896/pg759"/>

                <head><hi rendition="#italic">Mr. Uhl to Mr. Williams.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1895-04-05"><hi rendition="#italic">April 5,
                        1895</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1062.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I am in receipt of your dispatch No. 2462,
                    of the 28th ultimo, inclosing a copy of a letter addressed by you to Mr. Julio
                    Sanguily, informing him of the transfer of his case to civil jurisdiction.</p>
                <p>I am, sir, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Edwin F. Uhl.</hi></signed></closer>
            </div>
        </body>
    </text>
