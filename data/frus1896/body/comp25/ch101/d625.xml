    <text>
        <body>
            <div xml:id="d625">

                <pb facs="0798" n="704" sameAs="frus:frus1896/pg704"/>

                <head><hi rendition="#italic">Mr. Taylor to Mr.
                            Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Legation</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1897-01-20"><hi rendition="#italic">January 20, 1897</hi></date>.
                        (Received February 1.)</dateline>
                    <seg rendition="#float-left">No. 635.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Replying further to your No. 625, of the
                    15th ultimo, relative to the threat of the Cuban insurgents against the Juragua
                    Iron Company, I have the honor to inclose herewith a copy, with translation, of
                    a note from the minister for foreign affairs, informing me that he has advised
                    the minister of ultramar to take such action as would insure the safety of the
                    company’s property.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Hannis Taylor.</hi></signed></closer>


                <xi:include href="d625-a1.xml" xpointer="d625-a1"/>
