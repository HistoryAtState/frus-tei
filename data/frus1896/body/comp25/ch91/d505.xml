    <text>
        <body>
            <div xml:id="d505">

                <pb facs="0679" n="585" sameAs="frus:frus1896/pg585"/>

                <head><hi rendition="#italic">Mr. Olney to Mr. Dupuy de Lôme.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-04-30"><hi rendition="#italic">April 30,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 121.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to Department’s No. 111 of the
                    10th instant, I have the honor to inclose copy of a dispatch from our
                    consul-general at Habana, transmitting the sworn statement of the sole surviving
                    witness of the outrage committed on Dr. José Manuel Delgado.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Richard Olney.</hi></signed></closer>



                <xi:include href="d505-a1.xml" xpointer="d505-a1"/>
