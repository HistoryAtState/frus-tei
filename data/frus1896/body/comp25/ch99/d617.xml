    <text>
        <body>
            <div xml:id="d617">

                <pb facs="0791" n="697" sameAs="frus:frus1896/pg697"/>

                <head><hi rendition="#italic">Mr. Olney to Mr.
                            Dupuy de Lôme.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-04-11"><hi rendition="#italic">April 11,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 112.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith copy
                    of a report of the consul of the United States at Kingston, Jamaica, respecting
                    the case of the American schooner <hi rendition="#italic">William Todd</hi>, a
                    case which has already been called to your attention.</p>
                <p>I invite your attention to its early consideration, and to such settlement of the
                    same, conformably to the recent precedent of the <hi rendition="#italic"
                        >Alliança</hi> incident, as the dignity of the United States and the rights
                    of its citizens require.</p>
                <p>I avail, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Richard Olney.</hi></signed></closer>


                <xi:include href="d617-a1.xml" xpointer="d617-a1"/>
            </div>
        </body>
    </text>
