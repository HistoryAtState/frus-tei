                <pb facs="0728" n="634" sameAs="frus:frus1896/pg634"/>

                <head><hi rendition="#italic">Mr. Armstrong to Mr. Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1896-06-02"><hi rendition="#italic">June 2, 1896</hi></date>.
                        (Received June 15.)</dateline>
                    <seg rendition="#float-left">No. 528.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your No. 505, of the 13th ultimo, to Minister Taylor, relative to the arrest
                    of William A. Glean and his brother, Lewis N. Glean, citizens of the United
                    States, by the Spanish military authorities at Sagua la Grande, Cuba, and to
                    inform you that the case has been duly presented to the Spanish Government.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">H. Clay Armstrong</hi>, Jr.,<lb/><hi
                            rendition="#italic">Chargé d’Affaires ad interim.</hi></signed></closer>
            </div>
        </body>
