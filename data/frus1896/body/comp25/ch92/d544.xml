                <pb facs="0743" n="649" sameAs="frus:frus1896/pg649"/>

                <head><hi rendition="#italic">Mr. Taylor to Mr. Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1896-11-04"><hi rendition="#italic">November 4, 1896</hi></date>.
                        (Received Nov. 16.)</dateline>
                    <seg rendition="#float-left">No. 595.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your No. 592, of the 21st ultimo, relative to the case of Mr. del Villar, and
                    to inform you that I this day presented the case to the Spanish Government as
                    instructed.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Hannis Taylor.</hi></signed></closer>
            </div>
        </body>
