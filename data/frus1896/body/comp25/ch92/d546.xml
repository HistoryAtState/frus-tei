        <body>
            <div xml:id="d546">

                <pb facs="0743" n="649" sameAs="frus:frus1896/pg649"/>

                <head><hi rendition="#italic">Mr. Taylor to Mr. Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1896-11-06"><hi rendition="#italic">November 6, 1896</hi></date>.
                        (Received Nov. 21.)</dateline>
                    <seg rendition="#float-left">No. 600.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a copy and
                    translation of a note received from the minister of state relative to the case
                    of Chaqueilo.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Hannis Taylor.</hi></signed></closer>


                <xi:include href="d546-a1.xml" xpointer="d546-a1"/>
