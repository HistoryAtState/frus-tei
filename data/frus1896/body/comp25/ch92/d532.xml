    <text>
        <body>
            <div xml:id="d532">

                <pb facs="0734" n="640" sameAs="frus:frus1896/pg640"/>

                <head><hi rendition="#italic">Mr. Taylor to Mr.
                            Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1896-07-10"><hi rendition="#italic">July 10, 1896</hi></date>.
                        (Received July 25.)</dateline>
                    <seg rendition="#float-left">No. 540.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your No. 527, of the 24th ultimo, and to report that I have duly communicated
                    to the Spanish Government the further evidence therein contained relative to the
                    case of the brothers Glean.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Hannis Taylor.</hi></signed></closer>
            </div>
        </body>
    </text>
