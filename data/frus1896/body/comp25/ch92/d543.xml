        <body>
            <div xml:id="d543">

                <pb facs="0742" n="648" sameAs="frus:frus1896/pg648"/>

                <head><hi rendition="#italic">Mr. Taylor to Mr.
                            Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1896-10-29"><hi rendition="#italic">October 29, 1896</hi></date>.
                        (Received Nov. 13.)</dateline>
                    <seg rendition="#float-left">No. 589.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor of submitting for your
                    consideration a note, with translation, lately received from the Spanish
                    Government concerning the case of Manuel Fernandez Chaqueilo.</p>
                <p>Awaiting your further instructions, I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Hannis Taylor.</hi></signed></closer>


                <xi:include href="d543-a1.xml" xpointer="d543-a1"/>
