                <pb facs="0727" n="633" sameAs="frus:frus1896/pg633"/>

                <head><hi rendition="#italic">Mr. Taylor to Mr.
                            Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1896-05-23"><hi rendition="#italic">May 23, 1896</hi></date>.
                        (Received June 5.)</dateline>
                    <seg rendition="#float-left">No. 522.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your telegram of the 18th instant.</p>
                <p>Acting in accordance therewith, the case will not be submitted for consideration
                    to the Spanish Government.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Hannis Taylor.</hi></signed></closer>
            </div>
        </body>
    </text>
