                <pb facs="0833" n="739" sameAs="frus:frus1896/pg739"/>

                <head><hi rendition="#italic">Mr. Lee to Mr. Rockhill.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Consulate-General</hi>,<lb/><hi rendition="#italic"
                                >Habana</hi></placeName>, <date calendar="gregorian"
                            when="1896-09-09"><hi rendition="#italic">September 9,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 118.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit herewith copy translation of a
                    note from Captain-General Weyler relative to the quarters in the Cabaña fortress
                    occupied by the <hi rendition="#italic">Competitor</hi> prisoners.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Fitzhugh Lee.</hi></signed></closer>



                <xi:include href="d683-a1.xml" xpointer="d683-a1"/>
