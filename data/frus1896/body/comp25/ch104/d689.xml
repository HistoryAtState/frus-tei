    <text>
        <body>
            <div xml:id="d689">

                <pb facs="0837" n="743" sameAs="frus:frus1896/pg743"/>

                <head><hi rendition="#italic">Mr. Rockhill to Mr.
                            Springer.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-11-19"><hi rendition="#italic">November 19,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 165.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for your information and such
                    action as the exigency of the case demands, a copy of a letter from Mrs. Emmie
                    Laborde, transmitting a communication from Alfred Laborde, master of the <hi
                        rendition="#italic">Competitor</hi>, relative to a new trial of the men of
                    the <hi rendition="#italic">Competitor</hi>.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. W. Rockhill.</hi></signed></closer>
            </div>
        </body>
    </text>
