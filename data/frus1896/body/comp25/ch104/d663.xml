    <text>
        <body>
            <div xml:id="d663">

                <pb facs="0813" n="719" sameAs="frus:frus1896/pg719"/>

                <head><hi rendition="#italic">Mr. Rockhill to Mr.
                            Williams.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-05-11"><hi rendition="#italic">May 11,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1362.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The Department has received your dispatch
                    No. 2940, of the 2d instant, with inclosures, relative to the capture of the
                    American schooner <hi rendition="#italic">Competitor.</hi></p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. W. Rockhill.</hi></signed></closer>
            </div>
        </body>
    </text>
