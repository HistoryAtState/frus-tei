    <text>
        <body>
            <div xml:id="d672-a11">

                <pb facs="0826" n="732" sameAs="frus:frus1896/pg732"/>

                <opener><seg rendition="#center">[Inclosure 11 in No. 2987.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >United States Consulate-General</hi>,<lb/><hi rendition="#italic"
                                >Habana</hi></placeName>, <date calendar="gregorian"
                            when="1896-05-11"><hi rendition="#italic">May 11,
                        1896</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Colleague</hi>: I have to acknowledge the
                    receipt of your note of to-day, with many thanks for the interesting information
                    therein conveyed.</p>
                <p>Sincerely, yours,</p>
                <closer><signed><hi rendition="#small-caps">Ramon O.
                    Williams.</hi></signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Alex. Gollan</hi>, Esq.,<lb/><hi
                            rendition="#italic">Her Britannic Majesty’s Consul-General,
                        Habana.</hi></p>
                </postscript>
            </div>
        </body>
