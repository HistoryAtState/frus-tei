    <text>
        <body>
            <div xml:id="d697">

                <pb facs="0840" n="746" sameAs="frus:frus1896/pg746"/>

                <head><hi rendition="#italic">Message of the President.</hi></head>
                <p rendition="#flush"><hi rendition="#italic">To the Senate of the United
                        States:</hi></p>
                <p>I transmit herewith in response to the Senate resolution of December 21, 1896,
                    addressed to the Secretary of State, a report of that officer, covering a list
                    of persons claiming to be citizens of the United States, who have been arrested
                    on the Island of Cuba since February 24, 1895, to the present time.</p>
                <closer><signed><hi rendition="#small-caps">Grover Cleveland.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><hi rendition="#small-caps">Executive
                            Mansion</hi>,<lb/><placeName><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1897-01-25"><hi rendition="#italic">January 25,
                        1897.</hi></date></dateline>
                </closer>
            </div>
        </body>
    </text>
