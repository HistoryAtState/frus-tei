    <text>
        <body>
            <div xml:id="d576">

                <pb facs="0770" n="676" sameAs="frus:frus1896/pg676"/>

                <head><hi rendition="#italic">Mr. Olney to Mr.
                            Dupuy de Lôme.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-03-13"><hi rendition="#italic">March 13,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 100.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose for your
                    information copy of a letter just received from Messrs. E. Atkins &amp; Co., of
                    Boston, reporting further devastation of their cane fields by the
                    insurgents.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Richard Olney.</hi></signed></closer>


                <xi:include href="d576-a1.xml" xpointer="d576-a1"/>
