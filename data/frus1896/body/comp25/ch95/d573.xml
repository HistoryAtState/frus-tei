    <text>
        <body>
            <div xml:id="d573">

                <pb facs="0768" n="674" sameAs="frus:frus1896/pg674"/>

                <head><hi rendition="#italic">Mr. Olney to Mr. Dupuy de Lôme.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-02-14"><hi rendition="#italic">February 14,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 81.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose for your
                    information copies of the statements of the complaints made by Messrs. Perfecto
                    Lacoste and Patricio Ponce de Leon, American citizens, whose property in Cuba
                    has been destroyed by the insurgents.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Richard Olney.</hi></signed></closer>


                <xi:include href="d573-a1.xml" xpointer="d573-a1"/>
            </div>
