    <text>
        <body>
            <div xml:id="d623">

                <pb facs="0797" n="703" sameAs="frus:frus1896/pg703"/>

                <head><hi rendition="#italic">Mr. Taylor to Mr. Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1896-10-26"><hi rendition="#italic">October 26, 1896</hi></date>.
                        (Received November 10.)</dateline>
                    <seg rendition="#float-left">No. 583.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In reference to your No. 552, of the 20th
                    of August last, relative to the “Teresa” plantation, belonging to certain
                    American citizens, Messrs. Farrel and Rigney, I have the honor to inclose
                    herewith copy and translation of a note received from the Spanish Government in
                    reply to mine presenting the case.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Hannis Taylor.</hi></signed></closer>


                <xi:include href="d623-a1.xml" xpointer="d623-a1"/>
