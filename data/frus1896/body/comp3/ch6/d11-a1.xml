    <text>
        <body>
            <div xml:id="d11-a1">

                <pb facs="0114" n="20" sameAs="frus:frus1896/pg20"/>

                <opener><seg rendition="#center">[Inclosure in No. 203.]</seg></opener>
                <head><hi rendition="#italic">Mr. Morton to Mr.
                            Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps">U.
                                S. Department of Agriculture,<lb/>Office of the
                                Secretary</hi>,<lb/><hi rendition="#italic">Washington, D.
                            C.</hi></placeName>, <date calendar="gregorian" when="1896-04-07"><hi
                                rendition="#italic">April 7, 1896</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge with thanks
                    the receipt of your letter of the 1st instant in regard to your action
                    concerning the Belgian prohibition of American cattle, and in this connection I
                    inclose for your information a copy of a letter on the same subject from
                    Sanderson &amp; Son, steamship agents, 22 State street, New York.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">J. Sterling Morton</hi>,<lb/><hi
                            rendition="#italic">Secretary</hi>.</signed></closer>
            </div>
        </body>
    </text>
