        <body>
            <div xml:id="d307">

                <pb facs="0481" n="387" sameAs="frus:frus1896/pg387"/>

                <head><hi rendition="#italic">Mr. Mills to Mr. Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Honolulu</hi></placeName>, <date calendar="gregorian"
                            when="1896-06-22"><hi rendition="#italic">June 22, 1896</hi></date>.
                        (Received July 8.)</dateline>
                    <seg rendition="#float-left">No. 162.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I transmit copy of act No. 77, “to
                    prescribe the procedure in proceedings for naturalization of aliens.”</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Ellis Mills</hi>,<lb/><hi
                            rendition="#italic">Chargé d’Affaires ad interim.</hi></signed></closer>


                <xi:include href="d307-a1.xml" xpointer="d307-a1"/>
