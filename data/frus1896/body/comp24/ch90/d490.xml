    <text>
        <body>
            <div xml:id="d490">

                <pb facs="0672" n="578" sameAs="frus:frus1896/pg578"/>

                <head><hi rendition="#italic">Mr. Rockhill to Mr.
                            Knight.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi></placeName>, <date calendar="gregorian"
                            when="1896-03-07"><hi rendition="#italic">March 7,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 74.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for transmission to Mr. J. C.
                    Manion, consular agent at Johannesburg, a copy of a telegram from Mr. Hammond,
                    one of the Americans under arrest at Johannesburg, expressing his appreciation
                    of Mr. Manion’s efforts in his behalf, and saying that he is well treated by the
                    Transvaal Government.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. W. Rockhill.</hi><lb/><hi
                            rendition="#italic">Assistant Secretary.</hi></signed></closer>


                <xi:include href="d490-a1.xml" xpointer="d490-a1"/>
