                <pb facs="0675" n="581" xml:id="pg581"/>

                <head><hi rendition="#italic">Mr. Knight to Mr. Olney.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Cape Town</hi></placeName>, <date calendar="gregorian"
                            when="1896-06-11"><hi rendition="#italic">June 11,
                        1896</hi></date>.</dateline></opener>
                <p>Reform leaders released. Fined £25,000. No banishment.</p>
                <closer><signed><hi rendition="#small-caps">Knight.</hi></signed></closer>
            </div>
        </body>
