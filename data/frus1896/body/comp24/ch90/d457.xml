    <text>
        <body>
            <div xml:id="d457">

                <pb facs="0657" n="563" sameAs="frus:frus1896/pg563"/>

                <head><hi rendition="#italic">Mr. Olney to Mr. Bayard.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-01-15"><hi rendition="#italic">January 15,
                        1896</hi></date>.</dateline></opener>
                <p>Express to foreign office sincere thanks of this Government for prompt use of
                    kindly offices in aid of American citizens in the Transvaal.</p>
                <closer><signed><hi rendition="#small-caps">Olney.</hi></signed></closer>
            </div>
        </body>
    </text>
