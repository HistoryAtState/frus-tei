    <text>
        <body>
            <div xml:id="d125">

                <pb facs="0255" n="161" sameAs="frus:frus1896/pg161"/>

                <head><hi rendition="#italic">Mr. Olney to Mr.
                            von Reichenau.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-12-03"><hi rendition="#italic">December 3,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 251.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith for
                    the information of your Government a half-dozen copies of the President’s
                    proclamation of today’s date, suspending from and after January 2, 1897, the
                    provisions of his proclamation of January 26, 1888, in relation to tonnage
                    dues.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Richard Olney.</hi></signed></closer>



                <xi:include href="d125-a1.xml" xpointer="d125-a1"/>
