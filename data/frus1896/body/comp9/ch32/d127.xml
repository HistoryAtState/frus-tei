    <text>
        <body>
            <div xml:id="d127">

                <pb facs="0257" n="163" sameAs="frus:frus1896/pg163"/>

                <head><hi rendition="#italic">Mr. Olney to Mr.
                            von Reichenau.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-12-13"><hi rendition="#italic">December 13,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 260.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of your note of the 4th instant, presenting the views of your Government
                    relative to the proclamation of the 3d instant, by the President of the United
                    States of America, revoking the proclamation of January 26, 1888, concerning the
                    exemption from tonnage dues of German ships in ports of the United States.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Richard Olney.</hi></signed></closer>
            </div>
        </body>
    </text>
