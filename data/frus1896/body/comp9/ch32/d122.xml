    <text>
        <body>
            <div xml:id="d122">

                <pb facs="0253" n="159" sameAs="frus:frus1896/pg159"/>

                <head><hi rendition="#italic">Mr. Uhl to Mr. Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1896-11-04"><hi rendition="#italic">November 4, 1896</hi></date>.
                        (Received Nov. 14.)</dateline>
                    <seg rendition="#float-left">No. 165.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to ray dispatch No. 100, of July
                    31 last, I have the honor to inclose herewith a copy, with translation, of a
                    note to-day received from the Imperial foreign office, in regard to the exaction
                    of tonnage dues from American vessels in German ports, and to be, sir,</p>
                <p>Your obedient servant,</p>
                <closer><signed><hi rendition="#small-caps">Edwin F. Uhl.</hi></signed></closer>


                <xi:include href="d122-a1.xml" xpointer="d122-a1"/>
