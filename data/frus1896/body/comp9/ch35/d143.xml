    <text>
        <body>
            <div xml:id="d143">

                <pb facs="0290" n="196" sameAs="frus:frus1896/pg196"/>

                <head><hi rendition="#italic">Mr. Uhl to Mr.
                            Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1896-08-12"><hi rendition="#italic">August 12, 1896</hi></date>.
                        (Received August 27.)</dateline>
                    <seg rendition="#float-left">No. 108.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith, with
                    translation, copy of the acknowledgment this day received from the Imperial
                    foreign office to my note No. 78, of August 5 last, addressed to his excellency
                    Baron von Rotenhan, acting Imperial secretary of state for foreign affairs, in
                    regard to the pending application of the Mutual Life Insurance Company and the
                    New York Life Insurance Company for permission to resume business in Prussia,
                    copy of which note accompanied my dispatch No. 101, August 5, 1896.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Edwin F. Uhl.</hi></signed></closer>


                <xi:include href="d143-a1.xml" xpointer="d143-a1"/>
