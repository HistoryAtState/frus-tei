    <text>
        <body>
            <div xml:id="d142">

                <pb facs="0289" n="195" sameAs="frus:frus1896/pg195"/>

                <head><hi rendition="#italic">Mr. Uhl to Mr.
                            Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1896-08-05"><hi rendition="#italic">August 5, 1896</hi></date>.
                        (Received Aug. 18.)</dateline>
                    <seg rendition="#float-left">No. 101.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith copy
                    of my note of to-day’s date, F. O. 78, in which the attention of the foreign
                    office is again invited to the applications of the Mutual Life Insurance
                    Company, of New York, and the New York Life Insurance Company for permission to
                    resume business in Prussia, and to be, sir, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Edwin F. Uhl.</hi></signed></closer>


                <xi:include href="d142-a1.xml" xpointer="d142-a1"/>
