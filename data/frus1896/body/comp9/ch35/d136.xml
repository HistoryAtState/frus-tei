    <text>
        <body>
            <div xml:id="d136">

                <pb facs="0286" n="192" sameAs="frus:frus1896/pg192"/>

                <head><hi rendition="#italic">Mr. Jackson to Mr. Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1896-02-08"><hi rendition="#italic">February 8, 1896</hi></date>.
                        (Received Feb. 24.)</dateline>
                    <seg rendition="#float-left">No. 469.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to append hereto, in the
                    form of memoranda, notes on certain subjects, more particularly mentioned below,
                    relating <pb facs="0287" n="193" xml:id="pg193"/> to the commercial relations
                    between the United States and Germany, and to the parliamentary debates of the
                    past week, and to be, sir,</p>
                <p>Your obedient servant,</p>
                <closer><signed><hi rendition="#small-caps">John B. Jackson.</hi></signed></closer>


                <xi:include href="d136-a1.xml" xpointer="d136-a1"/>
            </div>
