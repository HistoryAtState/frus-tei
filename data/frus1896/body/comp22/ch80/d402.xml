    <text>
        <body>
            <div xml:id="d402">

                <pb facs="0600" n="506" sameAs="frus:frus1896/pg506"/>

                <head><hi rendition="#italic">Mr. Rockhill to Mr.
                            Breckinridge.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-09-11"><hi rendition="#italic">September 11,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 300.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 375, of the 27th ultimo, inclosing copy of your note of the same date to the
                    Russian <pb facs="0601" n="507" xml:id="pg507"/> foreign office, requesting
                    executive clemency for five American citizens convicted of illegal sealing in
                    Russian waters.</p>
                <p>Your note is approved.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. W. Rockhill</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
