    <text>
        <body>
            <div xml:id="d397">

                <pb facs="0595" n="501" sameAs="frus:frus1896/pg501"/>

                <head><hi rendition="#italic">Mr. Olney to Mr. Breckinridge.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-04-17"><hi rendition="#italic">April 17,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 223.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 271 of the 1st instant, inclosing copy of your note to the Russian minister
                    of foreign affairs in the matter of the citizens of the United States said to
                    have been imprisoned at Saghalien on the charge of illegal sealing.</p>
                <p>Your note is approved.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Richard Olney.</hi></signed></closer>
            </div>
        </body>
    </text>
