    <text>
        <body>
            <div xml:id="d360-a1">

                <pb facs="0551" n="457" sameAs="frus:frus1896/pg457"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 715.]</seg></opener>
                <head><hi rendition="#italic">Mr. Baker, chargé, to
                        Mr. Castellanos.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Managua</hi></placeName>, <date calendar="gregorian"
                            when="1896-10-15"><hi rendition="#italic">October 15,
                        1896</hi></date>.</dateline></opener>
                <p>Has Diet taken charge Salvador diplomatic affairs and has your foreign office
                    been abolished? Please answer by telegraph.</p>
                <closer><signed><hi rendition="#small-caps">Baker.</hi></signed></closer>
            </div>
        </body>
