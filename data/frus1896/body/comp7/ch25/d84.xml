    <text>
        <body>
            <div xml:id="d84">

                <pb facs="0204" n="110" sameAs="frus:frus1896/pg110"/>

                <head><hi rendition="#italic">Mr. Olney to Mr. Tillman.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-11-03"><hi rendition="#italic">November 3,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 82.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The Department has been gratified to
                    receive your No. 90, of the 13th ultimo, inclosing the award of Mr. St. John in
                    the Santos matter.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Richard Olney.</hi></signed></closer>
            </div>
        </body>
    </text>
