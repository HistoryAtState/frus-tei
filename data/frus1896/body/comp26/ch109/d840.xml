    <text>
        <body>
            <div xml:id="d840">

                <pb facs="0979" n="885" sameAs="frus:frus1896/pg885"/>

                <head><hi rendition="#italic">Mr. Rockhill to Mr.
                            Terrell.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-08-24"><hi rendition="#italic">August 24,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1072.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 943, of the 11th instant, and to approve your note to the minister for
                    foreign affairs of that date concerning the indemnity for the destruction of
                    American missionary property at Harpoot and the conduct of the Turkish
                    authorities in connection therewith.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. W. Rockhill</hi>,<lb/><hi
                            rendition="#italic">Acting Secretary.</hi></signed></closer>
            </div>
        </body>
    </text>
