    <text>
        <body>
            <div xml:id="d793">

                <pb facs="0946" n="852" sameAs="frus:frus1896/pg852"/>

                <head><hi rendition="#italic">Mr. Olney to Mr.
                            Terrell.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-03-03"><hi rendition="#italic">March 3,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 888.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Your No. 815, of the 17th ultimo, inclosing
                    a note from the Rev. Mr. Fuller, at Aintab, commending the services rendered by
                    Consular Agent Poche to missionaries, has been received. The Department
                    appreciates Mr. Poche’s exertions, and is pleased to learn that their value is
                    recognized by the missionaries.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Richard Olney.</hi></signed></closer>
            </div>
        </body>
    </text>
