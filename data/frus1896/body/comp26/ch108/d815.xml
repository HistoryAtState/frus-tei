    <text>
        <body>
            <div xml:id="d815">

                <pb facs="0963" n="869" sameAs="frus:frus1896/pg869"/>

                <head><hi rendition="#italic">Mr. Terrell to Mr. Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1896-10-05"><hi rendition="#italic">October 5, 1896</hi></date>.
                        (Received Oct. 17.)</dateline>
                    <seg rendition="#float-left">No. 1012.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith the
                    copy of a letter from Commander E. M. Shepard, of the U. S. S. <hi
                        rendition="#italic">San Francisco</hi>, dated at Alexandretta, and also a
                    copy of my letter in response.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">A. W. Terrell.</hi></signed></closer>



                <xi:include href="d815-a1.xml" xpointer="d815-a1"/>
