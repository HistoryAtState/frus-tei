        <body>
            <div xml:id="d789">

                <pb facs="0942" n="848" sameAs="frus:frus1896/pg848"/>

                <head><hi rendition="#italic">Mr. Terrell to Mr.
                            Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1896-02-09"><hi rendition="#italic">February 9, 1896</hi></date>.
                        (Received Feb. 25.)</dateline>
                    <seg rendition="#float-left">No. 805.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose for your
                    information a report from Consul Jewett on affairs at Marsovan. He was permitted
                    to come to this city for consultation at the request of American
                    missionaries.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">A. W. Terrell.</hi></signed></closer>


                <xi:include href="d789-a1.xml" xpointer="d789-a1"/>
