    <text>
        <body>
            <div xml:id="d823">

                <pb facs="0969" n="875" sameAs="frus:frus1896/pg875"/>

                <head><hi rendition="#italic">Mr. Terrell to Mr.
                            Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1896-11-27"><hi rendition="#italic">November 27, 1896</hi></date>.
                        (Received Dec. 14.)</dateline>
                    <seg rendition="#float-left">No. 1080.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose the copy of a
                    letter just received from President Tracy at Marsovan, which shows an era of
                    renewed suspicion and danger there.</p>
                <p>I will to-morrow endeavor to secure orders from the Porte to relieve him from
                    these annoyances which naturally embarrass.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">A. W. Terrell.</hi></signed></closer>


                <xi:include href="d823-a1.xml" xpointer="d823-a1"/>
