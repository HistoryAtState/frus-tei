    <text>
        <body>
            <div xml:id="d825">

                <pb facs="0972" n="878" xml:id="pg878"/>

                <head><hi rendition="#italic">Mr. Terrell to Mr.
                            Olney.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1897-01-11"><hi rendition="#italic">January 11,
                        1897</hi></date>.</dateline></opener>
                <p>I have obtained telegraphic orders to withdraw the guard at Bitlis on request of
                    missionaries there.</p>
                <closer><signed><hi rendition="#small-caps">Terrell.</hi></signed></closer>
            </div>
        </body>
    </text>
