        <body>
            <div xml:id="d805">

                <pb facs="0952" n="858" sameAs="frus:frus1896/pg858"/>

                <head><hi rendition="#italic">Mr. Terrell to Mr. Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1896-08-06"><hi rendition="#italic">August 6, 1896</hi></date>.
                        (Received Aug. 20.)</dateline>
                    <seg rendition="#float-left">No. 941.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that it was
                    deemed prudent to send the inclosed telegram to each mission post in the
                    interior.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">A. W. Terrell.</hi></signed></closer>



                <xi:include href="d805-a1.xml" xpointer="d805-a1"/>
