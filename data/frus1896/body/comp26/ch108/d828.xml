    <text>
        <body>
            <div xml:id="d828">

                <pb facs="0972" n="878" sameAs="frus:frus1896/pg878"/>

                <head><hi rendition="#italic">Mr. Terrell to Mr.
                            Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1897-01-20"><hi rendition="#italic">January 20, 1897</hi></date>.
                        (Received Feb. 5.)</dateline>
                    <seg rendition="#float-left">No. 1145.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose the copy of my
                    circular letter of the 19th instant to all educational posts in the interior,
                    which is sent to ascertain whether Turkish guards can be with safety dispensed
                    with.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">A. W. Terrell.</hi></signed></closer>


                <xi:include href="d828-a1.xml" xpointer="d828-a1"/>
