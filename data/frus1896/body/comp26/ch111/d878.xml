                <pb facs="1014" n="920" sameAs="frus:frus1896/pg920"/>

                <head><hi rendition="#italic">Mr. Adee to Mr.
                            Terrell.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-08-21"><hi rendition="#italic">August 21,
                        1896</hi></date>.</dateline></opener>
                <p>Referring to your 939, Sarkis Balaian, born 1871, emigrated 1888, naturalized,
                    Boston, January 10, 1895; passport No. 19174, issued January 12, 1895.</p>
                <closer><signed><hi rendition="#small-caps">Adee</hi>, <hi rendition="#italic"
                            >Acting.</hi></signed></closer>
            </div>
        </body>
    </text>
