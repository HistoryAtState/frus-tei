                <pb facs="1012" n="918" sameAs="frus:frus1896/pg918"/>

                <opener><seg rendition="#center">[Inclosure 1 in No. 952.]</seg></opener>
                <head><hi rendition="#italic">Mr. Terrell to Tahsin Bey.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1896-08-15"><hi rendition="#italic">August 15,
                        1896</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I request that you present my compliments
                    to His Imperial Majesty and inform him that I demand a personal audience with
                    him under instructions from my Government.</p>
                <p>Receive, excellency, etc.</p>
                <closer><signed><hi rendition="#small-caps">A. W. Terrell.</hi></signed></closer>
            </div>
        </body>
