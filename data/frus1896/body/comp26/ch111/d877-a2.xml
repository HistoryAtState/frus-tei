    <text>
        <body>
            <div xml:id="d877-a2">

                <pb facs="1013" n="919" xml:id="pg919"/>

                <opener><seg rendition="#center">[Inclosure 2 in No. 952.]</seg></opener>
                <head><hi rendition="#italic">Izzet Bey to Mr.
                            Terrell.</hi></head>
                <opener><dateline rendition="#float-right"><date calendar="gregorian"
                            when="1896-08-15"><hi rendition="#small-caps">August</hi> 15,
                            1896.</date></dateline></opener>
                <p>Mr. <hi rendition="#small-caps">Minister</hi>: His Imperial Majesty, my august
                    master, being occupied up to Friday and not being able to grant you an audience
                    in the course of the week, I keep myself at the disposal of your excellency for
                    any communication you may please to make to me.</p>
                <p>I avail myself, etc.,</p>
                <closer><signed><hi rendition="#small-caps">A. Izzet.</hi></signed></closer>
            </div>
        </body>
    </text>
