    <text>
        <body>
            <div xml:id="d868">

                <pb facs="1001" n="907" sameAs="frus:frus1896/pg907"/>

                <head><hi rendition="#italic">Mr. Riddle to Mr. Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1896-05-14"><hi rendition="#italic">May 14, 1896</hi></date>.
                        (Received May 29.)</dateline>
                    <seg rendition="#float-left">No. 872.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a
                    narrative which Mr. Knapp has written for your information, at my request, in
                    order that you might receive at first hand a full account of the manner of his
                    deportation and the treatment he was subjected to on his journey.</p>
                <p>I have, etc.</p>
                <closer><signed><hi rendition="#small-caps">J. W. Riddle.</hi></signed></closer>


                <xi:include href="d868-a1.xml" xpointer="d868-a1"/>
