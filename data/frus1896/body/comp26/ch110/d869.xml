    <text>
        <body>
            <div xml:id="d869">

                <pb facs="1006" n="912" sameAs="frus:frus1896/pg912"/>

                <head><hi rendition="#italic">Mr. Riddle to Mr. Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1896-06-18"><hi rendition="#italic">June 18, 1896</hi></date>.
                        (Received July 3.)</dateline>
                    <seg rendition="#float-left">No. 897.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith for
                    your further information in the case of Rev. George Knapp copy of a note
                    received from the minister for foreign affairs, with a memorandum annexed which
                    constitutes the only thing in the nature of charges so far presented by the
                    Porte.</p>
                <p>I have, etc.</p>
                <closer><signed><hi rendition="#small-caps">J. W. Riddle</hi>.</signed></closer>




