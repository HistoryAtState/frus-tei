                <pb facs="0155" n="61" xml:id="pg61"/>

                <head><hi rendition="#italic">Mr. Denby to Mr. Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1896-10-03"><hi rendition="#italic">October 3, 1896</hi></date>.
                        (Received Nov. 14.)</dateline>
                    <seg rendition="#float-left">No. 2610.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In my dispatch No. 2604, of September 21, I
                    inclosed a copy of a dispatch relating to antiforeign riots in China which was
                    sent by your direction to the Tsung-li Yamên.</p>
                <p>I now have the honor to inclose a translation of a dispatch received from the
                    Yamên in reply to my dispatch. It will be seen that the inclosure is
                    conciliatory and satisfactory in tone.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles Denby.</hi></signed></closer>


                <xi:include href="d38-a1.xml" xpointer="d38-a1"/>
