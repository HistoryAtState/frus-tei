    <text>
        <body>
            <div xml:id="d39">

                <pb facs="0155" n="61" sameAs="frus:frus1896/pg61"/>

                <head><hi rendition="#italic">Mr. Olney to Mr.
                            Denby.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-11-03"><hi rendition="#italic">November 3,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1360.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to approve the note addressed by you
                    to the Yamên on September 21, 1896, a copy of which is inclosed with your No.
                    2604, of the same date, on the subject of antiforeign riots in China.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Richard Olney.</hi></signed></closer>
            </div>
        </body>
    </text>
