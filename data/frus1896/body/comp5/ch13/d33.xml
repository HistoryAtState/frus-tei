    <text>
        <body>
            <div xml:id="d33">

                <pb facs="0150" n="56" sameAs="frus:frus1896/pg56"/>

                <head><hi rendition="#italic">Mr. Denby, chargé, to Mr. Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Peking</hi></placeName>, <date calendar="gregorian"
                            when="1896-07-22"><hi rendition="#italic">July 22, 1896</hi></date>.
                        (Received September 4.)</dateline>
                    <seg rendition="#float-left">No. 2566.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    of the receipt given by J. R. Goddard, treasurer of the American Baptist
                    Missionary Union, for 14,305 taels, paid by the Chinese Government, through the
                    Shanghai taotai, for said mission’s losses in Szechuan.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles Denby</hi>, Jr.,<lb/><hi
                            rendition="#italic">Chargé d’Affaires ad interim.</hi></signed></closer>


                <xi:include href="d33-a1.xml" xpointer="d33-a1"/>
            </div>
