    <text>
        <body>
            <div xml:id="d340">

                <pb facs="0520" n="426" sameAs="frus:frus1896/pg426"/>

                <head><hi rendition="#italic">Mr. Olney to Mr.
                            MacVeagh.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-12-26"><hi rendition="#italic">December 26,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 219.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: The Department has been gratified to learn
                    from your No. 220, of the 11th instant, of the discharge of Vittorio Gardella, a
                    naturalized American citizen of Italian origin, from the military service of
                    Italy by a grant of unlimited leave.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Richard Olney.</hi></signed></closer>
            </div>
        </body>
    </text>
