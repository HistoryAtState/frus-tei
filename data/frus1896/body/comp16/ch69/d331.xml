    <text>
        <body>
            <div xml:id="d331">

                <pb facs="0501" n="407" sameAs="frus:frus1896/pg407"/>

                <head><hi rendition="#italic">Mr. Olney to Baron Fava.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1896-10-10"><hi rendition="#italic">October 10,
                        1896</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 161.]</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of your note of the 27th ultimo relative to the lynching at Hahnville in
                    response to Department’s note No. 155, of the 21st ultimo, on the same
                    subject.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Richard Olney.</hi></signed></closer>
            </div>
        </body>
    </text>
