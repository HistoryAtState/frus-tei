    <text>
        <body>
            <div xml:id="d326-a1">

                <pb facs="0497" n="403" sameAs="frus:frus1896/pg403"/>

                <opener><seg rendition="#center">[Inclosure in No. 148.]</seg></opener>
                <head><hi rendition="#italic">Governor Foster to
                        Mr. Rockhill.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >State of Louisiana, Executive Department</hi>,<lb/><hi
                                rendition="#italic">Baton Rouge, La.</hi></placeName>, <date
                            calendar="gregorian" when="1896-08-25"><hi rendition="#italic">August
                                25, 1896</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to submit herewith the
                    report of the judge and the district attorney relative to the lynching of the
                    three Italians in the parish of St. Charles.</p>
                <p>Very respectfully,</p>
                <closer><signed><hi rendition="#small-caps">Murphy J. Foster</hi>,<lb/><hi
                            rendition="#italic">Governor.</hi></signed></closer>
            </div>
        </body>
    </text>
