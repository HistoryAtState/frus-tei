    <text>
        <body>
            <div xml:id="d710">

                <pb facs="0871" n="783" sameAs="frus:frus1933v05/pg783"/>

                <note rend="inline" type="source">838.51/2724: Telegram</note>
                <head><hi rendition="#italic">The Minister in Haiti</hi> (<hi
                            rendition="#italic">Armour</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Port-au-Prince</hi></placeName>, <date calendar="gregorian"
                            when="1933-10-27T14:00:00-05:00">October 27, 1933—2
                        p.m.</date><lb/>[Received 3:12 p.m.]</dateline>
                </opener>
                <p>114. Reference Legation’s No. 161 of October 20, forwarding draft of proposed
                    note modifying law on the budget and public accounting of July 4, 1933.</p>
                <p>Minister of Foreign Affairs accepts our draft. Please cable authorization to
                    effect exchange of notes.<anchor n="91" xml:id="d710-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Armour</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d710-f1" n="91" xml:id="d710-f1-content">
                <p>Telegram No. 114, October 30, 1933, 5 p.m., to the Minister in Haiti, granted the
                    authorization.</p>
            </note>
        </listAnnotation>
    </standOff>
