    <text>
        <body>
            <div xml:id="d34">

                <pb facs="0116" n="28" sameAs="frus:frus1933v05/pg28"/>

                <note rend="inline" type="source">611.3231/572: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Acting Secretary of
                        State</hi><anchor n="13a" xml:id="d34-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>S. S. “<hi rendition="#small-caps"
                                >American Legion</hi>,”</placeName>
                        <date calendar="gregorian" when="1933-11-14T16:00:00">November 14, 1933—4
                            p.m.</date><lb/>[Received 4:30 p.m.]</dateline>
                </opener>
                <p>2. In order that I may be intelligently informed in case matter comes up in
                    conversations please radio any expansion of trade agreement plans with regard to
                    Brazilian and Argentine negotiations.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d34-f1" n="13a" type="source" xml:id="d34-f1-content">
                <p>The Secretary of State was en route to the Seventh International Conference of
                    American States, held at Montevideo, December 3–26, 1933; for correspondence
                    concerning the Conference, see <ref target="frus1933v04#pg_1">vol. <hi
                            rendition="#small-caps">iv</hi>, pp. 1</ref> ff.</p>
            </note>
        </listAnnotation>
    </standOff>
