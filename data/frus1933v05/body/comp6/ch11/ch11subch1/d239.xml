                <pb facs="0366" n="278" xml:id="pg278"/>

                <note rend="inline" type="source">123W451/95: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Cuba</hi> (<hi
                            rendition="#italic">Reed</hi>) <hi rendition="#italic">to the
                            Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Habana</hi></placeName>, <date calendar="gregorian"
                            when="1933-04-20T13:00:00-05:00">April 20, 1933—1
                        p.m.</date><lb/>[Received 1:25 p.m.]</dateline>
                </opener>
                <p>34. The Secretary of State of Cuba informs me that the appointment of Mr. Welles
                    is agreeable to his Government.</p>
                <closer><signed><hi rendition="#small-caps">Reed</hi></signed></closer>
            </div>
        </body>
