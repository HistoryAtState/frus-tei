    <text>
        <body>
            <div xml:id="d283">

                <pb facs="0415" n="327" xml:id="pg327"/>

                <note rend="inline" type="source">837.00/3580: Telegram</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Ambassador in Cuba</hi> (<hi
                            rendition="#italic">Welles</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1933-07-19T18:00:00-04:00">July 19, 1933—6 p.m.</date></dateline>
                </opener>
                <p>58. You are authorized to state that the Department is fully in accord with the
                    statement you intend to make to President Machado, as set out by you.<anchor
                        n="28" xml:id="d283-f1"/></p>
                <closer><signed><hi rendition="#small-caps">Phillips</hi></signed></closer>
            </div>
        </body>
    </text>
