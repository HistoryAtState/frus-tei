    <text>
        <body>
            <div xml:id="d243">

                <pb facs="0374" n="286" sameAs="frus:frus1933v05/pg286"/>

                <note rend="inline" type="source">123C11/317: Telegram</note>
                <head><hi rendition="#italic">The Minister in Colombia</hi> (<hi rendition="#italic"
                        >Caffery</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Bogotá</hi></placeName>, <date calendar="gregorian"
                            when="1933-05-07T18:00:00-05:00">May 7, 1933—6 p.m.</date><lb/>[Received
                        9:50 p.m.]</dateline>
                </opener>
                <p>48. Department’s 44, May 6, 3 p.m. For Phillips from Caffery. I should be happy
                    to be appointed Ambassador to Cuba on the termination of Sumner Welles’ period
                    and in the meantime fill the vacancy of Assistant Secretary of State.<anchor
                        n="17" xml:id="d243-f1"/> Thank you.</p>
                <closer><signed><hi rendition="#small-caps">Caffery</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d243-f1" n="17" xml:id="d243-f1-content">
                <p>Mr. Caffery entered upon his duties as Assistant Secretary of State, July 12,
                    1933.</p>
            </note>
        </listAnnotation>
    </standOff>
