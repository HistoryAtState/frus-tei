                <pb facs="0525" n="437" xml:id="pg437"/>

                <note rend="inline" type="source">837.00/4008</note>
                <head><hi rendition="#italic">The Ambassador in Brazil</hi> (<hi rendition="#italic"
                        >Gibson</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">Rio de
                                Janeiro</hi></placeName>, <date calendar="gregorian"
                            when="1933-09-14">September 14, 1933</date>.<lb/>[Received September
                        23.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to furnish the Department
                    herewith, as serving to indicate the attitude of Brazil with respect to the
                    political situation in Cuba and the relations thereto of the United States,
                    Mexico, and Chile, a copy of a memorandum of a conversation I had with the
                    Brazilian Minister for Foreign Affairs on September 11.</p>
                <closer><signed><hi rendition="#small-caps">Gibson</hi></signed></closer>


                <xi:include href="d395-a1.xml" xpointer="d395-a1"/>
