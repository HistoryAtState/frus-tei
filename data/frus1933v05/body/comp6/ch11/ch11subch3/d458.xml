            <div xml:id="d458">

                <pb facs="0582" n="494" sameAs="frus:frus1933v05/pg494"/>

                <note rend="inline" type="source">837.00/4255</note>
                <head><hi rendition="#italic">The Ambassador in Cuba</hi> (<hi
                            rendition="#italic">Welles</hi>) <hi rendition="#italic">to
                        the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 182</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Habana</hi></placeName>, <date calendar="gregorian"
                            when="1933-10-21">October 21, 1933</date>.<lb/>[Received October
                        23.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my telegram No. 382 of October
                    20, 4 p.m., I have the honor to transmit herewith a copy, in English
                    translation, of the draft of a compromise solution which was handed to me
                    yesterday by Doctor Felix Granados by instruction of Doctor Grau San Martín.</p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Sumner Welles</hi></signed></closer>


                <xi:include href="d458-a1.xml" xpointer="d458-a1"/>
