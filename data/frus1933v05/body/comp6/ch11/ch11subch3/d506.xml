            <div xml:id="d506">

                <pb facs="0615" n="527" sameAs="frus:frus1933v05/pg527"/>

                <note rend="inline" type="source">837.01/47: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Acting Secretary of
                        State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>S. S. “<hi rendition="#small-caps"
                                >American Legion</hi>”</placeName>, <date calendar="gregorian"
                            when="1933-11-27T12:00:00">November 27, 1933—noon</date>.<lb/>[Received
                        7:50 p.m.]</dateline>
                </opener>
                <p>13. For the Acting Secretary and Caffery. Please telegraph me at Montevideo the
                    controlling facts and conditions to date against recognition of the Grau San
                    Martín regime in Cuba.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
