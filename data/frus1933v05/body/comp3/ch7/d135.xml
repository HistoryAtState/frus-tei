            </note>
            <note corresp="#d135-f2" n="47" xml:id="d135-f2-content">
                <p>Sir Henry G. Chilton, British Ambassador in Chile.</p>
            </note>
            <note corresp="#d135-f3" n="48" xml:id="d135-f3-content">
                <p>Gustavo Ross, Chilean Minister of Finance.</p>
            </note>
