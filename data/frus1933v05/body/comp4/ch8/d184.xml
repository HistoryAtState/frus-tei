    <text>
        <body>
            <div xml:id="d184">

                <pb facs="0308" n="220" sameAs="frus:frus1933v05/pg220"/>

                <note rend="inline" type="source">611.2131/35: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Colombia</hi> (<hi
                            rendition="#italic">Dawson</hi>) <hi rendition="#italic">to
                        the Acting Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Bogotá</hi></placeName>, <date calendar="gregorian"
                            when="1933-08-02T18:00:00-05:00">August 2, 1933—6
                        p.m.</date><lb/>[Received 8:10 p.m.]</dateline>
                </opener>
                <p>69. Legation’s 66, July 21, 6 p.m. Pomponio Guzmán<anchor n="7" xml:id="d184-f1"
                    /> and an official of Ministry of Finance, not yet designated, will assist
                    Lozano. Will arrive Washington in about 2 weeks.</p>
                <closer><signed><hi rendition="#small-caps">Dawson</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d184-f1" n="7" xml:id="d184-f1-content">
                <p>Former Minister of Finance.</p>
            </note>
        </listAnnotation>
    </standOff>
