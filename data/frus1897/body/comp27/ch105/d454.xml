            <div xml:id="d454">

                <pb facs="0495" n="461" sameAs="frus:frus1897/pg461"/>

                <head>[Untitled]</head>
                <p rendition="#flush"><hi rendition="#italic">To the Senate:</hi></p>
                <p>I transmit herewith, in response to the resolution of the Senate of February 24,
                    1897, a report from the Secretary of State in relation to the claim of M. A.
                    Cheek against the Siamese Government, with accompanying papers.</p>
                <closer><signed><hi rendition="#small-caps">Grover Cleveland.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left"><hi rendition="#small-caps">Executive
                            Mansion</hi>,<lb/><placeName><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1897-03-02"><hi rendition="#italic">March 2,
                        1897</hi></date>.</dateline>
                </closer>


                <xi:include href="d454-a1.xml" xpointer="d454-a1"/>
