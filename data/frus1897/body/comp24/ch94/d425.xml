    <text>
        <body>
            <div xml:id="d425">

                <pb facs="0468" n="434" sameAs="frus:frus1897/pg434"/>

                <head><hi rendition="#italic">Mr. Sherman to Senhor da Costa Duarte.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1897-08-16"><hi rendition="#italic">August 16,
                        1897</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 26.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the receipt
                    of Viscount de Santo-Thyrso’s note of the 9th instant, explaining further his
                    position in regard to the flag incident at Monterey, Cal.</p>
                <p>The Department has forwarded a copy of this note to the governor of California
                    for his information, thus closing the incident.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Sherman.</hi></signed></closer>
            </div>
        </body>
    </text>
