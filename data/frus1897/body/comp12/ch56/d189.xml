    <text>
        <body>
            <div xml:id="d189">

                <pb facs="0235" n="201" sameAs="frus:frus1897/pg201"/>

                <head><hi rendition="#italic">Mr. Uhl to Mr.
                            Sherman.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1897-03-31"><hi rendition="#italic">March 31, 1897</hi></date>.
                        (Received April 16.)</dateline>
                    <seg rendition="#float-left">No. 309.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my dispatch No. 228, of
                    December 31, 1896, I have the honor to append hereto a memorandum report of
                    certain military cases—more particularly mentioned below—which have either not
                    yet <pb facs="0236" n="202" xml:id="pg202"/> been referred to in my
                    correspondence with the Department or, having already been reported, have now
                    been favorably concluded, and to be, sir,</p>
                <p>Your obedient servant,</p>
                <closer><signed><hi rendition="#small-caps">Edwin F. Uhl.</hi></signed></closer>


                <xi:include href="d189-a1.xml" xpointer="d189-a1"/>
            </div>
        </body>
    </text>
