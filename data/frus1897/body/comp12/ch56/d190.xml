                <pb facs="0236" n="202" sameAs="frus:frus1897/pg202"/>

                <head><hi rendition="#italic">Mr. White to Mr.
                            Sherman.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Embassy of the United States</hi>,<lb/><hi rendition="#italic"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1897-10-01"><hi rendition="#italic">October 1, 1897</hi></date>.
                        (Received October 20.)</dateline>
                    <seg rendition="#float-left">No. 112.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my dispatch No. 17, of June 30
                    last, I have the honor to append hereto a memorandum report of certain military
                    cases, more particularly mentioned below, to which as yet no reference has been
                    made by the embassy in its correspondence with the Department, and am, sir,
                    etc.,</p>
                <closer><signed><hi rendition="#small-caps">And. D. White.</hi></signed></closer>



                <xi:include href="d190-a1.xml" xpointer="d190-a1"/>
