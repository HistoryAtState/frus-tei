    <text>
        <body>
            <div xml:id="d175">

                <pb facs="0219" n="185" sameAs="frus:frus1897/pg185"/>

                <head><hi rendition="#italic">Mr. von Reichenau to Mr. Sherman.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Imperial German Embassy</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1897-08-24"><hi rendition="#italic">August 24,
                        1897</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Mr. ‘Secretary of State</hi>: I have the honor to
                    acknowledge the receipt of your polite note of the 13th instant relative to the
                    German bark <hi rendition="#italic">Elisabeth Ahrens.</hi></p>
                <p>I have not failed to bring the matter to the notice of the Imperial Government,
                    and a subsequent communication may be expected from me on this subject.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Reichenau.</hi></signed></closer>
            </div>
        </body>
    </text>
