            <div xml:id="d326-a3">

                <pb facs="0371" n="337" sameAs="frus:frus1897/pg337"/>

                <opener><seg rendition="#center">[Inclosure 3 in No. 148.—Telegram.]</seg></opener>
                <head><hi rendition="#italic">Mr. Pringle to Mr.
                            Souza.</hi></head>
                <p>Have received notice from minister of foreign affairs that your exequatur has
                    been withdrawn by the President of this Republic. Please inform me at once if
                    you know the cause for this action.</p>
                <closer><signed><hi rendition="#small-caps">Pringle.</hi></signed>
                    <lb/>
                    <dateline rendition="#float-left">(Sent <date calendar="gregorian"
                            when="1897-07-30T14:30:00-06:02">Friday afternoon, July 30, 1897, about
                            2.30 p.m.</date>)</dateline></closer>
            </div>
        </body>
    </text>
