    <text>
        <body>
            <div xml:id="d609">

                <pb facs="0621" n="587" xml:id="pg587"/>

                <head><hi rendition="#italic">Mr. Terrell to Mr.
                            Sherman.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1897-04-28"><hi rendition="#italic">April 28, 1897</hi></date>.
                        (Received May 13.)</dateline>
                    <seg rendition="#float-left">No. 1268.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to append on the overleaf
                    a telegram received from the Stamford Manufacturing Company regarding the
                    expulsion of the Greek subjects from the Ottoman Empire, and also the copy of my
                    answer.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">A. W. Terrell.</hi></signed></closer>



                <xi:include href="d609-a1.xml" xpointer="d609-a1"/>
