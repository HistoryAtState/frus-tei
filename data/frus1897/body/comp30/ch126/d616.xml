    <text>
        <body>
            <div xml:id="d616">

                <pb facs="0624" n="590" sameAs="frus:frus1897/pg590"/>

                <head><hi rendition="#italic">Mr. Riddle to Mr.
                            Sherman.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1897-08-04"><hi rendition="#italic">August 4, 1897</hi></date>.
                        (Received Aug. 20.)</dateline>
                    <seg rendition="#float-left">No. 1331.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your instruction No. 1466, of
                    June 4, and my dispatch No. 1320, of June 26, relative to the indemnity claim of
                    Mrs. Haiganoosh S. Abdalian, I have the honor now to inclose copy of the reply I
                    have received from the minister for foreign affairs.</p>
                <p>I have the honor, etc.,</p>
                <closer><signed><hi rendition="#small-caps">J. W. Riddle.</hi></signed></closer>


                <xi:include href="d616-a1.xml" xpointer="d616-a1"/>
