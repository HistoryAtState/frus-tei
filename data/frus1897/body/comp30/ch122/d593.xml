    <text>
        <body>
            <div xml:id="d593">

                <pb facs="0604" n="570" sameAs="frus:frus1897/pg570"/>

                <head><hi rendition="#italic">Mr. Terrell to Mr. Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Constantinople</hi></placeName>, <date calendar="gregorian"
                            when="1897-02-06"><hi rendition="#italic">February 6,
                        1897</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1166.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose the copy of a
                    letter, long delayed in delivery, from Rev. O. Sanders, writing for Miss
                    Shattuck, which compliments the Turkish troops for their efficient protection
                    afforded at Ourfa, and desires that Miss Shattuck’s approval of the conduct of
                    the colonel commanding be made known to the war office.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">A. W. Terrell.</hi></signed></closer>


                <xi:include href="d593-a1.xml" xpointer="d593-a1"/>
