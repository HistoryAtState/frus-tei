    <text>
        <body>
            <div xml:id="d604">

                <pb facs="0617" n="583" sameAs="frus:frus1897/pg583"/>

                <head><hi rendition="#italic">Moustapha Bey to Mr. Sherman.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Imperial Legation of Turkey</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1897-03-09"><hi rendition="#italic">March 9,
                        1897</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Mr. Secretary of State</hi>: I hereby apprise your
                    excellency, in pursuance of instructions received, that Mr. Iasigi has been
                    relieved of his functions as consul-general at Boston, and is consequently in no
                    sense an agent of the Imperial Government.</p>
                <p>Be pleased to accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Moustapha.</hi></signed></closer>
            </div>
        </body>
    </text>
