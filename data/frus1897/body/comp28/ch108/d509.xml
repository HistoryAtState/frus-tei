    <text>
        <body>
            <div xml:id="d509">

                <pb facs="0532" n="498" sameAs="frus:frus1897/pg498"/>

                <head><hi rendition="#italic">Mr. Taylor to Mr. Sherman.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic">San
                                Sebastian</hi></placeName>, <date calendar="gregorian"
                            when="1897-09-03"><hi rendition="#italic">September 3, 1897</hi></date>.
                        (Received Sept. 14.)</dateline>
                    <seg rendition="#float-left">No. 750.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my No, 748, of the 25th
                    ultimo, relative to the case of Messrs. Sartorius &amp; Co., I have the honor to
                    inclose herewith a copy, with translation, of a note received from the Spanish
                    Government in reply to your cablegram of the 21st ultimo.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Hannis Taylor.</hi></signed></closer>


                <xi:include href="d509-a1.xml" xpointer="d509-a1"/>
