                <pb facs="0519" n="485" sameAs="frus:frus1897/pg485"/>

                <head><hi rendition="#italic">Mr. Taylor to Mr. Sherman.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1897-05-08"><hi rendition="#italic">May 8, 1897</hi></date>.
                        (Received May 21.)</dateline>
                    <seg rendition="#float-left">No. 690.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my dispatch No. 686, of the
                    23d ultimo, relative to certain American citizens arrested in Cuba, I have the
                    honor to inclose herewith copies and translations of two notes received from the
                    minister for foreign affairs, informing me officially that the naturalized
                    American citizens Jorge W. Aguirre and José L. Cepero have been placed in
                    liberty and expelled from the Island of Cuba by decree of the
                    Governor-General.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Hannis Taylor.</hi></signed></closer>




                <xi:include href="d483-a1.xml" xpointer="d483-a1"/>
