    <text>
        <body>
            <div xml:id="d50">

                <pb facs="0081" n="47" sameAs="frus:frus1897/pg47"/>

                <head><hi rendition="#italic">Mr. Conger to Mr. Sherman.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Petropolis</hi></placeName>, <date calendar="gregorian"
                            when="1897-11-10"><hi rendition="#italic">November 10, 1897</hi></date>.
                        (Received Dec. 7.)</dateline>
                    <seg rendition="#float-left">No. 57.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Since writing my dispatch No. 56 of this
                    morning I have received a telegram from the President of Brazil, a copy and
                    translation of which I inclose.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. H. Conger.</hi></signed></closer>


                <xi:include href="d50-a1.xml" xpointer="d50-a1"/>
