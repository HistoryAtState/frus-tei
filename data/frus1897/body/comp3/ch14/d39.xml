    <text>
        <body>
            <div xml:id="d39">

                <pb facs="0070" n="36" xml:id="pg36"/>

                <head><hi rendition="#italic">Mr. Sherman to Mr. Storer.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1897-10-01"><hi rendition="#italic">October 1,
                        1897</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 39.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your No. 25<anchor n="1"
                        xml:id="d39-f1"/> of the 10th ultimo, I inclose herewith copy of a letter
                    from the Secretary of Agriculture covering his reply to the letter which you
                    sent him directly on the same day in regard to the status of affairs in Belgium
                    relative to the trade in American animals and meats.</p>
                <p>Respectfully, yours,</p>
                <closer><signed><hi rendition="#small-caps">John Sherman.</hi></signed></closer>



                <xi:include href="d39-a1.xml" xpointer="d39-a1"/>
                <xi:include href="d39-a2.xml" xpointer="d39-a2"/>
