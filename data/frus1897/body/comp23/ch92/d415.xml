    <text>
        <body>
            <div xml:id="d415">

                <pb facs="0461" n="427" sameAs="frus:frus1897/pg427"/>

                <head><hi rendition="#italic">Mr. McDonald to Mr. Olney.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Teheran, Persia</hi></placeName>, <date calendar="gregorian"
                            when="1897-01-25"><hi rendition="#italic">January 25,
                        1897</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 278.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I herewith transmit a translation of an
                    order from the foreign minister, by direction of the Shah, prohibiting the
                    importation of books into Persia, except under certain vexatious restrictions. I
                    shall protest against this edict as unjust to foreigners residing in the Kingdom
                    and as contrary to the spirit of the age.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alex. McDonald.</hi></signed></closer>


                <xi:include href="d415-a1.xml" xpointer="d415-a1"/>
