                <pb facs="0101" n="67" sameAs="frus:frus1897/pg67"/>

                <head><hi rendition="#italic">Mr. Denby to Mr. Sherman.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Pekin</hi></placeName>, <date calendar="gregorian"
                            when="1897-07-10"><hi rendition="#italic">July 10, 1897</hi></date>.
                        (Received Aug. 16.)</dateline>
                    <seg rendition="#float-left">No. 2774.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a copy of a
                    dispatch which was sent by me to the Tsung-li Yamên the 10th instant, on the
                    subject of the prevention of antiforeign riots.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles Denby.</hi></signed></closer>
            </div>
        </body>
    </text>
