                <pb facs="0119" n="85" xml:id="pg85"/>

                <head><hi rendition="#italic">Mr. Denby to Mr. Sherman.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Pekin</hi></placeName>, <date calendar="gregorian"
                            when="1897-03-11"><hi rendition="#italic">March 11, 1897</hi></date>.
                        (Received. April 26.)</dateline>
                    <seg rendition="#float-left">No. 2707.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In Department’s dispatch No. 1395, of 19th
                    January, I was directed to insist on the demand that the officials who did not
                    do their duty in preventing the Kutien riots should be punished.</p>
                <p>I have accordingly addressed to the Tsung-li Yamén a communication on the
                    subject, of which a copy is inclosed.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles Denby.</hi></signed></closer>


                <xi:include href="d81-a1.xml" xpointer="d81-a1"/>
