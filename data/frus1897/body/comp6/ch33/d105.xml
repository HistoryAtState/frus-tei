    <text>
        <body>
            <div xml:id="d105">

                <pb facs="0141" n="107" sameAs="frus:frus1897/pg107"/>

                <head><hi rendition="#italic">Mr. Denby to Mr. Sherman.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Pekin</hi></placeName>, <date calendar="gregorian"
                            when="1897-06-19"><hi rendition="#italic">June 19, 1897</hi></date>.
                        (Received July 30.)</dateline>
                    <seg rendition="#float-left">No. 2765.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a translation
                    of a communication from the Tsung-li Yamên relating to the prevention of
                    counterfeiting and the, importation of machinery to be used for making
                    counterfeit money.</p>
                <p>To this paper I have sent an answer of which a copy is inclosed.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles Denby.</hi></signed></closer>



                <xi:include href="d105-a1.xml" xpointer="d105-a1"/>
