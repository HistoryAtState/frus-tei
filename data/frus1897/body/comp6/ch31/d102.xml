    <text>
        <body>
            <div xml:id="d102">

                <pb facs="0139" n="105" sameAs="frus:frus1897/pg105"/>

                <head><hi rendition="#italic">Mr. Sherman to Mr.
                            Denby.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1897-08-17"><hi rendition="#italic">August 17,
                        1897</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    dispatch No. 2775, of the 12th ultimo, inclosing a copy of the correspondence
                    between yourself and the Chinese Government in relation to the exhibition of
                    passports by travelers in China, and matters connected therewith.</p>
                <p>Your reply to the Tsung-li Yamên is approved by the Department.</p>
                <p>Respectfully, yours,</p>
                <closer><signed><hi rendition="#small-caps">John Sherman.</hi></signed></closer>
            </div>
        </body>
    </text>
