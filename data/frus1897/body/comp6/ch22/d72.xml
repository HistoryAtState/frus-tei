    <text>
        <body>
            <div xml:id="d72">

                <pb facs="0105" n="71" sameAs="frus:frus1897/pg71"/>

                <head><hi rendition="#italic">Mr. Denby to Mr.
                            Sherman.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of the United States</hi>,<lb/><hi rendition="#italic"
                                >Pekin</hi></placeName>, <date calendar="gregorian"
                            when="1897-07-31"><hi rendition="#italic">July 31, 1897</hi></date>.
                        (Received Sept. 17.)</dateline>
                    <seg rendition="#float-left">No. 2787.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a copy of a
                    dispatch recently sent by me to the consul-general on the subject of the rights
                    of foreigners in the newly opened ports of Soochow and Hangchow. A review of the
                    Japanese treaties induces me to conclude that foreigners have the right to
                    reside in these cities, and to buy land therein.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles Denby.</hi></signed></closer>


                <xi:include href="d72-a1.xml" xpointer="d72-a1"/>
