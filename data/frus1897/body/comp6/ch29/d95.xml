    <text>
        <body>
            <div xml:id="d95">

                <pb facs="0133" n="99" sameAs="frus:frus1897/pg99"/>

                <head><hi rendition="#italic">Mr. Sherman to Mr. Denby.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1897-05-03"><hi rendition="#italic">May 3,
                        1897</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1438.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 2717, of March 19 last, and to approve the instructions of the same date
                    which you issued to Consul Smithers, at Chungking, in, regard to the exhibition
                    of passports and the traveling of roads by missionaries.</p>
                <p>Respectfully, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Sherman.</hi></signed></closer>
            </div>
        </body>
    </text>
