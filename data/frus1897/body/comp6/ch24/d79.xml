    <text>
        <body>
            <div xml:id="d79">

                <pb facs="0118" n="84" sameAs="frus:frus1897/pg84"/>

                <head><hi rendition="#italic">Mr. Sherman to Mr.
                            Denby.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1897-05-18"><hi rendition="#italic">May 18,
                        1897</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1444.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    No. 2731, of the 9th ultimo, and to approve your note to the Tsung-li Yamên, of
                    the same date, protesting against the exclusion of Chinese converts to
                    Christianity from entering Chinese Government examinations.</p>
                <p>Respectfully, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Sherman.</hi></signed></closer>
            </div>
        </body>
    </text>
