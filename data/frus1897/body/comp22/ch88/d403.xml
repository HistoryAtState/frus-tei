    <text>
        <body>
            <div xml:id="d403">

                <pb facs="0451" n="417" sameAs="frus:frus1897/pg417"/>

                <head><hi rendition="#italic">Mr. Baker to Mr.
                            Sherman.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Managua</hi></placeName>, <date calendar="gregorian"
                            when="1897-04-06"><hi rendition="#italic">April 6,
                        1897</hi></date>.</dateline></opener>
                <p>Am assured by the President of Nicaragua they do not intend at present to declare
                    the Nicaraguan Canal concession forfeited.</p>
                <closer><signed><hi rendition="#small-caps">Baker.</hi></signed></closer>
            </div>
        </body>
    </text>
