    <text>
        <body>
            <div xml:id="d270">

                <pb facs="0327" n="293" sameAs="frus:frus1897/pg293"/>

                <head><hi rendition="#italic">Mr. Sherman to Sir Julian Pauncefote.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1897-06-15"><hi rendition="#italic">June 15,
                        1897</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 699.]</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge the
                    receipt of your note of the 13th instant, giving the names of the British
                    vessels which will be employed in Bering Sea on patrol duties this season on
                    behalf of Her Britannic Majesty’s Government.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Sherman.</hi></signed></closer>
            </div>
        </body>
    </text>
