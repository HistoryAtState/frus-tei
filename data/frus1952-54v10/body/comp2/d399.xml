    <text>
        <body>
            <div xml:id="d399">

                <pb facs="0881" n="855" sameAs="frus:frus1952-54v10/pg855"/>

                <note rend="inline" type="source">788.5 MSP/12–2353</note>
                <head>No. 399<lb/><hi rendition="#italic">Memorandum by the Assistant Secretary of
                        State for Near Eastern, South Asian, and African Affairs (Byroade) to the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left"><hi rendition="#small-caps">secret</hi></seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1953-12-23">December 23, 1953</date>.</dateline>
                </opener>
                <list subtype="subject" type="description">
                    <label>Subject:</label>
                    <item>Future Aid to Iran.</item>
                </list>
                <p>Attached (Tab A) is a summary of the main points in a memorandum containing the
                    tentative views of Ambassador Henderson
                    on future aid to Iran. The memorandum was transmitted under cover of a letter
                    from the Ambassador to Vice President Nixon.<anchor n="1" xml:id="d399-f1"/></p>
                <p>It might be helpful for you to read this before the NSC discussion of Iran this week.<anchor n="2" xml:id="d399-f2"
                    /></p>


                <xi:include href="d399-a1.xml" xpointer="d399-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d399-f1" n="1" xml:id="d399-f1-content">
                <p>Not found in Department of State files.</p>
            </note>
            <note corresp="#d399-f2" n="2" xml:id="d399-f2-content">
                <p>Presumably a reference to the 177th meeting of the National Security Council on
                    Dec. 23; see <ref target="#d398"><hi rendition="#italic">supra</hi></ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
