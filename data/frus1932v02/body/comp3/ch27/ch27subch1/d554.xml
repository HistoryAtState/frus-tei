            <div xml:id="d554">

                <pb facs="0841" n="751" sameAs="frus:frus1932v02/pg751"/>

                <note rend="inline" type="source">882.01 Foreign Control/346</note>
                <head><hi rendition="#italic">The President of the Finance Corporation of America
                            (Wm. P. Belden) to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Cleveland, Ohio</hi></placeName>, <date calendar="gregorian"
                            when="1932-09-02">2 September, 1932</date>.<lb/>[Received September
                        6.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: We are herewith transmitting for the
                    information of the Department of State copy of an invitation received from The
                    Secretary General of the League of Nations, dated August 24th, 1932, together
                    with our reply, dated September 2nd, 1932.</p>
                <p>Yours very truly,</p>
                <closer><hi rendition="#small-caps">Finance Corporation of
                                America</hi><lb/><signed><hi rendition="#small-caps">Wm.
                                P. Belden</hi></signed>, <hi rendition="#italic"
                        >President</hi></closer>



