    <text>
        <body>
            <div xml:id="d555">

                <pb facs="0842" n="752" sameAs="frus:frus1932v02/pg752"/>

                <note rend="inline" type="source">882.01 Foreign Control/345</note>
                <head><hi rendition="#italic">The Firestone Plantations
                            Company to the Secretary of
                    State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps">Akron,
                                Ohio</hi></placeName>, <date calendar="gregorian" when="1932-09-02"
                            >September 2, 1932</date>.<lb/>[Received September 3.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: We are herewith transmitting for the
                    information of the Department of State copy of an invitation received from The
                    Secretary General of the League of Nations, dated August 24th, 1932.<anchor
                        n="67" xml:id="d555-f1"/></p>
                <p>No reply has been made to this message.</p>
                <p>Yours very truly,</p>
                <closer><hi rendition="#small-caps">Firestone Plantations
                                Company</hi><lb/><signed><hi rendition="#small-caps">B. M.
                                Robinson</hi>, <hi rendition="#italic"
                        >Secretary</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d555-f1" n="67" xml:id="d555-f1-content">
                <p>Not printed; it was similar to the one sent to the Finance Corporation of
                    America, <ref target="#pg751">p. 751</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
