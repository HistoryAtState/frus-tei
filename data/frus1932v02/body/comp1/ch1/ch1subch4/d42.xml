            <div xml:id="d42">

                <pb facs="0138" n="48" sameAs="frus:frus1932v02/pg48"/>

                <note rend="inline" type="source">811.114 Fisher Lassie/25</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain (Mellon) to the
                        Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 168</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1932-06-20">June 20, 1932</date>.<lb/>[Received June
                        30.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to refer to the
                    Department’s instruction No. 1010 of November 27, 1931, File No. 811.114 Fisher
                    Lassie/9, and to transmit herewith a copy of the Embassy’s informal
                    communication of December 11 to the Foreign Office and a copy of the reply of
                    June 18, with enclosures, which has just been received.</p>
                <p>Respectfully yours,</p>
                <closer>For the Ambassador:<lb/><signed><hi rendition="#small-caps">Ray
                            Atherton</hi></signed><lb/><hi rendition="#italic">Counselor of
                        Embassy</hi></closer>




                <xi:include href="d42-a1.xml" xpointer="d42-a1"/>
