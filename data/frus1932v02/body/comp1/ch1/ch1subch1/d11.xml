    <text>
        <body>
            <div xml:id="d11">

                <pb facs="0100" n="10" sameAs="frus:frus1932v02/pg10"/>

                <note rend="inline" type="source">890b.6363 Gulf Oil Corporation/42: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Chargé in Great Britain
                        (Atherton)</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1932-03-22T18:00:00-05:00">March 22, 1932—6 p.m.</date></dateline>
                </opener>
                <p>95. Your 112, March 18, 5 p.m.<anchor n="12" xml:id="d11-f1"/> Please telegraph
                    summary of note which you propose to send to Oliphant.</p>
                <closer><signed><hi rendition="#small-caps">Stimson</hi></signed></closer>
            </div>
        </body>
    </text>
