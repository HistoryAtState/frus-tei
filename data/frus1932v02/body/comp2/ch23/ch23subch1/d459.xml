    <text>
        <body>
            <div xml:id="d459">

                <pb facs="0706" n="616" sameAs="frus:frus1932v02/pg616"/>

                <note rend="inline" type="source">660H.113/22</note>
                <head><hi rendition="#italic">The Minister in Yugoslavia (Prince) to the Secretary
                        of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 1558</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Belgrade</hi></placeName>, <date calendar="gregorian"
                            when="1933-02-07">February 7, 1933</date>.<lb/>[Received February
                        23.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my despatch No. 1419 of
                    August 8, 1932, and to previous correspondence concerning the so-called Standard
                    Oil Company case, I have the honor to enclose for the information of the
                    Department my last note to the Foreign Office on the subject, dated February 3,
                    1933. This communication was addressed to the Minister of Foreign Affairs at the
                    request of the Company, and any developments in the situation will be promptly
                    reported to the Department.<anchor n="6" xml:id="d459-f1"/></p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">John Dyneley
                    Prince</hi></signed></closer>


                <xi:include href="d459-a1.xml" xpointer="d459-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d459-f1" n="6" xml:id="d459-f1-content">
                <p>Apparently no reply was received to the Minister’s note of February 3, 1933.</p>
            </note>
        </listAnnotation>
    </standOff>
