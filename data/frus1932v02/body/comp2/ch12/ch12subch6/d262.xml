                <pb facs="0457" n="367" sameAs="frus:frus1932v02/pg367"/>

                <note rend="inline" type="source">662.116 Fruit/35: Telegram</note>
                <head><hi rendition="#italic">The Chargé in Germany (Gordon) to the Secretary of
                            State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1932-10-29T12:00:00+01:00">October 29,
                        1932—noon</date>.<lb/>[Received October 29—9:10 a.m.]</dateline>
                </opener>
                <p>211. Department’s 126, October 28, noon. I have again taken occasion to impress
                    upon the German Government our position in this matter as outlined in
                    Department’s 124, October 21, 6 p.m.</p>
                <closer><signed><hi rendition="#small-caps"
                            >Gordon</hi></signed></closer>
                <postscript>
                    <p>[The files of the Department appear to contain no continuation of
                        correspondence on this subject.]</p>
                </postscript>
            </div>
