    <text>
        <body>
            <div xml:id="d71">

                <pb facs="0205" n="115" sameAs="frus:frus1932v02/pg115"/>

                <note rend="inline" type="source">711.754/53: Telegram</note>
                <head><hi rendition="#italic">The Minister in Albania (Bernstein) to the Secretary
                        of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Tirana</hi></placeName>, <date calendar="gregorian"
                            when="1932-04-05T17:00:00+01:00">April 5, 1932—5
                        p.m.</date><lb/>[Received 6:16 p.m.]</dateline>
                </opener>
                <p>3. Naturalization treaty signed today omitting paragraph 3 of article number
                        1.<anchor n="2" xml:id="d71-f1"/> Signed treaty will be delivered by me to
                    the Department on my arrival at Washington.</p>
                <closer><signed><hi rendition="#small-caps">Bernstein</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d71-f1" n="2" xml:id="d71-f1-content">
                <p>See text of unperfected treaty, signed January 21, 1931, <ref
                        target="frus1931v01#pg_835"><hi rendition="#italic">ibid.</hi>, p.
                    835</ref>.</p>
            </note>
