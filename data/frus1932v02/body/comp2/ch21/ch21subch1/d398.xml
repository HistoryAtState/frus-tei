    <text>
        <body>
            <div xml:id="d398">

                <pb facs="0627" n="537" xml:id="pg537"/>

                <note rend="inline" type="source">611.5231/665</note>
                <head><hi rendition="#italic">The Chargé in Spain (Crosby) to the Acting Secretary
                        of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 671</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Madrid</hi></placeName>, <date calendar="gregorian"
                            when="1932-04-11">April 11, 1932</date>.<lb/>[Received April
                        23.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my telegraphic despatch
                    No. 31 of April 10, 11 a.m.,<anchor n="10" xml:id="d398-f1"/> I have the honor
                    to transmit herewith a corrected translation of the Minister of State’s Note of
                    April 5, 1932, concerning the Spanish Government’s point of view with regard to
                    the application of Most Favored Nation Treatment to American products in Spain,
                    which I shall ask you to be so good as to substitute for the copy forwarded you
                    as an enclosure to the Ambassador’s despatch No. 667 of April 6, 1932.<anchor
                        n="10" xml:id="d398-f2"/></p>
                <p>Respectfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Sheldon L. Crosby</hi></signed></closer>


                <xi:include href="d398-a1.xml" xpointer="d398-a1"/>
            </div>
        </body>
    </text>
