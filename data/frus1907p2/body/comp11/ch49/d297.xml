                <pb facs="1075" n="925" sameAs="frus:frus1907p2/pg925"/>

                <note rend="inline" type="source">File No. 7370/3.</note>
                <head><hi rendition="#italic">The Norwegian Chargé to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Norway</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1907-12-19"><hi rendition="#italic">December 19,
                        1907</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: It is with the deepest sorow that I have
                    the honor to inform your, excellency that I have received a cablegram from the
                    foreign office at Christiania advising me that my beloved chief, Mr. Hauge, died
                    from heart disease this afternoon.</p>
                <p>Accept, etc.,</p>
                <closer><signed><hi rendition="#small-caps">O. Skybak.</hi></signed></closer>
            </div>
        </body>
