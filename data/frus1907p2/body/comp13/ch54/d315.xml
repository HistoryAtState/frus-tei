    <text>
        <body>
            <div xml:id="d315">

                <pb facs="1099" n="949" xml:id="pg949"/>

                <note rend="inline" type="source">File No. 3714/2–3.</note>
                <head><hi rendition="#italic">The President of the United States to the Shah of
                        Persia.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >The White House</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1907-01-09"><hi rendition="#italic">January 9,
                        1907</hi></date>.</dateline></opener>
                <p rendition="#flush">His Majesty <hi rendition="#small-caps">Mohammed Ali,
                        Shah</hi>, <hi rendition="#italic">Teheran</hi>.</p>
                <p>I tender sincere condolences upon the great bereavement suffered by you and by
                    the Persian nation.</p>
                <closer><signed><hi rendition="#small-caps">Theodore
                    Roosevelt.</hi></signed></closer>
            </div>
        </body>
