    <text>
        <body>
            <div xml:id="d503">

                <pb facs="1276" n="1126" sameAs="frus:frus1907p2/pg1126"/>

                <head><hi rendition="#italic">The Secretary of State to
                        Minister Hill.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1907-04-26"><hi rendition="#italic">April 26,
                        1907</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to inform you that the Argentine
                    Republic has appointed as its delegates to the Second Hague Conference Messrs.
                    Luis M. Drago, Carlos Rodriguez Larreta, and Roque Saenz Peña.</p>
                <p>I am etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. Root.</hi></signed></closer>
            </div>
        </body>
    </text>
