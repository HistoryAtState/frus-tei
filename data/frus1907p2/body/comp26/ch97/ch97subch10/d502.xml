        <body>
            <div xml:id="d502">

                <pb facs="1276" n="1126" sameAs="frus:frus1907p2/pg1126"/>

                <head><hi rendition="#italic">Minister Hicks to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Santiago</hi></placeName>, <date calendar="gregorian" when="1907-02-28"
                                ><hi rendition="#italic">February 28, 1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 125.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I beg to inclose herewith translation of a
                    law passed by the Chilean Congress and published in the Diario Oficial on the
                    15th of February, 1907.</p>
                <p>According to this law, the Government of Chile accepts the conclusions of the
                    First Conference of The Hague, with the proviso [understanding] that article 17
                    of the convention relating to the pacific adjustment of international conflicts
                    does not affect questions pending settlement previous to the date of the
                    international agreement.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Hicks.</hi></signed></closer>


                <xi:include href="d502-a1.xml" xpointer="d502-a1"/>
