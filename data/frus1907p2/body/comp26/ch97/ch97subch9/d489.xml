        <body>
            <div xml:id="d489">

                <pb facs="1268" n="1118" sameAs="frus:frus1907p2/pg1118"/>

                <head><hi rendition="#italic">Minister Hill to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">The
                            Hague</hi></placeName>, <date calendar="gregorian" when="1907-04-02"><hi
                                rendition="#italic">April 2, 1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 205.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my No. 191, dated March 16,
                    1907, relating to the bill for the admission of nonsignatories of The Hague
                    Convention to the Second Peace Conference, I have the honor to inclose herewith,
                    in duplicate, copies of the law of March 15, 1907, together with translation of
                    the same.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">David J. Hill.</hi></signed></closer>


                <xi:include href="d489-a1.xml" xpointer="d489-a1"/>
