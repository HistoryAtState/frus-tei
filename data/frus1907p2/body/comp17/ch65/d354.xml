        <body>
            <div xml:id="d354">

                <pb facs="1127" n="977" sameAs="frus:frus1907p2/pg977"/>

                <note rend="inline" type="source">File No. 4757/16–17.</note>
                <head><hi rendition="#italic">The Acting Secretary of State to Ambassador
                        Riddle.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1907-05-15"><hi rendition="#italic">May 15,
                        1907</hi></date>.</dateline></opener>
                <p>Draw for $3,000 and pay Russian Red Cross, relief famine sufferers, received from
                    American Red Cross.</p>
                <closer><signed><hi rendition="#small-caps">Bacon.</hi></signed></closer>
            </div>
        </body>
