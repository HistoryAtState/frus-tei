    <text>
        <body>
            <div xml:id="d356">

                <pb facs="1128" n="978" xml:id="pg978"/>

                <note rend="inline" type="source">File No. 4757/18–22.</note>
                <head><hi rendition="#italic">Ambassador Riddle to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1907-05-25"><hi rendition="#italic">May 25,
                        1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 40.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to confirm herewith your
                    telegram of May 15, reading as follows.<anchor n="a" xml:id="d356-f1"/> I
                    inclose a receipt from the Russian Red Cross Society for the sum of 5,820 rubles
                    (with translation) and a banker’s memorandum showing that the draft for $3,000
                    produced the sum of 5,820 at 1.94, the rate at which it was sold.</p>
                <p>I also transmit the translation of two letters received from the Russian Red
                    Cross conveying the thanks of the Dowager Empress to the American Red Cross and
                    the individual contributors.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">J. W. Riddle.</hi></signed></closer>





                <xi:include href="d356-a1.xml" xpointer="d356-a1"/>
