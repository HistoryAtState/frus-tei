    <text>
        <body>
            <div xml:id="d358">

                <pb facs="1129" n="979" sameAs="frus:frus1907p2/pg979"/>

                <note rend="inline" type="source">File No. 4757/26.</note>
                <head><hi rendition="#italic">The Secretary of State to Chargé Schuyler.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1907-11-09"><hi rendition="#italic">November 9,
                        1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 72.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose a copy of a letter<anchor n="a"
                        xml:id="d358-f1"/> from Mr. Charles L. Magee, secretary of the American
                    National Red Cross., who asks that it may <pb facs="1130" n="980" xml:id="pg980"
                    /> be ascertained whether the Russian Red Cross Society is still engaged in
                    relief work in behalf of the famine sufferers and, if so, whether a further
                    contribution, already on, deposit here, would be acceptable.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. Root.</hi></signed></closer>
            </div>
        </body>
    </text>
