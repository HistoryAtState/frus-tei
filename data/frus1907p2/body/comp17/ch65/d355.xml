                <pb facs="1127" n="977" sameAs="frus:frus1907p2/pg977"/>

                <note rend="inline" type="source">File No. 4757/17A.</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to Ambassador Riddle.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1907-06-01"><hi rendition="#italic">June 1,
                        1907</hi></date>.</dateline></opener>
                <p>Draw on Secretary of State $1,000, received through American Red Cross; pay same
                    to Russian Red Cross secretary, for relief famine sufferers.</p>
                <closer><signed><hi rendition="#small-caps">Bacon.</hi></signed></closer>
            </div>
        </body>
