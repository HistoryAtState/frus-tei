    <text>
        <body>
            <div xml:id="d370">

                <pb facs="1135" n="985" sameAs="frus:frus1907p2/pg985"/>

                <note rend="inline" type="source">File No. 79/131–132.</note>
                <head><hi rendition="#italic">Ambassador Riddle to the Secretary of
                    State.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic">St.
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1907-07-27"><hi rendition="#italic">July 27,
                        1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 72.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a
                    translation of the new election law which will govern the elections to the third
                    Douma.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">J. W. Riddle.</hi></signed></closer>


                <xi:include href="d370-a1.xml" xpointer="d370-a1"/>
