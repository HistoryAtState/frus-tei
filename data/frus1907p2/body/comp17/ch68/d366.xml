                <pb facs="1133" n="983" sameAs="frus:frus1907p2/pg983"/>

                <note rend="inline" type="source">File No. 79/105–106.</note>
                <head><hi rendition="#italic">Ambassador Riddle to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic">St
                                Petersburg</hi></placeName>, <date calendar="gregorian"
                            when="1907-03-20"><hi rendition="#italic">March 20,
                        1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 16.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a copy
                    of a circular, in the French text and with an English translation, which
                    appeared in the Journal de St. Petersburg of March 19. It exhorts the provincial
                    authorities, under penalty of dismissal and prosecution, to take stringent
                    measures for the preservation of order in the interior.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">J. W. Riddle.</hi></signed></closer>


                <xi:include href="d366-a1.xml" xpointer="d366-a1"/>
