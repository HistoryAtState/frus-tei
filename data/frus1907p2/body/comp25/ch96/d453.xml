            <div xml:id="d453">

                <pb facs="1247" n="1097" sameAs="frus:frus1907p2/pg1097"/>

                <note rend="inline" type="source">File No. 8430–1.</note>
                <head><hi rendition="#italic">Minister Russell to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Caracas</hi></placeName>, <date calendar="gregorian" when="1907-08-30"
                                ><hi rendition="#italic">August 30, 1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 231.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose you herewith a
                    copy and translation of the executive decree by which Pampatar, Island of
                    Margarita, is made an open port.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">William W.
                    Russell.</hi></signed></closer>



                <xi:include href="d453-a1.xml" xpointer="d453-a1"/>
