    <text>
        <body>
            <div xml:id="ch45">

                <pb facs="1062" n="912" sameAs="frus:frus1907p2/pg912"/>

                <head>Treaty between the United States and Nicaragua for the extradition of
                    criminals</head>
                <p><hi rendition="#italic">Signed at Washington March 1, 1905.</hi></p>
                <p><hi rendition="#italic">Ratification advised by the Senate March 16,
                    1905.</hi></p>
                <p><hi rendition="#italic">Ratified by the President June 11, 1907.</hi></p>
                <p><hi rendition="#italic">Ratified by Nicaragua April 26, 1907.</hi></p>
                <p><hi rendition="#italic">Ratifications exchanged at Washington June 14,
                    1907.</hi></p>
                <p><hi rendition="#italic">Proclaimed June 15, 1907.</hi></p>

                <xi:include href="ch45/d289.xml" xpointer="d289"/>
