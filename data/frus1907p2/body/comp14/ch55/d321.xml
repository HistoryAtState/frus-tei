                <pb facs="1101" n="951" sameAs="frus:frus1907p2/pg951"/>

                <note rend="inline" type="source">File No. 3764/1–3.</note>
                <head><hi rendition="#italic">Minister Combs to the
                            Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Lima</hi></placeName>, <date calendar="gregorian" when="1907-08-13"><hi
                                rendition="#italic">August 13, 1907</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose a copy of
                    President Pardo’s message to Congress, with a résumé in English.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Leslie Combs.</hi></signed></closer>


                <xi:include href="d321-a1.xml" xpointer="d321-a1"/>
