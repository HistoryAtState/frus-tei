    <text>
        <body>
            <div xml:id="d246">

                <pb facs="1002" n="852" sameAs="frus:frus1907p2/pg852"/>

                <note rend="inline" type="source">File No. 7187.</note>
                <head><hi rendition="#italic">Ambassador Thompson to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Mexico</hi></placeName>, <date calendar="gregorian" when="1907-10-22"
                                ><hi rendition="#italic">October 22, 1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 752.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: For the information of the department I
                    inclose herewith clippings<anchor n="a" xml:id="d246-f1"/> of everything that
                    was printed in the Mexican Herald with reference to the visit of Mr. Root to
                    Mexico from the time of his reception by the Mexican committee at San Antonio,
                    Tex., until his return to the United States.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">D. E. Thompson.</hi></signed></closer>


                <xi:include href="d246-a1.xml" xpointer="d246-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d246-f1" n="a" xml:id="d246-f1-content">
                <p>Speeches only are printed.</p>
            </note>
