    <text>
        <body>
            <div xml:id="d238">

                <pb facs="0995" n="845" sameAs="frus:frus1907p2/pg845"/>

                <note rend="inline" type="source">File No. 4500.</note>
                <head><hi rendition="#italic">Chargé Coolidge to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Mexico</hi></placeName>, <date calendar="gregorian" when="1907-11-19"
                                ><hi rendition="#italic">November 19, 1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 795.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my No. 781, of November
                        12,<anchor n="a" xml:id="d238-f1"/> with regard to the stationing of coaling
                    vessels at Magdalena Bay, I have the honor to inclose a copy of a note from the
                    foreign office in reply to the offer of reciprocity and to confirm my telegram
                    of the 18th thereon, as follows:<anchor n="a" xml:id="d238-f2"/></p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">John Gardner
                    Coolidge.</hi></signed></closer>


                <xi:include href="d238-a1.xml" xpointer="d238-a1"/>
            </div>
        </body>
    </text>
