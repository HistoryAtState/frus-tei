                <pb facs="1108" n="958" sameAs="frus:frus1907p2/pg958"/>

                <note rend="inline" type="source">File No. 2956.</note>
                <head><hi rendition="#italic">The Secretary of State to Minister Bryan.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1906-12-18"><hi rendition="#italic">December 18,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 108.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose a copy of a dispatch from the
                    American consul at Funchal reporting that Frank Fratus (Freitas), a naturalized
                    American citizen of Portuguese origin, has been arrested by the local
                    authorities and compelled to perform military service, also a copy of the
                    application for a passport made by Mr. Freitas to the American consul at St.
                    Michaels, Azores.</p>
                <p>You will see what can be done in his behalf.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. Root.</hi></signed></closer>



                <xi:include href="d329-a1.xml" xpointer="d329-a1"/>
            </div>
