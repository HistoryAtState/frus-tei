            <div xml:id="d381">

                <pb facs="1164" n="1014" sameAs="frus:frus1907p2/pg1014"/>

                <note rend="inline" type="source">File No. 8027/–1.</note>
                <head><hi rendition="#italic">Minister Collier to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">San
                                Sebastian</hi></placeName>, <date calendar="gregorian"
                            when="1907-07-31"><hi rendition="#italic">July 31,
                        1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 375.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to report that the Gaceta
                    announces the exchange at Berne on July 9, 1907, of the ratifications of a
                    treaty of arbitration between Spain and Switzerland.</p>
                <p>Copy of the Spanish text of the treaty and translation are herewith inclosed.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Wm. Miller
                    Collier.</hi></signed></closer>


                <xi:include href="d381-a1.xml" xpointer="d381-a1"/>
