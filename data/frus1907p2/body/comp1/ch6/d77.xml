    <text>
        <body>
            <div xml:id="d77">

                <pb facs="0782" n="632" sameAs="frus:frus1907p2/pg632"/>

                <note rend="inline" type="source">File No. 3691/498.</note>
                <head><hi rendition="#italic">President Roosevelt
                        to the President of Nicaragua.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1907-04-26"><hi rendition="#italic">April 26,
                        1907</hi></date>.</dateline></opener>
                <p>I thank Your Excellency for your expressions of appreciation for the services of
                    this Government in the interest of peace.</p>
                <closer><signed><hi rendition="#small-caps">Theodore
                    Roosevelt.</hi></signed></closer>
            </div>
        </body>
