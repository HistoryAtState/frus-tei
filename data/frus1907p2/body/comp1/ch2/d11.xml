                <pb facs="0744" n="594" sameAs="frus:frus1907p2/pg594"/>

                <note rend="inline" type="source">File No. 1012/7–8.</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Chinese Chargé.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1907-12-26"><hi rendition="#italic">December 26,
                        1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 100.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a
                    letter, or petition, addressed to the minister of China to the United States by
                    several Chinese merchants in Guatemala, on the subject of the recent application
                    of the exclusion laws of that country to persons of the Chinese race.</p>
                <p>The letter was transmitted by the signers through the American legation at
                    Guatemala City.</p>
                <p>Accept, sir, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Elihu Root.</hi></signed></closer>
            </div>
        </body>
    </text>
