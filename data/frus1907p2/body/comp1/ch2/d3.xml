                <pb facs="0740" n="590" sameAs="frus:frus1907p2/pg590"/>

                <note rend="inline" type="source">File No. 1012/4.</note>
                <head><hi rendition="#italic">Chargé Brown to the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1906-08-29"><hi rendition="#italic">August 29,
                        1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 441.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to submit copies of
                    correspondence concerning the arrest of the Chinese Ramon Chan, whose complaint
                    against <pb facs="0741" n="591" xml:id="pg591"/> local authorities was
                    transmitted for the consideration of the Guatemalan minister for foreign
                    affairs.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Philip Brown.</hi></signed></closer>





