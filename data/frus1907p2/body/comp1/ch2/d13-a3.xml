                <pb facs="0746" n="596" sameAs="frus:frus1907p2/pg596"/>

                <opener><seg rendition="#center">[Inclosure 3.—Translation.]</seg></opener>
                <head><hi rendition="#italic">The Minister for Foreign
                            Affairs to Chargé Sands.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Foreign Office</hi>,<lb/><hi rendition="#italic"
                            >Guatemala</hi></placeName>, <date calendar="gregorian"
                            when="1907-12-11"><hi rendition="#italic">December 11,
                        1907</hi>.</date></dateline></opener>
                <p><hi rendition="#small-caps">Honorable Sir</hi>: I have the honor to remit,
                    appended herewith, copies of the regulations issued concerning Chinese
                    immigration in this Republic. With the highest consideration and esteem,
                    etc.,</p>
                <closer><signed><hi rendition="#small-caps">Juan Barrios, M.</hi></signed></closer>
            </div>
        </body>
    </text>
