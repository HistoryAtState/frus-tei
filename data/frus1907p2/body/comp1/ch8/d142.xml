    <text>
        <body>
            <div xml:id="d142">

                <pb facs="0812" n="662" sameAs="frus:frus1907p2/pg662"/>

                <note rend="inline" type="source">File No. 6775/243–244.</note>
                <head><hi rendition="#italic">The Costa Rican Minister to the Secretary of
                        State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Legation of Costa Rica</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1907-11-25"><hi rendition="#italic">November 25,
                        1907</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: Believing that it might
                    be of interest to you, I take pleasure in sending you, inclosed herein, a copy
                    of the minutes of the meeting of the Presidents of Honduras, Nicaragua, and
                    Salvador, at the port of Amapala, the 6th instant.</p>
                <p>I am, my dear Mr. Secretary, very sincerely yours,</p>
                <closer><signed><hi rendition="#small-caps">J. B. Calvo.</hi></signed></closer>



                <xi:include href="d142-a1.xml" xpointer="d142-a1"/>
            </div>
