    <text>
        <body>
            <div xml:id="d115">

                <pb facs="0802" n="652" sameAs="frus:frus1907p2/pg652"/>

                <note rend="inline" type="source">File No. 6775/137.</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to the Minister for Foreign Affairs of
                            Honduras.</hi></head>
                <opener><seg rendition="#center">[Telegram.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1907-10-02"><hi rendition="#italic">October 2,
                        1907</hi></date>.</dateline></opener>
                <p>Your cordial message<anchor n="a" xml:id="d115-f1"/> is highly appreciated. The
                    attendance of a representative of the President of the United States
                    concurrently with one named by the President of Mexico will be most agreeable to
                    this Government.</p>
                <closer><signed><hi rendition="#small-caps">Robert Bacon.</hi></signed></closer>
            </div>
        </body>
    </text>
