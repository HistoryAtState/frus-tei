        <body>
            <div xml:id="d174">

                <pb facs="0904" n="754" sameAs="frus:frus1907p2/pg754"/>

                <note rend="inline" type="source">File No. 6351/18–19.</note>
                <head><hi rendition="#italic">Ambassador White to the Secretary of
                    State.</hi></head>
                <opener><seg rendition="#center">[Extract]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Paris</hi></placeName>, <date calendar="gregorian" when="1907-06-19"
                                ><hi rendition="#italic">June 19, 1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 43.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a
                    translation of the treaty recently concluded between this country and Japan.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry White.</hi></signed></closer>


                <xi:include href="d174-a1.xml" xpointer="d174-a1"/>
