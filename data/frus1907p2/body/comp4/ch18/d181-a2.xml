    <text>
        <body>
            <div xml:id="d181-a2">

                <pb facs="0913" n="763" sameAs="frus:frus1907p2/pg763"/>

                <head>[Subinclosure.]</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Yokohama</hi></placeName>, <date calendar="gregorian"
                            when="1906-10-15"><hi rendition="#italic">October 15,
                        1906</hi></date>.</dateline></opener>
                <p>We, the undersigned, representing the Jewish Benevolent Association and acting on
                    behalf of the Jewish community in Yokohama, do appoint Mr. M. Russell to act as
                    rabbi pro tern, to perform such functions as may be required of him.</p>
                <closer>(Signed) <signed><hi rendition="#small-caps">Seigfreid
                            Komor.</hi></signed><lb/><signed><hi rendition="#small-caps">J. H.
                            Rosenthal.</hi></signed><lb/><signed><hi rendition="#small-caps">H. S.
                            Blum</hi>.</signed><lb/><signed><hi rendition="#small-caps">S.
                            Isaacs.</hi></signed><lb/>I accept the position as mentioned
                    above.<lb/>(Signed) <signed><hi rendition="#small-caps">Maurice
                            Russell</hi>,<lb/><hi rendition="#italic"
                    >President.</hi></signed></closer>
            </div>
        </body>
    </text>
