    <text>
        <body>
            <div xml:id="d193">

                <pb facs="0926" n="776" sameAs="frus:frus1907p2/pg776"/>

                <note rend="inline" type="source">File No. 6625/10–11.</note>
                <head><hi rendition="#italic">Ambassador Wright to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Tokyo</hi></placeName>, <date calendar="gregorian" when="1907-05-15"
                                ><hi rendition="#italic">May 15, 1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 258.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to my dispatch, No. 238, of April
                    25, last,<anchor n="b" xml:id="d193-f1"/> I have the honor to transmit herewith
                    translation of the text of the agreement recently signed between Japan and China
                    relating to the Simmintun-Mukden and Kirin-Changchun railways, as published in
                    the Official Gazette of the 4th instant.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Luke E. Wright.</hi></signed></closer>



                <xi:include href="d193-a1.xml" xpointer="d193-a1"/>
            </div>
        </body>
    </text>
