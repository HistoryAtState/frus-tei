            <div xml:id="d248">

                <pb facs="1021" n="871" sameAs="frus:frus1907p2/pg871"/>

                <note rend="inline" type="source">File No. 4968/3–4.</note>
                <head><hi rendition="#italic">The Acting Secretary of State to Minister
                        Gummeré.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1907-04-09"><hi rendition="#italic">April 9,
                        1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 92.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your dispatch No. 168, of
                    February 16, 1907, transmitting correspondence with the British minister
                    concerning the mutual protection of British and American patents in Morocco, <pb
                        facs="1022" n="872" xml:id="pg872"/> I inclose for your information a copy
                    of a letter from the Secretary of the Interior, accompanied by a copy of one
                    from the Commissioner of Patents, expressing approval of the agreement
                    suggested.</p>
                <p>You will make the exchange of notes necessary to effect the proposed
                    arrangement.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Robert Bacon.</hi></signed></closer>



                <xi:include href="d248-a1.xml" xpointer="d248-a1"/>
