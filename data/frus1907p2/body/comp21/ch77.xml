            <div xml:id="ch77">

                <pb facs="1174" n="1024" sameAs="frus:frus1907p2/pg1024"/>

                <head>Convention for the amelioration of the condition of the wounded of the armies
                    in the field</head>
                <p rendition="#flush"><hi rendition="#italic">Signed at Geneva July 6,
                    1906.</hi></p>
                <p rendition="#flush"><hi rendition="#italic">Ratification advised by the Senate
                        December 19, 1906.</hi></p>
                <p rendition="#flush"><hi rendition="#italic">Ratified by the President of the
                        United States January 2, 1907.</hi></p>
                <p rendition="#flush"><hi rendition="#italic">Ratification deposited with the
                        Government of the Swiss Confederation February 9, 1907.</hi></p>
                <p rendition="#flush"><hi rendition="#italic">Proclaimed August 3, 1907.</hi></p>

                <xi:include href="ch77/d397.xml" xpointer="d397"/>
