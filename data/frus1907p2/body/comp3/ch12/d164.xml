    <text>
        <body>
            <div xml:id="d164">

                <pb facs="0895" n="745" sameAs="frus:frus1907p2/pg745"/>

                <note rend="inline" type="source">File No. 8911/–1.</note>
                <head><hi rendition="#italic">Ambassador Griscom to
                        the Secretary of State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Rome</hi></placeName>, <date calendar="gregorian" when="1907-09-12"><hi
                                rendition="#italic">September 12, 1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 167.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit to you
                    herewith three copies of the Official Gazette,<anchor n="a" xml:id="d164-f1"/>
                    of September 10, 1907, No. 215, containing on pages 5485, 5486 the declaration
                    made between Italy and Denmark for the protection of designs and industrial
                    models, signed at Rome March 3, 1907.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Lloyd C. Griscom.</hi></signed></closer>
            </div>
        </body>
    </text>
