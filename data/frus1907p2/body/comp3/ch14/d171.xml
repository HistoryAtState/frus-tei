    <text>
        <body>
            <div xml:id="d171">

                <pb facs="0900" n="750" sameAs="frus:frus1907p2/pg750"/>

                <note rend="inline" type="source">File No. 2074/17–18.</note>
                <head><hi rendition="#italic">Ambassador Griscom to the Secretary of
                    State.</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Rome</hi></placeName>, <date calendar="gregorian" when="1908-01-03"><hi
                                rendition="#italic">January 3, 1908</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 252.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: With reference to my dispatch No.
                        231,<anchor n="a" xml:id="d171-f1"/> of the 3d ultimo, relative to the new
                    treaty of commerce and navigation between Italy and Russia, I have the honor to
                    transmit herewith copies<anchor n="a" xml:id="d171-f2"/> of No. 370 of the
                    Official Gazette of December 30, 1907, containing the text of the said
                    treaty.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Lloyd C. Griscom.</hi></signed></closer>
            </div>
        </body>
    </text>
