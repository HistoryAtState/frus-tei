    <text>
        <body>
            <div xml:id="d197">

                <pb facs="0941" n="791" sameAs="frus:frus1907p2/pg791"/>

                <head><hi rendition="#italic">The Consul-General at Boma to the Secretary of
                        State.</hi></head>
                <opener><seg rendition="#center">[Extract.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Consulate-General</hi>,<lb/><hi rendition="#italic"
                                >Boma</hi></placeName>, <date calendar="gregorian" when="1906-12-01"
                                ><hi rendition="#italic">December 1, 1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 7.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    confidential report concerning the Kongo Free State as a commercial
                    undertaking.</p>
                <p>I beg to inform the department that this report is based upon personal
                    observation, personal reading of public documents, and conversations with
                    officials, traders, and other trustworthy men of affairs.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Clarence Rice
                    Slocum.</hi></signed></closer>


                <xi:include href="d197-a1.xml" xpointer="d197-a1"/>
