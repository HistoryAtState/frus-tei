    <text>
        <body>
            <div xml:id="d204-a1">

                <pb facs="0952" n="802" sameAs="frus:frus1907p2/pg802"/>

                <opener><seg rendition="#center">[Inclosure 1.—Translation.]</seg></opener>
                <opener><dateline rendition="#float-right"><hi rendition="#small-caps">Cabinet of
                            the King</hi>, <lb/>
                        <placeName><hi rendition="#italic"><placeName type="venue"
                                    >Palace</placeName> of <placeName type="city"
                                    >Brussels</placeName></hi></placeName>, <date
                            calendar="gregorian" when="1907-01-25"><hi rendition="#italic">January
                                25, 1907</hi></date>.</dateline></opener>
                <p>Mr. <hi rendition="#small-caps">Dear Minister</hi>: I have the pleasure of
                    sending you herewith the information suggested by our conversation of the other
                    day.</p>
                <p>Please accept, etc.</p>
                <closer><signed><hi rendition="#small-caps">Carton de Wiart.</hi></signed></closer>
            </div>
        </body>
