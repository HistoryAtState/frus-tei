    <text>
        <body>
            <div xml:id="d367">

                <pb facs="0785" n="735" xml:id="pg735"/>

                <note rend="inline" type="source">763.72119/8881: Telegram</note>
                <head><hi rendition="#italic">The Commissioner in Hungary</hi> (<hi rendition="#italic">Grant-Smith</hi>) <hi
                        rendition="#italic">to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Budapest</hi></placeName>, <date calendar="gregorian"
                            when="1920-01-31T20:00:00+01:00">January 31, 1920—8
                        p.m.</date><lb/>[Received via Paris February 2—10:02
                    a.m.]</dateline></opener>
                <p>Respectfully recommend that General Bandholtz be sent home on State Department
                    detail until he has had an opportunity of reporting personally to the Secretary
                    of State at Washington on conditions in Hungary, also that he be accorded the
                    usual diplomatic customs courtesies as retiring Commissioner of the United
                    States in Hungary on arrival at New York.</p>
                <closer><signed><hi rendition="#small-caps">Grant-Smith</hi></signed></closer>
            </div>
        </body>
    </text>
