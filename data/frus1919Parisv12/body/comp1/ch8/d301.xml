            <div xml:id="d301">

                <pb facs="0729" n="679" sameAs="frus:frus1919Parisv12/pg679"/>

                <note rend="inline" type="source">Paris Peace Conf. 181.9202/111: Telegram</note>
                <head><hi rendition="#italic">General Bandholtz to
                        the Commission to Negotiate Peace</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Budapest</hi></placeName>, <date calendar="gregorian"
                            when="1919-09-15">September 15, 1919</date>.<lb/>[Received September
                        15—11:50 p.m.]</dateline></opener>
                <p>69A [<hi rendition="#italic">69</hi>]. The following telegram has just been
                    received with request that it be forwarded.</p>
                <pb facs="0730" n="680" xml:id="pg680"/>
                <quote rend="blockquote">
                    <p>“President Supreme Council, Peace Conference, Paris. The Hungarian
                        Government, in view of the imminent danger which threatens the country on
                        account of Roumania, desires to be placed under the protection of the
                        Supreme Council of Versailles and requests the Supreme Council to make
                        decision to this end as soon as possible. Friedrich MP, President of the
                        Council.”</p>
                </quote>
                <closer><signed><hi rendition="#small-caps">Bandholtz</hi></signed></closer>
            </div>
        </body>
    </text>
