                <pb facs="0686" n="636" sameAs="frus:frus1919Parisv12/pg636"/>

                <note rend="inline" type="source">Paris Peace Conf. 181.9202/7: Telegram</note>
                <head><hi rendition="#italic">General Bandholtz to
                        the Commission to Negotiate Peace</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Budapest</hi></placeName>, <date calendar="gregorian"
                            when="1919-08-11">August 11, 1919</date>.<lb/>[Received August 12—3:50
                        p.m.]</dateline></opener>
                <p>2. General Mombelli, Italian representative on Interallied Military Mission to
                    Hungary, arrived this evening and is in entire conformity with Mission
                    organization started by General Gorton and myself.</p>
                <closer><signed><hi rendition="#small-caps">Bandholtz</hi></signed></closer>
            </div>
        </body>
