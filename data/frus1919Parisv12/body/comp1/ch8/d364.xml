    <text>
        <body>
            <div xml:id="d364">

                <pb facs="0783" n="733" xml:id="pg733"/>

                <note rend="inline" type="source">Paris Peace Conf. 181.921/72</note>
                <head><hi rendition="#italic">General Bandholtz to the Interallied Military
                        Mission</hi></head>
                <opener><dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Budapest</hi></placeName>,] <date calendar="gregorian"
                            when="1919-12-13">13 December, 1919</date>.</dateline></opener>
                <p rendition="#flush">Subject: Change of Status.</p>
                <p>1. In compliance with telegraphic instructions from the American Commission to
                    Negotiate Peace, the undersigned this date ceases to be a member of the
                    Interallied Military Mission.</p>
                <closer><signed><hi rendition="#small-caps">H. H. Bandholtz</hi></signed></closer>
            </div>
        </body>
    </text>
