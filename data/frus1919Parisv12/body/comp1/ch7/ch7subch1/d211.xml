    <text>
        <body>
            <div xml:id="d211">

                <pb facs="0609" n="559" sameAs="frus:frus1919Parisv12/pg559"/>

                <note rend="inline" type="source">Paris Peace Conf. 184.011102/301</note>
                <head><hi rendition="#italic">Mr. Albert Halstead to the Secretary of
                        State</hi><anchor n="23" xml:id="d211-f1"/></head>
                <opener>
                    <seg rendition="#float-left">No. 35</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Vienna</hi></placeName>, <date calendar="gregorian"
                            when="1919-08-10">August 10, 1919</date>.</dateline>
                </opener>
                <p rendition="#flush">Subject: An interview with Dr. Renner.</p>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    memorandum of a conversation I had yesterday with the German-Austrian
                    Chancellor, Dr. Renner.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Albert Halstead</hi></signed></closer>


                <xi:include href="d211-a1.xml" xpointer="d211-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d211-f1" n="23" type="source" xml:id="d211-f1-content">
                <p>Copy transmitted to the Commission by Mr. Halstead under covering letter No. 387,
                    August 10; received August 13.</p>
            </note>
        </listAnnotation>
