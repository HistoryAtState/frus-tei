                <pb facs="0525" n="475" sameAs="frus:frus1919Parisv12/pg475"/>

                <note rend="inline" type="source">Paris Peace Conf. 184.01102/166</note>
                <head><hi rendition="#italic">Professor A. C.
                            Coolidge to the Commission to Negotiate
                            Peace</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 116</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Vienna</hi></placeName>, <date calendar="gregorian"
                            when="1919-03-02">March 2, 1919</date>.<lb/>[Received March
                        5.]</dateline>
                </opener>
                <p>Sirs: I have the honor to inclose herewith a number of extracts from reports sent
                    me by Lieutenant Leroy King who is at present in Agram.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Archibald Cary
                    Coolidge</hi></signed></closer>




