    <text>
        <body>
            <div xml:id="d377">

                <pb facs="0798" n="748" sameAs="frus:frus1919Parisv12/pg748"/>

                <note rend="inline" type="source">Paris Peace Conf. 181.91/79</note>
                <head><hi rendition="#italic">President Wilson to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>,] <date calendar="gregorian"
                            when="1919-04-15">15 April, 1919</date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I have delayed replying
                    to the enclosed<anchor n="6" xml:id="d377-f1"/> because the other Powers
                    involved seem to have virtually withdrawn from their agreement to send
                    commissioners to Syria, but in case we alone send them, these letters would be
                    just as suitable, and I am very glad to authorize you to sign them.</p>
                <p>Cordially and faithfully yours,</p>
                <closer><signed><hi rendition="#small-caps">Woodrow Wilson</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d377-f1" n="6" xml:id="d377-f1-content">
                <p>Presumably Secretary Lansing’s letter of April 2, <hi rendition="#italic"
                        >supra.</hi></p>
            </note>
        </listAnnotation>
