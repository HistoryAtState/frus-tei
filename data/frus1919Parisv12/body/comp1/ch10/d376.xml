    <text>
        <body>
            <div xml:id="d376">

                <pb facs="0797" n="747" sameAs="frus:frus1919Parisv12/pg747"/>

                <note rend="inline" type="source">Paris Peace Conf. 181.91/73</note>
                <head><hi rendition="#italic">The Secretary of State to
                        President Wilson</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1919-04-02">April 2, 1919</date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. President</hi>: In connection with the
                    instructions which were agreed upon by you, Mr. Lloyd George, Mr. Clemenceau and
                    Mr. Orlando on March 25, 1919, with regard to the sending of Commissioners from
                    the Peace Conference to make inquiries in certain portions of the Turkish Empire
                    which are to be <pb facs="0798" n="748" xml:id="pg748"/> permanently separated
                    from Turkey and put under the guidance of governments acting as Mandatories for
                    the League of Nations, I respectfully request your authorization to sign the
                    appended letters<anchor n="3" xml:id="d376-f1"/> addressed to Mr. H. C.
                        King<anchor n="4" xml:id="d376-f2"/> and Mr. Charles R. Crane,<anchor n="5"
                        xml:id="d376-f3"/> designating them as the two American Commissioners.</p>
                <p>I am [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Robert Lansing</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d376-f1" n="3" xml:id="d376-f1-content">
                <p>Neither printed.</p>
            </note>
            <note corresp="#d376-f2" n="4" xml:id="d376-f2-content">
                <p>President of Oberlin College, Ohio.</p>
            </note>
            <note corresp="#d376-f3" n="5" xml:id="d376-f3-content">
                <p>Treasurer of the American Committee for Armenian and Syrian Relief.</p>
            </note>
        </listAnnotation>
    </standOff>
