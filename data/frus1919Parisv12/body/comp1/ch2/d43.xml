        <body>
            <div xml:id="d43">

                <pb facs="0168" n="118" xml:id="pg118"/>

                <note rend="inline" type="source">Paris Peace Conf. 184.013202/4</note>
                <head><hi rendition="#italic">Mr. E. L. Dresel to the Commission to Negotiate
                        Peace</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Berlin</hi></placeName>, <date calendar="gregorian"
                            when="1919-05-10">May 10, 1919</date>.<lb/>[Received May
                    12.]</dateline></opener>
                <p><hi rendition="#small-caps">Sirs</hi>: I have the honor to transmit, herewith,
                    for the information of the Commission, a copy of the report on the general
                    political situation in Germany, dated May 10, 1919.</p>
                <p>I have [etc.]</p>
                <closer>For Mr. Dresel:<lb/><signed><hi rendition="#small-caps">Charles B.
                        Dyar</hi></signed></closer>




