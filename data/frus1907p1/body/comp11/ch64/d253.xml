    <text>
        <body>
            <div xml:id="d253">

                <pb facs="0408" n="296" sameAs="frus:frus1907p1/pg296"/>

                <note rend="inline" type="source">File No. 7622/1.</note>
                <head><hi rendition="#italic">The Acting Secretary of State to Minister
                    Morgan</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1907-07-18"><hi rendition="#italic">July 18,
                        1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 143.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose a copy of a letter<anchor n="a"
                        xml:id="d253-f1"/> from Mr. F. W. Bacot, of Charleston, S. C, making
                    inquiries concerning the value of a Cuban bond. A copy of the bond is also
                    inclosed.</p>
                <p>You are requested to ascertain the value of the bond and to return the copy
                    thereof to the department with your reply.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Robert Bacon.</hi></signed></closer>


                <xi:include href="d253-a1.xml" xpointer="d253-a1"/>
            </div>
        </body>
    </text>
