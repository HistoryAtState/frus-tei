            <div xml:id="d40">

                <pb facs="0151" n="39" sameAs="frus:frus1907p1/pg39"/>

                <note rend="inline" type="source">File No. 5748.</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to Minister Beaupré</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1907-04-10"><hi rendition="#italic">April 10,
                        1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 118.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose a copy of a letter from A. A.
                    Lisman &amp; Co., of New York, inquiring what has become of the issues of
                    certain bonds of the Entre Rios Eastern Railway Company described therein.</p>
                <p>You will endeavor to secure the information desired and transmit it to the
                    department for communication to Messrs. Lisman &amp; Co.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Robert Bacon.</hi></signed></closer>


                <xi:include href="d40-a1.xml" xpointer="d40-a1"/>
            </div>
