                <pb facs="0131" n="19" sameAs="frus:frus1907p1/pg19"/>

                <note rend="inline" type="source">File No. 4478/4.</note>
                <head><hi rendition="#italic">Chargé Wilson to the Secretary of State</hi>.</head>
                <opener><seg rendition="#center">[Telegram.—Paraphrase.]</seg></opener>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic">Buenos
                                Aires</hi></placeName>, <date calendar="gregorian" when="1907-10-09"
                                ><hi rendition="#italic">October 9,
                    1907</hi></date>.</dateline></opener>
                <p>(Mr. Wilson reports, referring to his cablegram of the 5th instant, that the
                    steamer <hi rendition="#italic">Las Palmas</hi> was returned to its owner
                    yesterday.)</p>
            </div>
