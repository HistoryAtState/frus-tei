    <text>
        <body>
            <div xml:id="d95">

                <pb facs="0227" n="115" sameAs="frus:frus1907p1/pg115"/>

                <note rend="inline" type="source">File No. 4517/2–3.</note>
                <head><hi rendition="#italic">Ambassador Dudley to the Secretary of
                    State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Petropolis</hi></placeName>, <date calendar="gregorian"
                            when="1907-06-05"><hi rendition="#italic">June 5,
                        1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 30.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith two
                    copies and a translation of regulations just promulgated by the President of
                    Brazil providing the procedure for the enforcement of the Brazilian law for the
                    expulsion of undesirable foreigners, a copy of which accompanied embassy’s No.
                    90 of January 10, 1907.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Irving B. Dudley.</hi></signed></closer>


                <xi:include href="d95-a1.xml" xpointer="d95-a1"/>
            </div>
