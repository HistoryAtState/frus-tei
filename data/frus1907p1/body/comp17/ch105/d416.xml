            <div xml:id="d416">

                <pb facs="0665" n="553" sameAs="frus:frus1907p1/pg553"/>

                <note rend="inline" type="source">File No. 3513.</note>
                <head><hi rendition="#italic">The Acting Secretary of
                            State to Chargé Carter</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1907-01-07"><hi rendition="#italic">January 7,
                        1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 366.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose a letter from Charles A. L. Reed,
                    chairman of the committee on medical legislation of the American Medical
                    Association, bringing to the department’s notice alleged discrimination <pb
                        facs="0666" n="554" xml:id="pg554"/> against the graduates of American
                    medical schools in Hongkong and other British territory in the Orient.</p>
                <p>You will make appropriate inquiry and report to the department regarding the
                    specific discrimination complained of in the inclosure.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee.</hi></signed></closer>


                <xi:include href="d416-a1.xml" xpointer="d416-a1"/>
            </div>
