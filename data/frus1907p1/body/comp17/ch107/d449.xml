    <text>
        <body>
            <div xml:id="d449">

                <pb facs="0685" n="573" xml:id="pg573"/>

                <note rend="inline" type="source">File No. 1229/9–10.</note>
                <head><hi rendition="#italic">Vice-Consul Sarle to the Third Assistant Secretary of
                        State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Consulate</hi>,<lb/><hi rendition="#italic"
                            >Zanzibar</hi></placeName>, <date calendar="gregorian" when="1907-04-21"
                                ><hi rendition="#italic">April 21, 1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 39.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to report that the
                    jurisdiction hitherto exercised by the German consular court in Zanzibar has
                    been transferred to the British consular court as from March 30. Inclosed is a
                    copy of official notice.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">A. L. Sarle.</hi></signed></closer>
            </div>
        </body>
