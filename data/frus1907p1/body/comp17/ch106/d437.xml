                <pb facs="0677" n="565" sameAs="frus:frus1907p1/pg565"/>

                <note rend="inline" type="source">File No. 4001/66.</note>
                <head><hi rendition="#italic">The British Chargé to the Secretary of
                    State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >British Embassy</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1907-02-01"><hi rendition="#italic">February 1,
                        1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 28.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you, in
                    accordance with instructions received from Sir Edward Grey, that the governor of
                    Jamaica desires that an expression of his most sincere thanks, which are very
                    cordially indorsed by His Majesty’s Government, should be conveyed to the United
                    States Government for a supply of tents which have been just received in
                    Jamaica.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Esme Howard.</hi></signed></closer>
            </div>
        </body>
    </text>
