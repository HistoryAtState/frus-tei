                <pb facs="0671" n="559" sameAs="frus:frus1907p1/pg559"/>

                <note rend="inline" type="source">File No. 4001/2.</note>
                <head><hi rendition="#italic">The British Chargé to the Secretary of
                    State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >British Embassy</hi>,<lb/><hi rendition="#italic"
                            >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1907-01-17"><hi rendition="#italic">January 17,
                        1907</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that I have
                    been instructed by His Majesty’s principal secretary of state for foreign
                    affairs to express the high appreciation of His Majesty’s Government at the
                    prompt assistance rendered by the United States Government in the dispatch of
                    their ships to Jamaica to afford aid to the stricken population of Kingston.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Esme Howard.</hi></signed></closer>
            </div>
        </body>
    </text>
