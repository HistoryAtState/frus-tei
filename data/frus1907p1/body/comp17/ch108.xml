            <div xml:id="ch108">

                <pb facs="0688" n="576" xml:id="pg576"/>

                <head>Supplementary convention between the United States and Great Britain for the
                    extradition of criminals</head>
                <p><hi rendition="#italic">Signed at London April 12, 1905.</hi></p>
                <p><hi rendition="#italic">Ratification advised by the Senate December 13,
                        1905.</hi></p>
                <p><hi rendition="#italic">Ratified by the President December 21, 1906.</hi></p>
                <p><hi rendition="#italic">Ratified by Great Britain November 14, 1906.</hi></p>
                <p><hi rendition="#italic">Ratifications exchanged at Washington December 21,
                        1906.</hi></p>
                <p><hi rendition="#italic">Proclaimed February 12, 1907.</hi></p>

                <xi:include href="ch108/d458.xml" xpointer="d458"/>
