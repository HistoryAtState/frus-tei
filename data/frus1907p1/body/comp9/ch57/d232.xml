            <div xml:id="d232">

                <pb facs="0383" n="271" sameAs="frus:frus1907p1/pg271"/>

                <note rend="inline" type="source">File No. 803.</note>
                <head><hi rendition="#italic">Minister Rockhill to
                        the Secretary of State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Peking</hi></placeName>, <date calendar="gregorian" when="1906-08-01"
                                ><hi rendition="#italic">August 1, 1906</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 366.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith, for
                    the information of the department, a copy of a note which I have received from
                    the Prince of Ch’ing regarding the entry into the United States from other
                    countries of Chinese of the exempt classes.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. W. Rockhill.</hi></signed></closer>


                <xi:include href="d232-a1.xml" xpointer="d232-a1"/>
