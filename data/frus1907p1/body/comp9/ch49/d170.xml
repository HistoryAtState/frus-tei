    <text>
        <body>
            <div xml:id="d170">

                <pb facs="0313" n="201" sameAs="frus:frus1907p1/pg201"/>

                <note rend="inline" type="source">File No. 4857/11–13.</note>
                <head><hi rendition="#italic">Minister Rockhill to the Secretary of
                    State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Peking</hi></placeName>,<date calendar="gregorian" when="1907-06-07"
                                ><hi rendition="#italic">June 7, 1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 636.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In reference to my dispatch, No. 610, of
                    the 13th ultimo, I have the honor to transmit herewith inclosed, for the
                    department’s information, a copy of a note addressed to this legation on the
                    28th of May by the Wai-wu Pu regarding alleged illegal importations of arms by
                    foreign merchants, and a copy of my reply of this date thereto.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">W. W. Rockhill.</hi></signed></closer>



                <xi:include href="d170-a1.xml" xpointer="d170-a1"/>
