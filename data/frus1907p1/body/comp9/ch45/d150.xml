    <text>
        <body>
            <div xml:id="d150">

                <pb facs="0283" n="171" sameAs="frus:frus1907p1/pg171"/>

                <note rend="inline" type="source">File No. 774/148–149.</note>
                <head><hi rendition="#italic">Chargé Fletcher to
                        the Secretary of State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Peking</hi></placeName>,<date calendar="gregorian" when="1907-11-28"
                                ><hi rendition="#italic">November 28, 1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 785.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In general reference to the anti-opium
                    movement in China, I have the honor to inclose a translation, in duplicate, of
                    regulations recently issued with reference to the use of the drug by officials
                    of the province of Chihli.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry P.
                    Fletcher.</hi></signed></closer>


                <xi:include href="d150-a1.xml" xpointer="d150-a1"/>
