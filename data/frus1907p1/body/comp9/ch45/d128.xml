    <text>
        <body>
            <div xml:id="d128">

                <pb facs="0268" n="156" sameAs="frus:frus1907p1/pg156"/>

                <note rend="inline" type="source">File No. 774/47–48.</note>
                <head><hi rendition="#italic">Chargé Eddy to the Secretary of State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Berlin</hi></placeName>,<date calendar="gregorian" when="1907-04-03"
                                ><hi rendition="#italic">April 3, 1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 1142.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your instruction No. 604, of
                    the 31st of January, 1907, I have the honor to transmit herewith a copy and a
                    translation of a note dated the 28th of March, 1907, which I have just received
                    from the Imperial German ministry for foreign affairs on the subject of the
                    opium trade in eastern Asia. I have also the honor to confirm herewith my cipher
                    telegram of April 2, on the same subject, which being deciphered should read as
                        follows:<anchor n="a" xml:id="d128-f1"/></p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Spencer Eddy.</hi></signed></closer>


                <xi:include href="d128-a1.xml" xpointer="d128-a1"/>
            </div>
        </body>
    </text>
