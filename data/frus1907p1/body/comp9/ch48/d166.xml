            <div xml:id="d166">

                <pb facs="0308" n="196" sameAs="frus:frus1907p1/pg196"/>

                <note rend="inline" type="source">File No. 1518/85–86.</note>
                <head><hi rendition="#italic">Chargé Fletcher to the Secretary of State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Peking</hi></placeName>,<date calendar="gregorian" when="1907-10-12"
                                ><hi rendition="#italic">October 12, 1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 758.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: In continuation of Mr. Rockhill’s No. 745,
                    of September 28 last, I have the honor to inclose translation of an imperial
                    edict, published the 9th instant, on the subject of the abolition of race
                    distinctions as between Manchus and Chinese.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry P.
                    Fletcher.</hi></signed></closer>



                <xi:include href="d166-a1.xml" xpointer="d166-a1"/>
