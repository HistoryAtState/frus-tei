    <text>
        <body>
            <div xml:id="d62">

                <pb facs="0174" n="62" sameAs="frus:frus1907p1/pg62"/>

                <note rend="inline" type="source">File No. 821/17–19.</note>
                <head><hi rendition="#italic">Ambassador Francis to the Secretary of
                    State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Vienna</hi></placeName>, <date calendar="gregorian" when="1907-02-16"
                                ><hi rendition="#italic">February 16, 1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 175.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: Referring to your No. 69,<anchor n="a"
                        xml:id="d62-f1"/> dated January 12, 1907, with reference to the question of
                    the admission of American meats in Austria, <pb facs="0175" n="63" xml:id="pg63"
                    /> I have the honor to inclose copies of my letters on the subject to Baron
                    Aehrenthal, imperial and royal minister of foreign affairs, dated November 6,
                    1906, and February 16, 1907.</p>
                <p>The reply of the minister of foreign affairs will be forwarded to you immediately
                    upon its receipt.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Charles S.
                    Francis.</hi></signed></closer>



                <xi:include href="d62-a1.xml" xpointer="d62-a1"/>
                <xi:include href="d62-a2.xml" xpointer="d62-a2"/>
            </div>
