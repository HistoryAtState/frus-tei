            <div xml:id="d463">

                <pb facs="0696" n="584" sameAs="frus:frus1907p1/pg584"/>

                <note rend="inline" type="source">File No. 5619.</note>
                <head><hi rendition="#italic">The Acting Secretary of State to Minister
                    Jackson</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1907-03-08"><hi rendition="#italic">March 8,
                        1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 145 Greek Series.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose for appropriate inquiry and
                    report copy of a letter from J. T. Gore, D. D. S., of Philadelphia, requesting
                    information relative to the practice of dentistry in Greece by foreigners.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Robert Bacon.</hi></signed></closer>


                <xi:include href="d463-a1.xml" xpointer="d463-a1"/>
