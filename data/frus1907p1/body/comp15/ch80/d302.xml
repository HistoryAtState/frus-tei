    <text>
        <body>
            <div xml:id="d302">

                <pb facs="0514" n="402" sameAs="frus:frus1907p1/pg402"/>

                <note rend="inline" type="source">File No. 585/21–23.</note>
                <head><hi rendition="#italic">The Secretary of State to the French
                    Ambassador</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1907-06-11"><hi rendition="#italic">June 11,
                        1907</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Mr. Ambassador</hi>: I take pleasure in
                    acknowledging the receipt of your note of the 5th instant, inclosing draft for
                    30,000 francs on the French public treasury, for the family of late Lieutenant
                    England.</p>
                <p>The matter will be taken up with the father of Lieutenant England, and the
                    receipts inclosed with your note will be returned to you, signed by the proper
                    parties, in due time.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Elihu Root.</hi></signed></closer>
            </div>
        </body>
    </text>
