    <text>
        <body>
            <div xml:id="d334">

                <pb facs="0543" n="431" sameAs="frus:frus1907p1/pg431"/>

                <note rend="inline" type="source">File No. 5121/1–4.</note>
                <head><hi rendition="#italic">Chargé Vignaud to the Secretary of State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Paris</hi></placeName>, <date calendar="gregorian" when="1907-03-14"
                                ><hi rendition="#italic">March 14, 1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 6.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    cable of the 13th instant, directing that the sympathy of the President and the
                    sorrow of the American people be conveyed to the President of the French
                    Republic on the occasion of the loss of the battle ship <hi rendition="#italic"
                        >Jena</hi> and the death of so many brave sailors, which instruction was at
                    once complied with.</p>
                <p>I inclose herewith copies of your cable, of my note to M. Pichon, and of his
                    reply.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry Vignaud.</hi></signed></closer>




                <xi:include href="d334-a1.xml" xpointer="d334-a1"/>
