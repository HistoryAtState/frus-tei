        <body>
            <div xml:id="d332">

                <pb facs="0542" n="430" sameAs="frus:frus1907p1/pg430"/>

                <note rend="inline" type="source">File No. 4286/–1.</note>
                <head><hi rendition="#italic">Ambassador McCormick to the Secretary of
                    State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Embassy</hi>,<lb/><hi rendition="#italic"
                            >Paris</hi></placeName>, <date calendar="gregorian" when="1907-01-17"
                                ><hi rendition="#italic">January 17,
                    1907</hi></date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith, two
                    copies of a Yellow Book just issued by the French foreign office on the affairs
                    of Ethiopia.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Robert S.
                    McCormick.</hi></signed></closer>


                <xi:include href="d332-a1.xml" xpointer="d332-a1"/>
