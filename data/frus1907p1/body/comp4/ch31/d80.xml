                <pb facs="0196" n="84" sameAs="frus:frus1907p1/pg84"/>

                <note rend="inline" type="source">File No. 7775/–1.</note>
                <head><hi rendition="#italic">Minister Wilson to the Secretary of State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Brussels</hi></placeName>, <date calendar="gregorian" when="1907-07-09"
                                ><hi rendition="#italic">July 9, 1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 196.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to transmit for the
                    information of the department a duplicate copy of a convention, recently
                    concluded between the Kingdoms of Belgium and Great Britain, which is an
                    addition to the extradition treaty of October 29, 1901.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry Lane
                    Wilson.</hi></signed></closer>


                <xi:include href="d80-a1.xml" xpointer="d80-a1"/>
