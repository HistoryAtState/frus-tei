            <div xml:id="d75">

                <pb facs="0188" n="76" sameAs="frus:frus1907p1/pg76"/>

                <note rend="inline" type="source">File No. 6774/1.</note>
                <head><hi rendition="#italic">Minister Wilson to the Secretary of State</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >American Legation</hi>,<lb/><hi rendition="#italic"
                            >Brussels</hi></placeName>, <date calendar="gregorian" when="1907-05-15"
                                ><hi rendition="#italic">May 15, 1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 180.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to send you herewith
                    duplicate copies, in the original text, of a convention concluded between
                    Belgium and Sweden relative to the rights of their citizens to inherit and to
                    acquire property in their respective domains.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Henry Lane
                    Wilson.</hi></signed></closer>


                <xi:include href="d75-a1.xml" xpointer="d75-a1"/>
