                <pb facs="0183" n="71" sameAs="frus:frus1907p1/pg71"/>

                <note rend="inline" type="source">File No. 907/31–32.</note>
                <head><hi rendition="#italic">The Secretary of State to
                        Minister Wilson</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1907-06-14"><hi rendition="#italic">June 14,
                        1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 110.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    Nos. 167 and 175, dated respectively April 7 and May 7 last, and to inform you
                    that the question of the employment of state agents to induce immigration from
                    Europe is receiving the consideration of the Department of Commerce and Labor,
                    and that when a conclusion is reached in the matter you will be informed
                    thereof.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">E. Root.</hi></signed></closer>
            </div>
        </body>
    </text>
