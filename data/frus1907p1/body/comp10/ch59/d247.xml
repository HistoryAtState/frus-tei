                <pb facs="0402" n="290" sameAs="frus:frus1907p1/pg290"/>

                <note rend="inline" type="source">File No. 4344/–5.</note>
                <head><hi rendition="#italic">The Acting Secretary of State to Chargé
                    Heimké</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1907-02-12"><hi rendition="#italic">February 12,
                        1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 50.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    dispatch No. 139, of December 29, 1906, relative to the claim of Ricardo A.
                    Deeb, an American citizen, for losses sustained during the late civil war in the
                    United States of Colombia.</p>
                <p>The department approves the action of the legation in respect to this case.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Robert Bacon</hi>.</signed></closer>
            </div>
        </body>
