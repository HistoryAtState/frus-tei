        <body>
            <div xml:id="d8">

                <pb facs="0127" n="15" sameAs="frus:frus1907p1/pg15"/>

                <note rend="inline" type="source">File No. 8258.</note>
                <head><hi rendition="#italic">The Acting Secretary of State to Minister
                    Beaupré</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1907-08-31"><hi rendition="#italic">August 31,
                        1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 133.]</seg></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I inclose herewith copy of a letter from
                    the Navy Department giving the itinerary of a fleet of battle ships and a
                    torpedo flotilla which will sail in December from the North Atlantic to the
                    Pacific coast of the United States.</p>
                <p>You are requested to bring to the notice of the foreign office such portions of
                    this communication as pertain to Argentine territory.</p>
                <p>I am, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Alvey A. Adee.</hi></signed></closer>
                <postscript>
                    <p>(Same, mutatis mutandis, to Brazil, No. 25; Chile, No. 72; Great Britain, No.
                        510; Mexico, No. 302; Panama, No. 55; Peru, No. 19.)</p>
                </postscript>


                <xi:include href="d8-a1.xml" xpointer="d8-a1"/>
