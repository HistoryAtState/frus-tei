            <div xml:id="d358">

                <pb facs="0607" n="495" sameAs="frus:frus1907p1/pg495"/>

                <note rend="inline" type="source">File No. 5727/60.</note>
                <head><hi rendition="#italic">The Secretary of State to the British
                    Ambassador</hi>.</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Department of State</hi>,<lb/><hi rendition="#italic"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1907-06-12"><hi rendition="#italic">June 12,
                        1907</hi></date>.</dateline>
                    <seg rendition="#float-left">No. 80.]</seg></opener>
                <p><hi rendition="#small-caps">Excellency</hi>: Supplementing my note of the 8th
                    instant, I have the honor to inclose a copy of a letter received on yesterday
                    from the Secretary of the Treasury touching on the question of the acceptance of
                    certificates issued by foreign chambers of commerce.</p>
                <p>I have, etc.,</p>
                <closer><signed><hi rendition="#small-caps">Elihu Root.</hi></signed></closer>


                <xi:include href="d358-a1.xml" xpointer="d358-a1"/>
