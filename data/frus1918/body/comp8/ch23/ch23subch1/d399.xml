            <div xml:id="d399">

                <pb facs="0489" n="377" sameAs="frus:frus1918/pg377"/>

                <note rend="inline" type="source">File No. 439.00/36</note>
                <head>
                    <hi rendition="#italic">The Secretary of the Navy</hi> (<hi rendition="#italic">Daniels</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            ana="#date_undated-inferred-from-document-content-and-sibling-dates"
                            calendar="gregorian" notAfter="1918-08-13T23:59:59-04:00"
                            notBefore="1918-08-12T00:00:00-04:00"><hi rendition="#italic"
                                >undated</hi></date>. <lb/> [<hi rendition="#italic">Received August
                            13, 1918.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to previous correspondence with
                    your Department in connection with the liquidation of claims against the
                    Dominican Republic, I have the honor to forward herewith two copies of Executive
                    Order No. 193, together with Spanish translations thereof, issued by the
                    Military Governor of Santo Domingo under date of August 2, 1918, in regard to
                    the issue of bonds for the purpose of paying the awards made by the Dominican
                    Claims Commission of 1917.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Josephus Daniels</hi>
                    </signed>
                </closer>


                <xi:include href="d399-a1.xml" xpointer="d399-a1"/>
            </div>
