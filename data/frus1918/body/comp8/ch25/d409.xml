    <text>
        <body>
            <div xml:id="d409">

                <pb facs="0510" n="398" sameAs="frus:frus1918/pg398"/>

                <note rend="inline" type="source">File No. 704.9339/2</note>
                <head>
                    <hi rendition="#italic">The Minister in the Dominican Republic</hi> (<hi rendition="#italic">Russell</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Santo Domingo</hi></placeName>, <date
                            calendar="gregorian" when="1918-05-30T08:00:00-04:40">
                            <hi rendition="#italic">May 30, 1918, 8 a.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Referring to my cable of May 2, 4 p.m., in regard to Chinese, please answer, as
                    there are many Chinamen here who want to go to China by way of New York and the
                    steamers will not accept them without passports.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Russell</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
