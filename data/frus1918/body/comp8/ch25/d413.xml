            <div xml:id="d413">

                <pb facs="0511" n="399" sameAs="frus:frus1918/pg399"/>

                <note rend="inline" type="source">File No. 704.9339/4</note>
                <head>
                    <hi rendition="#italic">The Minister in Haiti</hi> (<hi rendition="#italic"
                        >Blanchard</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Port au Prince</hi></placeName>, <date
                            calendar="gregorian" when="1918-06-25T15:00:00-05:00">
                            <hi rendition="#italic">June 25, 1918, 3 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Department’s June 4, 6 p.m., and June 13, 4 p.m.<anchor n="2" xml:id="d413-f1"/>
                    Desired permission granted. I am instructing consuls.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Blanchard</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
