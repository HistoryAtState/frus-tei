    <text>
        <body>
            <div xml:id="d412">

                <pb facs="0511" n="399" sameAs="frus:frus1918/pg399"/>

                <note rend="inline" type="source">File No. 704.9339/5</note>
                <head>
                    <hi rendition="#italic">The Minister in the Dominican Republic</hi> (<hi rendition="#italic">Russell</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 354</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Santo Domingo</hi></placeName>, <date
                            calendar="gregorian" when="1918-06-19">
                            <hi rendition="#italic">June 19, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to my telegram of May 30, 8
                    a.m., and to the Department’s reply thereto of June 4, 6 p.m., I have the honor
                    to report that I requested and obtained from the Military Government permission
                    for the diplomatic and consular representatives of the United States in this
                    Republic to take charge of Chinese interests and issue passports to Chinese
                    citizens.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William W. Russell</hi>
                    </signed>
                </closer>
            </div>
        </body>
