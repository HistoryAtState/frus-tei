            <div xml:id="d393">

                <pb facs="0471" n="359" sameAs="frus:frus1918/pg359"/>

                <note rend="inline" type="source">File No. 839.00/2092</note>
                <head>
                    <hi rendition="#italic">The Secretary of the Navy</hi> (<hi rendition="#italic"
                        >Daniels</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-07-17">
                            <hi rendition="#italic">July 17, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith, for
                    the information of the Department of State, a copy of the quarterly report of
                    the Military Governor of Santo Domingo for the period April 1, 1918, to June 30,
                    1918.</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Josephus Daniels</hi>
                    </signed>
                </closer>


                <xi:include href="d393-a1.xml" xpointer="d393-a1"/>
