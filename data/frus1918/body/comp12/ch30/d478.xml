                <pb facs="0598" n="486" sameAs="frus:frus1918/pg486"/>

                <note rend="inline" type="source">File No. 814.48/104a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Guatemala</hi> (<hi rendition="#italic"
                            >Leavell</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-05-24T18:00:00-04:00">
                            <hi rendition="#italic">May 24, 1918, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>For Red Cross:</p>
                <p>American Red Cross requests that you be advised that for important reasons it
                    desires that its relief committee conclude their work and American personnel
                    return to the United States on June 1. Red Cross desires you to inform
                    immediately all concerned and to express to Government sincere appreciation of
                    its cordial attitude toward our workers and splendid cooperation with them.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
