    <text>
        <body>
            <div xml:id="d471">

                <pb facs="0595" n="483" sameAs="frus:frus1918/pg483"/>

                <note rend="inline" type="source">File No. 814.48/38</note>
                <head>
                    <hi rendition="#italic">The Chargé in Guatemala</hi> (<hi
                            rendition="#italic">Thurston</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Guatemala</hi></placeName>, <date
                            calendar="gregorian" when="1918-01-16T00:00:00-06:36">
                            <hi rendition="#italic">January 16, 1918, midnight.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Earthquakes continue moderately heavy. Please inform Red Cross written account
                    leaves here next Tuesday. Relief work proceeding as quickly as conditions here
                    allow. All supplies now discharged and being brought to this city. Commission
                    from Panama very efficient.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Thurston</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
