                <pb facs="0176" n="64" sameAs="frus:frus1918/pg64"/>

                <note rend="inline" type="source">File No. 832.73/132a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Brazil</hi>
                        (<hi rendition="#italic">Morgan</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-01-14T19:00:00-05:00">
                            <hi rendition="#italic">January 14, 1918, 7 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Please inform Brazilian Government O’Shaughnessy in own name authorized by
                    Western Union Telegraph Co. negotiate cable concession.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
