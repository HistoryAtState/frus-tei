                <pb facs="0183" n="71" sameAs="frus:frus1918/pg71"/>

                <note rend="inline" type="source">File No. 832.73/153</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Brazil</hi> (<hi rendition="#italic">Morgan</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-07-12T19:00:00-04:00">
                            <hi rendition="#italic">July 12, 1918, 7 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>For O’Shaughnessy from Carlton. You are authorized to sign.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polk</hi>
                    </signed>
                </closer>
            </div>
