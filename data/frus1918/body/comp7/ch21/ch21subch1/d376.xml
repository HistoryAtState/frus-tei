    <text>
        <body>
            <div xml:id="d376">

                <pb facs="0455" n="343" sameAs="frus:frus1918/pg343"/>

                <note rend="inline" type="source">File No. 837.61351/51</note>
                <head>
                    <hi rendition="#italic">The International Sugar Committee to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">New York</hi></placeName>, <date
                            calendar="gregorian" when="1917-10-26">
                            <hi rendition="#italic">October 26, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Sirs</hi>: I am directed by my committee to
                    suggest the advisability of the arranging of a conference at an early date, not
                    later than Thursday, November 8, with the representatives of the Cuban
                    Government and planters, and to that end it is suggested that delegates thereof
                    to the number of five, should meet the International Sugar Committee at No. 111
                    Wall Street, to discuss the situation as co the movement of the coming crop.</p>
                <p>Yours very truly,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Edwin T. Gibson</hi>
                    </signed>
                    <lb/>
                    <hi rendition="#italic">Temporary Secretary</hi>
                </closer>
            </div>
        </body>
    </text>
