    <text>
        <body>
            <div xml:id="d365">

                <pb facs="0439" n="327" sameAs="frus:frus1918/pg327"/>

                <note rend="inline" type="source">File No. 837.51/309</note>
                <head>
                    <hi rendition="#italic">The Minister in Cuba</hi> (<hi
                            rendition="#italic">Gonzales</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 628</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Habana</hi></placeName>, <date
                            calendar="gregorian" when="1918-05-08">
                            <hi rendition="#italic">May 8, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to the Legation’s telegram of
                    May 7 [4?] 10 p.m.,<anchor n="1" xml:id="d365-f1"/> regarding the matter of the
                    Cuban loan of $15,000,000, I have the honor to transmit herewith the original
                    communication dated May 6, 1918, from the Cuban Secretary of the Treasury to the
                    Cuban Secretary of State, together with a translation of same in duplicate.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William E. Gonzales</hi>
                    </signed>
                </closer>


                <xi:include href="d365-a1.xml" xpointer="d365-a1"/>
            </div>
        </body>
    </text>
