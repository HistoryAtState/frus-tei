    <text>
        <body>
            <div xml:id="d322">

                <pb facs="0397" n="285" sameAs="frus:frus1918/pg285"/>

                <note rend="inline" type="source">File No. 837.51/249</note>
                <head>
                    <hi rendition="#italic">The Minister in Cuba</hi> (<hi
                            rendition="#italic">Gonzales</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Habana</hi></placeName>, <date
                            calendar="gregorian" when="1917-07-13T12:00:00-05:29">
                            <hi rendition="#italic">July 13, 1917, noon.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Congress last night voted authority for 30,000,000-dollar loan asked for by the
                    President.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gonzales</hi>
                    </signed>
                </closer>


                <xi:include href="d322-a1.xml" xpointer="d322-a1"/>
