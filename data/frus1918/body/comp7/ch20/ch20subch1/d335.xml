    <text>
        <body>
            <div xml:id="d335">

                <pb facs="0416" n="304" sameAs="frus:frus1918/pg304"/>

                <note rend="inline" type="source">File No. 837.51/267</note>
                <head>
                    <hi rendition="#italic">The Secretary of War</hi> (<hi
                            rendition="#italic">Baker</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-09-04">
                            <hi rendition="#italic">September 4, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I beg to acknowledge yours of August 31,
                        1917,<anchor n="1" xml:id="d335-f1"/> in which you request that one of the
                    financial experts of the Insular Bureau of this Department be directed to
                    examine certain financial data submitted by the Cuban Minister relating to a
                    proposed Cuban loan.</p>
                <p>I return herewith the enclosures received with your letter with a memorandum from
                    the Chief of the Bureau of Insular Affairs on the proposed loan.</p>
                <p>Very respectfully,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Newton D. Baker</hi>
                    </signed>
                </closer>


                <xi:include href="d335-a1.xml" xpointer="d335-a1"/>
            </div>
        </body>
    </text>
