    <text>
        <body>
            <div xml:id="d366">

                <pb facs="0441" n="329" sameAs="frus:frus1918/pg329"/>

                <note rend="inline" type="source">File No. 837.51/310</note>
                <head>
                    <hi rendition="#italic">The Minister in Cuba</hi> (<hi rendition="#italic"
                        >Gonzales</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 630</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Habana</hi></placeName>, <date
                            calendar="gregorian" when="1918-05-09">
                            <hi rendition="#italic">May 9, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith in
                    duplicate translation of note No. 417, dated May 8, 1918, from the Cuban
                    Secretary of State, in regard to the loan of $15,000,000. This note is in answer
                    to the Department’s telegraphic instructions of April 5, 6 p.m., and April 20, 6
                    p.m., and a <hi rendition="#italic">résumé</hi> of which was in my telegram of
                    May 9, 11 a.m.<anchor n="1" xml:id="d366-f1"/>
                </p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">William E. Gonzales</hi>
                    </signed>
                </closer>


                <xi:include href="d366-a1.xml" xpointer="d366-a1"/>
            </div>
        </body>
    </text>
