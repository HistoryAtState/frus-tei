    <text>
        <body>
            <div xml:id="d320">

                <pb facs="0396" n="284" sameAs="frus:frus1918/pg284"/>

                <note rend="inline" type="source">File No. 837.51/247a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Cuba</hi> (<hi
                        rendition="#italic">Gonzales</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1917-06-18T17:00:00-05:00">
                            <hi rendition="#italic">June 18, 1917, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Mail Department full translation of provisions of decree authorizing loan of
                    thirty million pesos and for increased revenues, reported in <hi
                        rendition="#italic">La Lucha</hi> of May 27 last.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
