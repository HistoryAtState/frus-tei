            <div xml:id="d318">

                <pb facs="0395" n="283" sameAs="frus:frus1918/pg283"/>

                <note rend="inline" type="source">File No. 837.00/1474</note>
                <head>
                    <hi rendition="#italic">The Minister in Cuba</hi> (<hi
                            rendition="#italic">Gonzales</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Habana</hi></placeName>, <date
                            calendar="gregorian" when="1918-03-21T11:00:00-05:29">
                            <hi rendition="#italic">March 21, 1918, 11 a.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>My March 19, 4 p.m. José Miguel Gomez, former President of Cuba, released under
                    amnesty bill.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Gonzales</hi>
                    </signed>
                </closer>
            </div>
        </body>
