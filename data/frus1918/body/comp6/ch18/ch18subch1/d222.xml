        <body>
            <div xml:id="d222">

                <pb facs="0342" n="230" sameAs="frus:frus1918/pg230"/>

                <note rend="inline" type="source">File No. 818.00/289</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Panama</hi>
                        (<hi rendition="#italic">Price</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-01-05T18:00:00-05:00">
                            <hi rendition="#italic">January 5, 1918, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your January 3, 3 p.m. Considered advisable not to permit these men to proceed to
                    Nicaragua.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
