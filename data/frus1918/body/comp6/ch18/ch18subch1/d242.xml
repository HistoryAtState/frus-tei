            <div xml:id="d242">

                <pb facs="0355" n="243" xml:id="pg243"/>

                <note rend="inline" type="source">File No. 818.00/335</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Consul at Port Limon</hi>
                        (<hi rendition="#italic">McMillin</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-02-28T18:00:00-05:00">
                            <hi rendition="#italic">February 28, 1918, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your cables February 24, 2 p.m. and February 25, 4 p.m. Keep Department fully
                    advised by cable in regard to situation.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
