    <text>
        <body>
            <div xml:id="d265-a1">

                <pb facs="0369" n="257" sameAs="frus:frus1918/pg257"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in
                        Panama</hi><anchor n="1" xml:id="d265-f1"/> (<hi rendition="#italic"
                        >Price</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-04-25T16:00:00-04:00">
                            <hi rendition="#italic">April 25, 1918, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>For your information and whatever public use you may deem desirable, following
                    telegram was sent American Legation, San José:</p>
                <p>[Here follows text of telegram of April 23, printed above.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d265-f1" n="1" type="source" xml:id="d265-f1-content">
                <p>The same, on the same date, to the American Legations in Guatemala and
                    Nicaragua.</p>
            </note>
        </listAnnotation>
    </standOff>
