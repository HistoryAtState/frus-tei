                <pb facs="0366" n="254" sameAs="frus:frus1918/pg254"/>

                <note rend="inline" type="source">File No. 818.00/387</note>
                <head>
                    <hi rendition="#italic">The Chargé in Costa Rica</hi> (<hi rendition="#italic"
                        >Johnson</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">San José</hi></placeName>, <date
                            calendar="gregorian" when="1918-04-07T13:00:00-05:36">
                            <hi rendition="#italic">April 7, 1918, 1 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Volio expedition has arrived on Costa Rican soil near Panaman border.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Johnson</hi>
                    </signed>
                </closer>
            </div>
