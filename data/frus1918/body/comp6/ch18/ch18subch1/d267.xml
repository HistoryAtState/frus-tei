                <pb facs="0370" n="258" sameAs="frus:frus1918/pg258"/>

                <note rend="inline" type="source">File No. 811.111/3588</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in Costa Rica</hi> (<hi rendition="#italic"
                            >Johnson</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-04-26T12:00:00-04:00">
                            <hi rendition="#italic">April 26, 1918, noon.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your March 15, 10 a.m. and April 19, 1 a.m. The United States Government has no
                    objection to Joaquin Tinoco’s going to France via the United States.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
