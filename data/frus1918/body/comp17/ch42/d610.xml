    <text>
        <body>
            <div xml:id="d610">

                <pb facs="0780" n="668" sameAs="frus:frus1918/pg668"/>

                <note rend="inline" type="source">File No. 312.11/8525</note>
                <head>
                    <hi rendition="#italic">The Chargé in Mexico</hi> (<hi
                            rendition="#italic">Summerlin</hi>) <hi rendition="#italic"
                        >to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1918-01-05T10:00:00-06:36">
                            <hi rendition="#italic">January 5, 1918, 10 a.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>671. Department’s 660, December 22, 7 p.m.<anchor n="1" xml:id="d610-f1"/>
                    Foreign Office informs me that the military commander in the region of Yaqui
                    Valley had been ordered to afford protection to the persons and property of
                    American citizens commensurate with the exigencies of the campaign.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Summerlin</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
