        <body>
            <div xml:id="d697">

                <pb facs="0919" n="807" xml:id="pg807"/>

                <note rend="inline" type="source">File No. 412.00/66</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Mexico</hi> (<hi rendition="#italic"
                        >Fletcher</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 886</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1918-04-02">
                            <hi rendition="#italic">April 2, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt of the Department’s instruction No. 470 of March 8, 1918, relative to
                    the establishment of a claims commission by the Mexican Government. As directed
                    by the Department, representations regarding this matter were made to the
                    Foreign Office in the Embassy’s note No. 288 of March 29, 1918, a copy of which
                    is attached hereto.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry P. Fletcher</hi>
                    </signed>
                </closer>


                <xi:include href="d697-a1.xml" xpointer="d697-a1"/>
            </div>
        </body>
    </text>
