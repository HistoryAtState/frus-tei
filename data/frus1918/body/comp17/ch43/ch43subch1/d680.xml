    <text>
        <body>
            <div xml:id="d680">

                <pb facs="0884" n="772" sameAs="frus:frus1918/pg772"/>

                <note rend="inline" type="source">File No. 812.512/2238</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Mexico</hi> (<hi
                            rendition="#italic">Fletcher</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1639</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1918-12-03">
                            <hi rendition="#italic">December 3, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to the Embassy’s despatch
                    No. 1627 of November 27, 1918,<anchor n="1" xml:id="d680-f1"/> I have the honor
                    to transmit herewith the translation of the new proposed petroleum law,
                    submitted to the Congress by President Carranza on November 23, 1918.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry P. Fletcher</hi>
                    </signed>
                </closer>


                <xi:include href="d680-a1.xml" xpointer="d680-a1"/>
            </div>
        </body>
    </text>
