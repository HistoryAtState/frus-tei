    <text>
        <body>
            <div xml:id="d667">

                <pb facs="0854" n="742" sameAs="frus:frus1918/pg742"/>

                <note rend="inline" type="source">File No. 812.512/2047</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Mexico</hi> (<hi
                            rendition="#italic">Fletcher</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1241</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1918-07-19">
                            <hi rendition="#italic">July 19, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose, herewith, the
                    text and translation of a presidential decree imposing a tax on petroleum claims
                    of five pesos per hectare or fraction thereof greater than one-half a
                    hectare.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry P. Fletcher</hi>
                    </signed>
                </closer>



                <xi:include href="d667-a1.xml" xpointer="d667-a1"/>
            </div>
