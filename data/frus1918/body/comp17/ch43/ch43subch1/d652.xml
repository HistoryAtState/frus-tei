            <div xml:id="d652">

                <pb facs="0830" n="718" xml:id="pg718"/>

                <note rend="inline" type="source">File No. 812.512/1955</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Mexico</hi> (<hi rendition="#italic"
                        >Fletcher</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 985</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1918-05-01">
                            <hi rendition="#italic">May 1, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to my despatch No. 890 of
                    April 3, 1918, regarding the petroleum decree of the Mexican Government of
                    February 19 this year, I have the honor to transmit to the Department, herewith,
                    the text, with translation, of Circular No. 14 dated April 23, 1918, issued by
                    the Department of Hacienda, fixing a term for the presentation of declarations
                    and paying taxes on petroleum lands and leases established by the decree
                    mentioned.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry P. Fletcher</hi>
                    </signed>
                </closer>


                <xi:include href="d652-a1.xml" xpointer="d652-a1"/>
