            <div xml:id="d658">

                <pb facs="0833" n="721" xml:id="pg721"/>

                <note rend="inline" type="source">File No. 812.512/1957</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Mexico</hi> (<hi rendition="#italic"
                            >Fletcher</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-05-18T20:00:00-04:00">
                            <hi rendition="#italic">May 18, 1918, 8 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1085. Your 1070, May 14, 2 p.m. Department is pleased to note deterrent effect of
                    its protest and trusts you will be able to impress upon President Carranza the
                    necessity and advisability of radically modifying decree.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
