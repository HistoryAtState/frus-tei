            <div xml:id="d659">

                <pb facs="0833" n="721" sameAs="frus:frus1918/pg721"/>

                <note rend="inline" type="source">File No. 812.512/1983</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Mexico</hi> (<hi rendition="#italic"
                        >Fletcher</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1051</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1918-05-22">
                            <hi rendition="#italic">May 22, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to my telegram No. 1078 of May
                    17, 12 noon, reporting an extension until July 31 of the time within which
                    statements required by Article 14 of the petroleum decree of February 19 last,
                    may be filed, I have the honor to enclose, herewith, the text and translation of
                    presidential decree making the extension of time referred to and prescribing the
                    information to be given in the statements mentioned.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry P. Fletcher</hi>
                    </signed>
                </closer>


                <xi:include href="d659-a1.xml" xpointer="d659-a1"/>
            </div>
