                <pb facs="0829" n="717" sameAs="frus:frus1918/pg717"/>

                <note rend="inline" type="source">File No. 812.6363/384</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Mexico</hi> (<hi
                            rendition="#italic">Fletcher</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1918-04-19T13:00:00-06:36">
                            <hi rendition="#italic">April 19, 1918, 1 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>983. Your 985, April 18 [17], 7 p.m. Representations made this morning. Minister
                    for Foreign Affairs informs me General Dieguez has been ordered to oil fields
                    and will be instructed in the sense desired by the State Department.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Fletcher</hi>
                    </signed>
                </closer>
            </div>
        </body>
