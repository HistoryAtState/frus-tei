            <div xml:id="d687">

                <pb facs="0903" n="791" sameAs="frus:frus1918/pg791"/>

                <note rend="inline" type="source">File No. 812.032/43</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Mexico</hi> (<hi rendition="#italic">Fletcher</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-12-27T17:00:00-05:00">
                            <hi rendition="#italic">December 27, 1918, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1752. Your 1860. Department approves of making urgent representations in the
                    sense you outline in a separate communication to be sent to Foreign Office
                    simultaneously with communication to be submitted in compliance with
                    Department’s instruction, 797.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
