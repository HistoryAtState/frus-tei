    <text>
        <body>
            <div xml:id="d557">

                <pb facs="0706" n="594" sameAs="frus:frus1918/pg594"/>

                <note rend="inline" type="source">File No. 711.12/110</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Mexico</hi> (<hi rendition="#italic"
                        >Fletcher</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1918-07-01T16:00:00-06:36">
                            <hi rendition="#italic">July 1, 1918, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1243. Your 1220, June 29, 8 p.m. Statement published to-day by <hi
                        rendition="#italic">Universal, Excelsior</hi>, and <hi rendition="#italic"
                        >Republica. Pueblo</hi> did not publish it although given copy. Not
                    furnished <hi rendition="#italic">Democrata.</hi>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Fletcher</hi>
                    </signed>
                </closer>
            </div>
        </body>
