    <text>
        <body>
            <div xml:id="d593">

                <pb facs="0754" n="642" sameAs="frus:frus1918/pg642"/>

                <note rend="inline" type="source">File No. 812.51/418</note>
                <head>
                    <hi rendition="#italic">The Chargé in Mexico</hi> (<hi
                            rendition="#italic">Summerlin</hi>) <hi rendition="#italic"
                        >to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 798</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1918-02-20">
                            <hi rendition="#italic">February 20, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit, herewith, a
                    letter addressed to the Honorable the Secretary of State, from Mr. George W.
                    Cook, <pb facs="0755" n="643" xml:id="pg643"/> 2a Calle de Madrid, No. 35,
                    Mexico City, enclosing a memorandum in regard to the new “Law of Payments”
                    promulgated December 24, 1917, and which was reported by the Embassy in its No.
                    668 of December 19, 1917,<anchor n="1" xml:id="d593-f1"/> page 16, and No. 688
                    of January 2, 1918,<anchor n="1" xml:id="d593-f2"/> page 15.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">George T. Summerlin</hi>
                    </signed>
                </closer>


                <xi:include href="d593-a1.xml" xpointer="d593-a1"/>
            </div>
        </body>
    </text>
