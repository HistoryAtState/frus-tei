            <div xml:id="d543">

                <pb facs="0688" n="576" xml:id="pg576"/>

                <note rend="inline" type="source">File No. 811.0144/109</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Mexico</hi> (<hi
                            rendition="#italic">Fletcher</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1678</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1918-12-19">
                            <hi rendition="#italic">December 19, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to the Department’s instruction
                    No. 782 dated November 22 last, regarding the stealing and carrying away of
                    property of United States citizens by armed Mexicans in the Big Bend district,
                    Texas, between Ojinaga and Pilares, I have the honor to transmit herewith copy
                    and translation of a note received by the Embassy from the Mexican Foreign
                    Office, under date of the 14th instant, which states that the matter has been
                    brought to the attention of the appropriate authorities.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry P. Fletcher</hi>
                    </signed>
                </closer>


                <xi:include href="d543-a1.xml" xpointer="d543-a1"/>
            </div>
