            <div xml:id="d506">

                <pb facs="0664" n="552" xml:id="pg552"/>

                <note rend="inline" type="source">File No. 812.00/21679</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Chargé in
                        Mexico</hi> (<hi rendition="#italic">Summerlin</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-01-26T16:00:00-05:00">
                            <hi rendition="#italic">January 26, 1918, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>726. You may announce publicly that entire story covered in despatch mentioned in
                    your 720 is sheer fabrication, and on its face propaganda to disturb existing
                    relations between two friendly Governments.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
