            <div xml:id="d583">

                <pb facs="0735" n="623" sameAs="frus:frus1918/pg623"/>

                <note rend="inline" type="source">File No. 612.119/1235</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Mexico</hi> (<hi rendition="#italic"
                        >Fletcher</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 889</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1918-04-03">
                            <hi rendition="#italic">April 3, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to the Department’s
                    telegraphic instructions No. 926 of March 28, 7 p.m., and to previous
                    correspondence regarding the negotiations between the United States and Mexico
                    on the subject of commercial interchange, I have the honor to enclose herewith a
                    copy of my note to the Foreign Office No. 289 of March 30, 1918, as outlined in
                    my telegram No. 909 of March 27, 4 p.m.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry P. Fletcher</hi>
                    </signed>
                </closer>


                <xi:include href="d583-a1.xml" xpointer="d583-a1"/>
            </div>
