            <div xml:id="d582">

                <pb facs="0735" n="623" sameAs="frus:frus1918/pg623"/>

                <note rend="inline" type="source">File No. 612.119/1151</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Mexico</hi>
                        (<hi rendition="#italic">Fletcher</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-03-28T19:00:00-05:00">
                            <hi rendition="#italic">March 28, 1918, 7 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>926. Department approves your proposed reply as outlined in your 909, March 27, 4
                    p.m. Of course you will have in mind subdivision (<hi rendition="#italic"
                    >c</hi>) of paragraph 2 of Department’s 883, March 15, 8 p.m.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
