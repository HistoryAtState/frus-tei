            <div xml:id="d589">

                <pb facs="0742" n="630" xml:id="pg630"/>

                <note rend="inline" type="source">File No. 711.12/117</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Mexico</hi> (<hi
                            rendition="#italic">Fletcher</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1918-07-11T10:00:00-06:36">
                            <hi rendition="#italic">July 11, 1918, 10 a.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1263. My statement published to-day on the first page of <hi rendition="#italic"
                        >Excelsior, El Universal</hi>, and <hi rendition="#italic">El Pueblo.</hi>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Fletcher</hi>
                    </signed>
                </closer>
            </div>
        </body>
