            <div xml:id="d565">

                <pb facs="0714" n="602" sameAs="frus:frus1918/pg602"/>

                <note rend="inline" type="source">File No. 612.119/697</note>
                <head>
                    <hi rendition="#italic">The Chargé in Mexico</hi> (<hi rendition="#italic"
                        >Summerlin</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1918-01-05T12:00:00-06:36">
                            <hi rendition="#italic">January 5, 1918, noon.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>673. The statement contained in your telegram No. 676 was given to the press late
                    yesterday afternoon and was printed in all of today’s papers except the <hi
                        rendition="#italic">Universal.</hi>
                </p>
                <p>Press comments on this announcement will be promptly telegraphed as they
                    appear.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Summerlin</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
