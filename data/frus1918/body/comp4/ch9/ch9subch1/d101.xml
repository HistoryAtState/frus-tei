    <text>
        <body>
            <div xml:id="d101">

                <pb facs="0228" n="116" sameAs="frus:frus1918/pg116"/>

                <note rend="inline" type="source">File No. 893.00/2916</note>
                <head>
                    <hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Reinsch</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 2319</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1918-11-08">
                            <hi rendition="#italic">November 8, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to forward for your
                    information copies of a telegram from Dr. Wu Ting-fang in which in behalf of the
                    “Military Government” at Canton, he protests the election of President Hsü
                    Shih-ch’ang as illegal and announces that the Cabinet of the “Military
                    Government” will perform the functions of President.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Paul S. Reinsch</hi>
                    </signed>
                </closer>



                <xi:include href="d101-a1.xml" xpointer="d101-a1"/>
            </div>
        </body>
    </text>
