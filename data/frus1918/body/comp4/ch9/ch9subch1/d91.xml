    <text>
        <body>
            <div xml:id="d91">

                <pb facs="0221" n="109" sameAs="frus:frus1918/pg109"/>

                <note rend="inline" type="source">File No. 893.001H85/1</note>
                <head>
                    <hi rendition="#italic">The Chinese Minister</hi> (<hi rendition="#italic"
                        >Koo</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 74</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-09-05">
                            <hi rendition="#italic">September 5, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to inform you, in
                    pursuance of instructions from my Government, that His Excellency Hsü
                    Shih-ch’ang has been elected President of the Republic of China for the next
                    term in accordance with the laws of the Republic.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Vi Kyuin Wellington Koo</hi>
                    </signed>
                </closer>
            </div>
        </body>
