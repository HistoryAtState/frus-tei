    <text>
        <body>
            <div xml:id="d217">

                <pb facs="0334" n="222" sameAs="frus:frus1918/pg222"/>

                <note rend="inline" type="source">File No. 793.94/704</note>
                <head>
                    <hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Reinsch</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 2092</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1918-06-06">
                            <hi rendition="#italic">June 6, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: In continuation of my despatches Nos. 2062
                    and 2063 of May 23,<anchor n="1" xml:id="d217-f1"/> I now have the honor to
                    forward for your information the official text of the notes exchanged in Tokyo
                    on March 25, 1918, between the Minister for Foreign Affairs and the Chinese
                    Minister, <pb facs="0335" n="223" xml:id="pg223"/> relating to military
                    cooperation. The text transmitted is as officially given out by the Foreign
                    Office in Peking.<anchor n="2" xml:id="d217-f2"/> …</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Paul S. Reinsch</hi>
                    </signed>
                </closer>





                <xi:include href="d217-a1.xml" xpointer="d217-a1"/>
                <xi:include href="d217-a2.xml" xpointer="d217-a2"/>
                <xi:include href="d217-a3.xml" xpointer="d217-a3"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d217-f1" n="1" xml:id="d217-f1-content">
                <p>Not printed.</p>
            </note>
            <note corresp="#d217-f2" n="2" xml:id="d217-f2-content">
                <p>Copies of notes exchanged were also left at the Department by the Japanese
                    Ambassador August 16, 1918 (File No. 793.94/709).</p>
            </note>
        </listAnnotation>
