    <text>
        <body>
            <div xml:id="d156">

                <pb facs="0278" n="166" sameAs="frus:frus1918/pg166"/>

                <note rend="inline" type="source">File No. 893.51/1896</note>
                <head>
                    <hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Reinsch</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1996</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1918-04-12">
                            <hi rendition="#italic">April 12, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose a list of
                    loans made to the Chinese Government during the year 1917, and during January of
                    the present year.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Paul S. Reinsch</hi>
                    </signed>
                </closer>



                <xi:include href="d156-a1.xml" xpointer="d156-a1"/>
            </div>
