    <text>
        <body>
            <div xml:id="d155">

                <pb facs="0277" n="165" sameAs="frus:frus1918/pg165"/>

                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Chargé in China</hi> (<hi rendition="#italic"
                            >MacMurray</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-10-10T11:00:00-04:00">
                            <hi rendition="#italic">October 10, 1918, 11 a.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your October 8, 2 p.m., and referring to note from Foreign Office of August 21,
                    1918.</p>
                <pb facs="0278" n="166" xml:id="pg166"/>
                <p>You may inquire of the Chinese Government whether this Government is to
                    understand from the closing sentence of the reply of the Ministry of Finance
                    that those of other nationality including American citizens will be allowed to
                    cooperate in the Kirin forestry agreement and its subsidiary privileges.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
