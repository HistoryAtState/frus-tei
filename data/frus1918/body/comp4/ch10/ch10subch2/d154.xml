            <div xml:id="d154">

                <pb facs="0277" n="165" sameAs="frus:frus1918/pg165"/>

                <note rend="inline" type="source">File No. 893.51/2027</note>
                <head>
                    <hi rendition="#italic">The Chargé in China</hi> (<hi rendition="#italic"
                        >MacMurray</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1918-10-08T14:00:00+08:00">
                            <hi rendition="#italic">October 8, 1918, 2 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your September 24, 3 p.m. Ministry of Finance declined to communicate texts of
                    Kirin forestry agreement and notes.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">MacMurray</hi>
                    </signed>
                </closer>
            </div>
