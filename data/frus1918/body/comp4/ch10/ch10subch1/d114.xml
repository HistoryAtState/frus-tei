            <div xml:id="d114">

                <pb facs="0251" n="139" sameAs="frus:frus1918/pg139"/>

                <note rend="inline" type="source">File No. 893.51/1861</note>
                <head>
                    <hi rendition="#italic">The Minister in China</hi> (<hi
                            rendition="#italic">Reinsch</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1918-01-07T12:00:00+08:00">
                            <hi rendition="#italic">January 7, 1918, noon.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your January 5, 2 p.m. British Government misinformed. Loan signed yesterday.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Reinsch</hi>
                    </signed>
                </closer>
            </div>
