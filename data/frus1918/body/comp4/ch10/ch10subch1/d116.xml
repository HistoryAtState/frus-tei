    <text>
        <body>
            <div xml:id="d116">

                <pb facs="0251" n="139" sameAs="frus:frus1918/pg139"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in France</hi>
                        (<hi rendition="#italic">Sharp</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-01-09T15:00:00-05:00">
                            <hi rendition="#italic">January 9, 1918, 3 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>3050. Your 2930, December 21, 10 p.m.<anchor n="1" xml:id="d116-f1"/> Department
                    informed by Legation at Peking on January 7 that Japanese signed loan agreement
                    January 6.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
