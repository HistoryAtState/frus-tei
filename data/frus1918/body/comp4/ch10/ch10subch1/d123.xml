    <text>
        <body>
            <div xml:id="d123">

                <pb facs="0254" n="142" sameAs="frus:frus1918/pg142"/>

                <note rend="inline" type="source">File No. 893.51/1880</note>
                <head>
                    <hi rendition="#italic">The Minister in China</hi> (<hi rendition="#italic"
                        >Reinsch</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1878</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1918-02-11">
                            <hi rendition="#italic">February 11, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose copies of a
                    translation of an agreement for a second advance of yen 10,000,000, drawn up on
                    January 6, 1918,<anchor n="1" xml:id="d123-f1"/> between the Chinese Government
                    and the Yokohama Specie Bank, together with a statement of advances made by the
                    Bank of China to the Chinese Government.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Paul S. Reinsch</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
