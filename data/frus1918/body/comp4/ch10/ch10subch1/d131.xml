    <text>
        <body>
            <div xml:id="d131">

                <pb facs="0258" n="146" sameAs="frus:frus1918/pg146"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-04-11T16:00:00-04:00">
                            <hi rendition="#italic">April 11, 1918, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>7231. Your 9411, April 9, 10 p.m. Action has been deferred pending developments
                    here and in China. It is doubtful whether group will be organized in the near
                    future.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
