    <text>
        <body>
            <div xml:id="d181">

                <pb facs="0296" n="184" sameAs="frus:frus1918/pg184"/>

                <note rend="inline" type="source">File No. 893.51/1958</note>
                <head>
                    <hi rendition="#italic">The American Group to the Acting Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">New York</hi></placeName>, <date
                            calendar="gregorian" when="1918-08-06">
                            <hi rendition="#italic">August 6, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Sir</hi>: We are in receipt of your letter of
                    August 2, contents of which we note with interest.</p>
                <pb facs="0297" n="185" xml:id="pg185"/>
                <p>We hand you herewith for your information copy of the agreement which is being
                    signed by members of the new American group. As soon as we have heard from ail
                    of the institutions on the list approved by you we will send you the complete
                    membership of the group.</p>
                <p>Yours very truly,</p>
                <closer>
                    <hi rendition="#small-caps">J. P. Morgan &amp; Co</hi>.</closer>


                <xi:include href="d181-a1.xml" xpointer="d181-a1"/>
            </div>
