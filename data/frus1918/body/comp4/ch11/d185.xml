    <text>
        <body>
            <div xml:id="d185">

                <pb facs="0300" n="188" sameAs="frus:frus1918/pg188"/>

                <note rend="inline" type="source">File No. 893.51/1976</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 9710</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1918-08-16">
                            <hi rendition="#italic">August 16, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to the Department’s
                    circular telegram of July 11, 1918, and previous correspondence respecting the
                    formation of a new four-power group for the purpose of making a loan to China, I
                    have the honor to transmit herewith enclosed a copy of a note I have just
                    received from the Foreign Office setting forth certain points arising out of the
                    correspondence communicated to the British <pb facs="0301" n="189"
                        xml:id="pg189"/> Government which in their opinion call for further
                    elucidation in order that they may be in a position to appreciate fully the
                    scope of the proposals.</p>
                <p>I have [etc.]</p>
                <closer>For the Ambassador: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Irwin Laughlin</hi>
                    </signed>
                </closer>


                <xi:include href="d185-a1.xml" xpointer="d185-a1"/>
            </div>
