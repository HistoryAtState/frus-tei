    <text>
        <body>
            <div xml:id="d210-a1">

                <pb facs="0325" n="213" sameAs="frus:frus1918/pg213"/>

                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in China</hi> (<hi rendition="#italic"
                            >Reinsch</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-11-30T14:00:00-05:00">
                            <hi rendition="#italic">November 30, 1918, 2 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your November 25, 6 p.m. You will make appropriate expression to the Chinese
                    Government of the Department’s appreciation of their wise decision to destroy
                    the opium stocks at Shanghai.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
