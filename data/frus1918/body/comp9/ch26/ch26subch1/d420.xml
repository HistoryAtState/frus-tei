            <div xml:id="d420">

                <pb facs="0519" n="407" sameAs="frus:frus1918/pg407"/>

                <note rend="inline" type="source">File No. 422.11G93/954</note>
                <head>
                    <hi rendition="#italic">The Minister in Ecuador</hi> (<hi rendition="#italic"
                        >Hartman</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 299</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Quito</hi></placeName>, <date
                            calendar="gregorian" when="1918-05-07">
                            <hi rendition="#italic">May 7, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to my telegram of March 14,
                    1918, 4 p.m., and Department’s telegram of March 19, 6 p.m., relating to the
                    publication of official correspondence between the Foreign Office and this
                    Legation, by the Government of Ecuador, without permission of this Legation, I
                    have the honor to enclose herewith, for the information of the Department, one
                    copy each of the following:</p>
                <p>My note No. 266, of March 12, 1918, to the Foreign Office;</p>
                <p>Note No. 4, of March 12, 1918, from the Foreign Office to this Legation;</p>
                <p>Translation of said note No. 4. …</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Chas. S. Hartman</hi>
                    </signed>
                </closer>



                <xi:include href="d420-a1.xml" xpointer="d420-a1"/>
                <xi:include href="d420-a2.xml" xpointer="d420-a2"/>
