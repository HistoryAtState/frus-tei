                <pb facs="0536" n="424" sameAs="frus:frus1918/pg424"/>

                <note rend="inline" type="source">File No. 422.11G93/988</note>
                <head>
                    <hi rendition="#italic">The Minister in Ecuador</hi> (<hi rendition="#italic"
                        >Hartman</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Quito</hi></placeName>, <date
                            calendar="gregorian" when="1918-11-26T08:00:00-05:14">
                            <hi rendition="#italic">November 26, 1918, 8 a.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Department’s November 21, 6 p.m. Daily deposits made favor Guayaquil &amp; Quito
                    Railway Co. Total amount 79,000 sucres; no remittances to London.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hartman</hi>
                    </signed>
                </closer>
            </div>
