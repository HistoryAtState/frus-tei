            <div xml:id="d432">

                <pb facs="0528" n="416" sameAs="frus:frus1918/pg416"/>

                <note rend="inline" type="source">File No. 422.11G93/962</note>
                <head>
                    <hi rendition="#italic">The Minister in Ecuador</hi> (<hi
                            rendition="#italic">Hartman</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Quito</hi></placeName>, <date
                            calendar="gregorian" when="1918-07-12T08:00:00-05:14">
                            <hi rendition="#italic">July 12, 1918, 8 a.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Department’s July 9, 6 p.m. Yesterday noon I fully complied with Department’s
                    instruction, but have not received any answer. Will report by telegraph when
                    received.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hartman</hi>
                    </signed>
                </closer>
            </div>
        </body>
