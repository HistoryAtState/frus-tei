    <text>
        <body>
            <div xml:id="d707">

                <pb facs="0935" n="823" sameAs="frus:frus1918/pg823"/>

                <note rend="inline" type="source">File No. 817.51/978</note>
                <head>
                    <hi rendition="#italic">The Minister in Nicaragua</hi> (<hi rendition="#italic"
                        >Jefferson</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 383</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Managua</hi></placeName>, <date
                            calendar="gregorian" when="1917-06-19">
                            <hi rendition="#italic">June 19, 1917</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: For the information of the Department I
                    have the honor to transmit herewith the first interim report of the Commission
                    on Public Credit, as prepared by Mr. A. F. Lindberg, Commissioner. That the
                    Department may be kept fully advised as to the work accomplished by the
                    commission I have requested Mr. Lindberg to prepare from time to time such
                    reports.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Benjamin L. Jefferson</hi>
                    </signed>
                </closer>


                <xi:include href="d707-a1.xml" xpointer="d707-a1"/>
            </div>
        </body>
    </text>
