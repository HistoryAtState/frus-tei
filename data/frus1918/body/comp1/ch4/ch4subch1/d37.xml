    <text>
        <body>
            <div xml:id="d37">

                <pb facs="0146" n="34" sameAs="frus:frus1918/pg34"/>

                <note rend="inline" type="source">File No. 715.1715/66</note>
                <head>
                    <hi rendition="#italic">The Minister in Nicaragua</hi> (<hi rendition="#italic"
                        >Jefferson</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Managua</hi></placeName>, <date
                            calendar="gregorian" when="1918-09-11T15:00:00-05:45">
                            <hi rendition="#italic">September 11, 1918, 3 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Nicaraguan Minister at Washington has been appointed Nicaraguan representative in
                    Nicaraguan-Honduran boundary question, and Adolfo Cardenas of Managua will be
                    sent in the capacity of engineer and secretary.</p>
                <p>Copy sent to American Legation Tegucigalpa.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Jefferson</hi>
                    </signed>
                </closer>
            </div>
        </body>
