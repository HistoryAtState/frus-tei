    <text>
        <body>
            <div xml:id="d36">

                <pb facs="0146" n="34" sameAs="frus:frus1918/pg34"/>

                <note rend="inline" type="source">File No. 715.1715/62</note>
                <head>
                    <hi rendition="#italic">The Chargé in Honduras</hi> (<hi
                            rendition="#italic">Curtis</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tegucigalpa</hi></placeName>, <date
                            calendar="gregorian" when="1918-09-02T17:00:00-05:48">
                            <hi rendition="#italic">September 2, 1918, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your August 28, 6 p.m. The Honduran representative will be Bonilla, Honduran
                    envoy extraordinary and minister plenipotentiary on special mission now in the
                    United States. Documents, etc., will probably be sent by next mail.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Curtis</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
