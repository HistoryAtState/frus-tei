                <note rend="inline" type="source">File No. 711.0021/131a</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Spain</hi> (<hi rendition="#italic">Willard</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-12-27">
                            <hi rendition="#italic">December 27, 1918</hi></date>.</dateline>
                </opener>
                <p>1930. Department’s 765, April 4 last.<anchor n="1" xml:id="d9-f1"/> Report date
                    inserted ii note transmitted to Foreign Office pursuant to instruction.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
