    <text>
        <body>
            <div xml:id="d453">

                <pb facs="0540" n="428" sameAs="frus:frus1918/pg428"/>

                <note rend="inline" type="source">File No. 711.5112/63a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        French Ambassador</hi> (<hi rendition="#italic"
                            >Jusserand</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-02-21">
                            <hi rendition="#italic">February 21, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Ambassador</hi>: It having been finally
                    determined to extend the arbitration convention of February 10, 1908, for a
                    further period of five years instead of indefinitely, I beg to enclose herewith
                    a new draft<anchor n="2" xml:id="d453-f1"/> in English of the proposed agreement
                    and to request that if you find it satisfactory you will kindly supply me with
                    the French equivalent.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d453-f1" n="2" xml:id="d453-f1-content">
                <p>Draft not printed.</p>
            </note>
