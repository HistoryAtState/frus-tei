    <text>
        <body>
            <div xml:id="d452">

                <pb facs="0540" n="428" sameAs="frus:frus1918/pg428"/>

                <note rend="inline" type="source">File No. 711.5112/64a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the French Ambassador</hi>
                        (<hi rendition="#italic">Jusserand</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-02-13">
                            <hi rendition="#italic">February 13, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Ambassador</hi>: I enclose herewith a
                        draft<anchor n="2" xml:id="d452-f1"/> of an agreement extending indefinitely
                    the arbitration convention of February 10, 1908, between the United States and
                    France.</p>
                <p>If you find the draft acceptable and will kindly furnish me with the French
                    equivalent of the English text, I shall be glad to have the agreement at once
                    prepared for signature and to fix the time for its signature.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d452-f1" n="2" xml:id="d452-f1-content">
                <p>Draft not printed.</p>
            </note>
