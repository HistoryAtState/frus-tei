    <text>
        <body>
            <div xml:id="toc">

                <pb facs="0009" n="V" xml:id="pgV"/>

                <head>Contents</head>
                <list type="toc">
                    <item>
                        <ref target="#pgIII">
                            <hi rendition="#small-caps">Preface</hi>
                        </ref>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Belgium</hi>: <list>
                            <item>
                                <ref target="#pg1">Belgian and British protests regarding change
                                    from Belgian to Panamanian registry of tankers which had been
                                    operated by Belgian subsidiary of an American oil company</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Czechoslovakia</hi>: <list>
                            <item>
                                <ref target="#pg21">Recognition by the United States of the
                                    Provisional Czechoslovak Government at London</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Denmark</hi>: <list>
                            <item>
                                <ref target="#pg35">Agreement for defense of Greenland signed with
                                    Danish Minister; refusal by United States to recognize actions
                                    of Danish Government deemed to be under German duress</ref>
                            </item>
                            <item>
                                <ref target="#pg73">Seizure and requisition by the United States of
                                    Danish ships lying in American ports</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Finland</hi>: <list>
                            <item>
                                <ref target="#pg88">Relations between Finland and the Soviet Union,
                                    and the attempts of the United States to persuade Finland not to
                                    participate in the war against the Soviet Union in association
                                    with Germany</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">France</hi>: <list>
                            <item>
                                <ref target="#pg89">Concern of the United States over Franco-German
                                    collaboration and the matter of furnishing food and medical
                                    relief to unoccupied France</ref>
                            </item>
                            <item>Interest of the United States in political and economic conditions
                                in French North Africa: <list>
                                    <item>
                                        <ref target="#pg206">I. Negotiations leading to signature
                                            and approval of the Murphy–Weygand Agreement, February
                                            26, 1941</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg241">II. Negotiations with the British
                                            regarding American economic aid to French North
                                            Africa</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg269">III. Decision to proceed with economic
                                            aid program after delay because of fears regarding
                                            German infiltration into French North Africa</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg309">IV. American observers in French North
                                            Africa to supervise and control the economic aid
                                            program</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg321">V. Suspension of economic aid program
                                            for French North Africa in May, 1941; resumption of
                                            program in June</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg377">VI. Continuation of economic aid
                                            program for French North Africa, June–November,
                                            1941</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg455">VII. Suspension and reconsideration of
                                            the economic aid program for French North Africa
                                            following removal of General Weygand</ref>
                                    </item>
                                </list>
                            </item>
                            <item>
                                <ref target="#pg503">Persecution of Jews in France by German
                                    occupation and Vichy Governments; representations by the United
                                    States on behalf of American Jews</ref>
                            </item>
                            <item>
                                <ref target="#pg512">United States concern with regard to
                                    restrictions on official communications between Paris and Vichy;
                                    withdrawal of American diplomatic mission in Paris</ref>
                            </item>
                            <pb facs="0010" n="VI" xml:id="pgVI"/>
                            <item>
                                <ref target="#pg526">Surveillance by the United States over French
                                    ships in American harbors; requisition of these ships upon entry
                                    of the United States into the war</ref>
                            </item>
                            <item>
                                <ref target="#pg540">Concern of the United States over the control
                                    of the wireless radio station at St. Pierre and the seizure of
                                    St. Pierre and Miquelon by the Free French forces</ref>
                            </item>
                            <item>
                                <ref target="#pg570">Protests by the French Government regarding
                                    lend-lease aid to Free French in Equatorial Africa and sending
                                    there of American military and naval observers</ref>
                            </item>
                            <item>
                                <ref target="#pg587">Requests by France for intervention by the
                                    United States regarding British blockade of French
                                    Somaliland</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Germany</hi>: <list>
                            <item>
                                <ref target="#pg597">Representations to the German Government in
                                    behalf of American citizens arrested on suspicion of
                                    espionage</ref>
                            </item>
                            <item>
                                <ref target="#pg620">Representations to the German Government with
                                    respect to its treatment of American motion picture interests in
                                    Germany and in German-occupied areas</ref>
                            </item>
                            <item>
                                <ref target="#pg628">Closing of German consular and other offices in
                                    the United States and of similar American offices in Germany and
                                    German-occupied countries.</ref>
                            </item>
                            <item>
                                <ref target="#pg634">Representations by the German Government
                                    regarding Americans pulling down the German flag from the Consul
                                    General’s offices in San Francisco</ref>
                            </item>
                            <item>
                                <ref target="#pg634">American claims against Germany in the case of
                                    the sinking of the American ship <hi rendition="#italic">Robin
                                        Moor</hi> by a German submarine</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Greece</hi>: <list>
                            <item>The Axis war against Greece: <list>
                                    <item>
                                        <ref target="#pg635">I. Military stalemate between Italy and
                                            Greece; German pressure on Greece; British decision to
                                            send military aid to Greece</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg669">II. Consideration by the United States
                                            of ways and means of providing material aid to
                                            Greece</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg714">III. German invasion of Greece</ref>
                                    </item>
                                    <item>
                                        <ref target="#pg733">IV. German-Italian-Bulgarian
                                            occupation; protection of American interests; withdrawal
                                            of American representatives from occupied Greece</ref>
                                    </item>
                                </list>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Iceland</hi>: <list>
                            <item>
                                <ref target="#pg755">Negotiations between the United States, the
                                    United Kingdom, and Iceland regarding Icelandic trade;
                                    Lend-Lease Agreement between the United States and Iceland</ref>
                            </item>
                            <item>
                                <ref target="#pg776">Agreement with the Icelandic Government for
                                    sending of American troops to assume protection of Iceland</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Italy</hi>: <list>
                            <item>
                                <ref target="#pg793">Closing of Italian consular and other offices
                                    in the United States and of similar American offices in
                                    Italy</ref>
                            </item>
                            <item>
                                <ref target="#pg802">Request by the United States for the recall of
                                    the Italian Naval Attaché in Washington; similar action by Italy
                                    regarding the American Assistant Military and Air Attaché in
                                    Rome</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Netherlands</hi>: <list>
                            <item>
                                <ref target="#pg808">Lend-Lease Agreement between the United States
                                    and the Netherlands, signed August 9, 1941</ref>
                            </item>
                            <item>
                                <ref target="#pg811">Arrangements for sending American forces to
                                    Surinam to assist in protection of bauxite mines</ref>
                            </item>
                        </list>
                    </item>
                    <pb facs="0011" n="VII" xml:id="pgVII"/>
                    <item>
                        <hi rendition="#small-caps">Poland</hi>: <list>
                            <item>
                                <ref target="#pg835">Interest of the United States in the Polish
                                    Government in Exile, and its relations with the Soviet Union,
                                    1939–1941</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Portugal</hi>: <list>
                            <item>
                                <ref target="#pg836">Concern of the United States over the fate of
                                    Portugal and her island possessions in the event of an attack by
                                    Germany</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Rumania</hi>: <list>
                            <item>
                                <ref target="#pg860">Persecution of Jews in Rumania</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Spain</hi>: <list>
                            <item>
                                <ref target="#pg880">Concern of the United States over the
                                    maintenance of neutrality by Spain</ref>
                            </item>
                            <item>
                                <ref target="#pg936">
                                    <hi rendition="#small-caps">Union of Soviet Socialist
                                        Republics</hi>
                                </ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <hi rendition="#small-caps">Yugoslavia</hi>: <list>
                            <item>
                                <ref target="#pg937">Efforts of the United States to encourage
                                    Yugoslav resistance to Nazi aggression; invasion of Yugoslavia
                                    by Germany</ref>
                            </item>
                        </list>
                    </item>
                    <item>
                        <ref target="#pg987">
                            <hi rendition="#small-caps">Index</hi>
                        </ref>
                    </item>
                </list>
            </div>
        </body>
    </text>
</TEI>
