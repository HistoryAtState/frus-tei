                <pb facs="0596" n="584" xml:id="pg584"/>

                <note rend="inline" type="source">740.00118 European War 1939/867b: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Consul at Leopoldville</hi> (<hi rendition="#italic"
                            >Mallon</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1941-12-13T21:00:00-05:00">December 13,
                            1941—9 p.m.</date>
                    </dateline>
                </opener>
                <p>“From General Miles for Cunningham. Your telegram December 12 received. Return to
                    Washington by first available transportation. You are not authorized to make any
                    suggestions of military or diplomatic moves to any foreign representatives.”</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
