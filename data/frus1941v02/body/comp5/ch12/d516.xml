    <text>
        <body>
            <div xml:id="d516">

                <pb facs="0592" n="580" xml:id="pg580"/>

                <note rend="inline" type="source">740.0011 European War 1939/15742: Telegram</note>
                <head>
                    <hi rendition="#italic">The Consul at Leopoldville</hi> (<hi rendition="#italic"
                        >Mallon</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Leopoldville</hi></placeName>, <date
                            calendar="gregorian" when="1941-10-08T00:00:00+01:00">October 8,
                            1941—midnight</date>.<lb/>[Received October 10—9:48 a.m.]</dateline>
                </opener>
                <p rendition="#center">. . . . . . . . . . . . . .</p>
                <p>For Miles<anchor n="51" xml:id="d516-f1"/> from Cunningham.</p>
                <p>“Cable from General de Gaulle asks that President be informed of his deferential
                    gratitude for having sent a mission to Free France as well as his deep
                    thankfulness for the great things America has already done and the greater
                    things America will do for the sake of liberty. Full text will follow by pouch.
                    Will send one more cable before leaving on extended reconnaissance of entire
                    territory by all available means.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Mallon</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d516-f1" n="51" xml:id="d516-f1-content">
                <p>Brig. Gen. Sherman Miles, Assistant Chief of Staff, G–2 (Military
                    Intelligence).</p>
            </note>
        </listAnnotation>
    </standOff>
