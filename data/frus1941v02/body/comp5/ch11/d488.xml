    <text>
        <body>
            <div xml:id="d488">

                <pb facs="0564" n="552" sameAs="frus:frus1941v02/pg552"/>

                <note rend="inline" type="source">851A.01/13: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in the United Kingdom</hi> (<hi
                        rendition="#italic">Winant</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1941-12-25">December 25,
                        1941</date>.<lb/>[Received December 25—4:47 p.m.]</dateline>
                </opener>
                <p>6221. Your 6021<anchor n="17" xml:id="d488-f1"/> just received and has been
                    brought to the attention of the Foreign Office. I am informed that the action
                    taken was against the instructions and orders of the British Government.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Winant</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
