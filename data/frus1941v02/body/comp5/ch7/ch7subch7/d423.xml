    <text>
        <body>
            <div xml:id="d423">

                <pb facs="0506" n="494" sameAs="frus:frus1941v02/pg494"/>

                <note rend="inline" type="source">740.0011 European War 1939/20095</note>
                <head>
                    <hi rendition="#italic">The Counselor of Embassy in France</hi> (<hi rendition="#italic">Murphy</hi>), <hi
                        rendition="#italic">Temporarily at Algiers, to the Under Secretary of
                        State</hi> (<hi rendition="#italic"
                        >Welles</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Algiers</hi></placeName>, <date
                            calendar="gregorian" when="1941-12-07">December 7,
                        1941</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Secretary</hi>: I enclose as of possible
                    interest and to show the trend of thought of many representative Frenchmen who
                    are interested in French Africa, a memorandum of a conversation with M. J.
                    Lemaigre-Dubreuil, owner of <hi rendition="#italic">Le Jour</hi> and a prominent
                    French business man having important interests in French West Africa.</p>
                <p>Faithfully yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert</hi> D. <hi rendition="#small-caps"
                            >Murphy</hi>
                    </signed>
                </closer>


                <xi:include href="d423-a1.xml" xpointer="d423-a1"/>
            </div>
        </body>
    </text>
