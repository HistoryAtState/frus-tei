            </note>
            <note corresp="#d209-f2" n="82" xml:id="d209-f2-content">
                <p>Léon Marchal, Director of Commerce and Industry, French Zone of Morocco.</p>
            </note>
            <note corresp="#d209-f3" n="83" xml:id="d209-f3-content">
                <p>Gen. Albert Noguès, Resident General in the French Zone of Morocco.</p>
            </note>
        </listAnnotation>
