            <div xml:id="d235">

                <pb facs="0299" n="287" sameAs="frus:frus1941v02/pg287"/>

                <note rend="inline" type="source">740.0011 European War 1939/9873: Telegram</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Consul at Tunis</hi> (<hi
                        rendition="#italic">Heisler</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1941-04-16T14:00:00-05:00">April 16, 1941—2
                            p.m.</date>
                    </dateline>
                </opener>
                <p>21. Your 42, April 10, 7 p.m. Department would be interested in any further
                    information you may be able discreetly to obtain regarding extent to which
                    supplies are reaching Libya from Tunisia or through Tunisian territorial
                    waters.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hull</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
