    <text>
        <body>
            <div xml:id="d163">

                <pb facs="0215" n="203" sameAs="frus:frus1941v02/pg203"/>

                <note rend="inline" type="source">740.0011 European War 1939/17698: Telegram</note>
                <head>
                    <hi rendition="#italic">The Ambassador in France</hi> (<hi rendition="#italic"
                        >Leahy</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Vichy</hi></placeName>, <date
                            calendar="gregorian" when="1941-12-19">December 19,
                        1941</date>.<lb/>[Received December 19—7 p.m.]</dateline>
                </opener>
                <p>1571. Embassy’s 1530, 12th.<anchor n="8" xml:id="d163-f1"/> In note dated
                    December 17 Foreign Office acknowledges Embassy’s communication notifying French
                    Government that a state of war exists between the United States and Germany and
                    states that it is “the decision of the French Government to maintain in the
                    course of this conflict an attitude of neutrality.”</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Leahy</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d163-f1" n="8" xml:id="d163-f1-content">
                <p>Not printed; this telegram reported that notes containing declarations of war by
                    the United States against Germany and Italy were delivered at 5 p.m., December
                    12 (740.0011 European War 1939/17451).</p>
            </note>
        </listAnnotation>
    </standOff>
