    <text>
        <body>
            <div xml:id="d748">

                <pb facs="0767" n="755" sameAs="frus:frus1941v02/pg755"/>

                <note rend="inline" type="source">611.59A31/8</note>
                <head>
                    <hi rendition="#italic">The Icelandic Consul General at New York City</hi>
                        (<hi rendition="#italic">Thors</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">New York City</hi></placeName>, <date
                            calendar="gregorian" when="1941-07-14">July 14,
                        1941</date>.<lb/>[Received July 15.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that I have
                    received a message from my Government that they consider it necessary that a
                    delegation be sent from the United States Government to Iceland to discuss trade
                    and commercial relations between Iceland and the United States with the
                    Icelandic Government.</p>
                <p>I should appreciate learning at the earliest possible opportunity what would be
                    the opinion of the United States Government concerning this matter.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Thor Thors</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
