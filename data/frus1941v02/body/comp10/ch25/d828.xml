            <div xml:id="d828">

                <pb facs="0844" n="832" sameAs="frus:frus1941v02/pg832"/>

                <note rend="inline" type="source">856A.20/20: Telegram</note>
                <head>
                    <hi rendition="#italic">The Vice Consul at Paramaribo</hi> (<hi
                        rendition="#italic">Norden</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Paramaribo</hi></placeName>, <date
                            calendar="gregorian" when="1941-11-25T18:00:00-03:40">November 25,
                            1941—6 p.m.</date>
                        <lb/> [Received November 26—8:25 a.m.]</dateline>
                </opener>
                <p>Colonel Parkinson and staff arrived at Zanderij 1:50 afternoon today Washington
                    time.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Norden</hi>
                    </signed>
                </closer>
            </div>
        </body>
