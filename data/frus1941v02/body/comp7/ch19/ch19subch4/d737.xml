    <text>
        <body>
            <div xml:id="d737">

                <pb facs="0745" n="733" sameAs="frus:frus1941v02/pg733"/>

                <note rend="inline" type="source">740.0011 European War 1939/10467: Telegram</note>
                <head>
                    <hi rendition="#italic">The Chargé in Germany</hi> (<hi
                            rendition="#italic">Morris</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berlin</hi></placeName>, <date
                            calendar="gregorian" when="1941-04-30">April 30,
                        1941</date>.<lb/>[Received April 30—11:48 a.m.]</dateline>
                </opener>
                <p>1660. Following is translation of German text of telegram to Department from
                        MacVeagh<anchor n="19a" xml:id="d737-f1"/> transmitted orally by Foreign
                    Office: <pb facs="0746" n="734" xml:id="pg734"/>
                    <quote rend="blockquote">
                        <p>“298, April 29. All Americans in Athens are safe. Occupation of city
                            carried out in orderly and peaceful manner. German Legation very helpful
                            in assuring respect for property.”</p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Morris</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d737-f1" n="19a" xml:id="d737-f1-content">
                <p>Lincoln MacVeagh, American Minister in Greece.</p>
            </note>
        </listAnnotation>
    </standOff>
