    <text>
        <body>
            <div xml:id="d677">

                <pb facs="0710" n="698" sameAs="frus:frus1941v02/pg698"/>

                <note rend="inline" type="source">868.24/125</note>
                <head>
                    <hi rendition="#italic">The Greek Minister</hi> (<hi rendition="#italic"
                        >Diamantopoulos</hi>) <hi rendition="#italic">to the Under Secretary of
                        State</hi> (<hi rendition="#italic">Welles</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>,] <date calendar="gregorian"
                            when="1941-02-27">February 27, 1941</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: In connection with the
                    matter we discussed in our last conversation, I beg to enclose herewith a short
                    notice outlining the point for which I should appreciate your kind
                    assistance.</p>
                <p>I venture to draw your attention to the matter and leave it to Your Excellency to
                    develop it as you think advisable.</p>
                <p>I am, my dear Mr. Secretary,</p>
                <p>Sincerely yours,</p>
                <closer>
                    <signed>C. <hi rendition="#small-caps">Diamantopoulos</hi>
                    </signed>
                </closer>


                <xi:include href="d677-a1.xml" xpointer="d677-a1"/>
            </div>
        </body>
    </text>
