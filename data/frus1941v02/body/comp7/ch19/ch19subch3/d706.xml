            <div xml:id="d706">

                <pb facs="0730" n="718" sameAs="frus:frus1941v02/pg718"/>

                <note rend="inline" type="source">740.0011 European War 1939/9958: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Bulgaria</hi> (<hi
                            rendition="#italic">Earle</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Sofia</hi></placeName>, <date
                            calendar="gregorian" when="1941-04-14T23:00:00+02:00">April 14, 1941—11
                            p.m.</date>
                        <lb/> [Received April 15—2:40 a.m.]</dateline>
                </opener>
                <p>188. Heavy movement of Bulgarian troops by night through Sofia may mean
                    occupation of Thrace and Macedonia.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Earle</hi>
                    </signed>
                </closer>
            </div>
        </body>
