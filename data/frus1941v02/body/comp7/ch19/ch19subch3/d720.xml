    <text>
        <body>
            <div xml:id="d720">

                <pb facs="0737" n="725" sameAs="frus:frus1941v02/pg725"/>

                <note rend="inline" type="source">740.0011 European War 1939/10353</note>
                <head>
                    <hi rendition="#italic">The Greek Minister</hi> (<hi
                            rendition="#italic">Diamantopoulos</hi>) <hi
                        rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1167</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1941-04-25">April 25, 1941</date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: According to my instructions, I
                    have the honor to inform you that the Royal Greek Government has been
                    established at Canea, Crete.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>C. <hi rendition="#small-caps">Diamantopoulos</hi>
                    </signed>
                </closer>
            </div>
        </body>
