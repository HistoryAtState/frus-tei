    <text>
        <body>
            <div xml:id="d732">

                <pb facs="0742" n="730" sameAs="frus:frus1941v02/pg730"/>

                <note rend="inline" type="source">740.0011 European War 1939/11497: Telegram</note>
                <head>
                    <hi rendition="#italic">The Minister in Egypt</hi> (<hi rendition="#italic"
                        >Kirk</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Cairo</hi></placeName>, <date
                            calendar="gregorian" when="1941-05-30T19:00:00+03:00">May 30, 1941—7
                            p.m.</date>
                        <lb/> [Received June 1—7:12 a.m.]</dateline>
                </opener>
                <p>622. My 621, May 30, 6 p.m.<anchor n="16" xml:id="d732-f1"/> From the Military
                    Attaché to M. I. D. The fact that the evacuation of Crete is actually in
                    progress although known in limited circles in Cairo has not yet attained any
                    degree of publicity here.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Kirk</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
