            </note>
            <note corresp="#d384-f2" n="2" xml:id="d384-f2-content">
                <p>Huynh Van Diem, Director General of Planning.</p>
            </note>
            <note corresp="#d384-f3" n="3" xml:id="d384-f3-content">
