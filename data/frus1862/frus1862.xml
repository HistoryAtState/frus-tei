        <front>
            <pb facs="0007" n="[1]" xml:id="pg-seq-7"/>
            <p rendition="#center"><hi rendition="#small-caps">37th Congress</hi>, 3<hi
                    rendition="#italic">d Session</hi>.</p>
            <p rendition="#center">HOUSE OF REPRESENTATIVES.</p>
            <p rendition="#center">Ex. Doc. No. 1.</p>
            <titlePage type="main">
                <docTitle>
                    <titlePart type="series">MESSAGE OF THE PRESIDENT OF THE UNITED STATES TO THE
                        TWO HOUSES OF CONGRESS AT THE COMMENCEMENT OF THE THIRD SESSION OF THE
                        THIRTY-SEVENTH CONGRESS.</titlePart>
                    <titlePart type="subseries">VOLUME 1.</titlePart>
                </docTitle>
                <docImprint><hi rendition="#small-caps">December</hi> 1, 1862.—Read, and ordered
                    that the usual number of the message and documents be printed.</docImprint>
                <docImprint>WASHINGTON: GOVERNMENT PRINTING OFFICE.</docImprint>
            </titlePage>
            <pb facs="0008" n="[2]" xml:id="pg-seq-8"/>
