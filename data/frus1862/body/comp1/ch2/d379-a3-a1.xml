    <text>
        <body>
            <div xml:id="d379-a3-a1">

                <pb facs="0510" n="440" xml:id="pg440"/>

                <opener><seg rendition="#center">[Translation.]</seg></opener>
                <head><hi rendition="#italic">Document A.</hi></head>
                <table cols="2">
                    <row role="label">
                        <cell>One stallion, of pure blood, named Black Eagle</cell>
                        <cell role="num">$1,500</cell>
                    </row>
                    <row>
                        <cell>Two mares, of pure blood</cell>
                        <cell role="num">1,600</cell>
                    </row>
                    <row>
                        <cell>One carriage horse</cell>
                        <cell role="num">500</cell>
                    </row>
                    <row>
                        <cell>Four young horses, of pure blood</cell>
                        <cell role="num">1,200</cell>
                    </row>
                    <row>
                        <cell>Twenty work mules, at $225</cell>
                        <cell role="num">4,500</cell>
                    </row>
                    <row>
                        <cell>Twenty-five Merino sheep</cell>
                        <cell role="num">300</cell>
                    </row>
                    <row>
                        <cell>
                            <table>
                                <row role="label">
                                    <cell>Fourteen cows, of pure blood,</cell>
                                    <cell role="brace" rows="3">}</cell>
                                </row>
                                <row>
                                    <cell>One bull,</cell>
                                </row>
                                <row>
                                    <cell>Sixteen heifers and calves, </cell>
                                </row>
                            </table>
                        </cell>
                        <cell rendition="#middle" role="num">3,000</cell>
                    </row>
                    <row>
                        <cell>Saddles, bridles, and harness</cell>
                        <cell role="num">200</cell>
                    </row>
                    <row>
                        <cell/>
                        <cell role="num">12,800</cell>
                    </row>
                </table>
                <p>Twelve thousand eight hundred dollars.</p>
            </div>
        </body>
    </text>
