    <text>
        <body>
            <div xml:id="d316">

                <pb facs="0453" n="383" sameAs="frus:frus1862/pg383"/>

                <head>Mr. Seward to Mr.
                        Dayton.</head>
                <opener>
                    <seg rendition="#float-left">No. 224.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1862-09-24"><hi rendition="#italic"
                                >September</hi> 24, 1862.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch of September 12, No. 194, has
                    been received, and your proceedings in making the explanations, therein recited,
                    to Mr. Thouvenel are approved by the President.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">William L. Dayton</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
