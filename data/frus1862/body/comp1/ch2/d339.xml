    <text>
        <body>
            <div xml:id="d339">

                <pb facs="0471" n="401" sameAs="frus:frus1862/pg401"/>

                <head>Mr. Seward to Mr. Dayton.</head>
                <opener>
                    <seg rendition="#float-left">No. 240.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1862-10-21"><hi rendition="#italic"
                                >October</hi> 21, 1862.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I enclose herewith, for your information, a
                    copy of my despatch No. 382, of this date, to Mr. Adams, relative to military
                    events.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">William L. Dayton</hi>, Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                    <p>[The above-mentioned enclosure will be found in the correspondence with Mr.
                        Adams.]</p>
                </postscript>
            </div>
        </body>
    </text>
