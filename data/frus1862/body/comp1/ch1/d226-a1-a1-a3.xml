    <text>
        <body>
            <div xml:id="d226-a1-a1-a3">

                <pb facs="0348" n="278" sameAs="frus:frus1862/pg278"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <seg rendition="#float-left">No. 3.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>27 <hi rendition="#small-caps">Leadenhall Street,
                            London,</hi></placeName>
                        <date calendar="gregorian" when="1862-04-08"><hi rendition="#italic"
                                >April</hi> 8, 1862.</date></dateline></opener>
                <p><hi rendition="#small-caps">Dear Sir:</hi> I acknowledge to have received bills
                    of lading from you to a port in the Confederate States, which I undertake to get
                    insured and returned to you, leaving one copy on board with your brother.</p>
                <p>Yours, faithfully,</p>
                <closer>
                    <signed>A. T. CLARK.</signed></closer>
                <postscript>
                    <p>Mr. F. <hi rendition="#small-caps">North.</hi></p>
                </postscript>
            </div>
        </body>
