    <text>
        <body>
            <div xml:id="d226-a1-a1-a1">

                <pb facs="0347" n="277" sameAs="frus:frus1862/pg277"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <seg rendition="#float-left">No. 1.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>30 <hi rendition="#small-caps">Great Winchester
                            Street,</hi></placeName>
                        <date calendar="gregorian" when="1862-03-21"><hi rendition="#italic"
                                >March</hi> 21, 1862.</date></dateline></opener>
                <p><hi rendition="#small-caps">Gentlemen:</hi> I will take your freight—say 290
                    tons, the whole not to weigh more than 130 tons, more or less—at the rate of
                    £13, with customary primage. To deliver the same cargo, with all possible
                    despatch, at Charleston or some other confederate port.</p>
                <p>Yours, obediently,</p>
                <p rendition="#right">JO. LAWSON.</p>
                <p>Messrs. <hi rendition="#small-caps">Jorss &amp; North,</hi>
                    <hi rendition="#italic">Leeds.</hi></p>
                <p>Supercargo to be furnished with a first class passage, free of charge.</p>
                <closer>
                    <signed>J. L.</signed></closer>
                <postscript>
                    <p>P. S.—Payment of freight and insurance to be paid by bill of four months
                        drawn on Jorss &amp; Worth.</p>
                    <p rendition="#right">J. L.</p>
                </postscript>
            </div>
        </body>
    </text>
