    <text>
        <body>
            <div xml:id="d229">

                <pb facs="0354" n="284" sameAs="frus:frus1862/pg284"/>

                <head>Mr. F. W. Seward to Mr. Stuart.</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1862-09-01"><hi rendition="#italic"
                                >September</hi> 1, 1862.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have the honor to acknowledge the receipt
                    of your note of the 30th ultimo, enclosing a copy of Earl Russell’s despatch to
                    you of the 28th of July last, which you read to the Secretary of State on the
                    16th of last month, and to be, with high consideration, sir, your obedient
                    servant,</p>
                <closer>
                    <signed>F. W. SEWARD, <hi rendition="#italic">Acting
                    Secretary.</hi></signed></closer>
                <postscript>
                    <p>Hon. <hi rendition="#small-caps">Wm. Stuart,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
