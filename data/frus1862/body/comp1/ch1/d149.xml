    <text>
        <body>
            <div xml:id="d149">

                <pb facs="0267" n="197" sameAs="frus:frus1862/pg197"/>

                <head>Mr. Seward to Mr.
                        Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 356.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1862-09-23"><hi rendition="#italic"
                                >September</hi> 23, 1862.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> Your despatch No. 219, of the 5th instant,
                    with the papers which accompanied it in relation to the case of the steamer
                    Oreto, has been received and communicated to the Secretary of the Navy.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">Charles Francis Adams,</hi> Esq., <hi
                            rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
