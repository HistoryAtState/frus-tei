    <text>
        <body>
            <div xml:id="d165">

                <pb facs="0284" n="214" sameAs="frus:frus1862/pg214"/>

                <head>Mr. Seward to Mr.
                        Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 374.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1862-10-20"><hi rendition="#italic"
                                >October</hi> 20, 1862.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> With reference to the operations of the
                    insurgent steamer 290, an extract from a letter of Mr. Dabney, United States
                    consul at Teneriffe, to Mr. Perry, charge d’affaires at Madrid, is herewith
                    appended.</p>
                <p>I am your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p>C. F. <hi rendition="#small-caps">Adams,</hi> Esq., <hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>


                <xi:include href="d165-a1.xml" xpointer="d165-a1"/>
            </div>
        </body>
    </text>
