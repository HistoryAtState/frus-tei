    <text>
        <body>
            <div xml:id="d63">

                <pb facs="0158" n="88" sameAs="frus:frus1862/pg88"/>

                <head>Mr. Seward to Mr.
                        Adams.</head>
                <opener>
                    <seg rendition="#float-left">No. 250]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1862-05-12"><hi rendition="#italic"
                                >May</hi> 12, 1862.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I enclose a copy of a proclamation of the
                    President, of this date, opening certain ports which have recently been
                    blockaded. The treasury regulations to which it refers have not beeen received,
                    but will immediately follow.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">C. F. Adams,</hi>
                        <hi rendition="#italic">&amp;c., &amp;c., &amp;c.</hi></p>
                    <p rendition="#center">[Same to Mr. Dayton.]</p>
                </postscript>



                <xi:include href="d63-a1.xml" xpointer="d63-a1"/>
            </div>
        </body>
    </text>
