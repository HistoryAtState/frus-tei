    <text>
        <body>
            <div xml:id="d226-a1-a1-a2">

                <pb facs="0348" n="278" xml:id="pg278"/>

                <head ana="#head_untitled-missing-head-in-printed-volume">[Untitled]</head>
                <opener>
                    <seg rendition="#float-left">No. 2.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>27 <hi rendition="#small-caps">Leadenhall Street,
                            London,</hi></placeName>
                        <date calendar="gregorian" when="1862-03-21"><hi rendition="#italic"
                                >March</hi> 21, 1862.</date></dateline></opener>
                <p><hi rendition="#small-caps">Gentlemen</hi>: In consideration of your undertaking
                    to ship by my vessel (the Pacific) 250 tons or more of freight by Tuesday next,
                    if possible, the 25th instant, I hereby agree to effect insurance to the extent
                    of £25,000, and more, if possible, at the best current rate at Lloyd’s.</p>
                <p>I am, gentlemen, yours, faithfully,</p>
                <p rendition="#right">A. T. CLARK.</p>
                <p>Messrs. <hi rendition="#small-caps">Jorss &amp; North,</hi>
                    <hi rendition="#italic">Leeds.</hi></p>
                <p>Underwriter’s name shall be such as may be satisfactory to insured.</p>
                <closer>
                    <signed>A. T. C.</signed></closer>
            </div>
        </body>
    </text>
