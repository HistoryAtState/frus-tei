    <text>
        <body>
            <div xml:id="d690-a1">

                <pb facs="0940" n="870" sameAs="frus:frus1862/pg870"/>

                <head>[Telegram.]</head>
                <opener><seg rendition="#float-left">No. 1.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Madrid,</hi></placeName>
                        <date calendar="gregorian" when="1862-02-26"><hi rendition="#italic"
                                >February</hi> 26, 1862.</date></dateline></opener>
                <p>Pray take the Tangier prisoners in custody aboard your ship if it can be done
                    without losing sight of the Sumter.</p>
                <closer>
                    <signed>HORATIO J. PERRY, <hi rendition="#italic">Charge d’
                        Affaires.</hi></signed></closer>
                <postscript>
                    <p>Captain <hi rendition="#small-caps">Craven,</hi>
                        <hi rendition="#italic">Abordo vapor Tuscarora, Algeciras.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
