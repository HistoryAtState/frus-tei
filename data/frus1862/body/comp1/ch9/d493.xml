    <text>
        <body>
            <div xml:id="d493">

                <pb facs="0671" n="601" sameAs="frus:frus1862/pg601"/>

                <head>Mr. Seward to Mr.
                        Pike.</head>
                <opener>
                    <seg rendition="#float-left">No. 50.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1862-04-08"><hi rendition="#italic"
                                >April</hi> 8, 1862.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have read with much pleasure the
                    interesting and encouraging account you give of an improved public opinion
                    concerning our affairs in Europe in your despatch of March 19, (No. 42.)</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD.</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">James S. Pike</hi>, Esq.,<hi rendition="#italic"
                            >&amp;c., &amp;c., &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
