    <text>
        <body>
            <div xml:id="d504">

                <pb facs="0680" n="610" sameAs="frus:frus1862/pg610"/>

                <head>Mr. Seward to Mr.
                        Pike.</head>
                <opener>
                    <seg rendition="#float-left">No. 58.]</seg>
                    <dateline rendition="#float-right">
                        <placeName><hi rendition="#small-caps">Department of State,</hi>
                            <hi rendition="#italic">Washington,</hi></placeName>
                        <date calendar="gregorian" when="1862-06-04"><hi rendition="#italic"
                                >June</hi> 4, 1862.</date></dateline></opener>
                <p><hi rendition="#small-caps">Sir:</hi> I have to acknowledge the receipt of your
                    despatch (No. 49) of the 14th ultimo, and to state that former instructions
                    render reply unnecessary to the refusal of the Dutch government to modify its
                    decree extending shelter to insurgent vessels.</p>
                <p>I am, sir, your obedient servant,</p>
                <closer>
                    <signed>WILLIAM H. SEWARD</signed></closer>
                <postscript>
                    <p><hi rendition="#small-caps">James S. Pike</hi>, Esq., <hi rendition="#italic"
                            >&amp;c, &amp;c, &amp;c.</hi></p>
                </postscript>
            </div>
        </body>
    </text>
