            <div xml:id="d264">

                <pb facs="0629" n="591" sameAs="frus:frus1919Parisv11/pg591"/>

                <note rend="inline" type="source">Paris Peace Conf. 184.1 Morison, Samuel E.</note>
                <head><hi rendition="#italic">The Secretary General of the Commission to Negotiate
                        Peace</hi> (<hi rendition="#italic">Grew</hi>) <hi rendition="#italic">to
                        Mr. S. E. Morison</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1919-06-16">June 16, 1919</date>.</dateline></opener>
                <p><hi rendition="#small-caps">My Dear Dr. Morison</hi>: I beg to acknowledge the
                    receipt of your letter of June 15th and to advise you that the Commissioners
                    have accepted your resignation from the Commission.</p>
                <p>Yours very truly,</p>
                <closer><signed><hi rendition="#small-caps">J. C. Grew</hi></signed></closer>
            </div>
        </body>
