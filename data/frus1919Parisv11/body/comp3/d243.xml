    <text>
        <body>
            <div xml:id="d243">

                <pb facs="0586" n="550" sameAs="frus:frus1919Parisv11/pg550"/>

                <note rend="inline" type="source">Paris Peace Conf. 184/148</note>
                <head><hi rendition="#italic">The Secretary General of the Commission to Negotiate
                        Peace</hi> (<hi rendition="#italic">Grew</hi>) <hi rendition="#italic">to
                        the Acting Secretary of State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1919-04-21">April 21, 1919</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to enclose, for the
                    information of the Department, two copies of a chart showing in detail the
                    organization</p>
                <pb facs="0587" n="[Chart 1]" xml:id="pg-seq-0587-chart-1"/>
                <figure>
                    <graphic url="figure_0587"/>
                </figure>
                <pb facs="0588" n="[]" xml:id="pg-seq-0588"/>
                <pb facs="0589" n="551" xml:id="pg551"/>
                <p rendition="#flush">of the American Commission to Negotiate Peace.<anchor n="39"
                        xml:id="d243-f1"/> These charts are revised to April 1, 1919.</p>
                <p>I have [etc.]</p>
                <closer><signed><hi rendition="#small-caps">J. C. Grew</hi></signed></closer>
            </div>
        </body>
    </text>
