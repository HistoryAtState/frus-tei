                <note rend="inline" type="source">Paris Peace Conf. 184/160</note>
                <head><hi rendition="#italic">Composition and Functions of the American Commission
                        to Negotiate Peace, May 1, 1919</hi></head>
                <dateline>
                    <date ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                        when="1919-05-01">May 1, 1919</date>
                </dateline>
                <p rendition="#center"><hi rendition="#small-caps">Commissioners Plenipotentiary and
                        Personal Staffs</hi></p>
                <p rendition="#flush">Honorable Woodrow Wilson, President of the United States.</p>
                <list>
                    <item><hi rendition="#italic">Aide:</hi> Rear Admiral Cary T. Grayson, U. S.
                        N.</item>
                    <item><hi rendition="#italic">Confidential Secretary:</hi> Mr. Gilbert F.
                        Close.</item>
                </list>
                <p rendition="#flush">Honorable Robert Lansing, Secretary of State of the United
                    States.</p>
                <list>
                    <item><hi rendition="#italic">Assistant:</hi> Mr. A. C. Kirk, Second Secretary
