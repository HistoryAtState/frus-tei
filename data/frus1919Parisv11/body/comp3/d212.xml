    <text>
        <body>
            <div xml:id="d212">

                <pb facs="0545" n="509" sameAs="frus:frus1919Parisv11/pg509"/>

                <note rend="inline" type="source">Paris Peace Conf. 184/111</note>
                <head><hi rendition="#italic">Memorandum by the Administrative Officer of the
                        Commission to Negotiate Peace</hi> (<hi rendition="#italic"
                    >Patterson</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1919-02-19">February 19, 1919</date>.</dateline></opener>
                <p rendition="#flush">Memorandum No. 79</p>
                <p rendition="#flush">Subject: Division of Current Diplomatic and Political
                    Correspondence.</p>
                <p>1. A new section of the Secretariat, the Division of Current Diplomatic and
                    Political Correspondence, has been established, room 415 <pb facs="0546" n="510"
                        xml:id="pg510"/> Hotel Crillon, telephone Crillon 41, Mr. Ellis L. Dresel in
                    charge. The symbol for his office, to be used in the distribution of documents,
                    is S–D.</p>
                <closer><signed><hi rendition="#small-caps">R. C. Patterson,
                        Jr</hi>.</signed><lb/><hi rendition="#italic">Captain, U. S.
                    A.</hi></closer>
                <postscript>
                    <p>Approved:<lb/><hi rendition="#small-caps">J. C. Grew</hi><lb/><hi
                            rendition="#italic">Secretary</hi></p>
                </postscript>
            </div>
        </body>
    </text>
