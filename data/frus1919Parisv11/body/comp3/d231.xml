                <pb facs="0559" n="523" sameAs="frus:frus1919Parisv11/pg523"/>

                <note rend="inline" type="source">Paris Peace Conf. 811.001/208: Telegram</note>
                <head><hi rendition="#italic">President Wilson to the Commission to Negotiate
                        Peace</hi></head>
                <opener><dateline rendition="#float-right"><hi rendition="#small-caps">On Board
                                <placeName>U. S. S. “George Washington</placeName></hi>,” <date
                            calendar="gregorian" when="1919-03-12">March 12,
                        1919</date>.<lb/>[Received 10:20 p.m.]</dateline></opener>
                <p>For Colonel House. Shall probably reach Brest at 8:30 and shall of course take
                    dinner on the boat before going ashore. Regret late arrival but in circumstances
                    of course agree to arrangements suggested.</p>
                <closer><signed><hi rendition="#small-caps">Woodrow Wilson</hi></signed></closer>
            </div>
        </body>
    </text>
