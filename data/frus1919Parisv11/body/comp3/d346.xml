                <pb facs="0689" n="651" sameAs="frus:frus1919Parisv11/pg651"/>

                <note rend="inline" type="source">763.72119P43/715: Telegram</note>
                <head><hi rendition="#italic">Colonel E. M. House to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1919-10-05T11:00:00+01:00">October 5, 1919—11
                        a.m.</date><lb/>[Received October 5—9:35 a.m.]</dateline></opener>
                <p>4532. For the President and Secretary of State. I am leaving Paris today for
                    Brest and am sailing for home tomorrow morning on the <hi rendition="#italic"
                        >Northern Pacific</hi>.</p>
                <closer><signed><hi rendition="#small-caps">Edward House</hi></signed></closer>
            </div>
        </body>
