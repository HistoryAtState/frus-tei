                <pb facs="0688" n="650" sameAs="frus:frus1919Parisv11/pg650"/>

                <note rend="inline" type="source">Paris Peace Conf. 811.001/360: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to the Commission to Negotiate
                        Peace</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-10-03T17:00:00-04:00">October 3, 1919—5
                        p.m.</date><lb/>[Received October 4—9 a.m.]</dateline></opener>
                <p>3327. Very [confidential for?] Polk. The President is very seriously ill and
                    unable to attend to any business. You should not therefore for the present
                    forward to him personal communications since they cannot be answered.</p>
                <closer><signed><hi rendition="#small-caps">Lansing</hi></signed></closer>
            </div>
        </body>
    </text>
