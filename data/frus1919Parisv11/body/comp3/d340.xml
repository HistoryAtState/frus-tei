        <body>
            <div xml:id="d340">

                <pb facs="0687" n="649" sameAs="frus:frus1919Parisv11/pg649"/>

                <note rend="inline" type="source">Paris Peace Conf. 811.001/356b: Telegram</note>
                <head><hi rendition="#italic">The Commission to Negotiate Peace to the Secretary of
                        State</hi></head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>, <date calendar="gregorian"
                            when="1919-09-29T15:00:00+01:00">September 29, 1919—3
                        p.m.</date></dateline></opener>
                <p>4427. Confidential for Phillips from Polk. Please cable me to be deciphered by me
                    exact situation in regard to President’s health. Also, whether he is able to
                    attend to business. Absolutely necessary to have the most accurate information
                    possible for my guidance. Polk.</p>
                <closer><hi rendition="#small-caps">Am</hi>[<hi rendition="#small-caps">erican</hi>]
                        <hi rendition="#small-caps">Mission</hi></closer>
            </div>
        </body>
    </text>
