    <text>
        <body>
            <div xml:id="d237">

                <pb facs="0568" n="532" sameAs="frus:frus1919Parisv11/pg532"/>

                <note rend="inline" type="source">Paris Peace Conf. 185.1/41</note>
                <head><hi rendition="#italic">The Diplomatic Secretary of the Commission to
                        Negotiate Peace</hi> (<hi rendition="#italic">Harrison</hi>) <hi
                        rendition="#italic">to Mr. Henry White</hi></head>
                <opener><dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>,] <date calendar="gregorian"
                            when="1919-03-25">March 25, 1919</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. White</hi>: Mr. Lansing has directed me to
                    deliver the attached skeleton draft of the Treaty of Peace with Germany.</p>
                <p>An original copy of this document was handed to Dr. Scott by Mr. Hurst of the
                    British Delegation. Dr. Scott and Mr. Hurst have gone over the draft
                    together.</p>
                <p>Very respectfully,</p>
                <closer><signed><hi rendition="#small-caps">Leland Harrison</hi></signed></closer>


                <xi:include href="d237-a1.xml" xpointer="d237-a1"/>
