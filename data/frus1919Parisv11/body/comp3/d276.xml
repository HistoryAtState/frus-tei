    <text>
        <body>
            <div xml:id="d276">

                <pb facs="0645" n="607" xml:id="pg607"/>

                <note rend="inline" type="source">Paris Peace Conf. 182/52</note>
                <head><hi rendition="#italic">Memorandum by the Secretary of State Concerning
                        Subjects Still To Be Settled by the Conference</hi></head>
                <opener><dateline rendition="#float-right">[Undated—<placeName>Circa</placeName>
                        <date calendar="gregorian" when="1919-07-01">July 1,
                        1919</date>.]</dateline></opener>
                <p>Prepare Hungarian and Bulgarian Treaties at once.</p>
                <p>Agree on boundaries of states with Russia and announce decisions.</p>
                <p>Postpone Turkish matters until German treaty is ratified and our Syrian
                        Commission<anchor n="62" xml:id="d276-f1"/> reports.</p>
                <closer><signed><hi rendition="#small-caps">Lansing</hi></signed></closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d276-f1" n="62" xml:id="d276-f1-content">
                <p>The King–Crane Commission.</p>
            </note>
