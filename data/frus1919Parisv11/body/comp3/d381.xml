                <pb facs="0720" n="682" sameAs="frus:frus1919Parisv11/pg682"/>

                <note rend="inline" type="source">763.72119/8217½</note>
                <head><hi rendition="#italic">Mrs. Woodrow Wilson to the Secretary of
                    State</hi></head>
                <opener><dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1919-12-01">December 1, 1919</date>.]</dateline></opener>
                <p>The President wishes me to say he adheres to his original decision in regard to
                    the withdrawing of our American Commissioners.</p>
                <closer><signed>E. B. W[<hi rendition="#small-caps">ilson</hi>]</signed></closer>
            </div>
        </body>
