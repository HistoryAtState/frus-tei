    <text>
        <body>
            <div xml:id="d256">

                <pb facs="0613" n="575" sameAs="frus:frus1919Parisv11/pg575"/>

                <note rend="inline" type="source">Paris Peace Conf. 184.1 Miller, D. H.</note>
                <head><hi rendition="#italic">President Wilson to
                        the Secretary of State</hi></head>
                <opener><dateline rendition="#float-right">[<placeName><hi rendition="#small-caps"
                                >Paris</hi></placeName>,] <date calendar="gregorian"
                            when="1919-05-22">May 22, 1919</date>.</dateline></opener>
                <p rendition="#center"><hi rendition="#small-caps">Memorandum</hi></p>
                <p><hi rendition="#small-caps">Dear Mr. Secretary</hi>: Will you be so good as to
                    request Mr. David H. Miller (who is, I understand, a Special Assistant in your
                    Department), to return to the United States so that he may be able to confer
                    with some of the officials there respecting technical legal questions arising
                    under the Covenant of the League of Nations.</p>
                <closer>Approved:<lb/><signed>W. W.</signed></closer>
            </div>
        </body>
