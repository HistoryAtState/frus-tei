    <text>
        <body>
            <div xml:id="d75">

                <pb facs="0226" n="190" sameAs="frus:frus1919Parisv11/pg190"/>

                <note rend="inline" type="source">Paris Peace Conf. 184.00101/76</note>
                <head><hi rendition="#italic">Minutes of the Daily Meetings of the Commissioners
                        Plenipotentiary, Wednesday, May 28, 1919</hi></head>
                <dateline>
                    <date ana="#date_undated-inferred-from-document-head" calendar="gregorian"
                        when="1919-05-28">May 28, 1919</date>
                </dateline>
                <list subtype="participants" type="description">
                    <item>Present: <list>
                            <item><hi rendition="#small-caps">Mr. Lansing</hi></item>
                            <item><hi rendition="#small-caps">Mr. White</hi></item>
                            <item><hi rendition="#small-caps">Gen. Bliss</hi></item>
                            <item><hi rendition="#small-caps">Mr. Herter</hi></item>
                        </list></item>
                </list>
                <list>
                    <label>1.</label>
                    <item>Memorandum No. 297 was read regarding the release of Major Whitehouse from
                        duty with the Commission. The Commissioners approved of Major Whitehouse’s
                        release. <seg type="margin">Release of Major Whitehouse</seg></item>
                    <label>2.</label>
                    <item>Memorandum No. 298 was read regarding the release of Major James Steinberg
                        from further duty with the Commission. The Commissioners approved of Major
                        Steinberg’s release. <seg type="margin">Release of Major
                        Steinberg</seg></item>
                </list>
            </div>
        </body>
