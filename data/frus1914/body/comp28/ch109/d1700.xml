    <text>
        <body>
            <div xml:id="d1700">

                <pb facs="1082" n="966" xml:id="pg966"/>

                <note rend="inline" type="source">File No. 817.812/93.</note>
                <head>
                    <hi rendition="#italic">The President of Nicaragua to the Minister of
                        Nicaragua.</hi><anchor n="10" xml:id="d1700-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Translation.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Managua</hi></placeName>, <date
                            calendar="gregorian" when="1914-08-03">
                            <hi rendition="#italic">August 3, 1914</hi></date>.</dateline>
                </opener>
                <p>Canal treaty which you sent me in your cable of to-day meets with my entire
                    approbation. Advise me when the treaty has been signed.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Diaz</hi></signed>.</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1700-f1" n="10" type="source" xml:id="d1700-f1-content">
                <p>Translation left at the Department by the Minister on August 4, 1914.</p>
            </note>
        </listAnnotation>
    </standOff>
