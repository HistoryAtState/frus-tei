    <text>
        <body>
            <div xml:id="d1818">

                <pb facs="1188" n="1072" sameAs="frus:frus1914/pg1072"/>

                <note rend="inline" type="source">File No. 871.001/6.</note>
                <head>
                    <hi rendition="#italic">President Wilson to Queen Elizabeth.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The White House</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-10-12">
                            <hi rendition="#italic">October 12, 1914</hi></date>.</dateline>
                </opener>
                <p>I am deeply grieved to learn of the death of His Majesty and I offer to Your
                    Majesty, to the royal family and to the Roumanian nation the sincere condolences
                    of the Government and people of the United States and the expression of my own
                    deep sympathy in your great sorrow.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi></signed>.</closer>
            </div>
        </body>
