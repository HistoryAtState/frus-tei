    <text>
        <body>
            <div xml:id="d1821">

                <pb facs="1189" n="1073" sameAs="frus:frus1914/pg1073"/>

                <note rend="inline" type="source">File No. 871.001F37/3</note>
                <head>
                    <hi rendition="#italic">Minister Vopicka to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 143.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Bucharest</hi></placeName>, <date
                            calendar="gregorian" when="1914-10-24">
                            <hi rendition="#italic">October 24, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith a
                    letter sent to the President of the United States by King Ferdinand of
                    Roumania.</p>
                <p>I also enclose an office copy of said letter together with English translation of
                    same.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Charles J. Vopicka</hi></signed>.</closer>


                <xi:include href="d1821-a1.xml" xpointer="d1821-a1"/>
            </div>
