    <text>
        <body>
            <div xml:id="d1755">

                <pb facs="1144" n="1028" sameAs="frus:frus1914/pg1028"/>

                <note rend="inline" type="source">File No. 819.77/165.</note>
                <head>
                    <hi rendition="#italic">Consul General Snyder
                        to the Secretary of State.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate General</hi>, <lb/>
                            <hi rendition="#italic">Panama</hi></placeName>, <date
                            calendar="gregorian" when="1913-04-02">
                            <hi rendition="#italic">April 2, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to inclose herewith a
                    copy and translation of Law 29 of 1913, authorizing the Executive Power to make
                    the studies necessary to determine what railroads should be constructed in the
                    Republic, etc.</p>
                <p>In conformity with the law, the Minister of Public Works has signed a contract
                    with Messrs. R. W. Hebard &amp; Co. of this city, to make the necessary surveys,
                    reports, etc.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Alban G. Snyder</hi></signed>.</closer>



                <xi:include href="d1755-a1.xml" xpointer="d1755-a1"/>
            </div>
        </body>
    </text>
