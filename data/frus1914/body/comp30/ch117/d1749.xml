    <text>
        <body>
            <div xml:id="d1749">

                <pb facs="1139" n="1023" sameAs="frus:frus1914/pg1023"/>

                <note rend="inline" type="source">File No. 718.1915/226.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister of Costa
                        Rica.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-12-02">
                            <hi rendition="#italic">December 2, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My dear Mr. Minister</hi>: The Department
                    acknowledges, with thanks, the receipt of your note of November 25, 1914, with
                    which you enclose a translation of the reply of your Government to the note from
                    the Government of Panama setting forth the reasons which induced the latter not
                    to accept the arbitral award of the Chief Justice of the Supreme Court of the
                    United States, in the Costa Rica-Panama boundary dispute.</p>
                <p>Both your note and its enclosure have been read with great interest by the
                    Department of State.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan</hi></signed>.</closer>
            </div>
        </body>
    </text>
