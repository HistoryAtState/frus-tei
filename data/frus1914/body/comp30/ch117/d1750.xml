    <text>
        <body>
            <div xml:id="d1750">

                <pb facs="1139" n="1023" sameAs="frus:frus1914/pg1023"/>

                <note rend="inline" type="source">File No. 718.1915/230.</note>
                <head>
                    <hi rendition="#italic">Minister Hale to the
                            Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 49.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">San José</hi></placeName>, <date
                            calendar="gregorian" when="1914-12-05">
                            <hi rendition="#italic">December 5, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to acknowledge the
                    receipt of the Department’s telegram of November 25, and to enclose copy of a
                    letter which I sent to the Foreign Office on November 30.</p>
                <pb facs="1140" n="1024" xml:id="pg1024"/>
                <p>I have not yet received a reply to my letter, but will forward copy of that as
                    soon as it comes to hand.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">E. J. Hale</hi></signed>.</closer>


                <xi:include href="d1750-a1.xml" xpointer="d1750-a1"/>
            </div>
        </body>
    </text>
