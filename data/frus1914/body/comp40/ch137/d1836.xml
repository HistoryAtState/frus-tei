    <text>
        <body>
            <div xml:id="d1836">

                <pb facs="1206" n="1090" sameAs="frus:frus1914/pg1090"/>

                <note rend="inline" type="source">File No. 767.70/441.</note>
                <head>
                    <hi rendition="#italic">Ambassador Morgenthau to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 37.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Constantinople</hi></placeName>, <date
                            calendar="gregorian" when="1914-03-17">
                            <hi rendition="#italic">March 17, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith in
                    duplicate, copy, with translation, of the Turco-Servian Treaty which was signed
                    by the plenipotentiaries of the respective countries on the 14th instant.<anchor
                        n="1" xml:id="d1836-f1"/> In addition to the treaty, I have the honor to
                    transmit the letter exchanged by the signatories on the subject of mosques in
                    the ceded territories.<anchor n="2" xml:id="d1836-f2"/> Diplomatic relations
                    between Servia and Turkey have been resumed and Mr. Georgevitch has been
                    nominated Servian Chargé d’Affaires.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">H. Morgenthau</hi></signed>.</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1836-f1" n="1" xml:id="d1836-f1-content">
                <p>Not printed. It ratifies the Treaty of London of May 30, 1913. (<hi
                        rendition="#italic">See</hi>
                    <ref target="frus1913#pg_1309">For. Rel. 1913, p. 1309</ref>.)</p>
            </note>
            <note corresp="#d1836-f2" n="2" xml:id="d1836-f2-content">
                <p>Not printed.</p>
            </note>
        </listAnnotation>
    </standOff>
