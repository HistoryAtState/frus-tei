            <div xml:id="d628">

                <pb facs="0526" n="410" sameAs="frus:frus1914/pg410"/>

                <note rend="inline" type="source">File No. 365.117/35.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to Ambassador Page.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-10-14">
                            <hi rendition="#italic">October 14, 1914</hi></date>.</dateline>
                </opener>
                <p>60. Your 38, October 8. Department endeavoring obtain desired information. Where
                    possible please obtain it directly from persons held in Italy.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi></signed>.</closer>
            </div>
        </body>
