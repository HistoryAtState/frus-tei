            <div xml:id="d604">

                <pb facs="0510" n="394" sameAs="frus:frus1914/pg394"/>

                <note rend="inline" type="source">File No. 711.654/1–3.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to Ambassador
                        Griscom.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 47.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1907-06-29">
                            <hi rendition="#italic">June 29, 1907</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have to acknowledge the receipt of your
                    despatch No. 82, of the 5th instant, with reference to the proposed
                    naturalization treaty between the United States and Italy.</p>
                <p>This Government notes with great gratification the encouraging reception of its
                    proposition looking to a naturalization convention between the two countries,
                    and you will avail yourself of the earliest opportunity to so inform the
                    Minister of Foreign Relations.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Alvey A. Adee</hi></signed>.</closer>
            </div>
        </body>
    </text>
