            <div xml:id="d608">

                <pb facs="0513" n="397" xml:id="pg397"/>

                <note rend="inline" type="source">File No. 711.654/6.</note>
                <head>
                    <hi rendition="#italic">Ambassador Leishman to
                        the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 446.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Rome</hi></placeName>, <date
                            calendar="gregorian" when="1911-09-15">
                            <hi rendition="#italic">September 15, 1911</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to the Department’s instruction
                    No. 186 [185] of April 6 last, directing me to ascertain whether the proposed
                    Italian citizenship laws mentioned in Mr. Garrett’s despatch of June 19, 1908,
                    had been passed or, if not, whether they would be passed on in the near future;
                    and further directing me to avail myself of the first opportunity to present
                    this matter to the attention of the Italian Government again and urge the
                    conclusion of a naturalization treaty, I have the honor to enclose herewith
                    duplicate copies and translations of the Embassy’s note on the subject and of a
                    note from the Italian Foreign Office replying thereto.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John G. A. Leishman</hi></signed>.</closer>



                <xi:include href="d608-a1.xml" xpointer="d608-a1"/>
