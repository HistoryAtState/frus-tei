    <text>
        <body>
            <div xml:id="d608-a1">

                <pb facs="0513" n="397" sameAs="frus:frus1914/pg397"/>

                <opener>
                    <seg rendition="#center">[Inclosure 1.]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">Ambassador Leishman to the Minister for Foreign
                        Affairs.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 331.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Rome</hi></placeName>, <date
                            calendar="gregorian" when="1911-07-31">
                            <hi rendition="#italic">July 31, 1911</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: Referring to a note from this
                    Embassy dated May 25, 1907, in regard to the conclusion of a naturalization
                    treaty between the United States and Italy, and to subsequent conversations on
                    the subject, I have the honor to inform your excellency that I have again been
                    instructed by my Government to inquire whether the Royal Government would be
                    disposed to consider the conclusion of such a convention at the present
                    time.</p>
                <p>I avail [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John G. A. Leishman</hi></signed>.</closer>
            </div>
        </body>
    </text>
