                <pb facs="0504" n="388" sameAs="frus:frus1914/pg388"/>

                <head>Arbitration agreement between the United States and Italy, extending the
                    duration of the Convention of March 28, 1908</head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at Washington, May 28, 1913; ratification advised
                        by the Senate, February 21, 1914; ratified by the President, April 13, 1914;
                        ratified by Italy, March 12, 1914; ratifications exchanged at Washington,
                        April 13, 1914; proclaimed, April 15, 1914</hi>.</p>

                <xi:include href="ch85/d601.xml" xpointer="d601"/>
