    <text>
        <body>
            <div xml:id="d486">

                <pb facs="0449" n="333" sameAs="frus:frus1914/pg333"/>

                <note rend="inline" type="source">File No. 814.032/4.</note>
                <head>
                    <hi rendition="#italic">Minister Leavell to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 27.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Guatemala</hi></placeName>, <date
                            calendar="gregorian" when="1914-03-11">
                            <hi rendition="#italic">March 11, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to forward to the
                    Department a copy of the Message that the President of Guatemala sent to the
                    National Legislature when it convened on March 1, together with an English
                    translation of that part of it which relates especially to the United
                    States.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. Hayne Leavell</hi></signed>.</closer>


                <xi:include href="d486-a1.xml" xpointer="d486-a1"/>
            </div>
