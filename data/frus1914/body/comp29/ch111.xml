            <div xml:id="ch111">

                <pb facs="1086" n="970" sameAs="frus:frus1914/pg970"/>

                <head>Arbitration agreement between the United States and Norway, extending the
                    duration of the Convention of April 4, 1908</head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at Washington, June 16, 1913; ratification
                        advised by the Senate, February 21, 1914; ratified by the President, April
                        9, 1914; ratified by Norway, March 13, 1914; ratifications exchanged at
                        Washington, April 13, 1914; proclaimed, April 15, 1914</hi>.</p>

                <xi:include href="ch111/d1705.xml" xpointer="d1705"/>
