    <text>
        <body>
            <div xml:id="d1710">

                <pb facs="1091" n="975" xml:id="pg975"/>

                <note rend="inline" type="source">File No. 850d.00/265b.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Schmedeman.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-05-19">
                            <hi rendition="#italic">May 19, 1914</hi></date>.</dateline>
                </opener>
                <p>Inform Foreign Office Department has appointed Fred K. Nielsen, Assistant
                    Solicitor of this Department, as its technical delegate to assist delegates of
                    this Government at the Spitzbergen Conference.<anchor n="2" xml:id="d1710-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1710-f1" n="2" xml:id="d1710-f1-content">
                <p>Mr. Nielsen was later appointed plenipotentiary delegate.</p>
            </note>
        </listAnnotation>
    </standOff>
