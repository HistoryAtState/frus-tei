    <text>
        <body>
            <div xml:id="d1708">

                <pb facs="1090" n="974" sameAs="frus:frus1914/pg974"/>

                <note rend="inline" type="source">File No. 850d.00/258c.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <seg rendition="#float-left">No. 370.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-05-01">
                            <hi rendition="#italic">May 1, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to previous correspondence with
                    your Legation regarding the approaching International Conference on Spitzbergen
                    which is to be held at Christiania on or about June 16, 1914, I have the honor
                    to advise you of the appointment by this Government of Mr. William Miller
                    Collier of Auburn, New York, and Mr. Albert G. Schmedeman, Envoy Extraordinary
                    and Minister Plenipotentiary of the United States at Christiania, as delegates
                    to represent the Government of the United States at that International
                    Conference.</p>
                <p>Accept [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi></signed>.</closer>
            </div>
        </body>
    </text>
