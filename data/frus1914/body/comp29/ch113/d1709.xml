    <text>
        <body>
            <div xml:id="d1709">

                <pb facs="1090" n="974" sameAs="frus:frus1914/pg974"/>

                <note rend="inline" type="source">File No. 850d.00/259.</note>
                <head>
                    <hi rendition="#italic">The Minister of Norway to the
                            Secretary of State.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Legation of Norway</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-05-04">
                            <hi rendition="#italic">May 4, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary of State</hi>: I have the honor to
                    acknowledge the receipt of your excellency’s note of the 1st instant containing
                    information of the appointment of Mr. W. M. Collier and Minister A. G.
                    Schmedeman as delegates to represent the Government of the United States at the
                    International Conference in relation to Spitzbergen to be opened at Christiania
                    on June 16, 1914.</p>
                <p>I have taken pleasure in transmitting the said note to my Government.</p>
                <p>Please accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">H. Bryn</hi></signed>.</closer>
            </div>
        </body>
    </text>
