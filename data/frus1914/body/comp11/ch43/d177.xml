    <text>
        <body>
            <div xml:id="d177">

                <pb facs="0286" n="170" sameAs="frus:frus1914/pg170"/>

                <head>
                    <hi rendition="#italic">Minister Hale to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 17.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">San José</hi></placeName>, <date
                            calendar="gregorian" when="1914-05-02">
                            <hi rendition="#italic">May 2, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose a copy of the
                    message read by President Jimenez to the Congress of Costa Rica, which met
                    yesterday according to law, and a translation of the same.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">E. J. Hale</hi></signed>.</closer>


                <xi:include href="d177-a1.xml" xpointer="d177-a1"/>
            </div>
