    <text>
        <body>
            <div xml:id="d457">

                <pb facs="0417" n="301" sameAs="frus:frus1914/pg301"/>

                <note rend="inline" type="source">File No. 351.117/22.</note>
                <head>
                    <hi rendition="#italic">Ambassador Sharp to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1914-12-18">
                            <hi rendition="#italic">December 18, 1914</hi></date>.</dateline>
                </opener>
                <p>390. No answer having been received to Embassy’s despatch No. 767, November 17,
                    shall I make representations behalf Auguste Peralme as per Department’s No. 311,
                    November 25?</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sharp</hi></signed>.</closer>
            </div>
        </body>
