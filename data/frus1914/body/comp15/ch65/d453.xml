    <text>
        <body>
            <div xml:id="d453">

                <pb facs="0414" n="298" sameAs="frus:frus1914/pg298"/>

                <note rend="inline" type="source">File No. 351.117/18.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Ambassador Herrick.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-11-12">
                            <hi rendition="#italic">November 12, 1914</hi></date>.</dateline>
                </opener>
                <p>261. Department informed Jean Eloi Candevan born at Poey, Basses Pyrenees,
                    December 1, 1877; emigrated to this country at age of sixteen; naturalized as
                    American citizen 1902; impressed into French army at Poey. Investigate; ask for
                    release.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
