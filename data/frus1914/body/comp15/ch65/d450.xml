    <text>
        <body>
            <div xml:id="d450">

                <pb facs="0414" n="298" xml:id="pg298"/>

                <note rend="inline" type="source">File No. 351.117/16a.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to Ambassador
                        Herrick.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-10-27">
                            <hi rendition="#italic">October 27, 1914</hi></date>.</dateline>
                </opener>
                <p>207. Have you issued emergency passport Pierre Ismael Chandeysson and presented
                    his case to French authorities? Department informed he was naturalized September
                    22, 1906, but has been impressed into French Army.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi></signed>.</closer>
            </div>
        </body>
