    <text>
        <body>
            <div xml:id="d451">

                <pb facs="0414" n="298" sameAs="frus:frus1914/pg298"/>

                <note rend="inline" type="source">File No. 351.117/17.</note>
                <head>
                    <hi rendition="#italic">Ambassador Herrick to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Paris</hi></placeName>, <date
                            calendar="gregorian" when="1914-10-28">
                            <hi rendition="#italic">October 28, 1914</hi></date>.</dateline>
                </opener>
                <p>231. Your 206 [207], October 27. Chandeysson given certificate of citizenship
                    about August 12; was also assisted to obtain funds; now enrolled in 7th Company,
                    120th Territorial Regiment.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Herrick</hi></signed>.</closer>
            </div>
        </body>
