    <text>
        <body>
            <div xml:id="d464">

                <pb facs="0434" n="318" xml:id="pg318"/>

                <note rend="inline" type="source">File No. 811f.812/446.</note>
                <head>
                    <hi rendition="#italic">Ambassador Page to the
                            Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">London</hi></placeName>, <date
                            calendar="gregorian" when="1914-03-06">
                            <hi rendition="#italic">March 6, 1914</hi></date>.</dateline>
                </opener>
                <p>168. The President’s address to Congress on Panama Canal tolls is published in
                    full in all the chief newspapers here and the most appreciative and
                    complimentary comment appears in press of all parties and is heard on all
                    sides.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Page</hi></signed>.</closer>


                <xi:include href="d464-a1.xml" xpointer="d464-a1"/>
