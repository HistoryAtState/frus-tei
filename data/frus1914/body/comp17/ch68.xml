                <pb facs="0419" n="303" sameAs="frus:frus1914/pg303"/>

                <head>Arbitration agreement between the United States and Great Britain, extending
                    the duration of the Convention of April 4, 1908</head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at Washington, May 31, 1913; ratification advised
                        by the Senate, February 21, 1914; ratified by the President, March 27, 1914;
                        ratified by Great Britain, March 11, 1914; ratifications exchanged at
                        Washington, April 10, 1914; proclaimed April 10, 1914</hi>.</p>

                <xi:include href="ch68/d459.xml" xpointer="d459"/>
