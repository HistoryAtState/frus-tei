    <text>
        <body>
            <div xml:id="d1825">

                <pb facs="1193" n="1077" sameAs="frus:frus1914/pg1077"/>

                <note rend="inline" type="source">File No. 816.00/192.</note>
                <head>
                    <hi rendition="#italic">Chargé Tennant to the
                            Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 364.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">San Salvador</hi></placeName>, <date
                            calendar="gregorian" when="1914-06-30">
                            <hi rendition="#italic">June 30, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                    copy and translation of a clipping from the <hi rendition="#italic">Diario de El
                        Salvador</hi>, of a report of the Committee on Powers and Excuses of the
                    National Legislative Assembly of Salvador,<anchor n="3" xml:id="d1825-f1"/>
                    relative to the request of the President of Salvador, don Carlos Melendez, for
                    permission to resign the Presidency of the Republic in order to comply with the
                    Constitution and legally become candidate for the Presidency for the ensuing
                    term of four years.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry F. Tennant</hi></signed>.</closer>
            </div>
        </body>
    </text>
