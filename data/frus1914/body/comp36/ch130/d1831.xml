    <text>
        <body>
            <div xml:id="d1831">

                <pb facs="1195" n="1079" sameAs="frus:frus1914/pg1079"/>

                <note rend="inline" type="source">File No. 816.001Q4/1.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to Minister Long.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 2.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-10-17">
                            <hi rendition="#italic">October 17, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I enclose, with office copy, a letter
                    addressed by the President to His Excellency Alfonso Quinonez Molina,
                    acknowledging his letter of August 29 last in which he announced his assumption
                    of the Presidency of the Republic of Salvador and his entrance upon the duties
                    of that office.</p>
                <p>You will forward the copy to the foreign office and deliver the original in the
                    manner most agreeable to His Excellency.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi></signed>.</closer>


                <xi:include href="d1831-a1.xml" xpointer="d1831-a1"/>
            </div>
        </body>
    </text>
