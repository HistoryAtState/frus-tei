                <pb facs="1192" n="1076" xml:id="pg1076"/>

                <head>Arbitration agreement between the United States and Salvador, extending the
                    duration of the Convention of December 21, 1908</head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at Washington, May 13, 1914; ratification advised
                        by the Senate, May 20, 1914; ratified by the President, June 2, 1914;
                        ratified by Salvador, July 6, 1914; ratifications exchanged at Washington,
                        August 21, 1914; proclaimed, August 21, 1914</hi>.</p>

                <xi:include href="ch129/d1824.xml" xpointer="d1824"/>
