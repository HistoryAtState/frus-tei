    <text>
        <body>
            <div xml:id="d40">

                <pb facs="0146" n="30" sameAs="frus:frus1914/pg30"/>

                <note rend="inline" type="source">File No. 832.032/6.</note>
                <head>
                    <hi rendition="#italic">Ambassador Morgan to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 377.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Rio de Janeiro</hi></placeName>, <date
                            calendar="gregorian" when="1914-05-19">
                            <hi rendition="#italic">May 19, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    duplicate copies of the annual message to the Congress of Brazil which the
                    President sent to that body on the 3d of May.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Edwin V. Morgan</hi></signed>.</closer>


                <xi:include href="d40-a1.xml" xpointer="d40-a1"/>
            </div>
