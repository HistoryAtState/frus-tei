    <text>
        <body>
            <div xml:id="d438">

                <pb facs="0406" n="290" sameAs="frus:frus1914/pg290"/>

                <note rend="inline" type="source">File No. 322.112GG4/4.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Hartman.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-12-28">
                            <hi rendition="#italic">December 28, 1914</hi></date>.</dateline>
                </opener>
                <p>Result conference Ecuadorian Minister and Counselor Lansing, agreed Goo Kwai
                    allowed remain visiting friends Ecuador until December 31.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
