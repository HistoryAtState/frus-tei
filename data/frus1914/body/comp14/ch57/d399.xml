                <pb facs="0388" n="272" sameAs="frus:frus1914/pg272"/>

                <note rend="inline" type="source">File No. 822.00/374.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Consul General Goding.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-03-23">
                            <hi rendition="#italic">March 23, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received your despatch
                    No. 17 of February 12, 1914, with regard to the revolutionary situation in
                    Esmeraldas.</p>
                <p>The Department has been fully informed regarding the revolutionary movement in
                    question,</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Wilbur J. Carr</hi></signed>.</closer>
            </div>
        </body>
