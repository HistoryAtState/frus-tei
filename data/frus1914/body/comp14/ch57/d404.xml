            <div xml:id="d404">

                <pb facs="0390" n="274" xml:id="pg274"/>

                <note rend="inline" type="source">File No. 822.00/387.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Hartman.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-08-25T16:00:00-05:00">
                            <hi rendition="#italic">August 25, 1914, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your August 22, 3 p.m. The Department does not consider it advisable or prudent
                    for the Government of the United States to mix in any way in the internal,
                    political affairs of Ecuador.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
