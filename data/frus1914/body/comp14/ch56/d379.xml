    <text>
        <body>
            <div xml:id="d379">

                <pb facs="0381" n="265" sameAs="frus:frus1914/pg265"/>

                <note rend="inline" type="source">File No. 822.032/14.</note>
                <head>
                    <hi rendition="#italic">Minister Hartman to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 74.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Quito</hi></placeName>, <date
                            calendar="gregorian" when="1914-08-12">
                            <hi rendition="#italic">August 12, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor of enclosing herewith for
                    the information of the Department copies of the Message of President Plaza to
                    the Congress which assembled on August 10, 1914.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Chas. S. Hartman</hi></signed>.</closer>


                <xi:include href="d379-a1.xml" xpointer="d379-a1"/>
