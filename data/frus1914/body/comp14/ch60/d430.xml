    <text>
        <body>
            <div xml:id="d430">

                <pb facs="0402" n="286" xml:id="pg286"/>

                <note rend="inline" type="source">File No. 322.112J72/16.</note>
                <head>
                    <hi rendition="#italic">Consul General Goding
                        to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 46.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate General</hi>, <lb/>
                            <hi rendition="#italic">Guayaquil</hi></placeName>, <date
                            calendar="gregorian" when="1914-06-27">
                            <hi rendition="#italic">June 27, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose certified copy
                    of the judge’s decree<anchor n="8" xml:id="d430-f1"/> discharging the bondsmen
                    of Mr. Robert B. Jones, which closes the case. The document was called for in
                    Department telegram dated March 16, 1914. A similar copy has been sent to the
                    American Legation at Quito, and an uncertified copy has been placed on file on
                    this office.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Frederic W. Goding</hi></signed>.</closer>
            </div>
        </body>
    </text>
