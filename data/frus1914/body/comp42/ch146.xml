                <pb facs="1224" n="1108" sameAs="frus:frus1914/pg1108"/>

                <head>Convention between the United States and other powers on literary and artistic
                    copyright; signed at Buenos Aires, August 11, 1910</head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at Buenos Aires, August 11, 1910, at the Fourth
                        International American Conference; ratification advised by the Senate,
                        February 15, 1911; ratified by the President, March 21, 1911; ratification
                        of the United States deposited with the Government of the Argentine Republic
                        May 1, 1911; proclaimed. July 13, 1914</hi>.</p>

                <xi:include href="ch146/d1863.xml" xpointer="d1863"/>
