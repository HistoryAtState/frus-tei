                <pb facs="1226" n="1110" xml:id="pg1110"/>

                <head>Convention between the United States and other powers for the protection of
                    inventions, patents, designs, and industrial models; signed at Buenos Aires,
                    August 20, 1910</head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at Buenos Aires, August 20, 1910; ratification
                        advised by the Senate, February 8, 1911; ratified by the President, March
                        21, 1911; ratification of the United States deposited with the Government of
                        the Argentine Republic, May 1, 1911; proclaimed, July 29, 1914</hi>.</p>

                <xi:include href="ch148/d1865.xml" xpointer="d1865"/>
