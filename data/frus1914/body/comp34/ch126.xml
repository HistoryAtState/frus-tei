                <pb facs="1186" n="1070" sameAs="frus:frus1914/pg1070"/>

                <head>Arbitration agreement between the United States and Portugal, extending the
                    duration of the Convention of April 6, 1908</head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at Washington, June 28, 1913; ratification
                        advised by the Senate, February 21, 1914; ratified by the President, April
                        14, 1914; ratified by Portugal, September 26, 1914; ratifications exchanged
                        at Washington, October 24, 1914; proclaimed, October 27, 1914</hi>.</p>

                <xi:include href="ch126/d1815.xml" xpointer="d1815"/>
