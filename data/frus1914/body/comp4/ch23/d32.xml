    <text>
        <body>
            <div xml:id="d32">

                <pb facs="0141" n="25" sameAs="frus:frus1914/pg25"/>

                <note rend="inline" type="source">File No. 863.0011/10.</note>
                <head>
                    <hi rendition="#italic">The Emperor to the President.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Vienna</hi></placeName>, <date
                            calendar="gregorian" when="1914-06-30">
                            <hi rendition="#italic">June 30, 1914</hi></date>.</dateline>
                </opener>
                <p>Deeply sensible of the condolence you have kindly transmitted to me in the name
                    of the Government and people of the United States, I beg you to accept therefor
                    and for the expression of your own sympathy my sincerest and cordial thanks.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Franz Joseph</hi></signed>.</closer>
            </div>
        </body>
    </text>
