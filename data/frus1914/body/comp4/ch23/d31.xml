    <text>
        <body>
            <div xml:id="d31">

                <pb facs="0141" n="25" sameAs="frus:frus1914/pg25"/>

                <note rend="inline" type="source">File No. 863.0011/9.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador of
                        Austria-Hungary.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-06-30">
                            <hi rendition="#italic">June 30, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My dear Mr. Ambassador</hi>: I am greatly shocked
                    and grieved to learn of the terrible affliction which has befallen the people of
                    Austria-Hungary through the assassination of the Archduke Franz Ferdinand and
                    his wife, and I beg of you, my dear Dr. Dumba, to accept, personally, this
                    expression of my profound sympathy.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan</hi></signed>.</closer>
            </div>
        </body>
    </text>
