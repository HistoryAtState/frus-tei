    <text>
        <body>
            <div xml:id="d290">

                <pb facs="0344" n="228" sameAs="frus:frus1914/pg228"/>

                <note rend="inline" type="source">File No. 839.00/1184.</note>
                <head>
                    <hi rendition="#italic">Consul Henry to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Puerto Plata</hi></placeName>, <date
                            calendar="gregorian" when="1914-04-28T09:00:00-04:40">
                            <hi rendition="#italic">April 28, 1914, 9 a.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>American steamer <hi rendition="#italic">Algonquin</hi> failed to enter port. De
                    facto blockade existing. Is it possible to send war ship? Town is being
                    shelled.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry</hi></signed>.</closer>
            </div>
        </body>
