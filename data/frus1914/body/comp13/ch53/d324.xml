    <text>
        <body>
            <div xml:id="d324">

                <pb facs="0358" n="242" sameAs="frus:frus1914/pg242"/>

                <note rend="inline" type="source">File No. 839.00/1416.</note>
                <head>
                    <hi rendition="#italic">Chargé White to the
                            Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 115.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Santo Domingo</hi></placeName>, <date
                            calendar="gregorian" when="1914-07-03">
                            <hi rendition="#italic">July 3, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith copy
                    of communication from the Minister for Foreign Affairs, together with
                    translation, <pb facs="0359" n="243" xml:id="pg243"/> setting forth the exact
                    status of the Bordas Government under the present Constitution of the Dominican
                    Republic.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John Campbell White</hi></signed>.</closer>


                <xi:include href="d324-a1.xml" xpointer="d324-a1"/>
            </div>
        </body>
    </text>
