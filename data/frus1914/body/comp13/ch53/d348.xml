        <body>
            <div xml:id="d348">

                <pb facs="0370" n="254" sameAs="frus:frus1914/pg254"/>

                <note rend="inline" type="source">File No. 839.00/1557.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to Chargé White.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-10-08T17:00:00-05:00">
                            <hi rendition="#italic">October 8, 1914, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>The Department approves postponement of elections for one week and allowance of
                    three instead of two days for voting.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi></signed>.</closer>
            </div>
