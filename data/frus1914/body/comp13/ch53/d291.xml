    <text>
        <body>
            <div xml:id="d291">

                <pb facs="0345" n="229" xml:id="pg229"/>

                <note rend="inline" type="source">File No. 839.00/1184.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Consul Henry.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-04-29T19:00:00-05:00">
                            <hi rendition="#italic">April 29, 1914, 7 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your April 28, 9 a.m. <hi rendition="#italic">Petrel</hi> has been ordered
                    proceed immediately from Guantanamo to Puerto Plata. <hi rendition="#italic"
                        >Wheeling</hi> reports no orders received from Navy due to interruption of
                    cable. She will remain Santo Domingo.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
    </text>
