    <text>
        <body>
            <div xml:id="d338">

                <pb facs="0365" n="249" sameAs="frus:frus1914/pg249"/>

                <note rend="inline" type="source">File No. 839.00/1498a.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Chargé White.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-08-28T22:00:00-05:00">
                            <hi rendition="#italic">August 28, 1914, 10 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>You will call upon the new Provisional President installed yesterday and present
                    the compliments and good wishes of this Government and enter into diplomatic
                    relations with him as Chief Executive of the Dominican Republic.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
