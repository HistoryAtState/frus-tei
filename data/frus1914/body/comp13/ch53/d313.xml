                <pb facs="0355" n="239" sameAs="frus:frus1914/pg239"/>

                <note rend="inline" type="source">File No. 839.00/1337.</note>
                <head>
                    <hi rendition="#italic">The Secretary of the Navy to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Navy Department</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-06-19">
                            <hi rendition="#italic">June 19, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to forward herewith, for
                    the information of the Department of State, copies of telegrams received by this
                    Department relative to conditions in Santo Domingo. Sincerely yours,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Josephus Daniels</hi></signed>.</closer>



                <xi:include href="d313-a1.xml" xpointer="d313-a1"/>
