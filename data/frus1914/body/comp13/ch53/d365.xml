    <text>
        <body>
            <div xml:id="d365">

                <pb facs="0376" n="260" xml:id="pg260"/>

                <note rend="inline" type="source">File No. 839.001B14/1.</note>
                <head>
                    <hi rendition="#italic">Ex-President Báez to President Wilson.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Translation.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Santo Domingo</hi></placeName>, <lb/>
                        <date calendar="gregorian" when="1914-12-10">
                            <hi rendition="#italic">December 10, 1914</hi></date>.</dateline>
                </opener>
                <p>My patriotic aspiration was fulfilled with free suffrage and lawful transfer of
                    power. I thankfully acknowledge your honoring congratulations and take pleasure
                    in offering to you the assurance of my highest personal esteem.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Doctor Báez</hi></signed>.</closer>
            </div>
        </body>
    </text>
