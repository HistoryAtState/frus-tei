                <pb facs="0363" n="247" sameAs="frus:frus1914/pg247"/>

                <note rend="inline" type="source">File No. 839.00/1476a.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Gonzales.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-08-13T18:00:00-05:00">
                            <hi rendition="#italic">August 13, 1914, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>For Commission proceeding to Santo Domingo: <quote rend="blockquote">
                        <p>You are instructed to observe and follow out with utmost care plan which
                            has been presented you by the Secretary of State. No opportunity for
                            argument should be given to any person or faction. It is desired that
                            you present plan and see that it is complied with.</p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
    </text>
