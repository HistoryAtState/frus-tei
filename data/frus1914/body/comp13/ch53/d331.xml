            <div xml:id="d331">

                <pb facs="0363" n="247" sameAs="frus:frus1914/pg247"/>

                <note rend="inline" type="source">File No. 839.00/1460.</note>
                <head>
                    <hi rendition="#italic">Consul Henry to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Puerto Plata</hi></placeName>, <date
                            calendar="gregorian" when="1914-08-06T13:00:00-04:40">
                            <hi rendition="#italic">August 6, 1914, 1 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>General armistice for fifteen days just signed, taking effect six tonight.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Henry</hi></signed>.</closer>
            </div>
