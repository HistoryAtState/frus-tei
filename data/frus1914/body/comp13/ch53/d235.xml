            <div xml:id="d235">

                <pb facs="0318" n="202" sameAs="frus:frus1914/pg202"/>

                <note rend="inline" type="source">File No. 839.51/1213c.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-01-29T23:00:00-05:00">
                            <hi rendition="#italic">January 29, 1914, 11 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>You may inform Minister for Foreign Affairs that Department has consulted
                    President and will send commercial attaché on receipt of written request
                    expressed as required in Department’s telegram of January 27, 8 p.m. Your
                    January 28, 2 p.m., just received, will consider relief measures tomorrow.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
