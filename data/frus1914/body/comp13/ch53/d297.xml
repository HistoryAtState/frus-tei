    <text>
        <body>
            <div xml:id="d297">

                <pb facs="0346" n="230" sameAs="frus:frus1914/pg230"/>

                <note rend="inline" type="source">File No. 839.00/1225.</note>
                <head>
                    <hi rendition="#italic">The Chargé d’Affaires of the Dominican Republic to the
                        Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation.]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 39.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Dominican Legation</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-05-14">
                            <hi rendition="#italic">May 14, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary</hi>: I have the honor to inform you
                    that by a cablegram dated yesterday and received to-day my Government informs me
                    that because of the state of rebellion existing in the cities of Puerto Plata
                    and Monte Cristi and as a measure tending to restore peace, the ports of Puerto
                    Plata and Monte Cristi have been declared closed to commerce and blockaded.</p>
                <p>I avail [etc.],</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">I. A. Cernuda</hi></signed>.</closer>
            </div>
        </body>
    </text>
