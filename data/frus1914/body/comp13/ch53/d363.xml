    <text>
        <body>
            <div xml:id="d363">

                <pb facs="0375" n="259" sameAs="frus:frus1914/pg259"/>

                <note rend="inline" type="source">File No. 839.001J56/a.</note>
                <head>
                    <hi rendition="#italic">President Wilson to
                        President Juan Isidro Jiménez.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The White House</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-12-08">
                            <hi rendition="#italic">December 8, 1914</hi></date>.</dateline>
                </opener>
                <p>I most heartily congratulate you upon your inauguration into office and extend to
                    you my most sincere wishes for the peace and prosperity of the Dominican
                    Republic.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Woodrow Wilson</hi></signed>.</closer>
            </div>
        </body>
