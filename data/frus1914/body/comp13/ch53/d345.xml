    <text>
        <body>
            <div xml:id="d345">

                <pb facs="0369" n="253" sameAs="frus:frus1914/pg253"/>

                <note rend="inline" type="source">File No. 701.3911/37.</note>
                <head>
                    <hi rendition="#italic">The Minister of the Dominican
                            Republic to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation—Extract.]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 71.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Dominican Legation</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-10-01">
                            <hi rendition="#italic">October 1, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary</hi>: I take pleasure in enclosing
                    herein copies of the autograph letter by which Dr. Ramon Báez announces his
                    elevation to the Chief Magistracy of the Republic to His Excellency President
                    Wilson.</p>
                <p>I avail [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Eduardo Soler</hi></signed>.</closer>


                <xi:include href="d345-a1.xml" xpointer="d345-a1"/>
            </div>
        </body>
    </text>
