    <text>
        <body>
            <div xml:id="d371">

                <pb facs="0378" n="262" sameAs="frus:frus1914/pg262"/>

                <note rend="inline" type="source">File No. 339.41/3.</note>
                <head>
                    <hi rendition="#italic">Minister Sullivan to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Santo Domingo</hi></placeName>, <date
                            calendar="gregorian" when="1914-05-13">
                            <hi rendition="#italic">May 13, 1914</hi></date>.</dateline>
                </opener>
                <p>British Chargé d’Affaires received cable that British railroad property is being
                    injured and asks protection by ship at Sanchez.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Sullivan</hi></signed>.</closer>
            </div>
        </body>
