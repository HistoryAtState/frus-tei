            <div xml:id="ch122">

                <pb facs="1169" n="1053" sameAs="frus:frus1914/pg1053"/>

                <head>Extradition treaty between the United States and Paraguay</head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at Asuncion, March 26, 1913; ratification advised
                        by the Senate, June 5, 1913; ratified by the President, October 16, 1913;
                        ratified by Paraguay July 16, 1913; ratifications exchanged at Asuncion,
                        January 17, 1914; proclaimed, January 24, 1914</hi>.</p>

                <xi:include href="ch122/d1789.xml" xpointer="d1789"/>
