            <div xml:id="d52">

                <pb facs="0154" n="38" sameAs="frus:frus1914/pg38"/>

                <note rend="inline" type="source">File No. 893.011.</note>
                <head>
                    <hi rendition="#italic">Minister Calhoun to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 482.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1912-03-20">
                            <hi rendition="#italic">March 20, 1912</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith
                    copies in translation of the Provisional Constitution of the Republic of
                    China.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Calhoun</hi></signed>.</closer>


                <xi:include href="d52-a1.xml" xpointer="d52-a1"/>
