    <text>
        <body>
            <div xml:id="d58">

                <pb facs="0177" n="61" sameAs="frus:frus1914/pg61"/>

                <note rend="inline" type="source">File No. 893.03/10.</note>
                <head>
                    <hi rendition="#italic">Minister Reinsch to the
                            Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 471.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1914-12-17">
                            <hi rendition="#italic">December 17, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith a
                        translation,<anchor n="13" xml:id="d58-f1"/> as published in the Peking
                    Gazette of October 26, 27, 28 and 29, 1914, of the draft of the law on the
                    organization of the Li Fa Yuan—National Assembly of the Chinese Republic. The
                    first election of members to this body will take place during the year 1915.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Paul S. Reinsch</hi></signed>.</closer>
            </div>
        </body>
    </text>
