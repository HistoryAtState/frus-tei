    <text>
        <body>
            <div xml:id="d133">

                <pb facs="0241" n="125" sameAs="frus:frus1914/pg125"/>

                <note rend="inline" type="source">File No. 893.512/38.</note>
                <head>
                    <hi rendition="#italic">Consul Williams to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 6.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Nanking</hi></placeName>, <date
                            calendar="gregorian" when="1914-08-08">
                            <hi rendition="#italic">August 8, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose a copy of my
                    despatch No. 5 of August 7th, 1914, addressed to the American Legation at
                    Peking, <pb facs="0242" n="126" xml:id="pg126"/> respecting the collection of
                    likin at Hsiakuan, the area set apart by the Chinese for foreign trade and
                    residence.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">C. L. L. Williams</hi></signed>.</closer>


                <xi:include href="d133-a1.xml" xpointer="d133-a1"/>
            </div>
        </body>
    </text>
