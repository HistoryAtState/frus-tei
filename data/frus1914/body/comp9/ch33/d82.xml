            <div xml:id="d82">

                <pb facs="0196" n="80" sameAs="frus:frus1914/pg80"/>

                <note rend="inline" type="source">File No. 493.11/542.</note>
                <head>
                    <hi rendition="#italic">The Chinese Charge d’Affaires to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Chinese Legation</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-11-30">
                            <hi rendition="#italic">November 30, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My dear Mr. Secretary</hi>: I beg to inform you that
                    I have just received from the Treasurer of the United States a check for two
                    hundred thousand dollars ($200,000), drawn in my favor as Counselor in charge of
                    the Chinese Legation, for part payment of the balance of the Chinese Indemnity
                    of 1900, returnable to the Chinese Government.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Yung Kwai</hi></signed>.</closer>
            </div>
        </body>
