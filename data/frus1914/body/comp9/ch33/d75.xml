    <text>
        <body>
            <div xml:id="d75">

                <pb facs="0191" n="75" sameAs="frus:frus1914/pg75"/>

                <note rend="inline" type="source">File No. 493.11/494.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Charge d’Affaires of
                        China.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-04-11">
                            <hi rendition="#italic">April 11, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I beg to enclose herewith check for
                    $45,147.97, drawn on the Treasury of the United States and payable to your order
                    as Charge d’Affaires of China. The amount named represents the portion of the
                    January 1914 indemnity payment refundable to China, as shown by the Treasury
                    Department’s letter<anchor n="25" xml:id="d75-f1"/> on the subject, copy of
                    which is enclosed herewith.</p>
                <p>Accept [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi></signed>.</closer>
            </div>
        </body>
    </text>
