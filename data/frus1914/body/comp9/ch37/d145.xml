        <body>
            <div xml:id="d145">

                <pb facs="0255" n="139" sameAs="frus:frus1914/pg139"/>

                <note rend="inline" type="source">File No. 893.631/4.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to Minister Reinsch.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 179.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-10-23">
                            <hi rendition="#italic">October 23, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Receipt is acknowledged of the Legation’s
                    despatch No. 364 of September 11, 1914, with enclosure, relating to the
                    objections which this Government has raised against certain provisions of the
                    Chinese Mining Regulations promulgated March 11, 1914.</p>
                <p>The Department approves the attitude taken by the Legation in this matter.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi></signed>.</closer>
            </div>
        </body>
    </text>
