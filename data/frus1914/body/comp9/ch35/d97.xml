    <text>
        <body>
            <div xml:id="d97">

                <pb facs="0212" n="96" sameAs="frus:frus1914/pg96"/>

                <note rend="inline" type="source">File No. 893.811/85.</note>
                <head>
                    <hi rendition="#italic">Chargé Williams to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 828.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Peking</hi></placeName>, <date
                            calendar="gregorian" when="1913-04-28">
                            <hi rendition="#italic">April 28, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to forward a number of
                    copies of Mr. C. D. Jameson’s Conservancy Report, which Mr. Jameson is
                    forwarding to the Department at the request of the American Consul General at
                    Shanghai.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">E. T. Williams</hi></signed>.</closer>



                <xi:include href="d97-a1.xml" xpointer="d97-a1"/>
            </div>
        </body>
    </text>
