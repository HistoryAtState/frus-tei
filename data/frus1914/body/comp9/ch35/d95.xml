    <text>
        <body>
            <div xml:id="d95">

                <pb facs="0212" n="96" sameAs="frus:frus1914/pg96"/>

                <note rend="inline" type="source">File No. 893.811/46.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Minister Calhoun.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1911-05-27">
                            <hi rendition="#italic">May 27, 1911</hi></date>.</dateline>
                </opener>
                <p>The Red Cross requests Department to inform you that engineer will be chosen
                    within few days and urged to leave without delay.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Knox</hi></signed>.</closer>
            </div>
        </body>
    </text>
