    <text>
        <body>
            <div xml:id="d120">

                <pb facs="0229" n="113" sameAs="frus:frus1914/pg113"/>

                <note rend="inline" type="source">File No. 893.811/156.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the American Red
                        Cross.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-11-02">
                            <hi rendition="#italic">November 2, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sirs</hi>: There is enclosed herewith, for your
                    information and for whatever action you may deem appropriate, paraphrase of a
                    telegram <pb facs="0230" n="114" xml:id="pg114"/> received to-day by the
                    Department of State from the American Minister at Peking regarding the need for
                    immediate relief work in the Huai River region.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi></signed>.</closer>
            </div>
        </body>
    </text>
