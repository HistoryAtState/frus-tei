    <text>
        <body>
            <div xml:id="d43">

                <pb facs="0148" n="32" sameAs="frus:frus1914/pg32"/>

                <note rend="inline" type="source">File No. 701.7411/5.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Minister Vopicka.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-09-10">
                            <hi rendition="#italic">September 10, 1914</hi></date>.</dateline>
                </opener>
                <p>This Government is gratified that Bulgaria has decided to appoint a Minister to
                    this country, and S. Panaretoff is entirely acceptable in that capacity.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
    </text>
