                <pb facs="0150" n="34" xml:id="pg34"/>

                <note rend="inline" type="source">File No. 701.7411/11.</note>
                <head>
                    <hi rendition="#italic">The Appointed Bulgarian
                            Minister to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>1761 <hi rendition="#small-caps">N Street</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-12-15">
                            <hi rendition="#italic">Dec. 15, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Having recently arrived to take possession
                    of the post to which I have been appointed by His Majesty the King of the
                    Bulgarians, I will be greatly obliged to you if you will kindly grant me an
                    audience at a time most convenient to you.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stephan Panaretoff</hi></signed>.</closer>
            </div>
        </body>
