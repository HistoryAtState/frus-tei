    <text>
        <body>
            <div xml:id="d45">

                <pb facs="0149" n="33" sameAs="frus:frus1914/pg33"/>

                <note rend="inline" type="source">File No. 701.7411/8.</note>
                <head>
                    <hi rendition="#italic">Consul General Rockhill to the Secretary of State.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Consulate General of Bulgaria</hi>, <lb/>
                            <hi rendition="#italic">New York</hi></placeName>, <date
                            calendar="gregorian" when="1914-12-01">
                            <hi rendition="#italic">December 1, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honour to inform you that Mr.
                    Stephan Panaretoff, the newly appointed Minister from Bulgaria to Washington, is
                    expected to arrive at New York on the steamship <hi rendition="#italic"
                        >Kroonland</hi>, due the fourth instant.</p>
                <p>Through the courtesy of the collector of the port of New York I have arranged to
                    meet Mr. Panaretoff on arrival of the steamer at quarantine; should you desire
                    me to convey any message to the Minister, kindly command me.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Clayton Rockhill</hi></signed>.</closer>
            </div>
        </body>
    </text>
