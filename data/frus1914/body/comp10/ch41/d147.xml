    <text>
        <body>
            <div xml:id="d147">

                <pb facs="0258" n="142" sameAs="frus:frus1914/pg142"/>

                <note rend="inline" type="source">File No. 022.21.</note>
                <head>
                    <hi rendition="#italic">Minister Thomson to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 98.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Bogota</hi></placeName>, <date
                            calendar="gregorian" when="1914-08-22">
                            <hi rendition="#italic">August 22, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith the
                    “Memoria del Ministro de Relaciones Exteriores al Congreso de 1914.”</p>
                <pb facs="0259" n="143" xml:id="pg143"/>
                <p>I have also the honor to enclose an English translation of that part of the
                    Memoria which refers to the United States, which will be found on pages 34–50
                    inclusive.* * *</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Thad A. Thomson</hi></signed>.</closer>


                <xi:include href="d147-a1.xml" xpointer="d147-a1"/>
            </div>
        </body>
    </text>
