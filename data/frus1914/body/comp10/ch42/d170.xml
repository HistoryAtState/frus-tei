    <text>
        <body>
            <div xml:id="d170">

                <pb facs="0282" n="166" sameAs="frus:frus1914/pg166"/>

                <note rend="inline" type="source">File No. 711.21/277.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Minister Thomson.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 26.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-06-24">
                            <hi rendition="#italic">June 24, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received your telegram
                    of June 17, 3 p.m.</p>
                <p>The Department will be glad to be promptly advised when any formal arrangements
                    shall be proposed for spending the amount stipulated for payment by the United
                    States in the pending treaty between the United States and Colombia.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi></signed>.</closer>
            </div>
        </body>
