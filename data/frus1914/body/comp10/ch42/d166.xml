                <pb facs="0278" n="162" sameAs="frus:frus1914/pg162"/>

                <note rend="inline" type="source">File No. 711.21/275.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Thomson.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-06-10">
                            <hi rendition="#italic">June 10, 1914</hi></date>.</dateline>
                </opener>
                <p>Your June 8. Congratulations. Hope to submit treaty next week.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>





