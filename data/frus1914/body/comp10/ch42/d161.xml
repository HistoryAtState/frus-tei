    <text>
        <body>
            <div xml:id="d161">

                <pb facs="0271" n="155" sameAs="frus:frus1914/pg155"/>

                <note rend="inline" type="source">File No. 711.21/242.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Minister Thomson.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Extract.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-04-08">
                            <hi rendition="#italic">April 8, 1914</hi></date>.</dateline>
                </opener>
                <p>Accept my hearty congratulations on your success in signing the treaty. You have
                    rendered a signal service. Please express to the Foreign Office my satisfaction.
                    * * *</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan</hi></signed>.</closer>
            </div>
        </body>
