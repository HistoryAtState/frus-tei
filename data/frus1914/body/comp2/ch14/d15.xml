    <text>
        <body>
            <div xml:id="d15">

                <pb facs="0131" n="15" sameAs="frus:frus1914/pg15"/>

                <note rend="inline" type="source">File No. 811f.812/589a.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-07-25">
                            <hi rendition="#italic">July 25, 1914</hi></date>.</dateline>
                </opener>
                <p rendition="#flush">
                    <hi rendition="#italic">To the American Consular Officers including Consular
                        Agents</hi>.</p>
                <p>
                    <hi rendition="#small-caps">Gentlemen</hi>: There is being forwarded to your
                    office under separate cover a copy of the Executive order of July 9, 1914,
                    prescribing the rules and regulations for the operation and navigation of the
                    Panama Canal and approaches thereto including all waters under its
                        jurisdiction.<anchor n="7" xml:id="d15-f1"/>
                </p>
                <p>You should bring the provisions of this order to the attention of all interested
                    persons in your consular jurisdiction.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Wilbur J. Carr</hi></signed>.</closer>
            </div>
        </body>
    </text>
