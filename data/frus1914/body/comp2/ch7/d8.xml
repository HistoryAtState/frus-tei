    <text>
        <body>
            <div xml:id="d8">

                <pb facs="0124" n="8" sameAs="frus:frus1914/pg8"/>

                <note rend="inline" type="source">File No. 811.607G/738a.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-05-27">
                            <hi rendition="#italic">May 27, 1914</hi></date>.</dateline>
                </opener>
                <p rendition="#flush">
                    <hi rendition="#italic">To the American Diplomatic and Consular
                    Officers</hi>.</p>
                <p>
                    <hi rendition="#small-caps">Gentlemen</hi>: There is appended for your
                    information circular No. 4<anchor n="5" xml:id="d8-f1"/> of the Department of
                    Labor containing the regulations governing <pb facs="0125" n="9" xml:id="pg9"/>
                    the admission and return of aliens participating in the Panama-Pacific
                    International Exposition and the Panama-California Exposition, to be held in
                    California in the year 1915.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Wilbur J. Carr</hi></signed>.</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d8-f1" n="5" xml:id="d8-f1-content">
                <p>Not printed. It supplements No. 3, referred to in the preceding circular
                    concerning Chinese participants.</p>
            </note>
        </listAnnotation>
    </standOff>
