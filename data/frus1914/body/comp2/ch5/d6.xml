    <text>
        <body>
            <div xml:id="d6">

                <pb facs="0124" n="8" sameAs="frus:frus1914/pg8"/>

                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-05-15">
                            <hi rendition="#italic">May 15, 1914</hi></date>.</dateline>
                </opener>
                <p rendition="#flush">
                    <hi rendition="#italic">To the Diplomatic Officers of the United
                    States</hi>.</p>
                <p>
                    <hi rendition="#small-caps">Gentlemen</hi>: By joint resolution approved May 9,
                    1914, the President is authorized to extend invitations to foreign Governments
                    to be represented by delegates at the Nineteenth International Congress of
                    Americanists, to be held at the city of Washington in October of the year
                    1914.</p>
                <p>You will accordingly extend to the Governments to which you are respectively
                    accredited a cordial official invitation to be represented by delegates at the
                    Congress mentioned; and in doing so you will add an expression of the pleasure
                    with which the Government of the United States will learn of the acceptance of
                    the invitation.</p>
                <p>The enclosed preliminary program of the Congress is furnished for the information
                    of the invited Government.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi></signed>.</closer>
            </div>
        </body>
    </text>
