            <div xml:id="d4">

                <pb facs="0121" n="5" sameAs="frus:frus1914/pg5"/>

                <note rend="inline" type="source">File No. 132.22/3.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-02-21">
                            <hi rendition="#italic">February 21, 1914</hi></date>.</dateline>
                </opener>
                <p rendition="#flush"><hi rendition="#italic">To the Diplomatic and Consular
                        Officers of the United States in China</hi>.</p>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department sends you herewith, for
                    your information, a copy of its instruction No. 16 of February 13, 1914, to the
                    Consul General at Shanghai concerning the status of Chinese women and women
                    partly of Chinese descent who are the wives or widows of American citizens.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Wilbur J. Carr</hi></signed>.</closer>



                <xi:include href="d4-a1.xml" xpointer="d4-a1"/>
