    <text>
        <body>
            <div xml:id="d1653">

                <pb facs="1053" n="937" sameAs="frus:frus1914/pg937"/>

                <note rend="inline" type="source">File No. 511.4A1/1488.</note>
                <head>
                    <hi rendition="#italic">Minister Williams to
                        the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Athens</hi></placeName>, <date
                            calendar="gregorian" when="1914-07-10">
                            <hi rendition="#italic">July 10, 1914</hi></date>.</dateline>
                </opener>
                <p>Greek Government accepts without reservation Opium Convention.
                    Congratulations.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Williams</hi></signed>.</closer>
            </div>
        </body>
    </text>
