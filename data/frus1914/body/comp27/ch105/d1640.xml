    <text>
        <body>
            <div xml:id="d1640">

                <pb facs="1040" n="924" sameAs="frus:frus1914/pg924"/>

                <note rend="inline" type="source">File No. 511.4A1/1429.</note>
                <head>
                    <hi rendition="#italic">The Chargé d’Affaires of the Netherlands to the
                        Secretary of State.</hi><anchor n="2" xml:id="d1640-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Translation.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Legation of the Netherlands</hi>, <lb/>
                            <hi rendition="#italic">Bar Harbor</hi></placeName>, <date
                            calendar="gregorian" when="1913-09-22">
                            <hi rendition="#italic">September 22, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary of State</hi>: * * * I have the honor
                    to transmit herewith to your excellency a certified copy of the Final Protocol
                    of the Second International Opium Conference, 1913.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">F. M. Schmolck</hi></signed>.</closer>


                <xi:include href="d1640-a1.xml" xpointer="d1640-a1"/>
            </div>
        </body>
    </text>
