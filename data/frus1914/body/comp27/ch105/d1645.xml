    <text>
        <body>
            <div xml:id="d1645">

                <pb facs="1043" n="927" sameAs="frus:frus1914/pg927"/>

                <note rend="inline" type="source">File No. 511.4A1/1469.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <seg rendition="#float-left">No. 2424.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Legation of the Netherlands</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-05-12">
                            <hi rendition="#italic">May 12, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary of State</hi>: Referring to your
                    communication of the 19th [18th] of April last, I have the honor of bringing to
                    your attention the fact that it appears from a telegram which I have just
                    received from my Government that the Opium Conference will meet at The Hague on
                    the 15th of next June.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. L. F. C. de Rappard</hi></signed>.</closer>
            </div>
        </body>
