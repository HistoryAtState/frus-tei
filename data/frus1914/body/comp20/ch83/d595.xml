    <text>
        <body>
            <div xml:id="d595">

                <pb facs="0501" n="385" sameAs="frus:frus1914/pg385"/>

                <note rend="inline" type="source">File No. 838.00/846.</note>
                <head>
                    <hi rendition="#italic">Consul Livingston to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Cape Haitien</hi></placeName>, <date
                            calendar="gregorian" when="1914-02-17">
                            <hi rendition="#italic">February 17, 1914</hi></date>.</dateline>
                </opener>
                <p>Wife of Charles Zamor with four children under twelve years wish to come into
                    Consulate in case of necessity.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Livingston</hi></signed>.</closer>
            </div>
        </body>
