    <text>
        <body>
            <div xml:id="d598">

                <pb facs="0502" n="386" sameAs="frus:frus1914/pg386"/>

                <note rend="inline" type="source">File No. 838.00/1014.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to Minister
                        Blanchard.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegrams.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-11-04">
                            <hi rendition="#italic">November 4, 1914</hi></date>.</dateline>
                </opener>
                <p>Your November 3. Action approved. You are authorized to take all necessary
                    measures for the protection of Charles Zamor and Cabinet.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi></signed>.</closer>
            </div>
        </body>
