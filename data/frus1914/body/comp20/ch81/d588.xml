    <text>
        <body>
            <div xml:id="d588">

                <pb facs="0498" n="382" sameAs="frus:frus1914/pg382"/>

                <note rend="inline" type="source">File No. 838.00/834.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Smith.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-02-13">
                            <hi rendition="#italic">February 13, 1914</hi></date>.</dateline>
                </opener>
                <p>If blockade of Cape Haitien by Haitian gunboat is effective, recognize
                    blockade.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
