    <text>
        <body>
            <div xml:id="d591">

                <pb facs="0500" n="384" sameAs="frus:frus1914/pg384"/>

                <note rend="inline" type="source">File No. 838.00/879.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <seg rendition="#float-left">No. 60.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Amercan Legation</hi>, <lb/>
                            <hi rendition="#italic">Port au Prince</hi></placeName>, <date
                            calendar="gregorian" when="1914-02-28">
                            <hi rendition="#italic">February 28, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to my despatch No. 57 of
                    February 20, 1914, relative to the blockade by the Haitian Government of the
                    various ports in the Republic, including that of Cape Haitien, the second port
                    in importance in Haiti, I have the honor to enclose herewith copy of an unsigned
                        communication<anchor n="9" xml:id="d591-f1"/> from the Haitian Foreign
                    Office dated February 27, 1914, announcing the lifting of the blockade by the
                    Haitian Government.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Madison R. Smith</hi></signed>.</closer>
            </div>
        </body>
    </text>
