    <text>
        <body>
            <div xml:id="d549">

                <pb facs="0477" n="361" sameAs="frus:frus1914/pg361"/>

                <note rend="inline" type="source">File No. 838.002/31.</note>
                <head>
                    <hi rendition="#italic">Minister Blanchard to
                        the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Port au Prince</hi></placeName>, <date
                            calendar="gregorian" when="1914-11-24T14:00:00-04:49">
                            <hi rendition="#italic">November 24, 1914, 2 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Bill introduced in Chamber of Deputies for the issue of 16,000,000 gourdes, paper
                    currency.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Blanchard</hi></signed>.</closer>
            </div>
