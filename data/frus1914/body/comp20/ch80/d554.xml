    <text>
        <body>
            <div xml:id="d554">

                <pb facs="0478" n="362" sameAs="frus:frus1914/pg362"/>

                <note rend="inline" type="source">File No. 838.00/1040.</note>
                <head>
                    <hi rendition="#italic">Minister Blanchard to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Extract.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Port au Prince</hi></placeName>, <date
                            calendar="gregorian" when="1914-12-01T09:00:00-04:49">
                            <hi rendition="#italic">December 1, 1914, 9 a.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>I respectfully request earliest possible instructions whether I am to negotiate
                    recognition of Theodore in conformity with instructions November 21, 7 p.m., or
                    November 24, 5 p.m.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Blanchard</hi></signed>.</closer>
            </div>
        </body>
