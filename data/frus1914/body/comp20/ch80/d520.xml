    <text>
        <body>
            <div xml:id="d520">

                <pb facs="0462" n="346" sameAs="frus:frus1914/pg346"/>

                <note rend="inline" type="source">File No. 838.00/935.</note>
                <head>
                    <hi rendition="#italic">Consul Livingston to
                        the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Cape Haitien</hi></placeName>, <date
                            calendar="gregorian" when="1914-06-19">
                            <hi rendition="#italic">June 19, 1914</hi></date>.</dateline>
                </opener>
                <p>Revolutionists interfering with operations of railroad, whole line in their
                    possession, train overdue, wires cut and handcar fired on. Warship
                    necessary.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Livingston</hi></signed>.</closer>
            </div>
        </body>
