            <div xml:id="d524">

                <pb facs="0463" n="347" sameAs="frus:frus1914/pg347"/>

                <note rend="inline" type="source">File No. 838.00/930.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Consul Livingston.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-06-26">
                            <hi rendition="#italic">June 26, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received your despatch
                    No. 231 of May 26, 1914, with regard to the revolutionary situation in
                    Haiti.</p>
                <p>The despatch has been read with interest by the Department and it approves the
                    course pursued by you as outlined therein.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Wilbur J. Carr</hi></signed>.</closer>
            </div>
        </body>
