    <text>
        <body>
            <div xml:id="d574">

                <pb facs="0487" n="371" sameAs="frus:frus1914/pg371"/>

                <note rend="inline" type="source">File No. 838.00/1068.</note>
                <head>
                    <hi rendition="#italic">Minister Blanchard to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Port au Prince</hi></placeName>, <date
                            calendar="gregorian" when="1914-12-21T09:00:00-04:49">
                            <hi rendition="#italic">December 21, 1914, 9 a.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>My telegram December 15, 11 p.m. Instructions your December 12, 5 p.m. complied
                    with verbally morning of December 17 and in writing on the 19th upon request of
                    Minister of Foreign Affairs.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Blanchard</hi></signed>.</closer>
            </div>
        </body>
