    <text>
        <body>
            <div xml:id="d488">

                <pb facs="0450" n="334" sameAs="frus:frus1914/pg334"/>

                <note rend="inline" type="source">File No. 838.00/747.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister Smith.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-01-21">
                            <hi rendition="#italic">January 21, 1914</hi></date>.</dateline>
                </opener>
                <p>In view of the situation, <hi rendition="#italic">Nashville</hi> ordered to
                    proceed to Cape Haitien for protection of American interests. Keep Department
                    informed as to situation at Port au Prince.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
