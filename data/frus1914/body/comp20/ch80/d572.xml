    <text>
        <body>
            <div xml:id="d572">

                <pb facs="0486" n="370" sameAs="frus:frus1914/pg370"/>

                <note rend="inline" type="source">File No. 838.516/23.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Port au Prince</hi></placeName>, <date
                            calendar="gregorian" when="1914-12-18T10:00:00-04:49">
                            <hi rendition="#italic">December 18, 1914, 10 a.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your December 15, 6 p.m. Gold embarked yesterday <hi rendition="#italic"
                        >Machias</hi> by unarmed marines. No disturbance. <hi rendition="#italic"
                        >Machias</hi> sailed at two and <hi rendition="#italic">Hancock</hi> at five
                    p.m. <hi rendition="#italic">Wheeling</hi> in port.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Blanchard</hi></signed>.</closer>
            </div>
        </body>
