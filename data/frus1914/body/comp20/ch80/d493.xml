    <text>
        <body>
            <div xml:id="d493">

                <pb facs="0451" n="335" sameAs="frus:frus1914/pg335"/>

                <note rend="inline" type="source">File No. 838.00/762.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Consul Livingston.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-01-25">
                            <hi rendition="#italic">January 25, 1914</hi></date>.</dateline>
                </opener>
                <p>Your January 23. Use all possible persuasion to cause de facto administrators of
                    customs to respect Haiti’s obligations to National Bank of Haiti.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
