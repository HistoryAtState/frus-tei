    <text>
        <body>
            <div xml:id="d526">

                <pb facs="0467" n="351" xml:id="pg351"/>

                <note rend="inline" type="source">File No 838.00/949a.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Chargé Terres.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-07-09">
                            <hi rendition="#italic">July 9, 1914</hi></date>.</dateline>
                </opener>
                <p>American Consul at Cape Haitien and Commander of <hi rendition="#italic">South
                        Carolina</hi> have been instructed to cooperate for the advancement of
                    American interests with other Americans now at Cape Haitien. Commander <hi
                        rendition="#italic">South Carolina</hi> further instructed to proceed to
                    Port au Prince if so desired by you to convey you from that place to any part of
                    the Republic as requested by you. Keep in constant communication by wireless
                    with <hi rendition="#italic">South Carolina</hi> and advise Department by cable
                    fully as to situation.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
    </text>
