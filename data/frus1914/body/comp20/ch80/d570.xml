    <text>
        <body>
            <div xml:id="d570">

                <pb facs="0485" n="369" sameAs="frus:frus1914/pg369"/>

                <note rend="inline" type="source">File No. 838.516/17.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Minister Blanchard.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-12-15T18:00:00-05:00">
                            <hi rendition="#italic">December 15, 1914, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your December 14, 11 a.m. Request Commanding Officer <hi rendition="#italic"
                        >Hancock</hi> to land as many marines as necessary to furnish safe escort
                    for gold from bank to <hi rendition="#italic">Machias</hi>.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
