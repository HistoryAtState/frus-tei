    <text>
        <body>
            <div xml:id="d484">

                <pb facs="0446" n="330" sameAs="frus:frus1914/pg330"/>

                <note rend="inline" type="source">File No. 702.6811/40.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Chargé d’Affaires of
                        Greece.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 202.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-04-07">
                            <hi rendition="#italic">April 7, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: In further reply to your note of December
                    17, 1913, advising the Department [etc.] the Department herewith transmits to
                    you for your information a copy of a letter from the Attorney General to the
                    Department, dated April 1, 1914, in reply to the Department’s letter of March
                    28, 1914, calling attention to this case.</p>
                <p>Accept [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi></signed>.</closer>
            </div>
        </body>
    </text>
