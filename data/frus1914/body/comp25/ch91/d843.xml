    <text>
        <body>
            <div xml:id="d843">

                <pb facs="0689" n="573" xml:id="pg573"/>

                <note rend="inline" type="source">File No. 812.00/12612.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Brazilian Minister to Mexico.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-07-27">
                            <hi rendition="#italic">July 27, 1914</hi></date>.</dateline>
                </opener>
                <p>181. Substance your 98, July 26, has been communicated to Vice Consul Silliman at
                    Tampico, with appropriate instructions to convey same to General Carranza.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan</hi></signed>.</closer>
            </div>
        </body>
