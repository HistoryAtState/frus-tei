            <div xml:id="d941">

                <pb facs="0730" n="614" xml:id="pg614"/>

                <note rend="inline" type="source">File No. 812.00/13699.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <seg rendition="#float-left">No. 66.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Brazilian Legation</hi>, <lb/>
                            <hi rendition="#italic">Mexico City</hi></placeName>, <date
                            calendar="gregorian" when="1914-10-28">
                            <hi rendition="#italic">October 28, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Confirming my telegram No. 191 of October
                    27th, 10 p.m., I have the honor to enclose herewith translation of the note
                    referred to in said telegram, relative to the evacuation.</p>
                <p>With assurances [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. M. Cardoso de
                    Oliveira</hi></signed>.</closer>


                <xi:include href="d941-a1.xml" xpointer="d941-a1"/>
