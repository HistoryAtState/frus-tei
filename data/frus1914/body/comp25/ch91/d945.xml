    <text>
        <body>
            <div xml:id="d945">

                <pb facs="0732" n="616" sameAs="frus:frus1914/pg616"/>

                <note rend="inline" type="source">File No. 812.00/13610.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to Special Agent Canova.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-11-02">
                            <hi rendition="#italic">November 2, 1914</hi></date>.</dateline>
                </opener>
                <p>You are instructed informally to bring to the attention of the Convention the
                    following paraphrase of telegram No. 311 which <pb facs="0733" n="617"
                        xml:id="pg617"/> the Department sent to the Brazilian Minister on November
                    1, 10 p.m.</p>
                <p>[Text of paraphrase.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi></signed>.</closer>
            </div>
        </body>
