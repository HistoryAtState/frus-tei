            <div xml:id="d682">

                <pb facs="0577" n="461" sameAs="frus:frus1914/pg461"/>

                <note rend="inline" type="source">File No. 812.00/11659.</note>
                <head>
                    <hi rendition="#italic">Chargé O’Shaughnessy to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 2208.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico City</hi></placeName>, <date
                            calendar="gregorian" when="1914-04-15">
                            <hi rendition="#italic">April 15, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to my cablegram No. 841, of
                    April 10, 8 p.m., I have the honor to enclose herewith a translation of the note
                    mentioned therein.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Nelson O’Shaughnessy</hi></signed>.</closer>


                <xi:include href="d682-a1.xml" xpointer="d682-a1"/>
