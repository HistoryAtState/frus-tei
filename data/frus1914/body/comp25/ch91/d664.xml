    <text>
        <body>
            <div xml:id="d664">

                <pb facs="0567" n="451" xml:id="pg451"/>

                <note rend="inline" type="source">File No. 812.00/11988.</note>
                <head>
                    <hi rendition="#italic">Admiral Fletcher to the
                            Secretary of the Navy.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegrams.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>U. S. S. <hi rendition="#italic">Florida, <lb/> Vera
                            Cruz</hi></placeName>, <date calendar="gregorian"
                            when="1914-04-11T15:00:00-06:36">
                            <hi rendition="#italic">April 11, 1914, 3 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Mayo reports: <quote rend="blockquote">
                        <p>General Zaragoza has sent me official letter expressing regrets over
                            arrest of boat’s crew, stating was due to ignorance of officer; but with
                            reference to other stipulations has asked twenty-four hours delay, on
                            account poor communication, to consult his Government. Request being
                            reasonable was granted.</p>
                        <p rendition="#right">
                            <hi rendition="#small-caps">Mayo</hi>.</p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Fletcher</hi></signed>.</closer>


                <xi:include href="d664-a1.xml" xpointer="d664-a1"/>
            </div>
        </body>
    </text>
