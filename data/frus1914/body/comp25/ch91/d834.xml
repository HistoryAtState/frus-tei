            <div xml:id="d834">

                <pb facs="0686" n="570" xml:id="pg570"/>

                <note rend="inline" type="source">File No. 812.00/14052b.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Special Agent Carothers.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-07-23T17:00:00-05:00">
                            <hi rendition="#italic">July 23, 1914, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>By direction of the President I send the following to be communicated by you to
                    Villa at once.</p>
                <p>[The remainder is identical with that of the foregoing telegram to Mr.
                    Silliman.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
