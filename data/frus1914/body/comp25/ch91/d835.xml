                <note rend="inline" type="source">File No. 812.001H87/3.</note>
                <head>
                    <hi rendition="#italic">Vice Consul Bundy to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Kingston, Jamaica</hi></placeName>, <date
                            calendar="gregorian" when="1914-07-24">
                            <hi rendition="#italic">July 24, 1914</hi></date>.</dateline>
                </opener>
                <p>Huerta arrived by cruiser <hi rendition="#italic">Dresden</hi> July 24, 2
                    p.m.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bundy</hi></signed>.</closer>
            </div>
