    <text>
        <body>
            <div xml:id="d671-a1">

                <pb facs="0572" n="456" sameAs="frus:frus1914/pg456"/>

                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <date calendar="gregorian" when="1914-04-12T23:30:00">
                            <hi rendition="#italic">April 12, 1914, 11.30 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>I have received from Embassy, dated Sunday afternoon, April 12, the following:
                        <quote rend="blockquote">
                        <p>Positive refusal of Mexican Government, in writing, to accede to demand
                            of Admiral Mayo relative to the salute at Tampico.</p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Fletcher</hi></signed>.</closer>
            </div>
        </body>
    </text>
