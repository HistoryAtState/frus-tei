    <text>
        <body>
            <div xml:id="d796">

                <pb facs="0655" n="539" sameAs="frus:frus1914/pg539"/>

                <note rend="inline" type="source">File No. 812.00/12313.</note>
                <head>
                    <hi rendition="#italic">Secretary Dodge to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 21.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Special Commission of the President of <lb/>
                                the United States, Near the Mediators</hi>, <lb/>
                            <hi rendition="#italic">Niagara Falls, N. Y.</hi></placeName>, <date
                            calendar="gregorian" when="1914-06-17">
                            <hi rendition="#italic">June 17, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose to you
                    herewith a copy of a memorandum in which, for greater convenience, the plan
                    submitted by the Mediators to serve as a basis for discussion and the
                    suggestions for modifications of this plan contained in your telegram of the 3rd
                    instant, have been placed in parallel columns.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">H. Pergival Dodge</hi></signed>.</closer>


                <xi:include href="d796-a1.xml" xpointer="d796-a1"/>
            </div>
        </body>
    </text>
