    <text>
        <body>
            <div xml:id="d792">

                <pb facs="0650" n="534" sameAs="frus:frus1914/pg534"/>

                <note rend="inline" type="source">File No. 812.00/12271.</note>
                <head>
                    <hi rendition="#italic">Secretary Dodge to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 19.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Special Commission of the President of <lb/>
                                the United States, near the Mediators</hi>, <lb/>
                            <hi rendition="#italic">Niagara Falls</hi></placeName>, <date
                            calendar="gregorian" when="1914-06-15">
                            <hi rendition="#italic">June 15, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to my despatch No. 18 of the
                    present instant, I have the honor to enclose you herewith a copy of the reply of
                    the Mediators to General Carranza which was sent this afternoon and made public
                    here at the same time.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">H. Percival Dodge</hi></signed>.</closer>



                <xi:include href="d792-a1.xml" xpointer="d792-a1"/>
            </div>
