    <text>
        <body>
            <div xml:id="d852">

                <pb facs="0692" n="576" sameAs="frus:frus1914/pg576"/>

                <note rend="inline" type="source">File No. 812.00/12762.</note>
                <head>
                    <hi rendition="#italic">Vice Consul Silliman to
                        the Secretary of State.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Monterey</hi></placeName>, <date
                            calendar="gregorian" when="1914-07-31">
                            <hi rendition="#italic">July 31, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    translated copies of a communication received from Senor Isidro Fabela, Acting
                    Secretary of Foreign Relations for General Carranza, First Chief of the
                    Constitutionalist Army, relative to my communication sent General Carranza as to
                    the instruction from the Department<anchor n="55" xml:id="d852-f1"/> relative to
                    the naming by Francisco Carbajal of General Lauro Villar and David Gutierrez
                    Allende as his representatives to treat with General Carranza.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">John R. Silliman</hi></signed>.</closer>


                <xi:include href="d852-a1.xml" xpointer="d852-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d852-f1" n="55" xml:id="d852-f1-content">
