            <div xml:id="d925">

                <pb facs="0724" n="608" sameAs="frus:frus1914/pg608"/>

                <note rend="inline" type="source">File No. 812.00/13384.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Brazilian Minister to Mexico.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-10-01T19:00:00-05:00">
                            <hi rendition="#italic">October 1, 1914, 7 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>267. Department anxiously awaiting reply to its September 22 with reference to
                    guaranties against the exaction of further import duties, municipal taxes, etc.,
                    upon American evacuation of Vera Cruz.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan</hi></signed>.</closer>
            </div>
