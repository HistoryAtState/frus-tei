    <text>
        <body>
            <div xml:id="d890">

                <pb facs="0708" n="592" xml:id="pg592"/>

                <note rend="inline" type="source">File No. 812.00/13007.</note>
                <head>
                    <hi rendition="#italic">The Department of State to
                        Mr. R. Zubáran Capmany.</hi>
                </head>
                <p>The Department of State respectfully acknowledges the receipt of the note of Mr.
                    E. Zubáran Capmany, dated the 25th instant, saying that on the twenty-second day
                    of August of this year, General Don Venustiano Carranza, Chief of the
                    Constitutionalist Army of Mexico, took charge of the Executive power of the
                    Mexican Republic.</p>
                <closer>
                    <dateline rendition="#float-left">
                        <hi rendition="#small-caps">Department of State</hi>, <lb/>
                        <placeName>
                            <hi rendition="#italic">Washington</hi>
                        </placeName>, <date calendar="gregorian" when="1914-08-28"><hi
                                rendition="#italic">August 28, 1914</hi></date>.</dateline>
                </closer>
            </div>
        </body>
    </text>
