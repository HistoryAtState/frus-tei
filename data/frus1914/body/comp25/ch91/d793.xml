    <text>
        <body>
            <div xml:id="d793">

                <pb facs="0651" n="535" sameAs="frus:frus1914/pg535"/>

                <note rend="inline" type="source">File No. 812.00/12288.</note>
                <head>
                    <hi rendition="#italic">Secretary Dodge to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 20.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Special Commission of the President of <lb/>
                                the United States, near the Mediators</hi>, <lb/>
                            <hi rendition="#italic">Niagara Falls</hi></placeName>, <date
                            calendar="gregorian" when="1914-06-16">
                            <hi rendition="#italic">June 16, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to previous correspondence, I
                    have the honor to enclose to you herewith a copy of a letter dated the 15th
                    instant addressed by Mr. Justice Lamar to Mr. Rabasa, the senior Huerta
                    Representative, in reply to Mr. Rabasa’s letter of the 12th instant<anchor
                        n="38" xml:id="d793-f1"/> stating his objections to the plan submitted by
                    the American Commissioners to the Mediators.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">H. Percival Dodge</hi></signed>.</closer>


                <xi:include href="d793-a1.xml" xpointer="d793-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d793-f1" n="38" xml:id="d793-f1-content">
                <p>Inclosed with Commissioner Lamar’s No. 14 of June 12.</p>
            </note>
        </listAnnotation>
    </standOff>
