    <text>
        <body>
            <div xml:id="d961">

                <pb facs="0739" n="623" sameAs="frus:frus1914/pg623"/>

                <note rend="inline" type="source">File No. 812.00/13921.</note>
                <head>
                    <hi rendition="#italic">The Brazilian Minister to Mexico to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 82.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Brazilian Legation</hi>, <lb/>
                            <hi rendition="#italic">Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1914-11-16">
                            <hi rendition="#italic">November 16, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to the evacuation of Vera Cruz,
                    I have the honor to enclose herewith translations of two notes which I have
                    received on this subject in answer to my note of November 14.<anchor n="70"
                        xml:id="d961-f1"/>
                </p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. M. Cardoso de
                    Oliveira</hi></signed>.</closer>




                <xi:include href="d961-a1.xml" xpointer="d961-a1"/>
                <xi:include href="d961-a2.xml" xpointer="d961-a2"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d961-f1" n="70" xml:id="d961-f1-content">
                <p>In pursuance of the Department’s telegram of November 13, 11 p.m.</p>
            </note>
        </listAnnotation>
