            <div xml:id="d683">

                <pb facs="0578" n="462" sameAs="frus:frus1914/pg462"/>

                <note rend="inline" type="source">File No. 812.00/11658.</note>
                <head>
                    <hi rendition="#italic">Chargé O’Shaughnessy to
                        the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 2207.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Embassy</hi>, <lb/>
                            <hi rendition="#italic">Mexico City</hi></placeName>, <date
                            calendar="gregorian" when="1914-04-15">
                            <hi rendition="#italic">April 15, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: Referring to my cablegram No. 842, of
                    April 11, 1 p.m., regarding the arrest of the American marines at the port of
                    Tampico, I have the honor to enclose to you herewith a translation of the note
                    in question.</p>
                <p>I have [etc.].</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Nelson O’Shaughnessy</hi></signed>.</closer>


                <xi:include href="d683-a1.xml" xpointer="d683-a1"/>
