    <text>
        <body>
            <div xml:id="d877">

                <pb facs="0703" n="587" sameAs="frus:frus1914/pg587"/>

                <note rend="inline" type="source">File No. 812.00/12847.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Brazilian Minister to
                        Mexico.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-08-14">
                            <hi rendition="#italic">August 14, 1914</hi></date>.</dateline>
                </opener>
                <p>207. Your 126. Agreement satisfactory. Peaceful transfer of power is assured. The
                    President appreciates the ability with which you have handled this matter. Again
                    accept our thanks.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan</hi></signed>.</closer>
            </div>
        </body>
    </text>
