            <div xml:id="d759">

                <pb facs="0616" n="500" xml:id="pg500"/>

                <note rend="inline" type="source">File No. 812.00/12019.</note>
                <head>
                    <hi rendition="#italic">The Spanish Ambassador to the Secretary of State.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Spanish Embassy</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-05-15">
                            <hi rendition="#italic">May 15, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary</hi>: I have the honor to inform your
                    excellency that the Minister of Foreign Relations of Mexico has asked me to
                    telegraph to express in his name the most earnest thanks to the Government of
                    the United States for the attentions shown to the members of the Mexican
                    delegation on their arrival in the territory of the Union.</p>
                <p>I avail [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Juan Riaño</hi></signed>.</closer>
            </div>
        </body>
    </text>
