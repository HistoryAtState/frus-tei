                <pb facs="0574" n="458" sameAs="frus:frus1914/pg458"/>

                <note rend="inline" type="source">File No. 812.00/11486.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Chargé O’Shaughnessy.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-04-13T20:00:00-05:00">
                            <hi rendition="#italic">April 13, 1914, 8 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>747. Your 847, April 12, 2 p.m. We are investigating statements contained in
                    Huerta’s reply. Will answer tomorrow. In meantime hope Huerta will reconsider
                    position taken.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
