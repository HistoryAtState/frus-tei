    <text>
        <body>
            <div xml:id="d721">

                <pb facs="0598" n="482" sameAs="frus:frus1914/pg482"/>

                <note rend="inline" type="source">File No. 812.00/11744a.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Bolivian Minister.</hi><anchor n="16"
                        xml:id="d721-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-04-22">
                            <hi rendition="#italic">April 22, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith for
                    your information a copy of the address delivered by the President to Congress on
                    April 20, 1914, regarding the situation which has arisen in the dealings of the
                    United States with General Victoriano Huerta at Mexico City.</p>
                <p>Accept [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi></signed>.</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d721-f1" n="16" type="source" xml:id="d721-f1-content">
                <p>The same to the diplomatic representatives of China, Colombia, Costa Rica, Cuba,
                    Dominican Republic, Ecuador, Guatemala, Haiti, Honduras, Japan, Nicaragua,
                    Panama, Paraguay, Persia, Peru, Salvador, Siam, Uruguay, and Venezuela.</p>
            </note>
        </listAnnotation>
    </standOff>
