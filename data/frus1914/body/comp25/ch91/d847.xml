    <text>
        <body>
            <div xml:id="d847">

                <pb facs="0690" n="574" sameAs="frus:frus1914/pg574"/>

                <note rend="inline" type="source">File No. 812.00/12637.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Brazilian Minister to Mexico.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-07-28">
                            <hi rendition="#italic">July 28, 1914</hi></date>.</dateline>
                </opener>
                <p>181 bis. Suitable instructions are today being telegraphed to Vice Consul
                    Silliman at Tampico for presentation to Carranza in accordance with your 100,
                    July 27. Names of Constitutionalist delegates will be telegraphed as soon as
                    received.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan</hi></signed>.</closer>
            </div>
        </body>
