    <text>
        <body>
            <div xml:id="d803">

                <pb facs="0663" n="547" sameAs="frus:frus1914/pg547"/>

                <note rend="inline" type="source">File No. 812.00/12363.</note>
                <head>
                    <hi rendition="#italic">Secretary Dodge to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 24.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Prospect House</hi>, <lb/>
                            <hi rendition="#italic">Niagara Falls, N. T.</hi></placeName>, <date
                            calendar="gregorian" when="1914-06-25">
                            <hi rendition="#italic">June 25, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith a
                    summary of the proceedings of the fourth plenary conference of the mediation,
                    which was held last evening at 9.45, the substance of which appears in the
                    Commissioners’telegram.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">H. Percival Dodge</hi></signed>.</closer>




