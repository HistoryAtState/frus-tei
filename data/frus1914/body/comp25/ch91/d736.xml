    <text>
        <body>
            <div xml:id="d736">

                <pb facs="0607" n="491" sameAs="frus:frus1914/pg491"/>

                <note rend="inline" type="source">File No. 812.00/11744c.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                            American diplomatic missions.</hi><anchor
                        n="19" xml:id="d736-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Circular telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-04-26">
                            <hi rendition="#italic">April 26, 1914</hi></date>.</dateline>
                </opener>
                <p>Please communicate to the Foreign Office the following note from Ambassador of
                    Brazil and Ministers of Argentina and Chile, together with the President’s reply
                    through the Secretary of State.</p>
                <p>[Texts of the note of April 25 and the reply.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d736-f1" n="19" type="source" xml:id="d736-f1-content">
                <p>Sent to all missions in America and Europe and to Japan and China.</p>
            </note>
        </listAnnotation>
    </standOff>
