    <text>
        <body>
            <div xml:id="d1104">

                <pb facs="0803" n="687" sameAs="frus:frus1914/pg687"/>

                <note rend="inline" type="source">File No. 812.48/1375.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Vice Consul Simpich.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-05-11">
                            <hi rendition="#italic">May 11, 1914</hi></date>.</dateline>
                </opener>
                <p>Your May 9. You are authorized to advise Americans who have recently been
                    provided with transportation and assistance at the expense of this Government to
                    reach their homes in the United States that should they return to Mexico during
                    the present disturbed conditions in that country and later on be obliged to
                    leave they should not look to this Government for further assistance in the way
                    of transportation.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
    </text>
