    <text>
        <body>
            <div xml:id="d1097">

                <pb facs="0798" n="682" sameAs="frus:frus1914/pg682"/>

                <note rend="inline" type="source">File No. 312.11/4048.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            German Ambassador.</hi><anchor n="90"
                        xml:id="d1097-f1"/>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 996.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi>
                        </placeName>
                        <date calendar="gregorian" when="1914-05-06">
                            <hi rendition="#italic">May 6, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: The Secretary of the Navy has made
                    known to me information which he has received from the Commander-in-Chief <pb
                        facs="0799" n="683" xml:id="pg683"/> of our Atlantic Fleet of the assistance
                    rendered by German naval vessels in removing American refugees from Tampico to
                    American men of war off the mouth of the river.</p>
                <p>It has given me pleasure to instruct the American Ambassador at Berlin to express
                    to your Government the cordial thanks of the Government of the United States for
                    this friendly service.</p>
                <p>Accept [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi></signed>.</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1097-f1" n="90" type="source" xml:id="d1097-f1-content">
                <p>Mutatis mutandis to the French and British Embassies.</p>
            </note>
        </listAnnotation>
    </standOff>
