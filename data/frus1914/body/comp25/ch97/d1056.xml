    <text>
        <body>
            <div xml:id="d1056">

                <pb facs="0785" n="669" sameAs="frus:frus1914/pg669"/>

                <note rend="inline" type="source">File No. 312.115W31.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Special Agent Carothers.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-04-09">
                            <hi rendition="#italic">April 9, 1914</hi></date>.</dateline>
                </opener>
                <p>Following cable sent to Tampico:</p>
                <p>[Here follows telegram sent to Tampico April 9, 1914.]</p>
                <p>Please unofficially present the above to Carranza and say we hope he will give
                    those under his control instructions to observe strictly the recommendations
                    herein set forth.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
