            <div xml:id="d1066-a1">

                <pb facs="0789" n="673" xml:id="pg673"/>

                <p rendition="#center">
                    <hi rendition="#italic">Act of Congress for Relief of Americans in
                    Mexico</hi>.</p>
                <p rendition="#flush">
                    <hi rendition="#small-caps">Chap</hi>. 68.—An Act Providing an appropriation for
                    the relief and transportation of American citizens in Mexico.</p>
                <p>
                    <hi rendition="#italic">Be in enacted by the Senate and House of Representatives
                        of the United States of America in Congress assembled</hi>, That for the
                    relief of American citizens in Mexico, including transportation to their homes
                    in the United States, there is appropriated, out of any money in the Treasury
                    not otherwise appropriated, the sum of $500,000, to be expended at the
                    discretion of the President.</p>
                <closer><dateline rendition="#float-left">Approved, <date calendar="gregorian"
                            when="1914-04-24">April 24, 1914</date>.</dateline></closer>
            </div>
        </body>
