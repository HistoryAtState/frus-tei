            <div xml:id="d1094">

                <pb facs="0798" n="682" sameAs="frus:frus1914/pg682"/>

                <note rend="inline" type="source">File No. 312.11/4058.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Consul Letcher.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-05-04T16:00:00-05:00">
                            <hi rendition="#italic">May 4, 1914, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your May 2. Consul Canada telegraphs Department Emery now in Mexico City safe and
                    well.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
