    <text>
        <body>
            <div xml:id="d1198">

                <pb facs="0850" n="734" sameAs="frus:frus1914/pg734"/>

                <note rend="inline" type="source">File No. 812.512/189.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Vice Consul Stadden.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-02-24">
                            <hi rendition="#italic">February 24, 1914</hi></date>.</dateline>
                </opener>
                <p>Your February 21. If attempt is made to impose war tax on American citizens, you
                    will make formal protest.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
