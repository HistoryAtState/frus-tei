    <text>
        <body>
            <div xml:id="d1255">

                <pb facs="0872" n="756" sameAs="frus:frus1914/pg756"/>

                <note rend="inline" type="source">File No. 812.512/400.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tampico</hi></placeName>, <date
                            calendar="gregorian" when="1914-08-17T19:00:00-06:41">
                            <hi rendition="#italic">August 17, 1914, 7 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Referring my August 15. Nafarrate has referred matter of war contribution to
                    Governor Caballero and will take no further action relative to collection same
                    pending instructions from his superior officer.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bevan</hi></signed>.</closer>
            </div>
        </body>
