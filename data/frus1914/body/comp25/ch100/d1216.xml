    <text>
        <body>
            <div xml:id="d1216">

                <pb facs="0857" n="741" sameAs="frus:frus1914/pg741"/>

                <note rend="inline" type="source">File No. 812.6363/91.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Consul Miller.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-06-15">
                            <hi rendition="#italic">June 15, 1914</hi></date>.</dateline>
                </opener>
                <p>Your June 3, 8 p.m. In order to safeguard their possible future interests,
                    American citizens should be advised to pay oil production taxes under
                    protest.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
    </text>
