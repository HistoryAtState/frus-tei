            <div xml:id="d1196">

                <pb facs="0850" n="734" xml:id="pg734"/>

                <note rend="inline" type="source">File No. 812.512/19.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to Vice Consul Bowman.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-04-30">
                            <hi rendition="#italic">April 30, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received your despatch
                    No. 230 of April 12, 1913, with regard to the payment of taxes on mining claims
                    in Sonora owned by Americans.</p>
                <p>In this connection your attention is referred to the Department’s telegram of
                    April 26, 1913, [to Vice Consul Simpich] upon the subject.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wilbur J. Carr</hi></signed>.</closer>
            </div>
        </body>
    </text>
