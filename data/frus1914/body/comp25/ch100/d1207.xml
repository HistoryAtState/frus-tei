    <text>
        <body>
            <div xml:id="d1207">

                <pb facs="0852" n="736" sameAs="frus:frus1914/pg736"/>

                <note rend="inline" type="source">File No. 812.00/11224.</note>
                <head>
                    <hi rendition="#italic">Vice Consul Stadden to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Extract.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Mazanillo</hi></placeName>, <date
                            calendar="gregorian" when="1914-03-19">
                            <hi rendition="#italic">March 19, 1914</hi></date>.</dateline>
                </opener>
                <p>Referring to my telegram of February 26. Government persists in collecting war
                    tax. Americans request advice.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Stadden</hi></signed>.</closer>
            </div>
        </body>
