    <text>
        <body>
            <div xml:id="d1004">

                <pb facs="0761" n="645" sameAs="frus:frus1914/pg645"/>

                <note rend="inline" type="source">File No. 703.3212/11.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Brazilian Chargé d’Affaires.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-05-27">
                            <hi rendition="#italic">May 27, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose herewith for
                    the Embassy’s information a copy of a telegram from the President of the
                    American <pb facs="0762" n="646" xml:id="pg646"/> Colony in Mexico City,
                    informing the Department of a vote of thanks tendered to the Brazilian Minister
                    by the members of the American Colony for his services to Americans.</p>
                <p>Accept [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi></signed>.</closer>
            </div>
        </body>
    </text>
