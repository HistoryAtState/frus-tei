    <text>
        <body>
            <div xml:id="d1005">

                <pb facs="0762" n="646" sameAs="frus:frus1914/pg646"/>

                <note rend="inline" type="source">File No. 703.3212/13.</note>
                <head>
                    <hi rendition="#italic">The Brazilian Chargé
                            d’Affaires to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Brazilian Embassy</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-05-28">
                            <hi rendition="#italic">May 28, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary of State</hi>: I have the honor to
                    acknowledge the receipt of the note of the 27th instant from the Counselor for
                    the Department of State, Mr. Robert Lansing, forwarding to this Embassy copy of
                    a telegram from the President of the American Colony in Mexico City, informing
                    the Department of a vote of thanks tendered to the Brazilian Minister by the
                    members of the American Colony for his services to Americans.</p>
                <p>It will give me great pleasure to send to my Government this proof of the
                    appreciation for the services which Mr. J. M. Cardoso de Oliveira is rendering
                    to Americans in Mexico during this trying time.</p>
                <p>Thanking you [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">E. L. Chermont</hi></signed>.</closer>
            </div>
        </body>
    </text>
