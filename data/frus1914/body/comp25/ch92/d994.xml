    <text>
        <body>
            <div xml:id="d994">

                <pb facs="0758" n="642" sameAs="frus:frus1914/pg642"/>

                <note rend="inline" type="source">File No. 125.0012/86a.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to certain American Consuls in
                        Mexico.</hi><anchor n="80" xml:id="d994-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-04-26">
                            <hi rendition="#italic">April 26, 1914</hi></date>.</dateline>
                </opener>
                <p>If in your judgment conditions permit, you may return to your post and carry on
                    your consular duties unless there should be objection on the part of the local
                    authorities.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d994-f1" n="80" type="source" xml:id="d994-f1-content">
                <p>Sent to Nogales, Matamoros, Nuevo Laredo, Diaz and Juárez.</p>
            </note>
        </listAnnotation>
    </standOff>
