                <pb facs="0761" n="645" sameAs="frus:frus1914/pg645"/>

                <note rend="inline" type="source">File No. 703.3212/11.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            Brazilian Minister to Mexico.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-05-25">
                            <hi rendition="#italic">May 25, 1914</hi></date>.</dateline>
                </opener>
                <p>81. American Colony, Mexico City, May 23, telegraphed Department grateful thanks
                    to you for your untiring, splendid services rendered Americans and for your
                    watchful care in their behalf.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan</hi></signed>.</closer>
            </div>
        </body>
