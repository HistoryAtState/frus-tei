    <text>
        <body>
            <div xml:id="d1598">

                <pb facs="1010" n="894" sameAs="frus:frus1914/pg894"/>

                <note rend="inline" type="source">File No. 312.62/95.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the German Chargé
                        d’Affaires.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-08-08">
                            <hi rendition="#italic">August 8, 1914</hi></date>.</dateline>
                </opener>
                <p>Your telegram August 4th. This Government will continue to use its good offices
                    as it has done in the past.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan</hi></signed>.</closer>
            </div>
        </body>
