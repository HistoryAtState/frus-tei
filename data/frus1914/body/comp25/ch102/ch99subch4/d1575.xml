    <text>
        <body>
            <div xml:id="d1575">

                <pb facs="1002" n="886" sameAs="frus:frus1914/pg886"/>

                <note rend="inline" type="source">File No. 312.41/90.</note>
                <head>
                    <hi rendition="#italic">Special Agent Carothers to the Secretary of
                        State.</hi><anchor n="149" xml:id="d1575-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Extract.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#italic">El Paso</hi></placeName>, <date
                            calendar="gregorian" when="1914-02-14">
                            <hi rendition="#italic">February 14, 1914</hi></date>.</dateline>
                </opener>
                <p>Have interviewed Villa. Assure German Ambassador every protection will be given
                    German subjects at Torreon. Report by letter to-morrow.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">G. C. Carothers</hi></signed>.</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1575-f1" n="149" type="source" xml:id="d1575-f1-content">
                <p>Communicated to the German Ambassador February 16, 1914.</p>
            </note>
        </listAnnotation>
    </standOff>
