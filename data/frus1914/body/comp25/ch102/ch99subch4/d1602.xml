    <text>
        <body>
            <div xml:id="d1602">

                <pb facs="1011" n="895" sameAs="frus:frus1914/pg895"/>

                <note rend="inline" type="source">File No. 812.00/13745.</note>
                <head>
                    <hi rendition="#italic">Special Agent Carothers to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Extract.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Aguascalientes</hi></placeName>, <date
                            calendar="gregorian" when="1914-11-11T23:00:00-06:36">
                            <hi rendition="#italic">November 11, 1914, 11 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Referring to property in Zacatecas belonging to German Vice Consul at Guanajuato
                    General Villa has ordered investigated and return of property to owners.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Carothers</hi></signed>.</closer>
            </div>
        </body>
