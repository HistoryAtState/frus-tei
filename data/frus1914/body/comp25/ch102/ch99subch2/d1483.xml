    <text>
        <body>
            <div xml:id="d1483">

                <pb facs="0962" n="846" sameAs="frus:frus1914/pg846"/>

                <note rend="inline" type="source">File No. 312.41/101b.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Vice Consul
                        Simpich.</hi><anchor n="134" xml:id="d1483-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-02-21">
                            <hi rendition="#italic">February 21, 1914</hi></date>.</dateline>
                </opener>
                <p>British Ambassador communicates telegram from Mrs. Benton praying that her
                    husband’s body be recovered before decomposition sets in. Endeavor to secure
                    compliance with this request.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1483-f1" n="134" type="source" xml:id="d1483-f1-content">
                <p>Same to Consul Edwards.</p>
            </note>
        </listAnnotation>
    </standOff>
