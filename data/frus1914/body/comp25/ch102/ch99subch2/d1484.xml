            <div xml:id="d1484">

                <pb facs="0962" n="846" sameAs="frus:frus1914/pg846"/>

                <note rend="inline" type="source">File No. 312.41/124.</note>
                <head>
                    <hi rendition="#italic">Special Agent Carothers
                        to the Secretary of State.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">El Paso</hi></placeName>, <date
                            calendar="gregorian" when="1914-02-21">
                            <hi rendition="#italic">February 21, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose original copy
                    of the sentence under which William Benton was executed.<anchor n="135"
                        xml:id="d1484-f1"/>
                </p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">G. C. Carothers</hi></signed>.</closer>
            </div>
        </body>
    </text>
