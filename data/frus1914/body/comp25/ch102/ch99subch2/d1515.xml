    <text>
        <body>
            <div xml:id="d1515">

                <pb facs="0976" n="860" sameAs="frus:frus1914/pg860"/>

                <note rend="inline" type="source">File No. 812.00/11151.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Italian
                        Ambassador.</hi><anchor n="137" xml:id="d1515-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-03-14">
                            <hi rendition="#italic">March 14, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Ambassador</hi>: I take pleasure in
                    enclosing for your information a copy of a communication from General Carranza,
                    received through our Consul at Nogales yesterday.</p>
                <p>Assuring you [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan</hi></signed>.</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1515-f1" n="137" type="source" xml:id="d1515-f1-content">
                <p>The same to the Embassies of Austria-Hungary, France, Germany, Great Britain,
                    Japan and Spain.</p>
            </note>
        </listAnnotation>
    </standOff>
