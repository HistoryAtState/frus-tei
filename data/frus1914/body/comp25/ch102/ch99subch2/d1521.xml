    <text>
        <body>
            <div xml:id="d1521">

                <pb facs="0980" n="864" sameAs="frus:frus1914/pg864"/>

                <note rend="inline" type="source">File No. 312.41/258.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Consul Letcher.</hi><anchor n="139"
                        xml:id="d1521-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-06-24">
                            <hi rendition="#italic">June 24, 1914</hi></date>.</dateline>
                </opener>
                <p>At request of British Embassy you are instructed to support appropriate
                    representations of British Vice Consul to prevent sequestration of William S.
                    Benton property.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1521-f1" n="139" type="source" xml:id="d1521-f1-content">
                <p>Same to Consul Edwards at Ciudad Juarez.</p>
            </note>
        </listAnnotation>
    </standOff>
