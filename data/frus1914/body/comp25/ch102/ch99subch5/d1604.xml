    <text>
        <body>
            <div xml:id="d1604">

                <pb facs="1012" n="896" sameAs="frus:frus1914/pg896"/>

                <note rend="inline" type="source">File No. 312.93/58.</note>
                <head>
                    <hi rendition="#italic">Consul Miller to the
                            Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 986.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Tampico, Mexico</hi></placeName>, <date
                            calendar="gregorian" when="1914-01-05">
                            <hi rendition="#italic">January 5, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to quote herewith the
                    telegram received from the Chinese Legation in Mexico City thanking this office
                    for assistance rendered to Chinese subjects during the recent attack on Tampico:
                        <quote rend="blockquote">
                        <p>Please accept thanks this Legation for assistance afforded and protection
                            offered Chinese during recent bombardment Tampico.</p>
                        <p rendition="#right">
                            <hi rendition="#small-caps">Wo Chung Yen</hi>.</p>
                    </quote>
                </p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Clarence A. Miller</hi></signed>.</closer>
            </div>
        </body>
    </text>
