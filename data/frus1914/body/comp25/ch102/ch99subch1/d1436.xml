                <pb facs="0941" n="825" sameAs="frus:frus1914/pg825"/>

                <note rend="inline" type="source">File No. 312.52/353.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Vice Consul Silliman.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-07-29">
                            <hi rendition="#italic">July 29, 1914</hi></date>.</dateline>
                </opener>
                <p>Reported by Spanish Ambassador that Father Vilalta, Spanish subject, imprisoned
                    by Constitutionalists at Tepic.</p>
                <p>Please confer with General Carranza and say that this Government will greatly
                    appreciate it if he will give personal consideration to the case of Father
                    Vilalta.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
