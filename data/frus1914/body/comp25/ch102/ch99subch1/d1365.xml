            <div xml:id="d1365">

                <pb facs="0912" n="796" xml:id="pg796"/>

                <note rend="inline" type="source">File No. 312.52/194.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Consul Letcher.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-03-17">
                            <hi rendition="#italic">March 17, 1914</hi></date>.</dateline>
                </opener>
                <p>Your March 16. Take up on first suitable occasion with Carranza matter of
                    investigation of killing of Gonzalez brothers.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
    </text>
