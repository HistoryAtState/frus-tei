    <text>
        <body>
            <div xml:id="d1404">

                <pb facs="0929" n="813" sameAs="frus:frus1914/pg813"/>

                <note rend="inline" type="source">File No. 312.52/271b.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Special Agent Carothers.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-05-14">
                            <hi rendition="#italic">May 14, 1914</hi></date>.</dateline>
                </opener>
                <p>The following telegram has been sent to American Consulate at Durango: [Telegram
                    to Consul Hamm, May 14, 1914.]</p>
                <p>We suggest that you take the matter up with Villa also.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
