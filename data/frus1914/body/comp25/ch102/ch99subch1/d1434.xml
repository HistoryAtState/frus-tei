    <text>
        <body>
            <div xml:id="d1434">

                <pb facs="0941" n="825" xml:id="pg825"/>

                <note rend="inline" type="source">File No. 312.52/380.</note>
                <head>
                    <hi rendition="#italic">Consul Miller to the
                            Secretary of State.</hi><anchor n="128"
                        xml:id="d1434-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Tampico</hi></placeName>, <date
                            calendar="gregorian" when="1914-07-23">
                            <hi rendition="#italic">July 23, 1914</hi></date>.</dateline>
                </opener>
                <p>Marcial Guerrero, Spanish priest at Cerritos, San Luis Potosi, arrived Tampico.
                    Is detained at Jefatura de Armas awaiting transportation from country, he having
                    been expelled from country by order of military commander at Cerritos. Is a
                    Spanish subject.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Miller</hi></signed>.</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1434-f1" n="128" type="source" xml:id="d1434-f1-content">
                <p>Communicated to the Spanish Ambassador July 27, 1914.</p>
            </note>
        </listAnnotation>
    </standOff>
