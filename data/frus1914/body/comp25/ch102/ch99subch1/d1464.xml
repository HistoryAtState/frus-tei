    <text>
        <body>
            <div xml:id="d1464">

                <pb facs="0954" n="838" sameAs="frus:frus1914/pg838"/>

                <note rend="inline" type="source">File No. 312.52/488.</note>
                <head>
                    <hi rendition="#italic">Vice Consul Bevan to the Secretary of State.</hi><anchor
                        n="132" xml:id="d1464-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Tampico</hi></placeName>, <date
                            calendar="gregorian" when="1914-12-22">
                            <hi rendition="#italic">December 22, 1914</hi></date>.</dateline>
                </opener>
                <p>Julian Zorrilla was released this evening upon payment of 10,000 pesos and
                    condition he would leave Mexico immediately by steamer. Have sent him to Sabine,
                    Texas, on oil tanker.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bevan</hi></signed>.</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1464-f1" n="132" type="source" xml:id="d1464-f1-content">
                <p>Communicated to the Spanish Ambassador December 24, 1914.</p>
            </note>
