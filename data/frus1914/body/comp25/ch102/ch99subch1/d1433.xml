    <text>
        <body>
            <div xml:id="d1433">

                <pb facs="0940" n="824" sameAs="frus:frus1914/pg824"/>

                <note rend="inline" type="source">File No. 312.52/373.</note>
                <head>
                    <hi rendition="#italic">Consul General Hanna to the Secretary of
                        State.</hi><anchor n="127" xml:id="d1433-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate General</hi>, <lb/>
                            <hi rendition="#italic">Monterey</hi></placeName>, <date
                            calendar="gregorian" when="1914-07-17">
                            <hi rendition="#italic">July 17, 1914</hi></date>.</dateline>
                </opener>
                <p>Department’s July 16, Referring to reports coming to Spanish Ambassador
                    concerning priests being shot and imprisoned, have been brought to attention of
                    Carranza.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Hanna</hi></signed>.</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1433-f1" n="127" type="source" xml:id="d1433-f1-content">
                <p>Communicated to the Spanish Ambassador July 22, 1914.</p>
            </note>
        </listAnnotation>
