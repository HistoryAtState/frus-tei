    <text>
        <body>
            <div xml:id="d1549">

                <pb facs="0993" n="877" sameAs="frus:frus1914/pg877"/>

                <note rend="inline" type="source">File No. 312.51/71.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Special Agent
                        Canova.</hi><anchor n="145" xml:id="d1549-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-07-31">
                            <hi rendition="#italic">July 31, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: There is enclosed herewith, for your
                    information in connection with future representations that the Department may
                    direct you to take in regard to the situation of the French priests at
                    Zacatecas, a copy of the report from the French Consular Agent at El Paso,
                    Texas, covering the experiences of the Christian Brothers of the Zacatecas
                    School, which was transmitted to the Department in a note, dated July 23d, from
                    the French Embassy.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Wilbur J. Carr</hi></signed>.</closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d1549-f1" n="145" type="source" xml:id="d1549-f1-content">
                <p>Same to Special Agent Carothers, Chihuahua.</p>
            </note>
        </listAnnotation>
    </standOff>
