            <div xml:id="d1564">

                <pb facs="0998" n="882" xml:id="pg882"/>

                <note rend="inline" type="source">File No. 812.404/16.</note>
                <head>
                    <hi rendition="#italic">Consul Canada to the
                            Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1041.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate, <lb/>
                            Veracruz</hi></placeName>, <date calendar="gregorian" when="1914-09-25">
                            <hi rendition="#italic">September 25, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit inclosed
                    herewith an order from the Governor of the State of Veracruz to the Military
                    Authorities relative to the clergy.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Wm. W. Canada</hi></signed>.</closer>


                <xi:include href="d1564-a1.xml" xpointer="d1564-a1"/>
