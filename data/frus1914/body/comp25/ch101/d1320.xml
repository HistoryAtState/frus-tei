    <text>
        <body>
            <div xml:id="d1320">

                <pb facs="0893" n="777" sameAs="frus:frus1914/pg777"/>

                <note rend="inline" type="source">File No. 812.6363/105.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Consul Miller.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-06-10T17:00:00-05:00">
                            <hi rendition="#italic">June 10, 1914, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>Your June 5, 10 p.m. Please report full result of meeting of Oil Association,
                    held Saturday night, and what action was taken regarding loan of two hundred
                    thousand pesos requested by Constitutionalists.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
