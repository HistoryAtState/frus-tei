    <text>
        <body>
            <div xml:id="d1266">

                <pb facs="0877" n="761" xml:id="pg761"/>

                <note rend="inline" type="source">File No. 812.00/8448.</note>
                <head>
                    <hi rendition="#italic">Consul Letcher to the
                            Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram—Extract.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Chihuahua</hi></placeName>, <date
                            calendar="gregorian" when="1913-08-17">
                            <hi rendition="#italic">August 17, 1913</hi></date>.</dateline>
                </opener>
                <p>Acting Consular Agent, Parral, reports that rebels are threatening to force loan
                    from Americans and that situation there is growing most unsatisfactory.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Letcher</hi></signed>.</closer>
            </div>
        </body>
