    <text>
        <body>
            <div xml:id="d1265">

                <pb facs="0875" n="759" sameAs="frus:frus1914/pg759"/>

                <note rend="inline" type="source">File No. 812.00/8013.</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to Chargé O’Shaughnessy.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1375.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-07-21">
                            <hi rendition="#italic">July 21, 1913</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I enclose herewith a copy of a despatch
                    from the Consul at San Luis Potosi, in regard to political conditions in the
                    city and state of San Luis Potosi.</p>
                <p>You will bring to the attention of the appropriate authorities the outrages upon
                    American citizens committed by revolutionists in the San Luis Potosi Consular
                    district, and urgently request that adequate protection be afforded to American
                    lives and property in that section.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">J. B. Moore</hi></signed>.</closer>


                <xi:include href="d1265-a1.xml" xpointer="d1265-a1"/>
            </div>
        </body>
    </text>
