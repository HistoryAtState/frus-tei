    <text>
        <body>
            <div xml:id="d1331">

                <pb facs="0897" n="781" sameAs="frus:frus1914/pg781"/>

                <note rend="inline" type="source">File No. 312.115/106.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 532.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Guadalajara</hi></placeName>, <date
                            calendar="gregorian" when="1914-11-09">
                            <hi rendition="#italic">November 9, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>:* * * I have the honor to say that this
                    company [Compañía Galletera Nacional] has been advised direct from the tax
                    office, that the forced loan imposed upon them has been abrogated.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Will B. Davis</hi></signed>.</closer>
            </div>
        </body>
