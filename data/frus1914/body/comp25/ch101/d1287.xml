    <text>
        <body>
            <div xml:id="d1287">

                <pb facs="0882" n="766" sameAs="frus:frus1914/pg766"/>

                <note rend="inline" type="source">File No. 812.512/137.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to chargé O’Shaughnessy.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegrams.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1913-12-08">
                            <hi rendition="#italic">December 8, 1913</hi></date>.</dateline>
                </opener>
                <p>Your December 6. You are instructed to bring to attention of appropriate
                    authorities any illegal procedure in connection with the levying of taxes in
                    Sinaloa.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
