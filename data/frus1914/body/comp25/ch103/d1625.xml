    <text>
        <body>
            <div xml:id="d1625">

                <pb facs="1019" n="903" xml:id="pg903"/>

                <note rend="inline" type="source">File No. 811.0144/15.</note>
                <head>
                    <hi rendition="#italic">Consul Garrett to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Nuevo Laredo</hi></placeName>, <date
                            calendar="gregorian" when="1914-02-01">
                            <hi rendition="#italic">February 1, 1914</hi></date>.</dateline>
                </opener>
                <p>Samuel Cantú released and brought to Laredo, Texas, by myself at eleven o’clock
                    to-day.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Garrett</hi></signed>.</closer>
            </div>
        </body>
