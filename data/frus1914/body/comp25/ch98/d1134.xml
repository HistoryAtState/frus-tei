            <div xml:id="d1134">

                <pb facs="0815" n="699" sameAs="frus:frus1914/pg699"/>

                <note rend="inline" type="source">File No. 812.6363/47.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                            British Ambassador.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-05-08">
                            <hi rendition="#italic">May 8, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Ambassador</hi>: I beg to acknowledge
                    the receipt of your note of May 1, from which I am gratified to learn that you
                    concur in the suggestion in my note of the same day’s date regarding the
                    neutralization of the oil wells of Mexico.</p>
                <p>Thanking you [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. J. Bryan</hi></signed>.</closer>
            </div>
        </body>
