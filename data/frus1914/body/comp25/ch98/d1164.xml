                <pb facs="0830" n="714" sameAs="frus:frus1914/pg714"/>

                <note rend="inline" type="source">File No. 812.6363/139.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Vice Consul Bevan.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-09-30">
                            <hi rendition="#italic">September 30, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: The Department has received your despatch
                    No. 1210 of September 12, 1914, relative to the interpretation of the decree
                    affecting oil lands recently issued by Governor Candido Aguilar of the State of
                    Vera Cruz, Mexico, and saying that you have addressed a letter upon the subject
                    to the Governor.</p>
                <p>The Department awaits the receipt of the Governor’s reply to the inquiry
                    addressed to him.</p>
                <p>I am [etc.]</p>
                <closer>For the Secretary of State: <lb/>
                    <signed>
                        <hi rendition="#small-caps">Wilbur J. Carr</hi></signed>.</closer>
            </div>
        </body>
