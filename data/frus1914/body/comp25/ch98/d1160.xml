    <text>
        <body>
            <div xml:id="d1160">

                <pb facs="0826" n="710" sameAs="frus:frus1914/pg710"/>

                <note rend="inline" type="source">File No. 812.6363/130.</note>
                <head>
                    <hi rendition="#italic">Vice Consul Bevan to
                        the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 1182.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Consulate</hi>, <lb/>
                            <hi rendition="#italic">Tampico</hi></placeName>, <date
                            calendar="gregorian" when="1914-08-14">
                            <hi rendition="#italic">August 14, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to enclose a copy of a
                    decree issued by Governor Cándido Aguilar of the State of Veracruz, relative to
                    leasing oil lands in the State of Veracruz.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Thomas H. Bevan</hi></signed>.</closer>



                <xi:include href="d1160-a1.xml" xpointer="d1160-a1"/>
            </div>
