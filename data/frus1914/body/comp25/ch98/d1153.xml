        <body>
            <div xml:id="d1153">

                <pb facs="0824" n="708" sameAs="frus:frus1914/pg708"/>

                <note rend="inline" type="source">File No. 812.6363/87.</note>
                <head>
                    <hi rendition="#italic">The Netherlands Minister to the Secretary of State.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The Netherlands Legation</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-06-02">
                            <hi rendition="#italic">June 2, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Excellency</hi>: I have the honor to acknowledge
                    receipt of your note of to-day, in which is stated: [Quotes note of June 2,
                    1914, printed on the preceding page.]</p>
                <p>I have the honor to inform you in reply that I am authorized by my Government to
                    accept in their name the agreement as described above, which they will therefore
                    regard as coming into effect from this day’s date.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">W. L. F. C. de Rappard</hi></signed>.</closer>
            </div>
        </body>
    </text>
