    <text>
        <body>
            <div xml:id="d1146">

                <pb facs="0820" n="704" sameAs="frus:frus1914/pg704"/>

                <note rend="inline" type="source">File No. 812.6363/70b.</note>
                <head ana="#head_untitled-inferred-from-preceding-sibling-head">[Untitled]</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-05-20">
                            <hi rendition="#italic">May 20, 1914</hi></date>.</dateline>
                </opener>
                <p>Repeat to Vice Consul of the Netherlands, Tampico, following telegram from the
                    Netherlands Minister at Washington: <quote rend="blockquote">
                        <p>Conform yourself following telegram sent today by Secretary of State to
                            American Consul saying: [Quotes telegram to Consul Canada, May 20,
                            1914.]</p>
                        <p rendition="#right">
                            <hi rendition="#small-caps">Rappard</hi>.</p>
                    </quote>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
    </text>
