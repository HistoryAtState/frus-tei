            <div xml:id="d1172">

                <pb facs="0835" n="719" sameAs="frus:frus1914/pg719"/>

                <note rend="inline" type="source">File No. 812.63/8.</note>
                <head>
                    <hi rendition="#italic">The British charge d’Affaires
                        to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 207]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">British Embassy</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-06-24">
                            <hi rendition="#italic">June 24, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honour to acknowledge the
                    receipt of your note dated today in which you state: [Quotes third, fourth and
                    fifth paragraphs of note to the British charge d’Affaires, dated June 24,
                    1914.]</p>
                <p>I have the honour to inform you in reply that I am authorised by my Government to
                    accept in their name the agreement as described above, which they will therefore
                    regard as coming into effect from this day’s date.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Colville Barclay</hi></signed>.</closer>
            </div>
        </body>
    </text>
