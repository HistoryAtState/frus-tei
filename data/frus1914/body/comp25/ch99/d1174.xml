            <div xml:id="d1174">

                <pb facs="0836" n="720" sameAs="frus:frus1914/pg720"/>

                <note rend="inline" type="source">File No. 812.63/11.</note>
                <head>
                    <hi rendition="#italic">The Spanish Ambassador to the Secretary of State.</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Spanish Embassy</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-07-06">
                            <hi rendition="#italic">July 6, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary</hi>: I have the honor to acknowledge
                    receipt of your excellency’s note of July 2, 1914, in which you state: [Quotes
                    Spanish translation of note to the Spanish Ambassador of July 2, 1914.]</p>
                <p>I have the honor, in reply to this note, to inform you that I am authorized by my
                    Government to accept the agreement proposed by your excellency, and I do accept
                    it, at the same time assuring you of my highest consideration.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Juan Riaño</hi></signed>.</closer>
            </div>
        </body>
    </text>
