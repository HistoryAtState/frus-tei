                <pb facs="0777" n="661" sameAs="frus:frus1914/pg661"/>

                <note rend="inline" type="source">File No. 125.8273/38a.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Consul General Hanna.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-05-04">
                            <hi rendition="#italic">May 4, 1914</hi></date>.</dateline>
                </opener>
                <p>Press despatches from Vera Cruz report Silliman a prisoner of General Maas for
                    eleven days and threatened with execution. Make every effort to communicate with
                    him; learn facts.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
    </text>
