                <pb facs="0782" n="666" sameAs="frus:frus1914/pg666"/>

                <note rend="inline" type="source">File No. 125.8273/68.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Consul Canada.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-05-26">
                            <hi rendition="#italic">May 26, 1914</hi></date>.</dateline>
                </opener>
                <p>Your May 26, 11 a.m. Mr. Silliman himself may draw for necessary funds.
                    Department would be glad to have him come to Washington as soon as he feels
                    physically able to make the trip.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
