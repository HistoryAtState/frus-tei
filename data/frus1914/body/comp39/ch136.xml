                <pb facs="1204" n="1088" sameAs="frus:frus1914/pg1088"/>

                <head>Arbitration agreement between the United States and Switzerland, extending the
                    duration of the Convention of February 29, 1908</head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at Washington, November 3, 1913; ratification
                        advised by the Senate, February 21, 1914; ratified by the President, March
                        23, 1914; ratified by Switzerland, March 10, 1914; ratifications exchanged
                        at Washington, April 27, 1914; proclaimed, April 28, 1914</hi>.</p>

                <xi:include href="ch136/d1835.xml" xpointer="d1835"/>
