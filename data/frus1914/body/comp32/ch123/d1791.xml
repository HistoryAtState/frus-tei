    <text>
        <body>
            <div xml:id="d1791">

                <pb facs="1175" n="1059" sameAs="frus:frus1914/pg1059"/>

                <note rend="inline" type="source">File No. 891.001/30.</note>
                <head>
                    <hi rendition="#italic">Minister Russell to the
                            Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Teheran</hi></placeName>, <date
                            calendar="gregorian" when="1914-07-14">
                            <hi rendition="#italic">July 14, 1914</hi></date>.</dateline>
                </opener>
                <p>Ministry for Foreign Affairs wants you to telegraph constituting me a Special
                    Ambassador at the coronation of the Shah same as the other Ministers.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Russell</hi></signed>.</closer>
            </div>
        </body>
