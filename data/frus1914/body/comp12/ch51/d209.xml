                <note rend="inline" type="source">File No. 837.13/30.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State of
                        Minister Gonzales.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washing ton</hi></placeName>, <date
                            calendar="gregorian" when="1914-12-04">
                            <hi rendition="#italic">December 4, 1914</hi></date>.</dateline>
                </opener>
                <p>Your November 27. Department has no especial interest in this case.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
