            <div xml:id="ch133">

                <pb facs="1198" n="1082" sameAs="frus:frus1914/pg1082"/>

                <head>Treaty for the advancement of general peace, concluded between the United
                    States and Spain</head>
                <p rendition="#flush">
                    <hi rendition="#italic">Signed at Washington, September 15, 1914; ratification
                        advised by the Senate, September 25, 1914; ratified by the President,
                        November 23, 1914; ratified by Spain, November 23, 1914; ratifications
                        exchanged at Washington, December 21, 1914; proclaimed, December 23,
                        1914</hi>.</p>

                <xi:include href="ch133/d1833.xml" xpointer="d1833"/>
