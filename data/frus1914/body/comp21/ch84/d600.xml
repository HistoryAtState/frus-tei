    <text>
        <body>
            <div xml:id="d600">

                <pb facs="0503" n="387" sameAs="frus:frus1914/pg387"/>

                <note rend="inline" type="source">File No. 815.032/8.</note>
                <head>
                    <hi rendition="#italic">Minister Ewing to the Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Extract.]</seg>
                </opener>
                <opener>
                    <seg rendition="#float-left">No. 3.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Tegucigalpa</hi></placeName>, <date
                            calendar="gregorian" when="1914-01-24">
                            <hi rendition="#italic">January 24, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    copies of the message read at the opening of the National Congress on January 1
                    by the President of the Republic, Dr. Francisco Bertrand.* * *</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Jno. Ewing</hi></signed>.</closer>


                <xi:include href="d600-a1.xml" xpointer="d600-a1"/>
