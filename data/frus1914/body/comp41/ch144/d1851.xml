    <text>
        <body>
            <div xml:id="d1851">

                <pb facs="1216" n="1100" xml:id="pg1100"/>

                <note rend="inline" type="source">File No. 831.404/10.</note>
                <head>
                    <hi rendition="#italic">Chargé Caffery to the
                            Secretary of State.</hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 134.]</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">American Legation</hi>, <lb/>
                            <hi rendition="#italic">Caracas</hi></placeName>, <date
                            calendar="gregorian" when="1914-01-02">
                            <hi rendition="#italic">January 2, 1914</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to my despatch No. 99 of
                    October 26, 1911, in regard to the extensions of the provisions of the law of
                    ecclesiastical patronage to foreign missionary societies, I have the honor to
                    enclose herewith copies of a letter<anchor n="1" xml:id="d1851-f1"/> presented
                    to me in triplicate by some of the American missionaries established in
                    Venezuela.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Jefferson Caffery</hi></signed>.</closer>
            </div>
        </body>
    </text>
