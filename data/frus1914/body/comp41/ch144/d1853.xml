    <text>
        <body>
            <div xml:id="d1853">

                <pb facs="1218" n="1102" sameAs="frus:frus1914/pg1102"/>

                <note rend="inline" type="source">File No. 831.404/13a.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Minister McGoodwin.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-04-16">
                            <hi rendition="#italic">April 16, 1914</hi></date>.</dateline>
                </opener>
                <p>You will please express the interest of the Government of the United States in
                    obtaining permission for American clergymen to exercise the ministry in the
                    Republic of Venezuela and the introduction of this measure into the revised
                    Constitution.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
