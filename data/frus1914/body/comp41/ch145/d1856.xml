    <text>
        <body>
            <div xml:id="d1856">

                <pb facs="1220" n="1104" sameAs="frus:frus1914/pg1104"/>

                <note rend="inline" type="source">File No. 701.3111/40.</note>
                <head>
                    <hi rendition="#italic">The Venezuelan Chargé
                            d’Affaires to the Secretary of
                        State.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Venezuelan Legation</hi>, <lb/>
                            <hi rendition="#italic">Atlantic City, New Jersey</hi></placeName>,
                            <date calendar="gregorian" when="1914-06-26">June 26,
                        1914</date>.</dateline>
                </opener>
                <p>It becomes my duty to inform your excellency that Senor Rojas, Minister of
                    Venezuela, died today in this city and that in my capacity as Secretary of the
                    Legation, I have taken charge as Chargé d’Affaires ad interim.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Luis Churion</hi></signed>.</closer>
            </div>
        </body>
