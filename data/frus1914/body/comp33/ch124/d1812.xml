    <text>
        <body>
            <div xml:id="d1812">

                <pb facs="1182" n="1066" sameAs="frus:frus1914/pg1066"/>

                <note rend="inline" type="source">File No. 823.00/178a.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to
                        Minister McMillin.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-05-26">
                            <hi rendition="#italic">May 26, 1914</hi></date>.</dateline>
                </opener>
                <p>You are instructed to call on the Minister for Foreign Affairs on May 27 and
                    inform him that the United States recognizes the Government of Colonel Benavides
                    as the Provisional Government of Peru. Inform diplomatic representatives of
                    Argentina, Brazil and Chile at Lima, in order that they may recognize at the
                    same time.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
