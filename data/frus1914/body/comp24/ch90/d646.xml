    <text>
        <body>
            <div xml:id="d646">

                <pb facs="0557" n="441" sameAs="frus:frus1914/pg441"/>

                <note rend="inline" type="source">File No. 882.51/623.</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to Minister Buchner.</hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram.]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Department of State</hi>, <lb/>
                            <hi rendition="#italic">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1914-09-30">
                            <hi rendition="#italic">September 30, 1914</hi></date>.</dateline>
                </opener>
                <p>Your September 24. Cable more definite information regarding condition of
                    American missionaries in Liberia and also needs of Liberians.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Bryan</hi></signed>.</closer>
            </div>
        </body>
