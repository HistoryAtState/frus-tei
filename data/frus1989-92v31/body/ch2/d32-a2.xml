                <head>Agenda Prepared in the National Security Council Staff<anchor n="7"
                        xml:id="d32-f1"/></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian">undated</date></dateline>
                </opener>
                <p rendition="#center"><hi rendition="#italic">NATIONAL SECURITY COUNCIL
                        MEETING</hi></p>
                <p rendition="#center">DATE: June 15, 1989</p>
                <p rendition="#center">Location: Cabinet Room</p>
                <p rendition="#center">TIME: 3:00–4:00 P.M.</p>
                <p rendition="#center"><hi rendition="#italic">START AND DEFENSE &amp; SPACE ISSUES</hi></p>
                <list>
                    <label>I.</label>
                    <item>Opening Statement The President</item>
                    <label>II.</label>
                    <item>START and Defense &amp; Space
                        Objectives Issues Overview Brent
                            Scowcroft</item>
                    <label>III.</label>
                    <item>Discussion All Participants</item>
                    <label>IV.</label>
                    <item>Summary Brent Scowcroft</item>
                </list>
            </div>
        </body>
