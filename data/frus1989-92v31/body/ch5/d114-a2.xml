                <list>
                    <label>1.</label>
                    <item>ALCMs</item>
                    <label>2.</label>
                    <item>SLCMs</item>
                    <label>3.</label>
                    <item>Follow-on negotiations</item>
                    <label>4.</label>
                    <item>Heavy ICBMs</item>
                </list>
                <p rendition="#section-heading #italic">Other Issues</p>
                <list>
                    <label>1.</label>
                    <item>Heavy bomber definiton</item>
                    <label>2.</label>
                    <item>Former heavy bomber definition</item>
                    <label>3.</label>
                    <item>Elimination of warheads</item>
                </list>
            </div>
