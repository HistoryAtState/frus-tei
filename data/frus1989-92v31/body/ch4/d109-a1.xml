                <head>Paper Prepared in the National Security Council<anchor n="3" xml:id="d109-f1"
                    /></head>
                <opener>
                    <dateline rendition="#float-right"><placeName>Washington</placeName>, <date
                            calendar="gregorian" when="1990-04-09">April 9, 1990</date></dateline>
                </opener>
                <p rendition="#center"><hi rendition="#bold"><hi rendition="#italic">START Issues
                            for Principals</hi></hi></p>
                <table>
                    <row role="label">
                        <cell><hi rendition="#italic">Issue</hi></cell>
                        <cell cols="2"><hi rendition="#italic">Tentative Meeting Dates</hi></cell>
                    </row>
                    <row>
                        <cell/>
                        <cell><hi rendition="#italic">Ungroup</hi></cell>
                        <cell><hi rendition="#italic">Principals</hi></cell>
                    </row>
                    <row>
                        <cell>1. <hi rendition="#bold">Central Limits</hi>
                            <list>
                                <label>—</label>
                                <item>SLCMs</item>
                                <label>—</label>
                                <item>ALCMs</item>
                                <label>—</label>
                                <item>Mobile ICBM Sublimits</item>
                                <label>—</label>
                                <item>Heavy ICBM Limits</item>
                            </list></cell>
                        <cell>4/16&amp;19</cell>
                        <cell>4/23</cell>
                    </row>
                    <row>
                        <cell>2. <hi rendition="#bold">New Kinds</hi>
                            <list>
                                <label>—</label>
                                <item>ASBMs</item>
                                <label>—</label>
                                <item>ICCMs</item>
                            </list></cell>
                        <cell>4/19</cell>
                        <cell>4/23</cell>
                    </row>
                    <row>
                        <cell>3. <hi rendition="#bold">Inspections</hi>
                            <list>
                                <label>—</label>
                                <item>PPCM</item>
                                <label>—</label>
                                <item>SSI</item>
                            </list></cell>
                        <cell>4/24</cell>
                        <cell>4/27</cell>
                    </row>
                    <row>
                        <cell>4. <hi rendition="#bold">RV Counting</hi>
                            <list>
                                <label>—</label>
                                <item>New Types Definition for Ballistic Missiles</item>
                                <label>—</label>
                                <item>RV Attribution for New Types</item>
                            </list></cell>
                        <cell>4/26</cell>
                        <cell>4/27</cell>
                    </row>
                    <row>
                        <cell>5. <hi rendition="#bold">Third Country Basing/Inspections</hi></cell>
                        <cell>4/30</cell>
                        <cell>5/4</cell>
                    </row>
                </table>
