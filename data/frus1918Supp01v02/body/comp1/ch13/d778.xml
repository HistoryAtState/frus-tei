    <text>
        <body>
            <div xml:id="d778">

                <pb facs="0887" n="1721" sameAs="frus:frus1918Supp01v02/pg1721"/>

                <note rend="inline" type="source">File No. 127.6/5a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Spain</hi> (<hi rendition="#italic">Willard</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-09-03T14:00:00-04:00">
                            <hi rendition="#italic">September 3, 1918, 2 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1504. Advise Department at once if there is any action which you wish the War
                    Trade Board to take in order to assist you in the present delicate diplomatic
                    situation in Spain.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
