    <text>
        <body>
            <div xml:id="d790">

                <pb facs="0894" n="1728" xml:id="pg1728"/>

                <note rend="inline" type="source">File No. 862.85/627a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Spain</hi>
                        (<hi rendition="#italic">Willard</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-11-07T16:00:00-05:00">
                            <hi rendition="#italic">November 7, 1918, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1782. Please ascertain and report by cable [details] of recent transfer of German
                    vessels to Spanish Government. Department understands that this transfer is not
                    absolute and that British Ambassador has informed Spanish Government that the
                    vessels will be seized if found outside Spanish territorial waters.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
