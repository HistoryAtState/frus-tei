    <text>
        <body>
            <div xml:id="d32">

                <pb facs="0118" n="952" sameAs="frus:frus1918Supp01v02/pg952"/>

                <note rend="inline" type="source">File No. 763.72/8526</note>
                <head>
                    <hi rendition="#italic">The Counselor for the Department of State</hi> (<hi
                        rendition="#italic">Polk</hi>) <hi rendition="#italic">to Major Grimprel of
                        the French High Commission</hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-01-30">
                            <hi rendition="#italic">January 30, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Major Grimprel</hi>: Referring to your
                    letter of the 11th instant, I beg to advise you that at the present time this
                    Government is not prepared to appoint a representative on the Permanent
                    International Committee on Economic Action.</p>
                <p>Yours sincerely,</p>
                <closer>[<signed>
                        <hi rendition="#small-caps">Frank L. Polk</hi>
                    </signed>]</closer>
            </div>
        </body>
    </text>
