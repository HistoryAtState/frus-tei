    <text>
        <body>
            <div xml:id="d46">

                <pb facs="0131" n="965" sameAs="frus:frus1918Supp01v02/pg965"/>

                <note rend="inline" type="source">File No. 656.119/178b</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in the
                        Netherlands</hi> (<hi rendition="#italic">Garrett</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-02-19T19:00:00-05:00">
                            <hi rendition="#italic">February 19, 1918, 7 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>991. War Trade Board in agreement with British and French will, beginning
                    February 20, consider applications for licenses to export to Sweden and Holland
                    certain commodities, a list of which we understand has been furnished you by
                    American Embassy, London.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
