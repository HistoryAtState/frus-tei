    <text>
        <body>
            <div xml:id="d59">

                <pb facs="0138" n="972" sameAs="frus:frus1918Supp01v02/pg972"/>

                <note rend="inline" type="source">File No. 600.119/620</note>
                <head>
                    <hi rendition="#italic">The Commercial Adviser of the British Embassy</hi> (<hi
                        rendition="#italic">Crawford</hi>) <hi rendition="#italic">to the Counselor
                        for the Department of State</hi> (<hi rendition="#italic">Polk</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-03-18">
                            <hi rendition="#italic">March 18, 1918</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received March 19.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. Polk</hi>: I enclose herewith copy of a
                    letter which I have today addressed to Mr. McCormick, and on which I shall be
                    very glad to have your opinion.</p>
                <p>Yours sincerely,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Richard Crawford</hi>
                    </signed>
                </closer>



                <xi:include href="d59-a1.xml" xpointer="d59-a1"/>
