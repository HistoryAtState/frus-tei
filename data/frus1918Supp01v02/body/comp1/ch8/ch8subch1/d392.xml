    <text>
        <body>
            <div xml:id="d392">

                <pb facs="0485" n="1319" sameAs="frus:frus1918Supp01v02/pg1319"/>

                <note rend="inline" type="source">File No. 659.119/237a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Chargé in Denmark</hi>
                        (<hi rendition="#italic">Grant-Smith</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-03-01T18:00:00-05:00">
                            <hi rendition="#italic">March 1, 1918, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>759. From War Trade Board:</p>
                <p>Please advise us as to possibility and desirability of exportation from here to
                    Denmark of raw materials to maintain Danish industries for domestic consumption,
                    suggesting figures for same.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
