                <pb facs="0464" n="1298" sameAs="frus:frus1918Supp01v02/pg1298"/>

                <note rend="inline" type="source">File No. 103.96/189</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi rendition="#italic"
                            >Page</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1918-01-11T23:00:00+00:00">
                            <hi rendition="#italic">January 11, 1918, 11 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received January 11, 10.51
                        p.m.</hi>]</dateline>
                </opener>
                <p>8241. For War Trade Board from Sheldon:</p>
                <p>Referring to your January 8, Denmark. Foreign Office cabling Spring Rice tonight some
                    suggestions for your consideration. They think 400,000 tons right amount for
                    Denmark’s needs, but leave it to you to increase if necessary to get an
                    agreement.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Page</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
