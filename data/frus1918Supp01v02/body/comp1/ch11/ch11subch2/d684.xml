    <text>
        <body>
            <div xml:id="d684">

                <pb facs="0809" n="1643" xml:id="pg1643"/>

                <note rend="inline" type="source">War trade Board Files: Switzerland, Shipping and
                    Tonnage, Austrian Ships in Spanish, Waters, Vol. II</note>
                <head>
                    <hi rendition="#italic">The Third Secretary of the British Embassy</hi> (<hi
                        rendition="#italic">Hudson</hi>) <hi rendition="#italic">to the Chairman of
                        the War Trade Board</hi> (<hi rendition="#italic">McCormick</hi>)</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-09-14">
                            <hi rendition="#italic">September 14, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear Mr. McCormick</hi>: I beg to enclose herewith
                    paraphrase of the telegram which Sir Richard Crawford showed you regarding
                    London’s opinion on the subject of tonnage for Switzerland.</p>
                <p>Yours very truly,</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">R. S. Hudson</hi>
                    </signed>
                </closer>


                <xi:include href="d684-a1.xml" xpointer="d684-a1"/>
            </div>
