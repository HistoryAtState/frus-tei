    <text>
        <body>
            <div xml:id="d674">

                <pb facs="0797" n="1631" sameAs="frus:frus1918Supp01v02/pg1631"/>

                <note rend="inline" type="source">File No. 664.119/355</note>
                <head>
                    <hi rendition="#italic">The Minister in Switzerland</hi> (<hi
                        rendition="#italic">Stovall</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 3461</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berne</hi></placeName>, <date
                            calendar="gregorian" when="1918-06-10">
                            <hi rendition="#italic">June 10, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received June 27.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: With reference to this Legation’s telegram
                    No. 3224 of May 2, 1918 (Mr. Dresel’s No. 21), concerning the new lumber
                    convention between the Allied Governments and the Swiss Government,<anchor n="1"
                        xml:id="d674-f1"/> I have the honor to transmit herewith copy and
                    translation of an official communication from the Swiss Department of Public
                    Economy, stating that the Federal Council has ratified this convention as
                    concluded on May 1, 1918.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Pleasant A. Stovall</hi>
                    </signed>
                </closer>



                <xi:include href="d674-a1.xml" xpointer="d674-a1"/>
            </div>
        </body>
    </text>
