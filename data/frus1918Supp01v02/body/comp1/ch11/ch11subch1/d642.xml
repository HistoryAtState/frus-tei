    <text>
        <body>
            <div xml:id="d642">

                <pb facs="0770" n="1604" sameAs="frus:frus1918Supp01v02/pg1604"/>

                <note rend="inline" type="source">File No. 654.119/157a</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Minister in Switzerland</hi> (<hi rendition="#italic"
                            >Stovall</hi>)<anchor n="1" xml:id="d642-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-03-12T18:00:00-05:00">
                            <hi rendition="#italic">March 12, 1918, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1604. For the purpose of obtaining greater tonnage to facilitate the movement of
                    the wheat crop from South America and thus hasten the relief in wheat promised
                    to Switzerland, War Trade Board has placed a temporary prohibition upon the
                    importation of corn from overseas.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Polk</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d642-f1" n="1" type="source" xml:id="d642-f1-content">
                <p>The same, on the same date, to the Ambassador in Argentina (No. 536) and the
                    Minister in Venezuela (No. 636).</p>
            </note>
        </listAnnotation>
    </standOff>
