    <text>
        <body>
            <div xml:id="d632">

                <pb facs="0762" n="1596" sameAs="frus:frus1918Supp01v02/pg1596"/>

                <note rend="inline" type="source">File No. 654.119/99</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in Switzerland</hi> (<hi rendition="#italic">Wilson</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-01-16T17:00:00-05:00">
                            <hi rendition="#italic">January 16, 1918, 5 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1347. Referring Legation’s No. 2379 of January 10, 10 a.m.,<anchor n="1"
                        xml:id="d632-f1"/>
                    Dresel should be
                    instructed to participate as suggested with British and French representatives
                    in forthcoming negotiations for the reduction of cotton and rubber goods in
                    accordance with the rights reserved in [part II,] article 11 (<hi
                        rendition="#italic">a</hi>) of the Swiss-American agreement signed in Paris
                    on December 5, 1917.<anchor n="2" xml:id="d632-f2"/>
                </p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
