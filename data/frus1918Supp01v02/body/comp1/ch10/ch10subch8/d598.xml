            <div xml:id="d598">

                <pb facs="0712" n="1546" xml:id="pg1546"/>

                <note rend="inline" type="source">File No. 656.119/786a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Chargé in the
                        Netherlands</hi> (<hi rendition="#italic">Bliss</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-10-02">
                            <hi rendition="#italic">October 2, 1918</hi></date>.</dateline>
                </opener>
                <p>2158. Do not act on telegram No. 2154, October 1, 4 p.m., until you receive
                    further instructions.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
