    <text>
        <body>
            <div xml:id="d494">

                <pb facs="0597" n="1431" sameAs="frus:frus1918Supp01v02/pg1431"/>

                <note rend="inline" type="source">File No. 656.119/261</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1918-03-27T18:00:00+01:00">
                            <hi rendition="#italic">March 27, 1918, 6 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received March 27, 11.17
                        a.m.</hi>]</dateline>
                </opener>
                <p>9240. War Trade Board [from Sheldon]:</p>
                <p>No. 347. Foreign Office inquire reason for the release of Dutch steamers <hi
                        rendition="#italic">Borneo</hi> and <hi rendition="#italic">Cornelis</hi>
                    and reinstatement of crews after their having been taken over by the United
                    States Government.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Page</hi>
                    </signed>
                </closer>
            </div>
        </body>
