    <text>
        <body>
            <div xml:id="d457">

                <pb facs="0559" n="1393" sameAs="frus:frus1918Supp01v02/pg1393"/>

                <note rend="inline" type="source">File No. 656.119/195</note>
                <head>
                    <hi rendition="#italic"> Major Grimprel of the French High Commission to the
                        Chairman of the War Trade Board</hi> (<hi rendition="#italic"
                    >McCormick</hi>)</head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-02-02">
                            <hi rendition="#italic">February 2, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. McCormick</hi>: The Government of the
                    Republic advises that, at the request of the Swiss Legation, it has informed the
                    Netherland Government that the Dutch ships now held in the United States, which
                    may proceed to Cette for the transportation of supplies to Switzerland, would
                    neither be detained nor requisitioned <pb facs="0560" n="1394" xml:id="pg1394"/>
                    by France, but would be allowed to continue on their course in accordance with
                    the agreements reached in the meantime with Holland.</p>
                <p>Accept [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">M. Grimprel</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
