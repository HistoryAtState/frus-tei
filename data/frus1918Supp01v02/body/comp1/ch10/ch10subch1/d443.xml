    <text>
        <body>
            <div xml:id="d443">

                <pb facs="0549" n="1383" sameAs="frus:frus1918Supp01v02/pg1383"/>

                <note rend="inline" type="source">File No. 656.119/119b</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Great
                        Britain</hi> (<hi rendition="#italic">Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-01-05T16:00:00-05:00">
                            <hi rendition="#italic">January 5, 1918, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>6172. For the Ambassador and Sheldon:</p>
                <p>For your confidential information and for the confidential information of Foreign
                    Office, but not under any circumstances to be used by you or Foreign Office in
                    any negotiations. In the event that reasonable propositions made by United
                    States are refused by Dutch Government concerning tonnage, United States
                    Government proposed [<hi rendition="#italic">sic</hi>] to requisition Dutch
                    boats under its control.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
