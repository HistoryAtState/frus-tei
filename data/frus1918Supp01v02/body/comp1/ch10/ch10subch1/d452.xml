    <text>
        <body>
            <div xml:id="d452">

                <pb facs="0557" n="1391" sameAs="frus:frus1918Supp01v02/pg1391"/>

                <note rend="inline" type="source">File No. 656.119/142a</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Minister in the
                        Netherlands</hi> (<hi rendition="#italic">Garrett</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-01-19T12:00:00-05:00">
                            <hi rendition="#italic">January 19, 1918, noon.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>924. Your 1899, January 17, 8 p.m. It is reported here that <hi
                        rendition="#italic">Nieuw Amsterdam</hi> has sailed. If she has not sailed,
                    Department gives authority to you to give assurance that <hi rendition="#italic"
                        >Nieuw Amsterdam</hi> will be permitted to return to Holland on a guarantee
                    from the Dutch Government that she will return immediately to the United States
                    on her next arrival in Holland. Department gives you this authority in order to
                    facilitate pending negotiations with the Dutch Government.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
