    <text>
        <body>
            <div xml:id="d552">

                <pb facs="0663" n="1497" sameAs="frus:frus1918Supp01v02/pg1497"/>

                <note rend="inline" type="source">File No. 656.119/491</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in the Netherlands</hi> (<hi rendition="#italic"
                            >Garrett</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-05-31T18:00:00-04:00">
                            <hi rendition="#italic">May 31, 1918, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1330. Your 2915, May 27, noon. Statement communicated to you by Stevens and quoted in your
                    cable is approved and should be transmitted to Foreign Office instead of
                    statement contained in Department’s 1282, May 25, 3 p.m.<anchor n="1"
                        xml:id="d552-f1"/>
                </p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
