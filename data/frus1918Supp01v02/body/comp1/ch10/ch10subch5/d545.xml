        <body>
            <div xml:id="d545">

                <pb facs="0657" n="1491" sameAs="frus:frus1918Supp01v02/pg1491"/>

                <note rend="inline" type="source">File No. 656.119/481</note>
                <head>
                    <hi rendition="#italic">The Netherland Chargé</hi> (<hi rendition="#italic">De
                            Beaufort</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Translation]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-05-20">
                            <hi rendition="#italic">May 20, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Mr. Secretary of State</hi>: I have the honor to
                    transmit herewith to Your Excellency a note of my Government, dated May 13,
                    about the requisition of Dutch vessels in United States ports.</p>
                <pb facs="0658" n="1492" xml:id="pg1492"/>
                <p>I beg leave to add, in reply to an oral inquiry of the State Department, that the
                    Royal Government has no objection to the publication of the notes exchanged
                    between that Government and the Government of the United States, on the subject
                    of the requisition of Dutch vessels, provided that the publication shall also
                    include the note herein enclosed.</p>
                <p>Be pleased to accept [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">W. de Beaufort</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d545-a1.xml" xpointer="d545-a1"/>
            </div>
