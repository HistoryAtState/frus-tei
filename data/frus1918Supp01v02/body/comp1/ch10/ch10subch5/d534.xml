    <text>
        <body>
            <div xml:id="d534">

                <pb facs="0650" n="1484" sameAs="frus:frus1918Supp01v02/pg1484"/>

                <note rend="inline" type="source">File No. 656.119/393</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Page</hi>) <hi rendition="#italic">to the Secretary of
                        State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1918-04-30T00:00:00+01:00">
                            <hi rendition="#italic">April 30, 1918, 12 a.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 4.13 p.m.</hi>]</dateline>
                </opener>
                <p>9781. War Trade Board [from Sheldon]:</p>
                <p>No. 502. My 485. Foreign Office requests no steps be taken publishing the
                    declination [<hi rendition="#italic">declaration?</hi>] without further
                    consultation with them. They believe publication should be postponed until
                    Dutch-German position is clear.<anchor n="1" xml:id="d534-f1"/>
                </p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Page</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
