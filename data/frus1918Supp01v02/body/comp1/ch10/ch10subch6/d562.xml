                <pb facs="0670" n="1504" sameAs="frus:frus1918Supp01v02/pg1504"/>

                <note rend="inline" type="source">File No. 656.119/552</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in the
                        Netherlands</hi> (<hi rendition="#italic">Garrett</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-06-19T14:00:00-04:00">
                            <hi rendition="#italic">June 19, 1918, 2 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1641. Your 3194, June 17, 5 p.m. Department does not wish you to take any steps
                    in this matter for the time being.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
