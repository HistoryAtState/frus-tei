    <text>
        <body>
            <div xml:id="d521">

                <pb facs="0632" n="1466" xml:id="pg1466"/>

                <note rend="inline" type="source">File No. 656.119/363</note>
                <head>
                    <hi rendition="#italic">The Minister in the Netherlands</hi> (<hi
                        rendition="#italic">Garrett</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The Hague</hi></placeName>, <date
                            calendar="gregorian" when="1918-04-18T15:00:00+01:19">
                            <hi rendition="#italic">April 18, 1918, 3 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received April 19, 2 a.m.</hi>]</dateline>
                </opener>
                <p>2337. My 2284, April 10. Belgian Commission Relief informs me that first cargo to
                    arrive since April 10 has been sent on to Belgium.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Garrett</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
