    <text>
        <body>
            <div xml:id="d517">

                <pb facs="0629" n="1463" sameAs="frus:frus1918Supp01v02/pg1463"/>

                <note rend="inline" type="source">File No. 656.119/350</note>
                <head>
                    <hi rendition="#italic">The Minister in the Netherlands</hi> (<hi
                        rendition="#italic">Garrett</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">The Hague</hi></placeName>, <date
                            calendar="gregorian" when="1918-04-11T18:00:00+01:19">
                            <hi rendition="#italic">April 11</hi> [<hi rendition="#italic">13</hi>],
                                <hi rendition="#italic">1918, 6 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received April 14, 10.34
                        a.m.</hi>]</dateline>
                </opener>
                <p>2309. Your 1085, April 8, 5 p.m.<anchor n="1" xml:id="d517-f1"/> After comparison
                    with instructions received by British Minister, I today [communicated] to
                    Minister for Foreign Affairs text of terms agreed upon for payment, etc., for
                    Dutch requisitioned ships and have given it to the press for publication
                    tomorrow.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Garrett</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
