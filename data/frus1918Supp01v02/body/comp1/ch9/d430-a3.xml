    <text>
        <body>
            <div xml:id="d430-a3">

                <pb facs="0537" n="1371" sameAs="frus:frus1918Supp01v02/pg1371"/>

                <opener>
                    <seg rendition="#center">[Annex 3]</seg>
                </opener>
                <head>
                    <hi rendition="#italic">The Icelandic Delegates to the Allied Delegates </hi>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1918-05-23">
                            <hi rendition="#italic">May 23, 1918</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Gentlemen</hi>: In reply to your letter of to-day,
                    we agree that it is understood that the supplementary provisions referred to
                    therein shall apply to the agreement signed by us to-day.</p>
                <p>We are, yours faithfully,</p>
                <closer>
                    <signed>
                        <list>
                            <item>
                                <hi rendition="#small-caps">Kl. Jonsson</hi>
                            </item>
                            <item>
                                <hi rendition="#small-caps">Richard Thors</hi>
                            </item>
                            <item>
                                <hi rendition="#small-caps">Eggert Briem</hi>
                            </item>
                        </list>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
