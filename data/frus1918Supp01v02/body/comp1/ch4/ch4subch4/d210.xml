    <text>
        <body>
            <div xml:id="d210">

                <pb facs="0247" n="1081" xml:id="pg1081"/>

                <note rend="inline" type="source">File No. 763.72112A/5402a</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State
                        to the Ambassador in Mexico</hi> (<hi rendition="#italic"
                            >Fletcher</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-12-21T14:00:00-05:00">
                            <hi rendition="#italic">December 21, 1918, 2 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1735. Japan is now participating enemy trade conferences London, Paris, and
                    Washington. You are authorized in conjunction with your British, French, and
                    Italian colleagues to invite representative of Japan to participate in
                    inter-Allied conferences on proposed changes in black lists.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Polk</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
