    <text>
        <body>
            <div xml:id="d131">

                <pb facs="0190" n="1024" sameAs="frus:frus1918Supp01v02/pg1024"/>

                <note rend="inline" type="source">File No. 763.72112/7434</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in France</hi>
                        (<hi rendition="#italic">Sharp</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-03-29T15:00:00-05:00">
                            <hi rendition="#italic">March 29, 1918, 3 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>3402. Frederick A. Sterling of your Embassy, who is familiar with procedure for
                    the inclusion or removal of names from enemy trading list, designated for the
                    purpose mentioned your 3214, February 19, 11 a.m.<anchor n="1" xml:id="d131-f1"
                    /> So inform Foreign Office.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
