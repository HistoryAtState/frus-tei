    <text>
        <body>
            <div xml:id="d149">

                <pb facs="0198" n="1032" sameAs="frus:frus1918Supp01v02/pg1032"/>

                <note rend="inline" type="source">File No. 763.72112/9358</note>
                <head>
                    <hi rendition="#italic">The Chargé in Denmark</hi> (<hi rendition="#italic"
                            >Grant-Smith</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Copenhagen</hi></placeName>, <date
                            calendar="gregorian" when="1918-07-09T18:00:00+01:00">
                            <hi rendition="#italic">July 9, 1918, 6 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 6.24 p.m.</hi>]</dateline>
                </opener>
                <p>2486. Your 920, June 18.<anchor n="1" xml:id="d149-f1"/> Am hoping daily to
                    secure copy of German black list, but find much difficulty, owing to fear of
                    Danes that the firms mentioned might receive preferential treatment. One list
                    said to be in possession of the Stock Exchange and one with the Chamber of
                    Manufacturers.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Grant-Smith</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d149-f1" n="1" xml:id="d149-f1-content">
                <p>“Can you obtain copy German black list?”</p>
            </note>
        </listAnnotation>
    </standOff>
