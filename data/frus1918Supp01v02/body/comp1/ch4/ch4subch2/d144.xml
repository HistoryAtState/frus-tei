    <text>
        <body>
            <div xml:id="d144">

                <pb facs="0196" n="1030" xml:id="pg1030"/>

                <note rend="inline" type="source">File No. 763.72112/8985</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Japan</hi> (<hi rendition="#italic">Morris</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-06-25T18:00:00-04:00">
                            <hi rendition="#italic">June 25, 1918, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>From War Trade Board:</p>
                <p>57. Referring Denby’s<anchor n="1" xml:id="d144-f1"/> report
                    May 7<anchor n="2" xml:id="d144-f2"/> approved by Consul General at Yokohama,
                    please suspend all activities in Japan for the compilation by naval attaché,
                    commercial attaché, or our consuls, of list of suspect or untrustworthy firms in
                    Japan beyond the list of local enemy traders compiled by the Japanese
                    Government. Knowledge of such activities by our representatives might seriously
                    embarrass negotiations pending in Washington with Japanese Embassy to secure
                    general Japanese cooperation with American and Allied Governments for common
                    policy toward enemy firms throughout neutral countries.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d144-f1" n="1" xml:id="d144-f1-content">
                <p>
                    Charles Denby, special assistant of the Department, making
                    investigations for the Department and the War Trade Board for licensing exports
                    to the Far East.</p>
            </note>
            <note corresp="#d144-f2" n="2" xml:id="d144-f2-content">
                <p>Not printed.</p>
            </note>
        </listAnnotation>
    </standOff>
