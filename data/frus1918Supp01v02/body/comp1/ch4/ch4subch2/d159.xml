                <note rend="inline" type="source">File No. 763.72112/9746</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in
                        Switzerland</hi> (<hi rendition="#italic">Stovall</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-08-20T20:50:00-04:00">
                            <hi rendition="#italic">August 20, 1918, 8.50 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>2572. For Dresel [from War Trade Board]:</p>
                <p>No. 84. Legation’s 4244, August 8, your 115. Your views approved. You are
                    authorized proceed accordingly.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
