            <div xml:id="d182">

                <pb facs="0228" n="1062" sameAs="frus:frus1918Supp01v02/pg1062"/>

                <note rend="inline" type="source">File No. 763.72112/10139</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Great Britain</hi> (<hi rendition="#italic"
                            >Page</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-09-26">
                            <hi rendition="#italic">September 26, 1918</hi></date>.</dateline>
                </opener>
                <p>1626. For Sheldon [from
                        Fuller, War Trade
                    Board]:</p>
                <p>No. 1274. Frothingham. Embassy’s 1906, September 16, your
                    1441. Action therein proposed is approved. Fuller.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
