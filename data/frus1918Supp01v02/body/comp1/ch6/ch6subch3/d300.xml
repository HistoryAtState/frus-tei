    <text>
        <body>
            <div xml:id="d300">

                <pb facs="0363" n="1197" sameAs="frus:frus1918Supp01v02/pg1197"/>

                <note rend="inline" type="source">War Trade Board Files: American-Norwegian
                    Agreement, Vol. III</note>
                <head>
                    <hi rendition="#italic">The Italian High Commissioner</hi> (<hi
                        rendition="#italic">Macchi di Cellere</hi>) <hi rendition="#italic">to the
                        Chairman of the War Trade Board</hi> (<hi rendition="#italic"
                    >McCormick</hi>)</head>
                <opener>
                    <seg rendition="#float-left">No. 8130/C—6</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-08-16">
                            <hi rendition="#italic">August 16, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. McCormick</hi>: With reference to the
                    Norwegian agreement signed on April 30 last, I am directed by my Government to
                    notify you of their adhesion to said agreement.</p>
                <p>Yours very truly,</p>
                <closer>High Commissioner for Italy <lb/>
                    <hi rendition="#italic">per</hi>
                    <signed>
                        <hi rendition="#small-caps">F. Quattrone</hi>
                    </signed>
                </closer>
            </div>
        </body>
