    <text>
        <body>
            <div xml:id="d296">

                <pb facs="0354" n="1188" xml:id="pg1188"/>

                <note rend="inline" type="source">File No. 657.119/514</note>
                <head>
                    <hi rendition="#italic">The British Ambassador on Special Mission</hi> (<hi
                        rendition="#italic">Reading</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 598</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-05-29">
                            <hi rendition="#italic">May 29, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received June 1.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Secretary</hi>: I beg to acknowledge the
                    receipt of your letter of May 3d enclosing copy of the Norwegian agreement which
                    was signed by Mr. McCormick and Doctor Nansen.</p>
                <p>I have received instructions from Mr. Balfour to inform you that His Majesty’s
                    Government are prepared formally to adhere to the agreement as enclosed in your
                    note of the 3d instant.</p>
                <p>Believe me [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Reading</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
