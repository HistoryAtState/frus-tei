    <text>
        <body>
            <div xml:id="d302">

                <pb facs="0364" n="1198" sameAs="frus:frus1918Supp01v02/pg1198"/>

                <note rend="inline" type="source">File No. 657.119/873</note>
                <head>
                    <hi rendition="#italic">The Chargé in Norway</hi> (<hi rendition="#italic"
                        >Schoenfeld</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 890</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Christiania</hi></placeName>, <date
                            calendar="gregorian" when="1918-08-19">
                            <hi rendition="#italic">August 19, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received September 12.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to report, for the
                    Department’s information, that a notice appeared in the press, under date of the
                    14th inst., that the Storting had unanimously approved, without debate, the
                    report relative to the agreement with the United States signed by Minister
                    Nansen on April 30, 1918.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">H. F. Arthur Schoenfeld</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
