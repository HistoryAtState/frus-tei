    <text>
        <body>
            <div xml:id="d293">

                <pb facs="0352" n="1186" sameAs="frus:frus1918Supp01v02/pg1186"/>

                <note rend="inline" type="source">File No. 657.119/447</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Norway</hi> (<hi rendition="#italic">Schmedeman</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-05-18T16:00:00-04:00">
                            <hi rendition="#italic">May 18, 1918, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>321. For Dye [from War
                    Trade Board]:</p>
                <p>No. 5. Our No. 1, Department’s 314, 6 p.m., May 14.<anchor n="1" xml:id="d293-f1"
                    /> We withdraw our suggestion that association agreements should be negotiated
                    at London and agree to their negotiation at Christiania. We are cabling London
                    in the above sense.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
