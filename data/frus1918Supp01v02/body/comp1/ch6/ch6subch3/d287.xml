    <text>
        <body>
            <div xml:id="d287">

                <pb facs="0349" n="1183" sameAs="frus:frus1918Supp01v02/pg1183"/>

                <note rend="inline" type="source">File No. 657.119/451b</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the French Ambassador</hi>
                        (<hi rendition="#italic">Jusserand</hi>)<anchor n="1" xml:id="d287-f1"/>
                </head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-05-03">
                            <hi rendition="#italic">May 3, 1918</hi>.</date>
                    </dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">My Dear Mr. Ambassador</hi>: I hand you herewith a
                    copy of the rationing agreement entered into on April 30, 1918, by the War Trade
                    Board with Fridtjof Nansen, special representative of the Norwegian
                    Government.</p>
                <p>I understand that previous to the execution of this agreement it was examined by
                    your representatives working in conjunction with the War Trade Board, and that
                    this agreement is entirely satisfactory to your Government.</p>
                <p>I should be glad if you would assure me that my understanding of this matter is
                    correct.</p>
                <p>I am [etc.]</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Robert Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d287-f1" n="1" type="source" xml:id="d287-f1-content">
                <p>The same, <hi rendition="#italic">mutatis mutandis</hi>, on the same date, to the
                    British Ambassador on Special Mission and to the Italian Ambassador.</p>
            </note>
        </listAnnotation>
    </standOff>
