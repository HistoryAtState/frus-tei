    <text>
        <body>
            <div xml:id="d262">

                <pb facs="0300" n="1134" sameAs="frus:frus1918Supp01v02/pg1134"/>

                <note rend="inline" type="source">File No. 657.119/372a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Norway</hi>
                        (<hi rendition="#italic">Schmedeman</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-02-21T20:00:00-05:00">
                            <hi rendition="#italic">February 21, 1918—8 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>239. For Schmedeman from War Trade Board:</p>
                <p>We have concluded to allow <hi rendition="#italic">Kim</hi> with cargo to sail
                    and Great Britain simultaneously will permit <hi rendition="#italic">Nobel</hi>
                    to sail. We have closed with Norwegian Government on terms our <hi
                        rendition="#italic">note verbale</hi> February 9,<anchor n="1"
                        xml:id="d262-f1"/> except increasing calcium carbide to 10,000 tons and
                    ferro silicon to 2,000 tons, and are preparing agreement for signature.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d262-f1" n="1" xml:id="d262-f1-content">
                <p>See telegram No. 6523, Feb. 9, to the Ambassador in Great Britain, <hi
                        rendition="#italic">ante</hi>, <ref target="#pg1127">p. 1127</ref>.</p>
            </note>
        </listAnnotation>
