    <text>
        <body>
            <div xml:id="d719">

                <pb facs="0837" n="1671" sameAs="frus:frus1918Supp01v02/pg1671"/>

                <note rend="inline" type="source">File No. 652.119/628</note>
                <head>
                    <hi rendition="#italic">The Ambassador in Spain</hi> (<hi rendition="#italic"
                        >Willard</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Madrid</hi></placeName>, <date
                            calendar="gregorian" when="1918-03-07T14:00:00+00:00">
                            <hi rendition="#italic">March 7, 1918, 2 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received March 8, 6.35 a.m.</hi>]</dateline>
                </opener>
                <p>1118. American-Spanish commercial agreement and French-Spanish commercial
                    financial agreement simultaneously ratified today by exchange of identic
                        notes.<anchor n="1" xml:id="d719-f1"/> Copies by next pouch.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Willard</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d719-f1" n="1" xml:id="d719-f1-content">
                <p>The former agreement only is printed, <hi rendition="#italic">infra.</hi>
                </p>
            </note>
        </listAnnotation>
    </standOff>
