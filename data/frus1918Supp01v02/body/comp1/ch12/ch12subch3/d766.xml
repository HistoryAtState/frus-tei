                <pb facs="0879" n="1713" sameAs="frus:frus1918Supp01v02/pg1713"/>

                <note rend="inline" type="source">File No. 652.119/1996</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Spain</hi> (<hi rendition="#italic">Willard</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-11-05T16:00:00-05:00">
                            <hi rendition="#italic">November 5, 1918, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1771. For Chadbourne
                    [from War Trade Board]:</p>
                <p>No. 354. Your 353, Embassy 1985, October 23, 6 p.m.<anchor n="1" xml:id="d766-f1"
                    /> You are authorized informally to discuss with Ventosa the matter of lifting
                    cotton and petroleum and the imposition of bunker control to insure regular
                    service between Spain and the United States. It is important <pb facs="0880"
                        n="1714" xml:id="pg1714"/> that your conversation be entirely informal in
                    character and designed to ascertain the attitude of the Spanish Government
                    without however committing ourselves to any definite policy or implying that our
                    right to impose bunker control is in any way dependent on Spanish
                    acquiescence.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
