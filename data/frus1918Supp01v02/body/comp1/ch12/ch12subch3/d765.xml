                <pb facs="0879" n="1713" sameAs="frus:frus1918Supp01v02/pg1713"/>

                <note rend="inline" type="source">File No. 652.119/2162e</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Ambassador in Spain</hi> (<hi rendition="#italic">Willard</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-11-01T19:00:00-05:00">
                            <hi rendition="#italic">November 1, 1918, 7 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1752. For Chadbourne
                    [from War Trade Board]:</p>
                <p>No. 343. We are advised by McFadden that he is unable at least for the present to proceed
                    to Spain to negotiate for horses and mules, but that Senator
                        Hollis has gone to Madrid as personal representative of
                        General Pershing.
                    You will please cooperate in the fullest possible manner with Senator
                        Hollis, lending him the fullest assistance of your
                    organization and advising us as to any pressure which in your opinion should be
                    exerted or any concession which might be offered to secure the desired
                    result.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
