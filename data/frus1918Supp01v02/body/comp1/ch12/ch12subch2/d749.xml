            <div xml:id="d749">

                <pb facs="0862" n="1696" sameAs="frus:frus1918Supp01v02/pg1696"/>

                <note rend="inline" type="source">File No. 652.119/1354j</note>
                <head>
                    <hi rendition="#italic">The Acting Secretary of State to the Ambassador in
                        Spain</hi> (<hi rendition="#italic">Willard</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-08-10T13:00:00-04:00">
                            <hi rendition="#italic">August 10, 1918, 1 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1411. For Smith from War Trade Board:</p>
                <p>Embassy’s 1608, July 31, 11 a.m. We are satisfied to have you come home for a
                    conference when in your judgment it seems best.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Polk</hi>
                    </signed>
                </closer>
            </div>
        </body>
