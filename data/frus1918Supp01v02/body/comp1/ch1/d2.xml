    <text>
        <body>
            <div xml:id="d2">

                <pb facs="0084" n="918" xml:id="pg918"/>

                <note rend="inline" type="source">File No. 763.72112/8835</note>
                <head>
                    <hi rendition="#italic">The British Ambassador on Special Mission</hi>
                        (<hi
                            rendition="#italic">Reading</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 588</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-05-29">
                            <hi rendition="#italic">May 29, 1918</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received June 1</hi>.]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honour, under instructions from
                    His Majesty’s Principal Secretary of State for Foreign Affairs, to inform you
                    that at the request of the Admiralty it is proposed to add to the British list
                    of absolute contraband the following: “Citric acid and citrates.” Before taking
                    this step I am instructed to enquire whether your Government will be willing to
                    take similar action. I should accordingly be grateful if I might expect a reply
                    at your early convenience.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Reading</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
