    <text>
        <body>
            <div xml:id="d793">

                <pb facs="0896" n="1730" xml:id="pg1730"/>

                <note rend="inline" type="source">File No. 837.711/2</note>
                <head>
                    <hi rendition="#italic">The Chargé in Cuba</hi> (<hi
                            rendition="#italic">Scholle</hi>) <hi rendition="#italic">to
                        the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Habana</hi></placeName>, <date
                            calendar="gregorian" when="1917-11-21T16:00:00-05:29">
                            <hi rendition="#italic">November 21, 1917, 4 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 7 p.m.</hi>]</dateline>
                </opener>
                <p>Your November 20, 6 p.m. President approves in principle and is anxious to have
                    officer come at once to explain.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Scholle</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
