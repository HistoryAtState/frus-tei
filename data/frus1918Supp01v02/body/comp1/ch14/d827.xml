    <text>
        <body>
            <div xml:id="d827">

                <pb facs="0910" n="1744" sameAs="frus:frus1918Supp01v02/pg1744"/>

                <note rend="inline" type="source">File No. 600.119/1259</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Ambassador in Spain</hi>
                        (<hi rendition="#italic">Willard</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-09-09T16:00:00-04:00">
                            <hi rendition="#italic">September 9, 1918, 4 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>1535. For Chadbourne [from War Trade Board]:</p>
                <p>No. 240. Yours of August 31, 7 p.m., Embassy’s 1761. Subject matter referred to
                    in your cable at present under discussion with Cuba. Will cable you when final
                    negotiations complete.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
