    <text>
        <body>
            <div xml:id="d811">

                <pb facs="0904" n="1738" sameAs="frus:frus1918Supp01v02/pg1738"/>

                <note rend="inline" type="source">File No. 652.119/1000</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Minister in Cuba</hi> (<hi rendition="#italic">Gonzales</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-06-22T15:00:00-04:00">
                            <hi rendition="#italic">June 22, 1918, 3 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>From War Trade Board:</p>
                <p>No. 90. Referring yours June 12, 11 p.m.<anchor n="1" xml:id="d811-f1"/> We are
                    allowing American coal to go to Cuba for the benefit of Cuba, and we prefer to
                    have Cuban Government restrict the sailings of all vessels from Cuba to Mexico
                    by declining to allow them to have the coal which we have shipped for Cuba’s own
                    use. Please arrange along these lines if possible.</p>
                <p>Show to Morgan.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
