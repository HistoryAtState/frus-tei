    <text>
        <body>
            <div xml:id="d350-a7">

                <pb facs="0434" n="1268" sameAs="frus:frus1918Supp01v02/pg1268"/>

                <head>Letter No. 3</head>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Foreign Office</hi></placeName>, <date
                            calendar="gregorian" when="1918-05-29">
                            <hi rendition="#italic">May 29, 1918</hi></date>.</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Dear M. Wallenberg</hi>: It is desirable that there should be put on
                    record your statement to me which forms part of the arrangements concluded by
                    the agreement, that the Swedish Government during the continuance of the
                    agreement will not permit the transit through Sweden of molybdenum or mica or
                    any articles containing molybdenum or mica.</p>
                <p>Yours sincerely,</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">F. Leverton Harris</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
