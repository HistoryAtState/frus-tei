    <text>
        <body>
            <div xml:id="d324">

                <pb facs="0382" n="1216" sameAs="frus:frus1918Supp01v02/pg1216"/>

                <note rend="inline" type="source">File No. 658.119/300</note>
                <head>
                    <hi rendition="#italic">The Minister in Sweden</hi> (<hi rendition="#italic"
                        >Morris</hi>) <hi rendition="#italic">to the Secretary of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Stockholm</hi></placeName>, <date
                            calendar="gregorian" when="1918-04-06T18:00:00+01:00">
                            <hi rendition="#italic">April 6, 1918, 6 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 11.57 p.m.</hi>]</dateline>
                </opener>
                <p>1855. Your 673. British Minister has received instructions from his Government to
                    drop matter, as they did not wish to consider requisitioning.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Morris</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
