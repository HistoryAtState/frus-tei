    <text>
        <body>
            <div xml:id="d319">

                <pb facs="0379" n="1213" sameAs="frus:frus1918Supp01v02/pg1213"/>

                <note rend="inline" type="source">File No. 658.119/260</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the Minister in Sweden</hi>
                        (<hi rendition="#italic">Morris</hi>)</head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-03-23T18:00:00-05:00">
                            <hi rendition="#italic">March 23, 1918, 6 p.m.</hi>
                        </date>
                    </dateline>
                </opener>
                <p>631. From War Trade Board:</p>
                <p>Your 1682, March 15, 5 p.m. Wheat Executive have guaranteed Swedish Minister
                    Sweden may purchase, if agreement concluded, from Argentine 100,000 tons wheat,
                    50,000 tons oats, 100,000 tons maize; from Australia 100,000 tons wheat, 80,000
                    tons wheat flour.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Lansing</hi>
                    </signed>
                </closer>
            </div>
        </body>
