    <text>
        <body>
            <div xml:id="d376">

                <pb facs="0459" n="1293" sameAs="frus:frus1918Supp01v02/pg1293"/>

                <note rend="inline" type="source">File No. 658.119/681</note>
                <head>
                    <hi rendition="#italic">The Chargé in Sweden</hi> (<hi
                            rendition="#italic">Whitehouse</hi>) <hi rendition="#italic"
                        >to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Stockholm</hi></placeName>, <date
                            calendar="gregorian" when="1918-11-02T17:00:00+01:00">
                            <hi rendition="#italic">November 2, 1918, 5 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received 9 p.m.</hi>]</dateline>
                </opener>
                <p>3094. Have just received Swedish reply with statistics and explanations regarding
                    the exports to Central Powers. Will telegraph brief <hi rendition="#italic"
                        >résumé</hi> and send text by direct boat on the 8th.<anchor n="1"
                        xml:id="d376-f1"/> Copy to London.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Whitehouse</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d376-f1" n="1" xml:id="d376-f1-content">
                <p>No telegraphic <hi rendition="#italic">résumé</hi> received; text enclosed in
                    despatch No. 1476, Nov. 6, received Dec. 8, not printed. (File No.
                    658.119/720.)</p>
            </note>
        </listAnnotation>
    </standOff>
