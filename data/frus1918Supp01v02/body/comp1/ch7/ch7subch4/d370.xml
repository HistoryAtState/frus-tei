    <text>
        <body>
            <div xml:id="d370">

                <pb facs="0457" n="1291" sameAs="frus:frus1918Supp01v02/pg1291"/>

                <note rend="inline" type="source">File No. 658.119/646</note>
                <head>
                    <hi rendition="#italic">The Chargé in Sweden</hi> (<hi
                            rendition="#italic">Whitehouse</hi>) <hi rendition="#italic"
                        >to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Stockholm</hi></placeName>, <date
                            calendar="gregorian" when="1918-10-07T17:00:00+01:00">
                            <hi rendition="#italic">October 7, 1918, 5 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received October 8, 1.45
                        a.m.</hi>]</dateline>
                </opener>
                <p>2954. Allied ministers have informed Minister for Foreign Affairs that their
                    Governments adhered to our note regarding the breach of agreement.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Whitehouse</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
