    <text>
        <body>
            <div xml:id="d371">

                <pb facs="0457" n="1291" sameAs="frus:frus1918Supp01v02/pg1291"/>

                <note rend="inline" type="source">File No. 658.119/659</note>
                <head>
                    <hi rendition="#italic">The Chargé in Great Britain</hi> (<hi
                        rendition="#italic">Laughlin</hi>) <hi rendition="#italic">to the Secretary
                        of State </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">London</hi></placeName>, <date
                            calendar="gregorian" when="1918-10-15">
                            <hi rendition="#italic">October 15, 1918</hi>.</date>
                        <lb/> [<hi rendition="#italic">Received 8.30 p.m.</hi>]</dateline>
                </opener>
                <p>2807. War Trade Board [from Sheldon]:</p>
                <p>No. 1667. Referring to my letter No. 5385 of September 12<anchor n="1"
                        xml:id="d371-f1"/> with reference to our engagement to bear one-third of the
                    expense in connection with the purchase of iron ore under the Swedish agreement.
                    Please let me have answer as soon as possible.</p>
                <closer>
                    <signed>
                        <hi rendition="#small-caps">Laughlin</hi>
                    </signed>
                </closer>
            </div>
        </body>
    </text>
