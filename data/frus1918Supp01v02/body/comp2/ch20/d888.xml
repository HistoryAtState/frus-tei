    <text>
        <body>
            <div xml:id="d888">

                <pb facs="0956" n="1790" sameAs="frus:frus1918Supp01v02/pg1790"/>

                <note rend="inline" type="source">File No. 763.72111/7037</note>
                <head>
                    <hi rendition="#italic">The Chargé in Honduras</hi> (<hi rendition="#italic"
                            >Curtis</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Tegucigalpa</hi></placeName>, <date
                            calendar="gregorian" when="1918-07-09T15:00:00-05:48">
                            <hi rendition="#italic">July 9, 1918, 3 p.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received July 10, 11.52 a.m.</hi>]</dateline>
                </opener>
                <p>In reference to your July 6, 7 p.m. The President, the Minister for Foreign
                    Affairs, assure me that there are no restrictions whatsoever as to the entrance
                    into Honduran ports of American merchant vessels armed for defense only.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Curtis</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
