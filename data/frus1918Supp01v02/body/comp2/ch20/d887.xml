    <text>
        <body>
            <div xml:id="d887">

                <pb facs="0956" n="1790" sameAs="frus:frus1918Supp01v02/pg1790"/>

                <note rend="inline" type="source">File No. 763.72111/7035a</note>
                <head>
                    <hi rendition="#italic">The Secretary of State to the
                        Chargé in Honduras</hi> (<hi rendition="#italic">Curtis</hi>)<anchor n="1"
                        xml:id="d887-f1"/>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Washington</hi></placeName>, <date
                            calendar="gregorian" when="1918-07-06">
                            <hi rendition="#italic">July 6, 1918</hi></date>.</dateline>
                </opener>
                <p>Inform Department by cable what restrictions, if any, are imposed by Government
                    of country to which you are accredited, upon entrance into its ports of armed
                    American merchantmen engaged in commerce.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Lansing</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d887-f1" n="1" type="source" xml:id="d887-f1-content">
                <p>The same, on the same date, to the Ministers in Salvador and Guatemala (File Nos.
                    763.72111/7035b and 7035c).</p>
            </note>
        </listAnnotation>
    </standOff>
