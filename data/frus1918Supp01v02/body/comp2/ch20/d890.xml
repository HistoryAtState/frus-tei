                <pb facs="0957" n="1791" sameAs="frus:frus1918Supp01v02/pg1791"/>

                <note rend="inline" type="source">File No. 763.72111/7044</note>
                <head>
                    <hi rendition="#italic">The Minister in Guatemala</hi> (<hi rendition="#italic"
                            >Leavell</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#center">[Telegram]</seg>
                </opener>
                <opener>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Guatemala</hi></placeName>, <date
                            calendar="gregorian" when="1918-07-17T10:00:00-06:36">
                            <hi rendition="#italic">July 17, 1918, 10 a.m.</hi>
                        </date>
                        <lb/> [<hi rendition="#italic">Received July 18, 5.15 a.m.</hi>]</dateline>
                </opener>
                <p>Your July 6, 7 p.m. Have just been informed by Under Secretary of Foreign
                    Relations, the President and the Foreign Minister both being sick, there are no
                    restrictions imposed upon armed American vessels upon entrance into any
                    Guatemalan port.</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Leavell</hi>
                        
                    </signed>
                </closer>
            </div>
        </body>
