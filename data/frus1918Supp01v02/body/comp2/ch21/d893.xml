            </note>
            <note corresp="#d893-f3" n="2" xml:id="d893-f3-content">
                <p>Not printed; see telegram of Oct. 11, <ref target="frus1917Supp02v02#pg_1262">
                        <hi rendition="#italic">ibid.</hi>, p. 1262</ref>.</p>
            </note>
        </listAnnotation>
