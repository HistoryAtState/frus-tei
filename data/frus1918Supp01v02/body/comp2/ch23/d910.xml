    <text>
        <body>
            <div xml:id="d910">

                <pb facs="0971" n="1805" sameAs="frus:frus1918Supp01v02/pg1805"/>

                <note rend="inline" type="source">File No. 763.72111/6919</note>
                <head>
                    <hi rendition="#italic">The Minister in Switzerland</hi> (<hi rendition="#italic"
                            >Stovall</hi>) <hi rendition="#italic">to the Secretary of State
                    </hi>
                </head>
                <opener>
                    <seg rendition="#float-left">No. 2546</seg>
                    <dateline rendition="#float-right">
                        <placeName>
                            <hi rendition="#small-caps">Berne</hi></placeName>, <date
                            calendar="gregorian" when="1918-03-05">
                            <hi rendition="#italic">March 5, 1918</hi></date>. <lb/> [<hi
                            rendition="#italic">Received April 2.</hi>]</dateline>
                </opener>
                <p>
                    <hi rendition="#small-caps">Sir</hi>: I have the honor to transmit herewith
                    enclosed a copy of a communication which the Legation has received from the
                    Swiss Political Department, relative to the alleged participation in illegal
                    information services on the part of consular officers of belligerent countries.
                    For the information of the American consular officers in this country, I have
                    forwarded a copy of this communication to each consular office.</p>
                <p>I have [etc.]</p>
                <closer>
                    <signed>
                        
                            <hi rendition="#small-caps">Pleasant A. Stovall</hi>
                        
                    </signed>
                </closer>


                <xi:include href="d910-a1.xml" xpointer="d910-a1"/>
            </div>
