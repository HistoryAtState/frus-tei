        <body>
            <div xml:id="d691">

                <pb facs="0879" n="789" xml:id="pg789"/>

                <note rend="inline" type="source">894.6363/150: Telegram</note>
                <head><hi rendition="#italic">The Secretary of State to
                        the Ambassador in Japan</hi> (<hi rendition="#italic"
                            >Grew</hi>)</head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1934-12-14T20:00:00-05:00">December 14, 1934—8
                        p.m.</date></dateline>
                </opener>
                <p>204. Your 274, December 13, 2 p.m. Department, after giving careful consideration
                    to your telegram under reference, desires further to consult London and will as
                    soon as practicable communicate with you further.</p>
                <closer><signed><hi rendition="#small-caps">Hull</hi></signed></closer>
            </div>
        </body>
    </text>
