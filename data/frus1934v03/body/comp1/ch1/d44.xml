    <text>
        <body>
            <div xml:id="d44">

                <pb facs="0151" n="61" sameAs="frus:frus1934v03/pg61"/>

                <note rend="inline" type="source">893.01 Manchuria/1027</note>
                <head><hi rendition="#italic">The Chinese Chargé</hi> (<hi
                            rendition="#italic">Yung Kwai</hi>) <hi rendition="#italic"
                        >to the Secretary of State</hi></head>
                <opener>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1934-03-06">March 6, 1934</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to inform you that I am
                    instructed by my Government to deliver to your an official translation of a
                    statement issued by the Minister of Foreign Affairs at Nanking on Pu Yi’s
                    enthronement, which is herewith enclosed.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Yung Kwai</hi></signed></closer>


                <xi:include href="d44-a1.xml" xpointer="d44-a1"/>
            </div>
