    <text>
        <body>
            <div xml:id="d229">

                <pb facs="0860" n="834" xml:id="pg834"/>

                <head>229. Letter From Secretary of State Kissinger to Egyptian Deputy Prime
                    Minister and Foreign Minister Fahmy<anchor n="1" xml:id="d229-f1"/></head>
                <opener><dateline rendition="#float-right"><placeName>Jerusalem</placeName>, <date
                            calendar="gregorian" when="1975-09-01">September 1,
                        1975</date>.</dateline></opener>
                <opener>
                    <salute>Dear Ismail:</salute>
                </opener>
                <p>This is to inform you that with respect to Syria, we have an Israeli assurance
                    that Israel will not initiate military action against Syria.</p>
                <p>Warm regards,</p>
                <closer>
                    <signed corresp="#p_KHA_1">Henry A. Kissinger<anchor n="2" xml:id="d229-f2"
                        /></signed>
                </closer>
            </div>
        </body>
    </text>
