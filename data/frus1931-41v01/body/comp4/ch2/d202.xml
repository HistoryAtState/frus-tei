    <text>
        <body>
            <div xml:id="d202">

                <pb facs="0374" n="278" sameAs="frus:frus1931-41v01/pg278"/>

                <note rend="inline" type="source">500.A15A5/636</note>
                <head><hi rendition="#italic">The Ambassador in Great Britain</hi> (<hi
                        rendition="#italic">Bingham</hi>) <hi rendition="#italic">to the Secretary
                        of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 1776</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >London</hi></placeName>, <date calendar="gregorian"
                            when="1935-10-24">October 24, 1935</date>.<lb/>[Received November
                        6.]</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor to refer to my telegram
                    No. 535, October 24, 4 p.m.<anchor n="16" xml:id="d202-f1"/> and to forward
                    herewith the text of the invitation to a naval conference referred to
                    therein.</p>
                <p>Respectfully yours,</p>
                <closer>For the Ambassador:<lb/><signed><hi rendition="#small-caps">Ray
                            Atherton</hi></signed><lb/><hi rendition="#italic">Counselor of
                        Embassy</hi></closer>


                <xi:include href="d202-a1.xml" xpointer="d202-a1"/>
            </div>
        </body>
    </text>
