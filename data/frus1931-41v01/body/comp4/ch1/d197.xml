            <div xml:id="d197">

                <pb facs="0370" n="274" sameAs="frus:frus1931-41v01/pg274"/>

                <note rend="inline" type="source">500.A4B/603</note>
                <head><hi rendition="#italic">The Japanese Ambassador</hi> (<hi rendition="#italic"
                        >Saito</hi>) <hi rendition="#italic">to the Secretary of State</hi></head>
                <opener>
                    <seg rendition="#float-left">No. 250</seg>
                    <dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Washington</hi></placeName>, <date calendar="gregorian"
                            when="1934-12-29">December 29, 1934</date>.</dateline>
                </opener>
                <p><hi rendition="#small-caps">Sir</hi>: I have the honor, under instructions from
                    my Government, to communicate to you the following:—</p>
                <p>In accordance with Article XXIII of the Treaty concerning the Limitation of Naval
                    Armament, signed at Washington on the 6th February, 1922, the Government of
                    Japan hereby give notice to the Government of the United States of America of
                    their intention to terminate the said Treaty, which will accordingly cease to be
                    in force after the 31st December, 1936.</p>
                <p>Accept [etc.]</p>
                <closer><signed><hi rendition="#small-caps">Saito</hi></signed></closer>
            </div>
        </body>
    </text>
