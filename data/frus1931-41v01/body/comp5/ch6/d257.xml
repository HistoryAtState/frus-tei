    <text>
        <body>
            <div xml:id="d257">

                <pb facs="0439" n="343" sameAs="frus:frus1931-41v01/pg343"/>

                <note rend="inline" type="source">793.94/10566</note>
                <head><hi rendition="#italic">The Counselor of the Japanese Embassy in China</hi>
                        (<hi rendition="#italic">Hidaka</hi>) <hi
                        rendition="#italic">to the Counselor of the American Embassy in China</hi>
                        (<hi rendition="#italic">Peck</hi>)</head>
                <opener><dateline rendition="#float-right"><placeName><hi rendition="#small-caps"
                                >Nanking</hi></placeName>, <date calendar="gregorian"
                            when="1937-08-13">August 13, 1937</date>.</dateline></opener>
                <p><hi rendition="#small-caps">Dear Mr. Peck</hi>: I have been instructed by my
                    Ambassador at Shanghai to convey to Their Excellencies the American, British,
                    French, German and Italian Ambassadors the views as stated in the separate paper
                    attached hereto as his reply to their Note of the 11th instant.<anchor n="26"
                        xml:id="d257-f1"/></p>
                <p>I shall be very much indebted to you if you will be so good as to transmit it to
                    the interested Ambassadors at the earliest opportunity.</p>
                <p>Yours faithfully,</p>
                <closer><signed><hi rendition="#small-caps">Shinrokuro Hidaka</hi></signed></closer>


                <xi:include href="d257-a1.xml" xpointer="d257-a1"/>
            </div>
        </body>
    </text>
    <standOff>
        <listAnnotation>
            <note corresp="#d257-f1" n="26" xml:id="d257-f1-content">
                <p>For text of the collective note of August 11, see telegram No. 403, Aug. 11,
                    1937, midnight, from the Ambassador in China, <ref target="#pg341">p.
                    341</ref>.</p>
            </note>
        </listAnnotation>
    </standOff>
