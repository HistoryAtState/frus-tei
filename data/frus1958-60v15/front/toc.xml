                <pb facs="0015" n="XI" xml:id="pgXI"/>

                <head>Contents</head>
                <list type="toc">
                    <item><ref target="#pgIII"><hi rendition="#bold">Preface</hi></ref></item>
                    <item><ref target="#pgXIII"><hi rendition="#bold">List of Unpublished
                                Sources</hi></ref>
                    </item>
                    <item><ref target="#pgXIX"><hi rendition="#bold">List of
                            Abbreviations</hi></ref>
                    </item>
                    <item><ref target="#pgXXIII"><hi rendition="#bold">List of
                        Persons</hi></ref></item>
                    <item><hi rendition="#bold">South Asia</hi>
                        <list>
                            <item><ref target="#pg1">U.S. policy toward the South Asia
                                region</ref></item>
                            <item><ref target="#pg47">U.S. efforts to help promote peaceful
                                    relations between India and Pakistan: development and
                                    presentation of a “package plan” for settling the major disputes
                                    between the two countries; U.S. policy toward the Kashmir
                                    dispute and support for the Indus Basin Waters
                                treaty</ref></item>
                        </list></item>
                    <item><hi rendition="#bold">Afghanistan</hi>
                        <list>
                            <item><ref target="#pg215">U.S. efforts to help resolve the
                                    “Pushtunistan”dispute between Afghanistan and Pakistan; U.S.
                                    interest in countering Soviet influence in Afghanistan; concern
                                    with the effectiveness of U.S. economic assistance
                                    programs</ref></item>
                        </list></item>
                    <item><hi rendition="#bold">Ceylon</hi>
                        <list>
                            <item><ref target="#pg371">U.S. political and economic relations with
                                    Ceylon; U.S. concern with political instability in
                                Ceylon</ref></item>
                        </list></item>
                    <pb facs="0016" n="XII" xml:id="pgXII"/>
                    <item><hi rendition="#bold">India</hi>
                        <list>
                            <item><ref target="#pg415">U.S. political, economic, and military
                                    relations with India; President Eisenhower’s visit to India</ref></item>
                        </list></item>
                    <item><hi rendition="#bold">Nepal</hi>
                        <list>
                            <item><ref target="#pg580">U.S. political and economic relations with
                                    Nepal; U.S. concern with Soviet assistance programs in Nepal;
                                    visits of King Mahendra
                                    and Prime Minister Koirala to the United States</ref></item>
                        </list></item>
                    <item><hi rendition="#bold">Pakistan</hi>
                        <list>
                            <item><ref target="#pg615">U.S. political, economic, and military
                                    relations with Pakistan; President Eisenhower’s visit to Pakistan</ref></item>
                        </list></item>
                    <item><hi rendition="#bold">Southeast Asia</hi></item>
                    <item>Philippines <list>
                            <item><ref target="#pg824">Resumption of the base negotiations;
                                    President Garcia’s June
                                    1958 State visit to the United States; U.S. interest in the 1959
                                    Philippine elections; President Eisenhower’s June 1960 visit to the Philippines;
                                    discussions of trade relations</ref></item>
                        </list></item>
                    <item><hi rendition="#bold">Thailand</hi>
                        <list>
                            <item><ref target="#pg977">U.S. interest in the political and economic
                                    stability, military strength, and international orientation of
                                    Thailand</ref></item>
                        </list></item>
