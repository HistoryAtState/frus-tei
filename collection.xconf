<collection xmlns="http://exist-db.org/collection-config/1.0">
    <index xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:dbk="http://docbook.org/ns/docbook">
        <fulltext default="none" attributes="false"/>
        <!-- vector-store=db: persist embeddings in vector.dbx (eXist 7 with the
             vector extension). hsg-embedding backs hybrid sitewide search in
             hsg-jinks (see its doc/OPS.md). -->
        <lucene vector-store="db">
            <!-- the module is stored next to this configuration by pre-install.xql, outside the data collection:
                 indexing reads it while documents are stored, see eXist-db/exist#7039 -->
            <module uri="http://teipublisher.com/index" prefix="idx" at="xmldb:exist:///db/system/config/db/apps/frus-tei/index.xql"/>
            <analyzer class="org.exist.indexing.lucene.analyzers.NoDiacriticsStandardAnalyzer">
                <param name="stopwords" type="org.apache.lucene.analysis.util.CharArraySet"/>
            </analyzer>
            <!-- Analyzer chains (eXist 7 lucene analyzer chains) for hsg-jinks's search
                 options. plain is the default field's: words are runs of non-space
                 characters without the punctuation around them, split at em dashes
                 (a pattern tokenizer, so highlights cover the word only); possessives
                 dropped; each word indexed whole and in its parts (U.S.-Soviet:
                 u.s.-soviet, u.s, soviet) but the parts never
                 joined, so U.S. is not "us"; at query time a word is kept whole;
                 lower-cased and folded (so F-16 equals F–16). cased keeps case; stemmed
                 adds English (Porter) stemming; punct and literal keep words as written
                 (no parts; literal keeps case too). -->
            <analyzer id="plain">
                <index>
                    <tokenizer name="pattern" pattern="[^\s\p{P}](?:[^\s—―]*[^\s\p{P}])?" group="0"/>
                    <filter name="length" min="1" max="255"/>
                    <filter name="englishPossessive"/>
                    <filter name="wordDelimiterGraph" preserveOriginal="1" splitOnNumerics="0"/>
                    <filter name="flattenGraph"/>
                    <filter name="lowercase"/>
                    <filter name="asciiFolding"/>
                </index>
                <query>
                    <tokenizer name="pattern" pattern="[^\s\p{P}](?:[^\s—―]*[^\s\p{P}])?" group="0"/>
                    <filter name="length" min="1" max="255"/>
                    <filter name="englishPossessive"/>
                    <filter name="lowercase"/>
                    <filter name="asciiFolding"/>
                </query>
            </analyzer>
            <analyzer id="cased">
                <index>
                    <tokenizer name="pattern" pattern="[^\s\p{P}](?:[^\s—―]*[^\s\p{P}])?" group="0"/>
                    <filter name="length" min="1" max="255"/>
                    <filter name="englishPossessive"/>
                    <filter name="wordDelimiterGraph" preserveOriginal="1" splitOnNumerics="0"/>
                    <filter name="flattenGraph"/>
                    <filter name="asciiFolding"/>
                </index>
                <query>
                    <tokenizer name="pattern" pattern="[^\s\p{P}](?:[^\s—―]*[^\s\p{P}])?" group="0"/>
                    <filter name="length" min="1" max="255"/>
                    <filter name="englishPossessive"/>
                    <filter name="asciiFolding"/>
                </query>
            </analyzer>
            <analyzer id="punct">
                <tokenizer name="pattern" pattern="[^\s\p{P}](?:[^\s—―]*[^\s\p{P}])?" group="0"/>
                <filter name="length" min="1" max="255"/>
                <filter name="lowercase"/>
                <filter name="asciiFolding"/>
            </analyzer>
            <analyzer id="literal">
                <tokenizer name="pattern" pattern="[^\s\p{P}](?:[^\s—―]*[^\s\p{P}])?" group="0"/>
                <filter name="length" min="1" max="255"/>
                <filter name="asciiFolding"/>
            </analyzer>
            <analyzer id="stemmed">
                <index>
                    <tokenizer name="pattern" pattern="[^\s\p{P}](?:[^\s—―]*[^\s\p{P}])?" group="0"/>
                    <filter name="length" min="1" max="255"/>
                    <filter name="englishPossessive"/>
                    <filter name="wordDelimiterGraph" preserveOriginal="1" splitOnNumerics="0"/>
                    <filter name="flattenGraph"/>
                    <filter name="lowercase"/>
                    <filter name="asciiFolding"/>
                    <filter name="porterStem"/>
                </index>
                <query>
                    <tokenizer name="pattern" pattern="[^\s\p{P}](?:[^\s—―]*[^\s\p{P}])?" group="0"/>
                    <filter name="length" min="1" max="255"/>
                    <filter name="englishPossessive"/>
                    <filter name="lowercase"/>
                    <filter name="asciiFolding"/>
                    <filter name="porterStem"/>
                </query>
            </analyzer>
            <text match="/tei:TEI/tei:text">
                <facet dimension="frus-volume-id" expression="(ancestor::tei:TEI//tei:bibl[@type='frus-volume-id'], ancestor::tei:TEI/@xml:id/string())[1]"/>
                <facet dimension="frus-division-type" expression="ancestor::tei:TEI//tei:bibl[@type='frus-division-type']"/>
                <field name="file" expression="util:document-name(.)"/>
                <field name="text" expression="."/>
            </text>
            <!-- Division-level index backing hsg-jinks's sitewide search
                 (OP#1316). Every v2 division file holds exactly one tei:div;
                 fields carry no "if" guards because conditional field storage
                 silently breaks on current eXist; undated or non-document
                 divisions simply yield empty expressions instead. -->
            <text qname="tei:div">
                <facet dimension="hsg-category" expression="'documents'"/>
                <facet dimension="hsg-publication" expression="'frus'"/>
                <facet dimension="frus-volume-id" expression="idx:frus-volume-id(.)"/>
                <facet dimension="frus-division-type" expression="idx:frus-division-type(.)"/>
                <!-- TODO: `if="@type = ('section', 'document')"`  see HistoryAtState/hsg-jinks-data#15-->
                <field analyzer="plain" name="hsg-fulltext" expression="." store="no"/>
                <!-- The option fields: the same text, analyzed differently (see the chains above). None is stored: ft:highlight-field-matches computes an unstored field's text from the node (eXist feat/highlight-unstored-fields). -->
                <field name="hsg-fulltext-stemmed" expression="." analyzer="stemmed" store="no"/>
                <field name="hsg-fulltext-cased" expression="." analyzer="cased" store="no"/>
                <field name="hsg-fulltext-punct" expression="." analyzer="punct" store="no"/>
                <field name="hsg-fulltext-literal" expression="." analyzer="literal" store="no"/>
                <field name="hsg-url" expression="idx:frus-url(.)"/>
                <field name="frus-search-date-min" expression="idx:frus-date-min-string(.)"/>
                <field name="frus-search-date-max" expression="idx:frus-date-max-string(.)"/>
                <field name="hsg-date-min" expression="idx:frus-date-min(.)" binary="true" type="xs:dateTime"/>
                <field name="hsg-date-max" expression="idx:frus-date-max(.)" binary="true" type="xs:dateTime"/>
                <vector-field name="hsg-embedding" expression="."
                    dimension="384" similarity="cosine"
                    embedding="local" model="all-MiniLM-L6-v2"/>
            </text>
        </lucene>
    </index>
</collection>
